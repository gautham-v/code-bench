@@ -0,0 +1,828 @@
+//! What a repo offers: its files, and its words.
+//!
+//! Files come from `git ls-files` (the one subprocess in Claude Code mode,
+//! and only on a cold [`super::VocabCache::get`]); outside git, from a
+//! bounded walk. Words come from three places, each filtered for the same
+//! reason: a word in the list gets rewritten in what the user says, so a word
+//! that is only ordinary English must not be in it.
+
+use std::collections::{HashSet, VecDeque};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::SystemTime;
+
+use crate::text;
+
+/// Read for words, and mentionable even when git ignores them (a CLAUDE.md
+/// is often local).
+const DOC_FILES: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+
+/// A doc is read up to this many bytes.
+const MAX_DOC_BYTES: usize = 256 * 1024;
+
+/// Manifests read for package names, nearest the root first.
+const MAX_MANIFESTS: usize = 48;
+
+const MAX_WALK_FILES: usize = 20_000;
+const MAX_WALK_DEPTH: usize = 12;
+
+/// Directories a walk outside git does not enter (besides hidden ones).
+const WALK_SKIP_DIRS: &[&str] = &["node_modules", "target", "__pycache__", "venv"];
+
+/// What a cached vocab was built from; a different stamp means rebuild.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) enum Stamp {
+    /// Inside git: the index file, with its mtime and size when it exists.
+    Git {
+        index: PathBuf,
+        state: Option<(SystemTime, u64)>,
+    },
+    /// No repo: only time invalidates.
+    Loose,
+}
+
+impl Stamp {
+    pub(super) fn of(cwd: &Path) -> Stamp {
+        match git_index(cwd) {
+            Some(index) => {
+                let state = std::fs::metadata(&index)
+                    .ok()
+                    .and_then(|m| Some((m.modified().ok()?, m.len())));
+                Stamp::Git { index, state }
+            }
+            None => Stamp::Loose,
+        }
+    }
+
+    #[cfg(test)]
+    fn is_git(&self) -> bool {
+        matches!(self, Stamp::Git { .. })
+    }
+}
+
+/// The index of the repo `cwd` is in: `.git/index`, or for a worktree or a
+/// submodule (where `.git` is a file naming the real directory) the index
+/// in there.
+fn git_index(cwd: &Path) -> Option<PathBuf> {
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        let Ok(meta) = std::fs::metadata(&dot_git) else {
+            continue;
+        };
+        if meta.is_dir() {
+            return Some(dot_git.join("index"));
+        }
+        let pointer = std::fs::read_to_string(&dot_git).ok()?;
+        let git_dir = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+        return Some(dir.join(git_dir.trim()).join("index"));
+    }
+    None
+}
+
+/// The files mentions can name, relative to `cwd`, sorted; and whether they
+/// are git's list. A repo with nothing tracked under `cwd` (a project not
+/// yet committed) is walked like any other directory.
+pub(super) fn files(cwd: &Path) -> (Vec<String>, bool) {
+    let listed = git_index(cwd)
+        .and_then(|_| git_files(cwd))
+        .filter(|listed| !listed.is_empty());
+    let tracked = listed.is_some();
+    let mut files = listed.unwrap_or_else(|| walk(cwd));
+    for doc in DOC_FILES {
+        // Compared without case: on a case-insensitive disk `claude.md`
+        // answers to CLAUDE.md, and it is already listed under its own name.
+        if !files.iter().any(|f| f.eq_ignore_ascii_case(doc)) && cwd.join(doc).is_file() {
+            files.push(doc.to_string());
+        }
+    }
+    files.sort();
+    files.dedup();
+    (files, tracked)
+}
+
+/// `git ls-files` under `cwd`, less the files deleted from the working tree
+/// but not yet from the index (a rename Claude just made): there is nothing
+/// there to open. `None` when git is missing or says no.
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        // `-t` tags each path: `R` for the deleted ones, which are also
+        // listed under their cached tag.
+        .args(["ls-files", "-z", "-t", "--cached", "--deleted"])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let mut files = Vec::new();
+    let mut deleted = HashSet::new();
+    for entry in out.stdout.split(|b| *b == 0) {
+        let Some((tag, path)) = std::str::from_utf8(entry)
+            .ok()
+            .and_then(|e| e.split_once(' '))
+        else {
+            continue;
+        };
+        if tag == "R" {
+            deleted.insert(path);
+        } else {
+            files.push(path);
+        }
+    }
+    Some(
+        files
+            .into_iter()
+            .filter(|path| !deleted.contains(path))
+            .map(str::to_string)
+            .collect(),
+    )
+}
+
+/// Breadth first, so when the bound cuts the walk short it is the deep files
+/// that are missing.
+fn walk(cwd: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    let mut queue: VecDeque<(PathBuf, String, usize)> = VecDeque::new();
+    queue.push_back((cwd.to_path_buf(), String::new(), 0));
+    while let Some((dir, prefix, depth)) = queue.pop_front() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let Ok(name) = entry.file_name().into_string() else {
+                continue;
+            };
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            if kind.is_dir() {
+                if depth < MAX_WALK_DEPTH
+                    && !name.starts_with('.')
+                    && !WALK_SKIP_DIRS.contains(&name.as_str())
+                {
+                    queue.push_back((entry.path(), format!("{prefix}{name}/"), depth + 1));
+                }
+            } else if kind.is_file() || entry.path().is_file() {
+                if name == ".DS_Store" {
+                    continue;
+                }
+                files.push(format!("{prefix}{name}"));
+                if files.len() >= MAX_WALK_FILES {
+                    return files;
+                }
+            }
+        }
+    }
+    files
+}
+
+/// The repo's jargon in its canonical casing: file stems, package names,
+/// and terms from the docs. In that order, without repeats.
+pub(super) fn words(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut words = Words::default();
+    for file in files {
+        if let Some(stem) = stem(file) {
+            words.add(stem);
+        }
+    }
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| MANIFESTS.contains(&base_name(f)))
+        .collect();
+    manifests.sort_by_key(|f| f.matches('/').count());
+    for manifest in manifests.into_iter().take(MAX_MANIFESTS) {
+        if let Some(body) = read_capped(&cwd.join(manifest)) {
+            package_names(base_name(manifest), &body, &mut words);
+        }
+    }
+    let docs: Vec<(&str, String)> = DOC_FILES
+        .iter()
+        .filter_map(|doc| Some((*doc, read_capped(&cwd.join(doc))?)))
+        .collect();
+    doc_terms(&docs, &mut words);
+    words.list
+}
+
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn add(&mut self, word: &str) {
+        let word = word.trim();
+        if !word.is_empty() && self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// A file's name up to its first dot: `status_item` for `src/status_item.rs`,
+/// `next` for `next.config.js`. Dotfiles have none.
+pub(super) fn stem(path: &str) -> Option<&str> {
+    let stem = base_name(path).split('.').next()?;
+    (stem.chars().count() > 1).then_some(stem)
+}
+
+fn read_capped(path: &Path) -> Option<String> {
+    use std::io::Read;
+    let mut buf = Vec::new();
+    std::fs::File::open(path)
+        .ok()?
+        .take(MAX_DOC_BYTES as u64)
+        .read_to_end(&mut buf)
+        .ok()?;
+    Some(String::from_utf8_lossy(&buf).into_owned())
+}
+
+const MANIFESTS: &[&str] = &["Cargo.toml", "package.json", "pyproject.toml", "go.mod"];
+
+/// The package's own name, and those of its dependencies that are not plain
+/// words: `serde_json` is worth knowing, `log` is not.
+fn package_names(manifest: &str, body: &str, words: &mut Words) {
+    let mut own = |name: &str| {
+        // `@scope/name` is spoken, and written in prose, as `name`.
+        let name = name.rsplit('/').next().unwrap_or(name);
+        if is_name(name) {
+            words.add(name);
+        }
+    };
+    let mut deps: Vec<String> = Vec::new();
+    match manifest {
+        "Cargo.toml" | "pyproject.toml" => {
+            let Ok(table) = body.parse::<toml::Table>() else {
+                return;
+            };
+            let at = |path: &[&str]| -> Option<&toml::Value> {
+                let mut value = table.get(path[0])?;
+                for key in &path[1..] {
+                    value = value.get(key)?;
+                }
+                Some(value)
+            };
+            for path in [
+                &["package", "name"][..],
+                &["project", "name"],
+                &["tool", "poetry", "name"],
+            ] {
+                if let Some(name) = at(path).and_then(toml::Value::as_str) {
+                    own(name);
+                }
+            }
+            for path in [
+                &["dependencies"][..],
+                &["dev-dependencies"],
+                &["build-dependencies"],
+                &["workspace", "dependencies"],
+                &["tool", "poetry", "dependencies"],
+            ] {
+                if let Some(table) = at(path).and_then(toml::Value::as_table) {
+                    deps.extend(table.keys().cloned());
+                }
+            }
+            if let Some(list) = at(&["project", "dependencies"]).and_then(toml::Value::as_array) {
+                // PEP 508: the name is what comes before the version spec.
+                deps.extend(list.iter().filter_map(toml::Value::as_str).map(|spec| {
+                    spec.chars()
+                        .take_while(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '.'))
+                        .collect()
+                }));
+            }
+        }
+        "package.json" => {
+            let Ok(json) = serde_json::from_str::<serde_json::Value>(body) else {
+                return;
+            };
+            if let Some(name) = json.get("name").and_then(|n| n.as_str()) {
+                own(name);
+            }
+            for key in ["dependencies", "devDependencies", "peerDependencies"] {
+                if let Some(map) = json.get(key).and_then(|d| d.as_object()) {
+                    deps.extend(map.keys().cloned());
+                }
+            }
+        }
+        "go.mod" => {
+            let module = body
+                .lines()
+                .find_map(|l| l.trim().strip_prefix("module "))
+                .unwrap_or_default();
+            own(module.trim());
+        }
+        _ => {}
+    }
+    for dep in deps {
+        let dep = dep.rsplit('/').next().unwrap_or(&dep);
+        let plain = dep.chars().all(char::is_lowercase);
+        if is_name(dep) && !plain {
+            words.add(dep);
+        }
+    }
+}
+
+/// Something a package can be called: letters, digits, `-` and `_`.
+fn is_name(name: &str) -> bool {
+    name.chars().count() > 1
+        && name.chars().any(char::is_alphabetic)
+        && name
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_'))
+}
+
+/// How a doc writes a word.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Shape {
+    /// `GitHub`, `macOS`, `objc2`: no other way to write it.
+    Mixed,
+    /// `GPUI`, `API`.
+    Caps,
+    /// `Parakeet`: a name, when it is not just the start of a sentence.
+    Capitalised,
+    Lower,
+    /// Not a word: a number, a path, punctuation.
+    Other,
+}
+
+fn shape(word: &str) -> Shape {
+    if !word.chars().all(char::is_alphanumeric) || !word.starts_with(char::is_alphabetic) {
+        return Shape::Other;
+    }
+    let letters = word.chars().filter(|c| c.is_alphabetic()).count();
+    let upper = word.chars().filter(|c| c.is_uppercase()).count();
+    let digits = word.chars().any(|c| c.is_ascii_digit());
+    if upper == 0 {
+        // `v3` is a version, `objc2` a name.
+        return if digits && letters > 1 {
+            Shape::Mixed
+        } else if digits {
+            Shape::Other
+        } else {
+            Shape::Lower
+        };
+    }
+    if upper == letters {
+        return if letters > 1 {
+            Shape::Caps
+        } else {
+            Shape::Other
+        };
+    }
+    if upper == 1 && word.starts_with(char::is_uppercase) && !digits {
+        Shape::Capitalised
+    } else {
+        Shape::Mixed
+    }
+}
+
+/// Terms from the docs, each given with its file name:
+/// - words with a casing of their own (`GPUI`, `GitHub`), wherever they stand;
+/// - capitalised words in the middle of a sentence (`Parakeet`), and runs of
+///   them as phrases (`Claude Code`);
+/// - the README's title, if it is short (`# squawk`).
+///
+/// A word the docs also write in lowercase has no canonical casing and is
+/// left out, as is anything on the common-word list.
+fn doc_terms(docs: &[(&str, String)], words: &mut Words) {
+    let mut lower: HashSet<String> = HashSet::new();
+    let mut singles: Vec<(String, Shape)> = Vec::new();
+    let mut phrases: Vec<Vec<String>> = Vec::new();
+    let mut titles: Vec<Vec<String>> = Vec::new();
+
+    for (name, doc) in docs {
+        // A README opens with what the project is called; the other docs
+        // open with anything.
+        let mut title_next = *name == "README.md";
+        let mut fenced = false;
+        // Whether the next word opens a sentence, carried across the lines of
+        // a wrapped paragraph.
+        let mut opening = true;
+        for line in doc.lines() {
+            let trimmed = line.trim();
+            if trimmed.starts_with("```") || trimmed.starts_with("~~~") {
+                fenced = !fenced;
+                opening = true;
+                continue;
+            }
+            if fenced {
+                continue;
+            }
+            let heading = trimmed.starts_with('#');
+            let body = trimmed
+                .trim_start_matches(|c: char| {
+                    matches!(c, '#' | '>' | '-' | '*' | '+' | '|') || c.is_whitespace()
+                })
+                .trim_start_matches(|c: char| c.is_ascii_digit())
+                .trim_start_matches(['.', ')'])
+                .trim_start();
+            if body.is_empty() || body.len() != trimmed.len() {
+                opening = true;
+            }
+            let prose = strip_markup(body);
+            let tokens: Vec<text::Chunk> = text::chunks(&prose);
+            if heading && std::mem::take(&mut title_next) {
+                let plain = |t: &text::Chunk| {
+                    t.lead.is_empty() && t.trail.is_empty() && shape(&t.core) != Shape::Other
+                };
+                if trimmed.starts_with("# ") && tokens.len() <= 3 && tokens.iter().all(plain) {
+                    titles.push(tokens.iter().map(|t| t.core.clone()).collect());
+                }
+            }
+            // "Getting Started": every word capitalised says nothing about any.
+            let title_case = heading
+                && tokens.len() > 1
+                && tokens
+                    .iter()
+                    .filter(|t| t.core.chars().count() > 3)
+                    .all(|t| t.core.starts_with(char::is_uppercase));
+
+            let mut run: Vec<(String, Shape)> = Vec::new();
+            let mut flush = |run: &mut Vec<(String, Shape)>| {
+                for (n, (word, shape)) in run.iter().enumerate() {
+                    // In "Apple Silicon" the name is the first word; the
+                    // rest is a noun that happens to be capitalised.
+                    if n == 0 || *shape != Shape::Capitalised {
+                        singles.push((word.clone(), *shape));
+                    }
+                }
+                if (2..=4).contains(&run.len()) {
+                    phrases.push(run.iter().map(|(word, _)| word.clone()).collect());
+                }
+                run.clear();
+            };
+            for token in &tokens {
+                let word = token
+                    .core
+                    .strip_suffix("'s")
+                    .or_else(|| token.core.strip_suffix("’s"))
+                    .unwrap_or(&token.core);
+                let possessive = word.len() != token.core.len();
+                let shape = if token.is_protected() {
+                    Shape::Other
+                } else {
+                    shape(word)
+                };
+                let named = match shape {
+                    Shape::Mixed | Shape::Caps => true,
+                    // The capital on a sentence's first word says nothing.
+                    Shape::Capitalised => !opening && !title_case,
+                    Shape::Lower | Shape::Other => false,
+                };
+                if !token.lead.is_empty() || !named {
+                    flush(&mut run);
+                }
+                if shape == Shape::Lower {
+                    lower.insert(word.to_string());
+                }
+                if named {
+                    run.push((word.to_string(), shape));
+                }
+                if possessive || !token.trail.is_empty() {
+                    flush(&mut run);
+                }
+                opening = token.ends_sentence() || token.trail.ends_with(':');
+            }
+            flush(&mut run);
+            if heading {
+                opening = true;
+            }
+        }
+    }
+
+    let common = |word: &String| {
+        let key = word.to_lowercase();
+        COMMON_WORDS.contains(&key.as_str())
+            || super::jargon::FUNCTION_WORDS.contains(&key.as_str())
+    };
+    for title in titles.iter().filter(|title| !title.iter().all(common)) {
+        words.add(&title.join(" "));
+    }
+    for (word, shape) in singles {
+        let ordinary = shape != Shape::Mixed && common(&word);
+        if !ordinary && !lower.contains(&word.to_lowercase()) {
+            words.add(&word);
+        }
+    }
+    // A phrase names something unless it is ordinary words throughout
+    // ("MUST NEVER").
+    for phrase in phrases.iter().filter(|phrase| !phrase.iter().all(common)) {
+        words.add(&phrase.join(" "));
+    }
+}
+
+/// Markdown down to its prose: code spans out, links down to their text.
+fn strip_markup(line: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut chars = line.chars().peekable();
+    while let Some(c) = chars.next() {
+        match c {
+            '`' => {
+                // A code span is not prose; what replaces it must not join
+                // the words on either side into a phrase.
+                for d in chars.by_ref() {
+                    if d == '`' {
+                        break;
+                    }
+                }
+                out.push_str(" , ");
+            }
+            ']' if chars.peek() == Some(&'(') => {
+                for d in chars.by_ref() {
+                    if d == ')' {
+                        break;
+                    }
+                }
+            }
+            '[' | ']' => {}
+            '!' if chars.peek() == Some(&'[') => {}
+            _ => out.push(c),
+        }
+    }
+    out
+}
