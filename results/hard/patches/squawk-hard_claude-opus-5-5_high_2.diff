+        assert_eq!(stem("src/status_item.rs"), Some("status_item"));
+        assert_eq!(stem("next.config.js"), Some("next"));
+        assert_eq!(stem("Makefile"), Some("Makefile"));
+        assert_eq!(stem(".gitignore"), None);
+        assert_eq!(stem("a.rs"), None);
+    }
+
+    #[test]
+    fn words_from_stems_manifests_and_docs() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        write(
+            root,
+            "Cargo.toml",
+            "[workspace.dependencies]\nserde_json = \"1\"\nlog = \"0.4\"\n",
+        );
+        write(
+            root,
+            "crates/squawk-core/Cargo.toml",
+            "[package]\nname = \"squawk-core\"\n[dependencies]\ncrossbeam-channel = \"0.5\"\n",
+        );
+        write(root, "crates/squawk-core/src/status_item.rs", "");
+        write(
+            root,
+            "web/package.json",
+            r#"{"name": "@squawk/site", "dependencies": {"react": "1", "react-dom": "1"}}"#,
+        );
+        write(
+            root,
+            "README.md",
+            "# squawk\n\nRuns on GPUI with Parakeet.\n",
+        );
+        let files = files(root).0;
+        let words = words(root, &files);
+        for expected in [
+            "status_item",
+            "squawk-core",
+            "serde_json",
+            "crossbeam-channel",
+            "site",
+            "react-dom",
+            "squawk",
+            "GPUI",
+            "Parakeet",
+        ] {
+            assert!(
+                words.iter().any(|w| w == expected),
+                "{expected} in {words:?}"
+            );
+        }
+        for unexpected in ["log", "react", "Runs"] {
+            assert!(!words.iter().any(|w| w == unexpected), "{unexpected}");
+        }
+    }
+
+    #[test]
+    fn doc_terms_are_names_not_sentence_starts() {
+        let got = terms(
+            "# squawk\n\n\
+             Local dictation for macOS. Built for talking to Claude Code in a\n\
+             terminal. Everything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3.\n\
+             No account, no API keys.\n\n\
+             ## License\n\nMIT\n",
+        );
+        assert_eq!(
+            got,
+            [
+                "squawk",
+                "macOS",
+                "Claude",
+                "Mac",
+                "NVIDIA",
+                "Parakeet",
+                "TDT",
+                "API",
+                "MIT",
+                "Claude Code",
+                "Parakeet TDT"
+            ]
+        );
+    }
+
+    #[test]
+    fn emphasis_labels_and_title_case_are_not_terms() {
+        let got = terms(
+            "## Getting Started\n\n\
+             IMPORTANT: you MUST NEVER push. Open the History tab, then the Zed panel.\n\
+             We history things too. Use `Foo Bar` here.\n\n\
+             ```\nSome Code Block\n```\n",
+        );
+        assert_eq!(got, ["Zed"]);
+    }
+
+    #[test]
+    fn only_the_head_of_a_name_stands_alone() {
+        let got = terms("We run on Apple Silicon and the Hotkey Machine.\n");
+        assert_eq!(got, ["Apple", "Hotkey", "Apple Silicon", "Hotkey Machine"]);
+    }
+
+    #[test]
+    fn the_title_is_the_readmes_first_heading() {
+        assert_eq!(terms("# Acme Widgets\n\n# Transcripts\n"), ["Acme Widgets"]);
+        assert!(terms("# Getting Started\n").is_empty());
+        assert!(terms("Intro.\n\n## squawk\n").is_empty());
+        let mut words = Words::default();
+        doc_terms(&[("CLAUDE.md", "# squawk\n".to_string())], &mut words);
+        assert!(words.list.is_empty());
+    }
+
+    #[test]
+    fn a_word_also_written_lowercase_has_no_casing() {
+        assert_eq!(terms("We ship Widgets daily.\n"), ["Widgets"]);
+        assert!(terms("We ship Widgets daily. Good widgets.\n").is_empty());
+    }
+
+    #[test]
+    fn links_and_wrapped_lines() {
+        let got = terms("See [the Ghostty docs](https://x.io/Docs) and\nKitty for more.\n");
+        assert_eq!(got, ["Ghostty", "Kitty"]);
+    }
+}
