+//! Finding the agent session behind the front terminal.
+//!
+//! The walk itself ([`find`]) is plain logic over a [`Source`], so it is
+//! tested with a made-up process table; [`system`] is the real one (libproc).
+//!
+//! What counts as an agent is decided by more than the process name. A
+//! native Claude Code install runs `~/.local/share/claude/versions/2.1.5`
+//! through a `claude` symlink, and the kernel names the process after the
+//! file it ended up at ("2.1.5"); an npm install is `node` running a script.
+//! So a process that is not called `claude` is also asked for its argv.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use super::{Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// One row of the process table.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Proc {
+    pub pid: i32,
+    pub ppid: i32,
+    /// The kernel's name for it: the executable's file name, cut at 15 bytes.
+    pub comm: String,
+}
+
+/// How a process was started.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub(super) struct Invocation {
+    /// The executable's path.
+    pub exe: String,
+    pub argv: Vec<String>,
+}
+
+/// The process table, as much of it as [`find`] needs.
+pub(super) trait Source {
+    fn processes(&self) -> Vec<Proc>;
+    fn invocation(&self, pid: i32) -> Option<Invocation>;
+    fn cwd(&self, pid: i32) -> Option<PathBuf>;
+    fn tty(&self, pid: i32) -> Option<PathBuf>;
+    /// When the tty last saw input or output.
+    fn last_used(&self, tty: &Path) -> Option<SystemTime>;
+}
+
+/// Terminals whose shells are not their descendants: the helper that owns
+/// them, by bundle id and process name prefix. iTerm2 hands its sessions to
+/// `iTermServer-<version>`, which is reparented to launchd.
+const TERMINAL_HELPERS: &[(&str, &str)] = &[("com.googlecode.iterm2", "iTermServer")];
+
+/// Multiplexers: the client runs under the terminal, the panes (and the
+/// agent in one of them) under a server that does not.
+const MULTIPLEXERS: &[&str] = &["tmux", "zellij"];
+
+/// Programs that run an agent as a script: `node …/bin/claude`.
+const INTERPRETERS: &[&str] = &["node", "bun", "deno", "sh", "bash", "zsh"];
+
+/// Where an agent's files are installed, for a process that carries neither
+/// its name nor its argv.
+const INSTALL_MARKERS: &[(&str, Agent)] = &[
+    ("/claude/versions/", Agent::Claude),
+    ("/@anthropic-ai/claude-code/", Agent::Claude),
+    ("/@openai/codex/", Agent::Codex),
+];
+
+/// See [`super::detect`].
+pub(super) fn find(front: &FrontApp, src: &dyn Source) -> Option<Session> {
+    let procs = src.processes();
+    let mut children: HashMap<i32, Vec<&Proc>> = HashMap::new();
+    for p in &procs {
+        children.entry(p.ppid).or_default().push(p);
+    }
+
+    let mut roots = vec![front.pid];
+    for (bundle, prefix) in TERMINAL_HELPERS {
+        if *bundle == front.bundle_id {
+            roots.extend(
+                procs
+                    .iter()
+                    .filter(|p| p.comm.starts_with(prefix))
+                    .map(|p| p.pid),
+            );
+        }
+    }
+
+    let mut walk = Walk::default();
+    walk.from(&roots, &children, src);
+    if walk.agents.is_empty() && walk.multiplexed {
+        // The servers are the multiplexer processes the walk did not reach.
+        let servers: Vec<i32> = procs
+            .iter()
+            .filter(|p| MULTIPLEXERS.contains(&p.comm.as_str()) && !walk.seen.contains(&p.pid))
+            .map(|p| p.pid)
+            .collect();
+        walk.from(&servers, &children, src);
+    }
+
+    walk.agents
+        .iter()
+        .filter_map(|found| {
+            let cwd = src.cwd(found.pid)?;
+            let tty = src.tty(found.pid);
+            let used = tty.as_deref().and_then(|t| src.last_used(t));
+            let session = Session {
+                agent: found.agent,
+                pid: found.pid,
+                cwd,
+                tty,
+            };
+            // Most recently used tty; then the one nearest the terminal; then
+            // the newest process.
+            Some(((used, std::cmp::Reverse(found.depth), found.pid), session))
+        })
+        .max_by_key(|(rank, _)| *rank)
+        .map(|(_, session)| session)
+}
+
+struct Found {
+    pid: i32,
+    agent: Agent,
+    depth: usize,
+}
+
+#[derive(Default)]
+struct Walk {
+    seen: HashSet<i32>,
+    agents: Vec<Found>,
+    /// A multiplexer client was among the descendants.
+    multiplexed: bool,
+}
+
+impl Walk {
+    /// Collect the agents below `roots`. An agent's own children are not
+    /// searched: a `claude -p` it started is not the session being talked to.
+    fn from(&mut self, roots: &[i32], children: &HashMap<i32, Vec<&Proc>>, src: &dyn Source) {
+        let mut queue: Vec<(i32, usize)> = Vec::new();
+        for &root in roots {
+            if self.seen.insert(root) {
+                queue.push((root, 0));
+            }
+        }
+        let mut next = 0;
+        while let Some(&(pid, depth)) = queue.get(next) {
+            next += 1;
+            for child in children.get(&pid).map(Vec::as_slice).unwrap_or_default() {
+                if !self.seen.insert(child.pid) {
+                    continue;
+                }
+                if MULTIPLEXERS.contains(&child.comm.as_str()) {
+                    self.multiplexed = true;
+                }
+                match agent_of(child, src) {
+                    Some(agent) => self.agents.push(Found {
+                        pid: child.pid,
+                        agent,
+                        depth: depth + 1,
+                    }),
+                    None => queue.push((child.pid, depth + 1)),
+                }
+            }
+        }
+    }
+}
+
+fn agent_of(proc: &Proc, src: &dyn Source) -> Option<Agent> {
+    agent_named(&proc.comm).or_else(|| agent_invoked(&src.invocation(proc.pid)?))
+}
+
+/// The agent a process name stands for. Exact: "Claude" is the desktop app
+/// and "claudebar" is something else.
+fn agent_named(name: &str) -> Option<Agent> {
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(known, _)| *known == name)
+        .map(|(_, agent)| *agent)
+}
+
+/// The agent an executable path and argv stand for.
+fn agent_invoked(inv: &Invocation) -> Option<Agent> {
+    let argv0 = inv.argv.first().map(|a| base_name(a)).unwrap_or_default();
+    if let Some(agent) = agent_named(argv0).or_else(|| agent_named(base_name(&inv.exe))) {
+        return Some(agent);
+    }
+    if let Some(agent) = installed_agent(&inv.exe) {
+        return Some(agent);
+    }
+    if !INTERPRETERS.contains(&argv0) && !INTERPRETERS.contains(&base_name(&inv.exe)) {
+        return None;
+    }
+    let script = inv.argv.iter().skip(1).find(|a| !a.starts_with('-'))?;
+    let name = base_name(script);
+    let name = [".js", ".mjs", ".cjs"]
+        .iter()
+        .find_map(|ext| name.strip_suffix(ext))
+        .unwrap_or(name);
+    agent_named(name).or_else(|| installed_agent(script))
+}
+
+fn installed_agent(path: &str) -> Option<Agent> {
+    INSTALL_MARKERS
+        .iter()
+        .find(|(marker, _)| path.contains(marker))
+        .map(|(_, agent)| *agent)
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn system() -> impl Source {
+    libproc::Libproc::default()
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn system() -> impl Source {
+    NoProcesses
+}
+
+/// Where there is no libproc there is no terminal squawk knows either.
+#[cfg(not(target_os = "macos"))]
+struct NoProcesses;
+
+#[cfg(not(target_os = "macos"))]
+impl Source for NoProcesses {
+    fn processes(&self) -> Vec<Proc> {
+        Vec::new()
+    }
+    fn invocation(&self, _: i32) -> Option<Invocation> {
+        None
+    }
+    fn cwd(&self, _: i32) -> Option<PathBuf> {
+        None
+    }
+    fn tty(&self, _: i32) -> Option<PathBuf> {
+        None
+    }
+    fn last_used(&self, _: &Path) -> Option<SystemTime> {
+        None
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod libproc {
+    use std::cell::RefCell;
+    use std::ffi::{c_int, c_void, CStr, OsStr};
+    use std::mem;
+    use std::os::unix::ffi::OsStrExt;
+    use std::path::{Path, PathBuf};
+    use std::ptr;
+    use std::sync::Mutex;
+    use std::time::SystemTime;
+
+    use super::{Invocation, Proc, Source};
+
+    /// `devname` answers from a static buffer.
+    static DEVNAME: Mutex<()> = Mutex::new(());
+
+    #[derive(Default)]
+    pub(super) struct Libproc {
+        /// KERN_PROCARGS2 wants room for a whole argument area; one buffer
+        /// serves every process asked about.
+        args: RefCell<Vec<u8>>,
+    }
+
+    /// `proc_pidinfo` for a fixed-size flavor; `None` unless it filled `T`.
+    fn pidinfo<T>(pid: i32, flavor: c_int) -> Option<T> {
+        let size = mem::size_of::<T>() as c_int;
+        // SAFETY: every `T` used here is a plain C struct, valid when zeroed,
+        // and the kernel writes at most `size` bytes into it.
+        unsafe {
+            let mut info: T = mem::zeroed();
+            let wrote = libc::proc_pidinfo(pid, flavor, 0, (&mut info as *mut T).cast(), size);
+            (wrote == size).then_some(info)
+        }
+    }
+
+    /// The bytes of a fixed C string field, up to its NUL.
+    fn c_field<T>(field: &T) -> &[u8] {
+        // SAFETY: reads only within `field`, which is an array of c_char.
+        let bytes = unsafe {
+            std::slice::from_raw_parts((field as *const T).cast::<u8>(), mem::size_of::<T>())
+        };
+        let end = bytes.iter().position(|b| *b == 0).unwrap_or(bytes.len());
+        &bytes[..end]
+    }
+
+    fn arg_max() -> usize {
+        let mut mib = [libc::CTL_KERN, libc::KERN_ARGMAX];
+        let mut value: c_int = 0;
+        let mut size = mem::size_of::<c_int>();
+        // SAFETY: a two-name mib and an int-sized out buffer, as sysctl(3) asks.
+        let ok = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as u32,
+                (&mut value as *mut c_int).cast::<c_void>(),
+                &mut size,
+                ptr::null_mut(),
+                0,
+            ) == 0
+        };
+        if ok && value > 0 {
+            value as usize
+        } else {
+            1 << 20
+        }
+    }
+
+    impl Source for Libproc {
+        fn processes(&self) -> Vec<Proc> {
+            // SAFETY: a null buffer asks for the count only.
+            let count = unsafe { libc::proc_listallpids(ptr::null_mut(), 0) };
+            if count <= 0 {
+                return Vec::new();
+            }
+            // Room for processes started between the two calls.
+            let mut pids: Vec<libc::pid_t> = vec![0; count as usize + 64];
+            let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as c_int;
+            // SAFETY: `pids` is `bytes` long.
+            let count = unsafe { libc::proc_listallpids(pids.as_mut_ptr().cast(), bytes) };
+            pids.truncate(count.max(0) as usize);
+            pids.into_iter()
+                .filter(|pid| *pid > 0)
+                .filter_map(|pid| {
+                    // The short flavor also answers for other users' processes
+                    // (`login`, between the terminal and the shell, is root's).
+                    let info: libc::proc_bsdshortinfo = pidinfo(pid, libc::PROC_PIDT_SHORTBSDINFO)?;
+                    Some(Proc {
+                        pid,
+                        ppid: info.pbsi_ppid as i32,
+                        comm: String::from_utf8_lossy(c_field(&info.pbsi_comm)).into_owned(),
+                    })
+                })
+                .collect()
+        }
+
+        fn invocation(&self, pid: i32) -> Option<Invocation> {
+            let mut buf = self.args.borrow_mut();
+            if buf.is_empty() {
+                buf.resize(arg_max(), 0);
+            }
+            let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+            let mut size = buf.len();
+            // SAFETY: `buf` is `size` bytes; the kernel sets `size` to what it wrote.
+            let ok = unsafe {
+                libc::sysctl(
+                    mib.as_mut_ptr(),
+                    mib.len() as u32,
+                    buf.as_mut_ptr().cast::<c_void>(),
+                    &mut size,
+                    ptr::null_mut(),
+                    0,
+                ) == 0
+            };
+            if !ok {
+                return None;
+            }
+            parse_procargs(buf.get(..size)?)
+        }
+
+        fn cwd(&self, pid: i32) -> Option<PathBuf> {
+            let info: Box<libc::proc_vnodepathinfo> =
+                Box::new(pidinfo(pid, libc::PROC_PIDVNODEPATHINFO)?);
+            let path = c_field(&info.pvi_cdir.vip_path);
+            (!path.is_empty()).then(|| PathBuf::from(OsStr::from_bytes(path)))
+        }
+
+        fn tty(&self, pid: i32) -> Option<PathBuf> {
+            let info: libc::proc_bsdinfo = pidinfo(pid, libc::PROC_PIDTBSDINFO)?;
+            // NODEV: no controlling terminal.
+            if info.e_tdev == u32::MAX {
+                return None;
+            }
+            let _guard = DEVNAME.lock().unwrap_or_else(|e| e.into_inner());
+            // SAFETY: devname returns null or a NUL-terminated string in a
+            // static buffer, copied before the lock is released.
+            let name = unsafe {
+                let name = libc::devname(info.e_tdev as libc::dev_t, libc::S_IFCHR);
+                if name.is_null() {
+                    return None;
+                }
+                CStr::from_ptr(name).to_bytes().to_vec()
+            };
+            if name.is_empty() || name.starts_with(b"?") {
+                return None;
+            }
+            Some(Path::new("/dev").join(OsStr::from_bytes(&name)))
+        }
+
+        fn last_used(&self, tty: &Path) -> Option<SystemTime> {
+            let meta = std::fs::metadata(tty).ok()?;
+            [meta.accessed().ok(), meta.modified().ok()]
+                .into_iter()
+                .flatten()
+                .max()
+        }
+    }
+
+    /// KERN_PROCARGS2: argc, the executable path, NUL padding, then argv.
+    pub(super) fn parse_procargs(buf: &[u8]) -> Option<Invocation> {
+        let argc = c_int::from_ne_bytes(buf.get(..4)?.try_into().ok()?);
+        let mut rest = &buf[4..];
+        let mut take = |skip_padding: bool| -> Option<String> {
+            if skip_padding {
+                let start = rest.iter().position(|b| *b != 0)?;
+                rest = &rest[start..];
+            }
+            let end = rest.iter().position(|b| *b == 0)?;
+            let s = String::from_utf8_lossy(&rest[..end]).into_owned();
+            rest = &rest[end + 1..];
+            Some(s)
+        };
+        let exe = take(false)?;
+        let mut argv = Vec::new();
+        for i in 0..argc.max(0) {
+            // Padding follows the path only; an empty argument later is real.
+            match take(i == 0) {
+                Some(arg) => argv.push(arg),
+                None => break,
+            }
+        }
+        Some(Invocation { exe, argv })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[derive(Default)]
+    struct Fake {
+        procs: Vec<Proc>,
+        invocations: HashMap<i32, Invocation>,
+        cwds: HashMap<i32, PathBuf>,
+        ttys: HashMap<i32, PathBuf>,
+        used: HashMap<PathBuf, SystemTime>,
+    }
+
+    impl Fake {
+        fn proc(mut self, pid: i32, ppid: i32, comm: &str) -> Fake {
+            self.procs.push(Proc {
+                pid,
+                ppid,
+                comm: comm.into(),
+            });
+            self
+        }
+
+        fn argv(mut self, pid: i32, exe: &str, argv: &[&str]) -> Fake {
+            self.invocations.insert(
+                pid,
+                Invocation {
+                    exe: exe.into(),
+                    argv: argv.iter().map(|a| a.to_string()).collect(),
+                },
+            );
+            self
+        }
+
+        fn cwd(mut self, pid: i32, cwd: &str) -> Fake {
+            self.cwds.insert(pid, cwd.into());
+            self
+        }
+
+        /// A tty last used `at` seconds after the epoch.
+        fn tty(mut self, pid: i32, tty: &str, at: u64) -> Fake {
+            self.ttys.insert(pid, tty.into());
+            self.used
+                .insert(tty.into(), SystemTime::UNIX_EPOCH + Duration::from_secs(at));
+            self
+        }
+    }
+
+    impl Source for Fake {
+        fn processes(&self) -> Vec<Proc> {
+            self.procs.clone()
+        }
+        fn invocation(&self, pid: i32) -> Option<Invocation> {
+            self.invocations.get(&pid).cloned()
+        }
+        fn cwd(&self, pid: i32) -> Option<PathBuf> {
+            self.cwds.get(&pid).cloned()
+        }
+        fn tty(&self, pid: i32) -> Option<PathBuf> {
+            self.ttys.get(&pid).cloned()
+        }
+        fn last_used(&self, tty: &Path) -> Option<SystemTime> {
+            self.used.get(tty).copied()
+        }
+    }
+
+    fn front(bundle_id: &str, pid: i32) -> FrontApp {
+        FrontApp {
+            bundle_id: bundle_id.into(),
+            name: "Terminal".into(),
+            pid,
+        }
+    }
+
+    fn ghostty() -> FrontApp {
+        front("com.mitchellh.ghostty", 100)
+    }
+
+    #[test]
+    fn finds_the_agent_under_the_terminal() {
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(110, 100, "login")
+            .proc(111, 110, "zsh")
+            .proc(112, 111, "claude")
+            .cwd(112, "/code/squawk")
+            .tty(112, "/dev/ttys004", 10);
+        assert_eq!(
+            find(&ghostty(), &src),
+            Some(Session {
+                agent: Agent::Claude,
+                pid: 112,
+                cwd: "/code/squawk".into(),
+                tty: Some("/dev/ttys004".into()),
+            })
+        );
+    }
+
+    #[test]
+    fn no_agent_or_someone_elses_agent_is_none() {
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(111, 100, "zsh")
+            // Under another terminal.
+            .proc(200, 1, "Terminal")
+            .proc(211, 200, "zsh")
+            .proc(212, 211, "claude")
+            .cwd(212, "/code/other");
+        assert_eq!(find(&ghostty(), &src), None);
+    }
+
+    #[test]
+    fn native_install_is_named_after_its_version() {
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(111, 100, "zsh")
+            .proc(112, 111, "2.1.286")
+            .argv(
+                112,
+                "/Users/you/.local/share/claude/versions/2.1.286",
+                &["claude", "--resume"],
+            )
+            .cwd(112, "/code/squawk");
+        assert_eq!(find(&ghostty(), &src).map(|s| s.agent), Some(Agent::Claude));
+    }
+
+    #[test]
+    fn script_installs_run_under_an_interpreter() {
+        let codex = Invocation {
+            exe: "/opt/homebrew/bin/node".into(),
+            argv: vec!["node".into(), "/opt/homebrew/bin/codex".into()],
+        };
+        assert_eq!(agent_invoked(&codex), Some(Agent::Codex));
+        let claude = Invocation {
+            exe: "/usr/local/bin/node".into(),
+            argv: vec![
+                "node".into(),
+                "--no-warnings".into(),
+                "/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js".into(),
+            ],
+        };
+        assert_eq!(agent_invoked(&claude), Some(Agent::Claude));
+        let other = Invocation {
+            exe: "/usr/local/bin/node".into(),
+            argv: vec!["node".into(), "server.js".into(), "claude".into()],
+        };
+        assert_eq!(agent_invoked(&other), None);
+        let editor = Invocation {
+            exe: "/usr/bin/vim".into(),
+            argv: vec!["vim".into(), "claude".into()],
+        };
+        assert_eq!(agent_invoked(&editor), None);
+    }
+
+    #[test]
+    fn names_are_exact() {
+        assert_eq!(agent_named("claude"), Some(Agent::Claude));
+        assert_eq!(agent_named("codex"), Some(Agent::Codex));
+        assert_eq!(agent_named("Claude"), None);
+        assert_eq!(agent_named("claudebar"), None);
+    }
+
+    #[test]
+    fn most_recently_used_tty_wins() {
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(111, 100, "zsh")
+            .proc(112, 111, "claude")
+            .cwd(112, "/code/one")
+            .tty(112, "/dev/ttys001", 10)
+            .proc(121, 100, "zsh")
+            .proc(122, 121, "codex")
+            .cwd(122, "/code/two")
+            .tty(122, "/dev/ttys002", 20)
+            .proc(131, 100, "zsh")
+            .proc(132, 131, "claude")
+            .cwd(132, "/code/three");
+        let session = find(&ghostty(), &src).unwrap();
+        assert_eq!(session.agent, Agent::Codex);
+        assert_eq!(session.cwd, PathBuf::from("/code/two"));
+    }
