+            .proc(100, 1, "ghostty")
+            .proc(112, 100, "claude");
+        assert_eq!(find(&ghostty(), &src), None);
+    }
+
+    #[test]
+    fn iterm_sessions_live_under_its_server() {
+        let src = Fake::default()
+            .proc(100, 1, "iTerm2")
+            .proc(300, 1, "iTermServer-3.5")
+            .proc(311, 300, "zsh")
+            .proc(312, 311, "claude")
+            .cwd(312, "/code/squawk");
+        assert_eq!(
+            find(&front("com.googlecode.iterm2", 100), &src).map(|s| s.pid),
+            Some(312)
+        );
+        // Only iTerm2 gets to look there.
+        assert_eq!(find(&ghostty(), &src), None);
+    }
+
+    #[test]
+    fn tmux_panes_are_searched_when_the_terminal_shows_tmux() {
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(111, 100, "zsh")
+            .proc(112, 111, "tmux")
+            .proc(400, 1, "tmux")
+            .proc(411, 400, "zsh")
+            .proc(412, 411, "claude")
+            .cwd(412, "/code/squawk");
+        assert_eq!(find(&ghostty(), &src).map(|s| s.pid), Some(412));
+
+        // No tmux client in the terminal: the server's panes are not ours.
+        let src = Fake::default()
+            .proc(100, 1, "ghostty")
+            .proc(111, 100, "zsh")
+            .proc(400, 1, "tmux")
+            .proc(412, 400, "claude")
+            .cwd(412, "/code/squawk");
+        assert_eq!(find(&ghostty(), &src), None);
+    }
+
+    #[test]
+    fn a_parent_loop_ends() {
+        let src = Fake::default().proc(100, 101, "a").proc(101, 100, "b");
+        assert_eq!(find(&ghostty(), &src), None);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn procargs_layout() {
+        let mut buf = 2i32.to_ne_bytes().to_vec();
+        buf.extend_from_slice(b"/bin/claude\0\0\0\0claude\0\0ignored=1\0");
+        assert_eq!(
+            libproc::parse_procargs(&buf),
+            Some(Invocation {
+                exe: "/bin/claude".into(),
+                argv: vec!["claude".into(), "".into()],
+            })
+        );
+        assert_eq!(libproc::parse_procargs(&[1, 0]), None);
+    }
+
+    /// The real table: a child of this test process, in its own directory.
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn finds_a_real_child_process() {
+        let dir = tempfile::tempdir().unwrap();
+        let exe = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &exe).unwrap();
+        let mut child = std::process::Command::new(&exe)
+            .arg("30")
+            .current_dir(dir.path())
+            .spawn()
+            .unwrap();
+        let me = front("com.apple.Terminal", std::process::id() as i32);
+        let session = find(&me, &system());
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let session = session.expect("the child is an agent under this process");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(session.pid, child.id() as i32);
+        assert_eq!(session.cwd, dir.path().canonicalize().unwrap());
+    }
+}
diff --git a/crates/squawk-core/src/context/jargon.rs b/crates/squawk-core/src/context/jargon.rs
new file mode 100644
index 0000000..1bc4eda
--- /dev/null
+++ b/crates/squawk-core/src/context/jargon.rs
@@ -0,0 +1,429 @@
+//! The repo's words in the repo's spelling.
+//!
+//! The rules are the dictionary's, applied to words nobody chose by hand, so
+//! a little more timid:
+//! - a word heard in any case is written in the repo's case ("gpui" → `GPUI`,
+//!   "parakeet" → `Parakeet`);
+//! - a phrase is matched word for word ("claude code" → `Claude Code`);
+//! - a name made of parts is matched when the model hears the parts apart
+//!   ("git hub" → `GitHub`, "squawk core" → `squawk-core`), unless a part
+//!   is a word like "is" or "at";
+//! - a word the repo writes in lowercase only takes the capital off a word
+//!   in the middle of a sentence ("ask Squawk" → "ask squawk"); it never
+//!   lowercases an acronym or a sentence's first word.
+//!
+//! File stems are in the vocab too, and most of them are ordinary words in
+//! odd clothes: `Cargo`, `CLAUDE`, `status_item`. Rewriting "run cargo test"
+//! or "ask Claude" or "the status item" to match would be wrong far more
+//! often than right, so a word that is a file's stem only counts when its
+//! casing could not be anything else (`AppDelegate`). The file itself is one
+//! "dot rs" away.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::dictionary::{is_jargon, split_jargon};
+use crate::text::{self, Chunk};
+
+/// Chunks one term can be heard as.
+const MAX_SPAN: usize = 4;
+
+/// Words that join anything to anything. A name with one of these as a part
+/// is not matched part by part ("is number" is not `is-number`), and a doc
+/// phrase does not start or end with one.
+pub(super) const FUNCTION_WORDS: &[&str] = &[
+    "a", "add", "all", "also", "an", "and", "any", "are", "as", "at", "be", "but", "by", "can",
+    "do", "does", "for", "from", "get", "go", "has", "have", "how", "i", "if", "in", "into", "is",
+    "it", "its", "just", "my", "new", "no", "not", "of", "on", "or", "our", "out", "run", "see",
+    "set", "so", "than", "that", "the", "then", "these", "this", "those", "to", "up", "use", "was",
+    "we", "what", "when", "why", "will", "with", "you", "your",
+];
+
+/// How the repo writes a word.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Canon {
+    text: String,
+    /// No capitals at all: see the module docs for what that limits.
+    lower: bool,
+}
+
+/// A term that can be heard in pieces.
+#[derive(Debug)]
+struct Split {
+    text: String,
+    /// Where the pieces may part, as offsets into the joined key; `true`
+    /// where they must (the space in `Claude Code`).
+    bounds: Vec<(usize, bool)>,
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Terms {
+    /// Lowercased word → its spelling; `None` when the repo has two.
+    exact: HashMap<String, Option<Canon>>,
+    /// Parts run together and lowercased (`github`, `squawkcore`,
+    /// `claudecode`) → the terms that read so.
+    joined: HashMap<String, Vec<Split>>,
+}
+
+fn key(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// The parts of one written word: at `-` and `_`, and inside camel case.
+/// `None` when it should only ever match whole.
+fn parts(word: &str) -> Option<Vec<String>> {
+    let separated = word.contains(['-', '_']);
+    let mut parts = Vec::new();
+    for segment in word.split(['-', '_']).filter(|s| !s.is_empty()) {
+        if is_jargon(segment) {
+            parts.extend(split_jargon(segment));
+        } else {
+            parts.push(segment.to_string());
+        }
+    }
+    let sound = |part: &String| {
+        let numeric = part.chars().all(|c| c.is_ascii_digit());
+        numeric
+            || (part.chars().count() > 1 && !FUNCTION_WORDS.contains(&part.to_lowercase().as_str()))
+    };
+    // Camel case alone is the dictionary's rule and needs no more; a
+    // separator joins ordinary words, which do.
+    if separated && !parts.iter().all(sound) {
+        return None;
+    }
+    Some(parts)
+}
+
+impl Terms {
+    pub(super) fn new(words: &[String], files: &[String]) -> Terms {
+        let stems: HashSet<&str> = files.iter().filter_map(|f| super::vocab::stem(f)).collect();
+        let mut terms = Terms::default();
+        for word in words {
+            // First, and before anything is allocated: in a big repo nearly
+            // every word is a stem that will not be used.
+            let stem = stems.contains(word.as_str());
+            if stem && !is_jargon(word) {
+                continue;
+            }
+            let written: Vec<&str> = word.split_whitespace().collect();
+            if written.is_empty()
+                || written.len() > MAX_SPAN
+                || word.len() > 64
+                || written
+                    .iter()
+                    .any(|w| text::is_protected(w) || !w.chars().any(char::is_alphanumeric))
+            {
+                continue;
+            }
+            let text = written.join(" ");
+            if written.len() == 1 {
+                let canon = Canon {
+                    lower: !text.chars().any(char::is_uppercase),
+                    text: text.clone(),
+                };
+                terms
+                    .exact
+                    .entry(text.to_lowercase())
+                    .and_modify(|known| {
+                        if known.as_ref() != Some(&canon) {
+                            *known = None;
+                        }
+                    })
+                    .or_insert(Some(canon));
+                if stem {
+                    continue;
+                }
+            }
+            let mut joined = String::new();
+            let mut bounds = Vec::new();
+            for (n, word) in written.iter().enumerate() {
+                if n > 0 {
+                    bounds.push((joined.len(), true));
+                }
+                match parts(word) {
+                    Some(parts) => {
+                        for (n, part) in parts.iter().enumerate() {
+                            if n > 0 {
+                                bounds.push((joined.len(), false));
+                            }
+                            joined.push_str(&key(part));
+                        }
+                    }
+                    None => joined.push_str(&key(word)),
+                }
+            }
+            if !bounds.is_empty() {
+                terms
+                    .joined
+                    .entry(joined)
+                    .or_default()
+                    .push(Split { text, bounds });
+            }
+        }
+        terms
+    }
+
+    fn is_empty(&self) -> bool {
+        self.exact.is_empty() && self.joined.is_empty()
+    }
+
+    /// A term heard in pieces from chunk `i` on: how many chunks it took
+    /// and what to write. The longest span wins.
+    fn joined_at(&self, chunks: &[Chunk], i: usize) -> Option<(usize, String)> {
+        for len in (1..=MAX_SPAN.min(chunks.len() - i)).rev() {
+            let span = &chunks[i..i + len];
+            let Some((heard, breaks, suffix)) = pieces(span) else {
+                continue;
+            };
+            let Some(splits) = self.joined.get(&heard) else {
+                continue;
+            };
+            let mut fits = splits.iter().filter(|split| {
+                breaks
+                    .iter()
+                    .all(|b| split.bounds.iter().any(|(at, _)| at == b))
+                    && split
+                        .bounds
+                        .iter()
+                        .all(|(at, required)| !required || breaks.contains(at))
+            });
+            let first = fits.next()?;
+            if fits.any(|other| other.text != first.text) {
+                return None;
+            }
+            let as_heard: Vec<&str> = span.iter().map(|c| c.core.as_str()).collect();
+            let written = format!("{}{suffix}", first.text);
+            if as_heard.join(" ") == written {
+                return None;
+            }
+            return Some((len, written));
+        }
+        None
+    }
+
+    /// The repo's spelling of chunk `i`, when it differs and applies.
+    fn exact_at(&self, chunks: &[Chunk], i: usize) -> Option<String> {
+        let (word, suffix) = possessive(&chunks[i].core);
+        let canon = self.exact.get(&word.to_lowercase())?.as_ref()?;
+        if canon.text == word {
+            return None;
+        }
+        if canon.lower {
+            let mut letters = word.chars();
+            let capitalised =
+                letters.next().is_some_and(char::is_uppercase) && !letters.any(char::is_uppercase);
+            let opens_sentence = i == 0 || chunks[i - 1].ends_sentence();
+            if !capitalised || opens_sentence {
+                return None;
+            }
+        }
+        Some(format!("{}{suffix}", canon.text))
+    }
+}
+
+/// `Parakeet's` → `Parakeet` and the `'s` to put back.
+fn possessive(core: &str) -> (&str, &str) {
+    for suffix in ["'s", "’s"] {
+        if let Some(word) = core.strip_suffix(suffix) {
+            return (word, &core[word.len()..]);
+        }
+    }
+    (core, "")
+}
+
+/// A span as heard: its pieces run together, where they part, and a
+/// possessive to put back. `None` if the span is not two or more plain
+/// pieces with nothing but spaces and hyphens between them.
+fn pieces(span: &[Chunk]) -> Option<(String, Vec<usize>, &str)> {
+    let mut heard = String::new();
+    let mut breaks = Vec::new();
+    let mut suffix = "";
+    for (n, chunk) in span.iter().enumerate() {
+        let last = n + 1 == span.len();
+        if chunk.is_protected()
+            || (n > 0 && !chunk.lead.is_empty())
+            || (!last && !chunk.trail.is_empty())
+        {
+            return None;
+        }
+        let mut word = chunk.core.as_str();
+        if last {
+            (word, suffix) = possessive(word);
+        }
+        for piece in word.split('-') {
+            if piece.is_empty() || !piece.chars().all(char::is_alphanumeric) {
+                return None;
+            }
+            if !heard.is_empty() {
+                breaks.push(heard.len());
+            }
+            heard.push_str(&piece.to_lowercase());
+        }
+    }
+    (!breaks.is_empty()).then_some((heard, breaks, suffix))
+}
+
+/// Respell repo terms in place, outside protected chunks. Returns whether
+/// anything changed.
+pub(super) fn rewrite(chunks: &mut Vec<Chunk>, terms: &Terms) -> bool {
+    if terms.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        if chunks[i].is_protected() || chunks[i].core.is_empty() {
+            i += 1;
+            continue;
+        }
+        if let Some((len, written)) = terms.joined_at(chunks, i) {
+            chunks[i].trail = std::mem::take(&mut chunks[i + len - 1].trail);
+            chunks[i].core = written;
+            chunks.drain(i + 1..i + len);
+            changed = true;
+        } else if let Some(written) = terms.exact_at(chunks, i) {
+            chunks[i].core = written;
+            changed = true;
+        }
+        i += 1;
+    }
+    changed
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn with_files(words: &[&str], files: &[&str], text: &str) -> String {
+        let words: Vec<String> = words.iter().map(|w| w.to_string()).collect();
+        let files: Vec<String> = files.iter().map(|f| f.to_string()).collect();
+        let terms = Terms::new(&words, &files);
+        let mut chunks = text::chunks(text);
+        let changed = rewrite(&mut chunks, &terms);
+        let out = text::join(&chunks);
+        assert_eq!(changed, out != text, "{text}");
+        out
+    }
+
+    fn j(words: &[&str], text: &str) -> String {
+        with_files(words, &[], text)
+    }
+
+    #[test]
+    fn casing() {
+        let words = ["GPUI", "Parakeet", "macOS", "GitHub"];
+        assert_eq!(j(&words, "gpui draws it"), "GPUI draws it");
+        assert_eq!(
+            j(&words, "ask parakeet, then Gpui."),
+            "ask Parakeet, then GPUI."
+        );
+        assert_eq!(j(&words, "on MacOS and Github"), "on macOS and GitHub");
+        assert_eq!(j(&words, "parakeet's output"), "Parakeet's output");
+        assert_eq!(j(&words, "GPUI and Parakeet"), "GPUI and Parakeet");
+    }
+
+    #[test]
+    fn whole_words_only() {
+        assert_eq!(j(&["Rust"], "trust the rust code"), "trust the Rust code");
+        assert_eq!(j(&["together"], "to get her"), "to get her");
+    }
+
+    #[test]
+    fn phrases() {
+        let words = ["Claude Code", "Parakeet TDT"];
+        assert_eq!(j(&words, "ask claude code now"), "ask Claude Code now");
+        assert_eq!(j(&words, "ask claude-code."), "ask Claude Code.");
+        assert_eq!(j(&words, "the claude is code"), "the claude is code");
+        assert_eq!(j(&words, "claude, code"), "claude, code");
+        assert_eq!(j(&words, "Claude Code is fine"), "Claude Code is fine");
+    }
+
+    #[test]
+    fn camel_case_heard_apart() {
+        let words = ["GitHub", "ChatGPT", "objc2", "VocabCache"];
+        assert_eq!(j(&words, "push to git hub"), "push to GitHub");
+        assert_eq!(j(&words, "ask chat GPT"), "ask ChatGPT");
+        assert_eq!(j(&words, "the objc 2 crate"), "the objc2 crate");
+        assert_eq!(j(&words, "clear the vocab cache."), "clear the VocabCache.");
+        // Pieces that do not part where the name does.
+        assert_eq!(j(&words, "vo cabcache"), "vo cabcache");
+    }
+
+    #[test]
+    fn separated_names_heard_apart() {
+        let words = ["squawk-core", "serde_json", "is-number", "launch_at_login"];
+        assert_eq!(j(&words, "the squawk core crate"), "the squawk-core crate");
+        assert_eq!(j(&words, "Squawk Core is slow"), "squawk-core is slow");
+        assert_eq!(j(&words, "use serde json here"), "use serde_json here");
+        assert_eq!(
+            j(&words, "the result is number five"),
+            "the result is number five"
+        );
+        assert_eq!(j(&words, "launch at login"), "launch at login");
+    }
+
+    #[test]
+    fn lowercase_names_only_undo_a_stray_capital() {
+        let words = ["squawk", "tokio"];
+        assert_eq!(
+            j(&words, "ask Squawk about Tokio"),
+            "ask squawk about tokio"
+        );
+        assert_eq!(
+            j(&words, "Squawk is slow. Tokio too."),
+            "Squawk is slow. Tokio too."
+        );
+        assert_eq!(j(&["ipc"], "the IPC server"), "the IPC server");
+    }
+
+    #[test]
+    fn two_spellings_is_no_spelling() {
+        assert_eq!(j(&["Config", "CONFIG"], "the config"), "the config");
+        assert_eq!(j(&["GPUI", "GPUI"], "the gpui"), "the GPUI");
+    }
+
+    #[test]
+    fn file_stems_are_not_prose() {
+        let files = [
+            "Cargo.toml",
+            "CLAUDE.md",
+            "src/status_item.rs",
+            "ios/AppDelegate.swift",
+        ];
+        let words = [
+            "Cargo",
+            "CLAUDE",
+            "status_item",
+            "AppDelegate",
+            "squawk-core",
+        ];
+        assert_eq!(
+            with_files(&words, &files, "run cargo test"),
+            "run cargo test"
+        );
+        assert_eq!(
+            with_files(&words, &files, "ask Claude about the status item"),
+            "ask Claude about the status item"
+        );
+        assert_eq!(
+            with_files(&words, &files, "the appdelegate in squawk core"),
+            "the AppDelegate in squawk-core"
+        );
+        assert_eq!(
+            with_files(&words, &files, "the app delegate"),
+            "the app delegate"
+        );
+    }
+
+    #[test]
+    fn protected_chunks_and_odd_words_are_skipped() {
+        let words = ["Audio", "SPEC.md", "src/main", "", "   "];
+        assert_eq!(
+            j(&words, "audio in @src/audio.rs and `audio`"),
+            "Audio in @src/audio.rs and `audio`"
+        );
+        assert_eq!(j(&words, "the spec.md"), "the spec.md");
+    }
+}
diff --git a/crates/squawk-core/src/context/mentions.rs b/crates/squawk-core/src/context/mentions.rs
new file mode 100644
index 0000000..cfce971
--- /dev/null
+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,739 @@
+//! Spoken file names to `@mentions`.
+//!
+//! A file is named by saying its extension: "status item dot rs", or without
+//! the dot for the extensions nobody says in a sentence by accident ("cargo
+//! toml", "the claude md"). The words before the extension are matched
+//! against file names with separators and case taken out, so "status item",
+//! "read me" and "IPC server" find `status_item`, `README` and `ipc_server`.
+//! The longest run of words that names a file wins.
+//!
+//! One file by that name becomes a mention. Several stay as spoken, unless a
+//! folder was said too ("context slash mod dot rs") and settles it. The
+//! session's own directory counts as a folder, by its name or as "root", so
+//! the top-level file among several can be named too ("squawk slash cargo
+//! toml"). A folder that settles nothing means the whole reference is left
+//! alone: a wrong mention is worse than none.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use crate::text::Chunk;
+
+/// Words a file's stem is looked for in, counting back from the extension.
+const MAX_STEM_WORDS: usize = 6;
+
+/// Words a folder's name is looked for in, counting back from "slash".
+const MAX_DIR_WORDS: usize = 4;
+
+/// Letters an extension can be spelled out in: "dot r s".
+const MAX_SPELLED: usize = 5;
+
+/// Extensions that name a file without "dot" in front. Code and data formats
+/// only, and none that is also a word people say after a file-like word
+/// ("go mod", "three js", "config in").
+const DOTLESS_EXTS: &[&str] = &[
+    "rs", "md", "mdx", "toml", "json", "jsonl", "jason", "yaml", "yml", "ts", "tsx", "jsx", "py",
+    "rb", "sh", "txt", "html", "css", "scss", "sql", "xml", "csv", "plist", "lock", "swift", "kt",
+    "cpp", "hpp", "lua", "zig", "nix", "php", "vue", "svelte",
+];
+
+/// Words that stand for punctuation inside a file name.
+const SEPARATOR_WORDS: &[&str] = &["dot", "underscore", "dash", "hyphen"];
+
+const NUMBER_WORDS: &[(&str, &str)] = &[
+    ("zero", "0"),
+    ("one", "1"),
+    ("two", "2"),
+    ("three", "3"),
+    ("four", "4"),
+    ("five", "5"),
+    ("six", "6"),
+    ("seven", "7"),
+    ("eight", "8"),
+    ("nine", "9"),
+    ("ten", "10"),
+];
+
+/// The extensions a spoken one may mean, likeliest first.
+fn exts_for(spoken: &str) -> Vec<&str> {
+    match spoken {
+        "jason" => vec!["json"],
+        "yaml" | "yamel" | "yammel" => vec!["yaml", "yml"],
+        "yml" => vec!["yml", "yaml"],
+        "tomel" | "tommel" => vec!["toml"],
+        "markdown" => vec!["md", "markdown"],
+        "text" => vec!["txt", "text"],
+        "pie" => vec!["py"],
+        other => vec![other],
+    }
+}
+
+/// Letters and digits, lowercased: how a name is compared with speech.
+fn key(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// File names by how they sound. Values index into the vocab's `files`.
+#[derive(Debug, Default)]
+pub(super) struct FileIndex {
+    /// `statusitem.rs` → every `status_item.rs`.
+    names: HashMap<String, Vec<u32>>,
+    /// `gitignore` → every `.gitignore`.
+    dotfiles: HashMap<String, Vec<u32>>,
+    /// `makefile` → every `Makefile`: names without an extension that say
+    /// "file" themselves.
+    bare: HashMap<String, Vec<u32>>,
+    /// What the directory the paths are relative to is called.
+    root: String,
+}
+
+impl FileIndex {
+    pub(super) fn new(root: &Path, files: &[String]) -> FileIndex {
+        let mut index = FileIndex {
+            root: root
+                .file_name()
+                .map(|name| key(&name.to_string_lossy()))
+                .unwrap_or_default(),
+            ..FileIndex::default()
+        };
+        for (i, path) in files.iter().enumerate() {
+            let i = i as u32;
+            let name = base_name(path);
+            let visible = name.strip_prefix('.').unwrap_or(name);
+            match visible.rsplit_once('.') {
+                Some((stem, ext)) => {
+                    let mut name = key(stem);
+                    if !name.is_empty() && !ext.is_empty() {
+                        name.push('.');
+                        name.extend(ext.chars().flat_map(char::to_lowercase));
+                        index.names.entry(name).or_default().push(i);
+                    }
+                }
+                None if name.len() != visible.len() => {
+                    index.dotfiles.entry(key(visible)).or_default().push(i);
+                }
+                None => {
+                    let name = key(name);
+                    if name.len() > 4 && name.ends_with("file") {
+                        index.bare.entry(name).or_default().push(i);
+                    }
+                }
+            }
+        }
+        index
+    }
+}
+
+/// One spoken word of a name.
+struct Piece {
+    key: String,
+    digit: Option<&'static str>,
+    separator: bool,
+}
+
+impl Piece {
+    /// `None` for anything that cannot be part of a spoken name: a protected
+    /// chunk, punctuation, a contraction.
+    fn of(chunk: &Chunk) -> Option<Piece> {
+        if chunk.is_protected()
+            || !chunk
+                .core
+                .chars()
+                .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_'))
+        {
+            return None;
+        }
+        let key = key(&chunk.core);
+        if key.is_empty() {
+            return None;
+        }
+        Some(Piece {
+            digit: NUMBER_WORDS
+                .iter()
+                .find(|(word, _)| *word == key)
+                .map(|(_, digit)| *digit),
+            separator: SEPARATOR_WORDS.contains(&key.as_str()),
+            key,
+        })
+    }
+}
+
+/// The names a run of words could be, and whether it opened with "dot".
+/// `pieces` is nearest-first, as the walk back collects them.
+fn spoken_names(pieces: &[Piece]) -> (Vec<String>, bool) {
+    let Some(outer) = pieces.last() else {
+        return (Vec::new(), false);
+    };
+    if let [only] = pieces {
+        // A lone "dash" is a file called dash, not a hyphen.
+        let mut names = vec![only.key.clone()];
+        names.extend(only.digit.map(str::to_string));
+        return (names, false);
+    }
+    let dotted = outer.key == "dot";
+    if outer.separator && !dotted {
+        return (Vec::new(), false);
+    }
+    let said = || pieces.iter().rev().filter(|p| !p.separator);
+    let plain: String = said().map(|p| p.key.as_str()).collect();
+    let digits: String = said().map(|p| p.digit.unwrap_or(&p.key)).collect();
+    let mut names = Vec::new();
+    if !plain.is_empty() {
+        if digits != plain {
+            names.push(digits);
+        }
+        names.insert(0, plain);
+    }
+    (names, dotted)
+}
+
+/// Walk back from the end of `out` over words that can be part of a name,
+/// handing each longer run to `lookup`; the longest run it accepts wins.
+/// Returns where that run starts and what `lookup` made of it.
+fn longest_run<T>(
+    out: &[Chunk],
+    max_words: usize,
+    mut lookup: impl FnMut(&str, bool) -> Option<T>,
+) -> Option<(usize, T)> {
+    let mut pieces: Vec<Piece> = Vec::new();
+    let mut best = None;
+    for (n, chunk) in out.iter().rev().take(max_words).enumerate() {
+        let Some(piece) = Piece::of(chunk) else { break };
+        if !chunk.trail.is_empty() || piece.key == "slash" {
+            break;
+        }
+        pieces.push(piece);
+        let (names, dotted) = spoken_names(&pieces);
+        if let Some(found) = names.iter().find_map(|name| lookup(name, dotted)) {
+            best = Some((out.len() - n - 1, found));
+        }
+        // Punctuation in front of a word ends the run with it.
+        if !chunk.lead.is_empty() {
+            break;
+        }
+    }
+    best
+}
+
+/// The files whose stem is the words at the end of `out`: where the words
+/// start, the name they spell (`statusitem.rs`), and the files.
+fn stem_before(
+    out: &[Chunk],
+    ext: &str,
+    files: &[String],
+    index: &FileIndex,
+) -> Option<(usize, (String, Vec<u32>))> {
+    longest_run(out, MAX_STEM_WORDS, |name, dotted| {
+        let name = format!("{name}.{ext}");
+        let named: Vec<u32> = index
+            .names
+            .get(&name)?
+            .iter()
+            .copied()
+            // "dot env dot example" is `.env.example`, not `env.example`.
+            .filter(|f| !dotted || base_name(&files[*f as usize]).starts_with('.'))
+            .collect();
+        (!named.is_empty()).then_some((name, named))
+    })
+}
+
+/// Whether the name that ends before chunk `end` goes on: "cargo dot toml
+/// dot orig" is `Cargo.toml.orig`, and the next "dot" will find it with
+/// these words as its stem.
+fn goes_on(chunks: &[Chunk], end: usize, name: &str, index: &FileIndex) -> bool {
+    chunks[end - 1].trail.is_empty()
+        && chunks
+            .get(end)
+            .is_some_and(|c| c.key() == "dot" && c.lead.is_empty() && c.trail.is_empty())
+        && spoken_exts(chunks, end + 1)
+            .iter()
+            .flat_map(|(exts, _)| exts)
+            .any(|ext| index.names.contains_key(&format!("{}.{ext}", key(name))))
+}
+
+/// "slash" between a folder and what is in it, or the `/` itself when the
+/// model wrote one on its own.
+fn is_slash(chunk: &Chunk) -> bool {
+    let bare = chunk.lead.is_empty() && chunk.trail.is_empty();
+    (bare && chunk.core.eq_ignore_ascii_case("slash")) || chunk.render() == "/"
+}
+
+/// Narrow `candidates` by the folders said before `start` ("squawk core
+/// slash src slash"), and say which file is meant and where the reference
+/// starts. `None` unless exactly one file is left.
+fn settle(
+    out: &[Chunk],
+    mut start: usize,
+    candidates: Vec<u32>,
+    files: &[String],
+    index: &FileIndex,
+) -> Option<(usize, u32)> {
+    // Each candidate with how many of its folders are still unclaimed.
+    let mut candidates: Vec<(u32, usize)> = candidates
+        .into_iter()
+        .map(|f| (f, files[f as usize].matches('/').count()))
+        .collect();
+    while start > 0 && is_slash(&out[start - 1]) {
+        let (at, inside) = longest_run(&out[..start - 1], MAX_DIR_WORDS, |name, _| {
+            let inside = inside_folder(&candidates, name, files, &index.root);
+            (!inside.is_empty()).then_some(inside)
+        })?;
+        start = at;
+        candidates = inside;
+    }
+    match candidates.as_slice() {
+        [(file, _)] => Some((start, *file)),
+        _ => None,
+    }
+}
+
+/// The candidates that sit in a folder called `name`: directly in it if any
+/// do, otherwise anywhere below it, otherwise (when `name` is the root's)
+/// those with no folder left to claim.
+fn inside_folder(
+    candidates: &[(u32, usize)],
+    name: &str,
+    files: &[String],
+    root: &str,
+) -> Vec<(u32, usize)> {
+    let mut direct = Vec::new();
+    let mut below = Vec::new();
+    let mut top = Vec::new();
+    for &(file, unclaimed) in candidates {
+        if unclaimed == 0 && (name == root || name == "root") {
+            top.push((file, 0));
+        }
+        let folders = files[file as usize].split('/').take(unclaimed);
+        let Some(at) = folders
+            .enumerate()
+            .filter(|(_, folder)| key(folder) == name)
+            .map(|(at, _)| at)
+            .last()
+        else {
+            continue;
+        };
+        if at + 1 == unclaimed {
+            direct.push((file, at));
+        } else {
+            below.push((file, at));
+        }
+    }
+    [direct, below, top]
+        .into_iter()
+        .find(|tier| !tier.is_empty())
+        .unwrap_or_default()
+}
+
+/// The extensions the words from `from` on could be, each with where it
+/// ends: one word ("rs", "jason"), or letters spelled out ("r s"), longest
+/// spelling first.
+fn spoken_exts(chunks: &[Chunk], from: usize) -> Vec<(Vec<String>, usize)> {
+    let plain = |c: &Chunk| {
+        !c.is_protected()
+            && c.lead.is_empty()
+            && !c.core.is_empty()
+            && c.core.chars().all(char::is_alphanumeric)
+    };
+    let Some(first) = chunks.get(from).filter(|c| plain(c)) else {
+        return Vec::new();
+    };
+    if first.core.chars().count() > 1 {
+        let exts = exts_for(&first.key())
+            .into_iter()
+            .map(str::to_string)
+            .collect();
+        return vec![(exts, from + 1)];
+    }
+    let mut letters = String::new();
+    let mut spelled = Vec::new();
+    for (n, chunk) in chunks[from..].iter().take(MAX_SPELLED).enumerate() {
+        if !plain(chunk) || chunk.core.chars().count() != 1 {
+            break;
+        }
+        letters.push_str(&chunk.key());
+        spelled.push((vec![letters.clone()], from + n + 1));
+        if !chunk.trail.is_empty() {
+            break;
+        }
+    }
+    spelled.reverse();
+    spelled
+}
+
+/// The dotfiles the words from `from` on name ("git ignore"), and where the
+/// name ends. The longest name wins.
+fn dotfile_at<'a>(
+    chunks: &[Chunk],
+    from: usize,
+    index: &'a FileIndex,
+) -> Option<(usize, &'a [u32])> {
+    let mut name = String::new();
+    let mut best = None;
+    for (n, chunk) in chunks.get(from..)?.iter().take(3).enumerate() {
+        let Some(piece) = Piece::of(chunk) else { break };
+        if !chunk.lead.is_empty() {
+            break;
+        }
+        name.push_str(&piece.key);
+        let end = from + n + 1;
+        if let Some(found) = index.dotfiles.get(&name) {
+            best = (!goes_on(chunks, end, &name, index)).then_some((end, found.as_slice()));
+        }
+        if !chunk.trail.is_empty() {
+            break;
+        }
+    }
+    best
+}
+
+/// A file reference ending in the chunks from `i` on.
+struct Reference {
+    /// Where it starts in `out`; `out.len()` if it starts at chunk `i`.
+    start: usize,
+    /// The first chunk after it.
+    end: usize,
+    file: u32,
+}
+
+fn reference_at(
+    out: &[Chunk],
+    chunks: &[Chunk],
+    i: usize,
+    files: &[String],
+    index: &FileIndex,
+) -> Option<Reference> {
+    let chunk = &chunks[i];
+    if chunk.is_protected() || chunk.core.is_empty() {
+        return None;
+    }
+    let word = chunk.key();
+    let found = |end: usize, (start, file): (usize, u32)| Reference { start, end, file };
+
+    if word == "dot" && chunk.trail.is_empty() {
+        if chunk.lead.is_empty() {
+            for (exts, end) in spoken_exts(chunks, i + 1) {
+                for ext in exts {
+                    if let Some((start, (name, named))) = stem_before(out, &ext, files, index) {
+                        if goes_on(chunks, end, &name, index) {
+                            return None;
+                        }
+                        // The words name a file; whether they name one
+                        // decides it, and no other reading is tried.
+                        return settle(out, start, named, files, index).map(|at| found(end, at));
+                    }
+                }
+            }
+        }
+        let (end, named) = dotfile_at(chunks, i + 1, index)?;
+        return settle(out, out.len(), named.to_vec(), files, index).map(|at| found(end, at));
+    }
+
+    if chunk.lead.is_empty() && DOTLESS_EXTS.contains(&word.as_str()) {
+        for ext in exts_for(&word) {
+            if let Some((start, (name, named))) = stem_before(out, ext, files, index) {
+                if goes_on(chunks, i + 1, &name, index) {
+                    return None;
+                }
+                return settle(out, start, named, files, index).map(|at| found(i + 1, at));
+            }
+        }
+    }
+
+    let named = index.bare.get(&key(&chunk.core))?;
+    Piece::of(chunk)?;
+    settle(out, out.len(), named.clone(), files, index).map(|at| found(i + 1, at))
+}
+
+/// Replace spoken file references with mentions. Returns the chunks and
+/// whether anything changed.
+pub(super) fn rewrite(
+    chunks: Vec<Chunk>,
+    files: &[String],
+    index: &FileIndex,
+) -> (Vec<Chunk>, bool) {
+    if files.is_empty() {
+        return (chunks, false);
+    }
+    let mut out: Vec<Chunk> = Vec::with_capacity(chunks.len());
+    let mut changed = false;
+    // Whether the last chunk of `out` is a mention made here.
+    let mut ends_in_mention = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        let reference = reference_at(&out, &chunks, i, files, index)
+            // `@a file.rs` would be read as `@a`.
+            .filter(|r| !files[r.file as usize].contains(char::is_whitespace));
+        let Some(reference) = reference else {
+            out.push(chunks[i].clone());
+            ends_in_mention = false;
+            i += 1;
+            continue;
+        };
+        let lead = out.get(reference.start).unwrap_or(&chunks[i]).lead.clone();
+        out.truncate(reference.start);
+        out.push(Chunk {
+            lead,
+            core: format!("@{}", files[reference.file as usize]),
+            trail: chunks[reference.end - 1].trail.clone(),
+        });
+        changed = true;
+        ends_in_mention = true;
+        i = reference.end;
+    }
+    // The period that ended the dictation would read as part of the path
+    // (`cleanup::finalize` leaves it off for the same reason).
+    if ends_in_mention {
+        if let Some(last) = out.last_mut().filter(|c| c.trail == ".") {
+            last.trail.clear();
+        }
+    }
+    (out, changed)
+}
