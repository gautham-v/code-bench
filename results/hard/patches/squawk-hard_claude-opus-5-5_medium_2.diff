+//! Finding the agent session behind the front terminal.
+//!
+//! Two halves: [`table`] reads the process table with libproc (macOS only;
+//! elsewhere it is empty), and [`candidates`] is the pure part that decides
+//! which processes are sessions, best first, so it can be tested without a
+//! terminal.
+
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use super::{Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// One row of the process table.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub(super) struct Proc {
+    pub pid: i32,
+    pub ppid: i32,
+    pub pgid: i32,
+    /// Foreground process group of the controlling tty.
+    pub tpgid: i32,
+    /// Controlling tty device, if any.
+    pub tdev: Option<u32>,
+    /// Every name the process goes by: its comm, its executable's file name,
+    /// argv[0], and for a script the script's name.
+    pub names: Vec<String>,
+    pub agent: Option<Agent>,
+}
+
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    if !super::is_terminal(&front.bundle_id) || front.pid <= 0 {
+        return None;
+    }
+    let mut procs = table();
+    let under = descendants(&procs, front);
+    for p in procs.iter_mut().filter(|p| under.contains(&p.pid)) {
+        p.agent = p.names.iter().find_map(|n| agent_named(n));
+        if p.agent.is_none() {
+            p.agent = sys::agent_from_args(p.pid);
+        }
+    }
+    let ranked = candidates(&procs, &under, sys::tty_used);
+    ranked.into_iter().find_map(|p| {
+        Some(Session {
+            agent: p.agent?,
+            pid: p.pid,
+            cwd: sys::cwd(p.pid)?,
+            tty: p.tdev.and_then(sys::tty_path),
+        })
+    })
+}
+
+/// Which agent a process name stands for. Exact names only, plus the
+/// platform-suffixed binary codex ships (`codex-aarch64-apple-darwin`).
+pub(super) fn agent_named(name: &str) -> Option<Agent> {
+    let name = name.rsplit('/').next().unwrap_or(name);
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(n, _)| {
+            name == *n
+                || name
+                    .strip_prefix(n)
+                    .and_then(|rest| rest.strip_prefix('-'))
+                    .is_some_and(|rest| rest.contains("-apple-") || rest.contains("-linux-"))
+        })
+        .map(|(_, a)| *a)
+}
+
+/// Pids descended from the front app. A terminal multiplexer breaks the
+/// parent chain (the tmux server is a daemon, iTerm2's shells hang off
+/// iTermServer), so those servers count as part of the terminal when the
+/// terminal runs a client for them.
+pub(super) fn descendants(procs: &[Proc], front: &FrontApp) -> HashSet<i32> {
+    let mut children: HashMap<i32, Vec<i32>> = HashMap::new();
+    for p in procs {
+        children.entry(p.ppid).or_default().push(p.pid);
+    }
+    let mut under = HashSet::new();
+    let grow = |roots: Vec<i32>, under: &mut HashSet<i32>| {
+        let mut stack = roots;
+        while let Some(pid) = stack.pop() {
+            for &c in children.get(&pid).map(Vec::as_slice).unwrap_or(&[]) {
+                if c != pid && under.insert(c) {
+                    stack.push(c);
+                }
+            }
+        }
+    };
+    grow(vec![front.pid], &mut under);
+
+    let named = |p: &Proc, prefix: &str| p.names.iter().any(|n| n.starts_with(prefix));
+    let mut servers = Vec::new();
+    if front.bundle_id == "com.googlecode.iterm2" {
+        servers.extend(procs.iter().filter(|p| named(p, "iTermServer")));
+    }
+    if procs
+        .iter()
+        .any(|p| under.contains(&p.pid) && named(p, "tmux"))
+    {
+        servers.extend(
+            procs
+                .iter()
+                .filter(|p| named(p, "tmux") && p.tdev.is_none()),
+        );
+    }
+    let roots: Vec<i32> = servers
+        .iter()
+        .map(|p| p.pid)
+        .filter(|pid| !under.contains(pid))
+        .collect();
+    grow(roots, &mut under);
+    under
+}
+
+/// The agent processes among `under`, best first: the one whose tty was used
+/// most recently, then the one in its tty's foreground, then the newest. An
+/// agent started by another agent (a subagent, `claude -p` from a tool call)
+/// is not a session of its own.
+pub(super) fn candidates<'a>(
+    procs: &'a [Proc],
+    under: &HashSet<i32>,
+    tty_used: impl Fn(u32) -> Option<SystemTime>,
+) -> Vec<&'a Proc> {
+    let by_pid: HashMap<i32, &Proc> = procs.iter().map(|p| (p.pid, p)).collect();
+    let nested = |p: &Proc| {
+        let mut pid = p.ppid;
+        // Bounded: a pid reused mid-snapshot could otherwise make a cycle.
+        for _ in 0..64 {
+            match by_pid.get(&pid) {
+                Some(parent) if under.contains(&parent.pid) => {
+                    if parent.agent.is_some() {
+                        return true;
+                    }
+                    pid = parent.ppid;
+                }
+                _ => break,
+            }
+        }
+        false
+    };
+    let mut found: Vec<(&Proc, Option<SystemTime>)> = procs
+        .iter()
+        .filter(|p| under.contains(&p.pid) && p.agent.is_some() && !nested(p))
+        .map(|p| (p, p.tdev.and_then(&tty_used)))
+        .collect();
+    found.sort_by(|(a, at), (b, bt)| {
+        let fg = |p: &Proc| p.tdev.is_some() && p.pgid == p.tpgid;
+        bt.cmp(at).then(fg(b).cmp(&fg(a))).then(b.pid.cmp(&a.pid))
+    });
+    found.into_iter().map(|(p, _)| p).collect()
+}
+
+#[cfg(target_os = "macos")]
+fn table() -> Vec<Proc> {
+    sys::table()
+}
+
+#[cfg(not(target_os = "macos"))]
+fn table() -> Vec<Proc> {
+    Vec::new()
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    use std::ffi::{CStr, OsStr};
+    use std::os::raw::{c_char, c_int, c_void};
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::MetadataExt;
+    use std::time::{Duration, UNIX_EPOCH};
+
+    use super::*;
+
+    extern "C" {
+        fn devname_r(
+            dev: libc::dev_t,
+            kind: libc::mode_t,
+            buf: *mut c_char,
+            len: c_int,
+        ) -> *mut c_char;
+    }
+
+    /// Runtimes that run an agent as a script: the agent's name is argv[1].
+    const INTERPRETERS: &[&str] = &["node", "bun", "deno", "sh", "bash", "zsh"];
+
+    pub fn table() -> Vec<Proc> {
+        let mut pids: Vec<libc::pid_t> = Vec::new();
+        // The count can grow between the two calls; leave headroom and retry.
+        for _ in 0..3 {
+            let n = unsafe { libc::proc_listallpids(std::ptr::null_mut(), 0) };
+            if n <= 0 {
+                return Vec::new();
+            }
+            pids = vec![0; n as usize + 64];
+            let bytes = (pids.len() * std::mem::size_of::<libc::pid_t>()) as c_int;
+            let got = unsafe { libc::proc_listallpids(pids.as_mut_ptr() as *mut c_void, bytes) };
+            if got <= 0 {
+                return Vec::new();
+            }
+            if (got as usize) < pids.len() {
+                pids.truncate(got as usize);
+                break;
+            }
+        }
+        pids.into_iter()
+            .filter(|&pid| pid > 0)
+            .filter_map(read)
+            .collect()
+    }
+
+    fn read(pid: libc::pid_t) -> Option<Proc> {
+        let mut info: libc::proc_bsdinfo = unsafe { std::mem::zeroed() };
+        let size = std::mem::size_of::<libc::proc_bsdinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            )
+        };
+        if got != size {
+            return read_short(pid);
+        }
+        let mut names = vec![fixed_str(&info.pbi_comm), fixed_str(&info.pbi_name)];
+        let mut path = [0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        let len =
+            unsafe { libc::proc_pidpath(pid, path.as_mut_ptr() as *mut c_void, path.len() as u32) };
+        if len > 0 {
+            let exe = String::from_utf8_lossy(&path[..len as usize]).into_owned();
+            // The native installer names the binary after its version and
+            // links `claude` to it: ~/.local/share/claude/versions/2.1.0.
+            if exe.contains("/claude/versions/") {
+                names.push("claude".to_string());
+            }
+            if let Some(base) = exe.rsplit('/').next() {
+                names.push(base.to_string());
+            }
+        }
+        names.retain(|n| !n.is_empty());
+        names.dedup();
+        // NODEV is all ones.
+        let tdev = (info.e_tdev != u32::MAX && info.e_tdev != 0).then_some(info.e_tdev);
+        Some(Proc {
+            pid,
+            ppid: info.pbi_ppid as i32,
+            pgid: info.pbi_pgid as i32,
+            tpgid: info.e_tpgid as i32,
+            tdev,
+            names,
+            agent: None,
+        })
+    }
+
+    /// Another user's process (`login`, which sits between Terminal and the
+    /// shell, is root's) refuses the full record but gives the short one,
+    /// and the parent pid is all the tree needs from it.
+    fn read_short(pid: libc::pid_t) -> Option<Proc> {
+        let mut info: libc::proc_bsdshortinfo = unsafe { std::mem::zeroed() };
+        let size = std::mem::size_of::<libc::proc_bsdshortinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDT_SHORTBSDINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            )
+        };
+        (got == size).then(|| Proc {
+            pid,
+            ppid: info.pbsi_ppid as i32,
+            pgid: info.pbsi_pgid as i32,
+            names: vec![fixed_str(&info.pbsi_comm)],
+            ..Proc::default()
+        })
+    }
+
+    fn fixed_str(raw: &[c_char]) -> String {
+        let bytes: Vec<u8> = raw
+            .iter()
+            .take_while(|&&c| c != 0)
+            .map(|&c| c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    /// For a process whose own names say nothing: argv[0] (`exec -a`, a
+    /// process title) and, under an interpreter, the script it runs.
+    pub fn agent_from_args(pid: i32) -> Option<Agent> {
+        let args = args(pid)?;
+        let first = args.first()?;
+        if let Some(agent) = agent_named(first) {
+            return Some(agent);
+        }
+        let base = first.rsplit('/').next().unwrap_or(first);
+        if !INTERPRETERS.contains(&base.trim_start_matches('-')) {
+            return None;
+        }
+        let script = args.get(1)?;
+        let name = script.rsplit('/').next().unwrap_or(script);
+        let name = name
+            .strip_suffix(".js")
+            .or_else(|| name.strip_suffix(".mjs"))
+            .or_else(|| name.strip_suffix(".cjs"))
+            .unwrap_or(name);
+        if let Some(agent) = agent_named(name) {
+            return Some(agent);
+        }
+        if script.contains("/@anthropic-ai/claude-code/") {
+            return Some(Agent::Claude);
+        }
+        if script.contains("/@openai/codex/") {
+            return Some(Agent::Codex);
+        }
+        None
+    }
+
+    /// argv via `sysctl kern.procargs2`: argc, the exec path, padding, then
+    /// the NUL-separated arguments. Fails for other users' processes.
+    fn args(pid: i32) -> Option<Vec<String>> {
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        let mut size: libc::size_t = 0;
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as u32,
+                std::ptr::null_mut(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || size < 4 {
+            return None;
+        }
+        let mut buf = vec![0u8; size];
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as u32,
+                buf.as_mut_ptr() as *mut c_void,
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || size < 4 {
+            return None;
+        }
+        buf.truncate(size);
+        let argc = i32::from_ne_bytes(buf[..4].try_into().ok()?).max(0) as usize;
+        let rest = &buf[4..];
+        let exec_end = rest.iter().position(|&b| b == 0)?;
+        let mut pos = exec_end;
+        while pos < rest.len() && rest[pos] == 0 {
+            pos += 1;
+        }
+        Some(
+            rest[pos..]
+                .split(|&b| b == 0)
+                .take(argc.min(4))
+                .map(|a| String::from_utf8_lossy(a).into_owned())
+                .collect(),
+        )
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        let mut info: libc::proc_vnodepathinfo = unsafe { std::mem::zeroed() };
+        let size = std::mem::size_of::<libc::proc_vnodepathinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            )
+        };
+        if got != size {
+            return None;
+        }
+        let path = &info.pvi_cdir.vip_path;
+        // libc declares the MAXPATHLEN buffer as 32 × 32; it is one string.
+        let bytes = unsafe {
+            std::slice::from_raw_parts(path.as_ptr() as *const u8, std::mem::size_of_val(path))
+        };
+        let len = bytes.iter().position(|&b| b == 0)?;
+        (len > 0).then(|| PathBuf::from(OsStr::from_bytes(&bytes[..len])))
+    }
+
+    pub fn tty_path(dev: u32) -> Option<PathBuf> {
+        let mut buf = [0 as c_char; 128];
+        let name = unsafe {
+            devname_r(
+                dev as libc::dev_t,
+                libc::S_IFCHR,
+                buf.as_mut_ptr(),
+                buf.len() as c_int,
+            )
+        };
+        if name.is_null() {
+            return None;
+        }
+        let name = unsafe { CStr::from_ptr(name) }.to_str().ok()?;
+        // devname answers "??" for a device it does not know.
+        (!name.is_empty() && !name.contains('?')).then(|| PathBuf::from(format!("/dev/{name}")))
+    }
+
+    /// When the tty last saw input or output.
+    pub fn tty_used(dev: u32) -> Option<SystemTime> {
+        let meta = std::fs::metadata(tty_path(dev)?).ok()?;
+        let at = |secs: i64, nanos: i64| {
+            UNIX_EPOCH + Duration::new(secs.max(0) as u64, nanos.clamp(0, 999_999_999) as u32)
+        };
+        Some(at(meta.atime(), meta.atime_nsec()).max(at(meta.mtime(), meta.mtime_nsec())))
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+mod sys {
+    use super::*;
+
+    pub fn agent_from_args(_pid: i32) -> Option<Agent> {
+        None
+    }
+    pub fn cwd(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+    pub fn tty_path(_dev: u32) -> Option<PathBuf> {
+        None
+    }
+    pub fn tty_used(_dev: u32) -> Option<SystemTime> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn proc(pid: i32, ppid: i32, name: &str, tdev: Option<u32>) -> Proc {
+        Proc {
+            pid,
+            ppid,
+            pgid: pid,
+            tpgid: pid,
+            tdev,
+            names: vec![name.to_string()],
+            agent: agent_named(name),
+        }
+    }
+
+    fn front(bundle_id: &str, pid: i32) -> FrontApp {
+        FrontApp {
+            bundle_id: bundle_id.to_string(),
+            name: "Terminal".to_string(),
+            pid,
+        }
+    }
+
+    fn at(secs: u64) -> Option<SystemTime> {
+        Some(SystemTime::UNIX_EPOCH + std::time::Duration::from_secs(secs))
+    }
+
+    #[test]
+    fn agent_names() {
+        assert_eq!(agent_named("claude"), Some(Agent::Claude));
+        assert_eq!(agent_named("/opt/homebrew/bin/codex"), Some(Agent::Codex));
+        assert_eq!(
+            agent_named("codex-aarch64-apple-darwin"),
+            Some(Agent::Codex)
+        );
+        assert_eq!(agent_named("claude-desktop"), None);
+        assert_eq!(agent_named("Claude"), None);
+        assert_eq!(agent_named("zsh"), None);
+    }
+
+    #[test]
+    fn most_recently_used_tty_wins() {
+        let procs = vec![
+            proc(10, 1, "ghostty", None),
+            proc(11, 10, "zsh", Some(1)),
+            proc(12, 11, "claude", Some(1)),
+            proc(13, 10, "zsh", Some(2)),
+            proc(14, 13, "codex", Some(2)),
+            proc(20, 1, "claude", Some(3)),
+        ];
+        let under = descendants(&procs, &front("com.mitchellh.ghostty", 10));
+        assert!(!under.contains(&20));
+        let ranked = candidates(&procs, &under, |dev| at(if dev == 2 { 200 } else { 100 }));
+        assert_eq!(
+            ranked.iter().map(|p| p.pid).collect::<Vec<_>>(),
+            vec![14, 12]
+        );
+    }
+
+    #[test]
+    fn an_agent_run_by_an_agent_is_not_a_session() {
+        let procs = vec![
+            proc(10, 1, "ghostty", None),
+            proc(11, 10, "claude", Some(1)),
+            proc(12, 11, "zsh", None),
+            proc(13, 12, "claude", None),
+        ];
+        let under = descendants(&procs, &front("com.mitchellh.ghostty", 10));
+        let ranked = candidates(&procs, &under, |_| at(1));
+        assert_eq!(ranked.iter().map(|p| p.pid).collect::<Vec<_>>(), vec![11]);
+    }
+
+    #[test]
+    fn tmux_server_counts_when_the_terminal_runs_a_client() {
+        let mut procs = vec![
+            proc(10, 1, "ghostty", None),
+            proc(11, 10, "zsh", Some(1)),
+            proc(30, 1, "tmux", None),
+            proc(31, 30, "zsh", Some(5)),
+            proc(32, 31, "claude", Some(5)),
+        ];
+        let f = front("com.mitchellh.ghostty", 10);
+        assert!(!descendants(&procs, &f).contains(&32));
+        procs.push(proc(12, 11, "tmux", Some(1)));
+        assert!(descendants(&procs, &f).contains(&32));
+    }
+
+    #[test]
+    fn not_a_terminal_is_no_session() {
+        assert_eq!(
+            detect(&front("com.apple.Safari", std::process::id() as i32)),
+            None
+        );
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn finds_a_running_agent_and_its_directory() {
+        // A real process named `claude` under this one.
+        let dir = tempfile::tempdir().unwrap();
+        let bin = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &bin).unwrap();
+        let work = dir.path().join("proj");
+        std::fs::create_dir(&work).unwrap();
+        let mut child = std::process::Command::new(&bin)
+            .arg("30")
+            .current_dir(&work)
+            .spawn()
+            .unwrap();
+        let me = std::process::id() as i32;
+        let mut found = None;
+        for _ in 0..50 {
+            found = detect(&front("com.mitchellh.ghostty", me));
+            if found.is_some() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let session = found.expect("session");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(session.pid, child.id() as i32);
+        assert_eq!(session.cwd, work.canonicalize().unwrap());
+        assert_eq!(session.project(), "proj");
+    }
+}
