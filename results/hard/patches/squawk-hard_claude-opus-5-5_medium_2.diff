+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn doc_terms(text: &str) -> Vec<String> {
+        let mut docs = Docs::default();
+        docs.scan(text);
+        docs.finish()
+    }
+
+    #[test]
+    fn stems_that_are_identifiers() {
+        assert_eq!(jargon_stem("src/status_item.rs"), Some("status_item"));
+        assert_eq!(jargon_stem("ui/VocabCache.swift"), Some("VocabCache"));
+        assert_eq!(jargon_stem("README.md"), Some("README"));
+        assert_eq!(jargon_stem("src/audio.rs"), None);
+        assert_eq!(jargon_stem("Cargo.toml"), None);
+        assert_eq!(jargon_stem("CLAUDE.md"), None);
+        assert_eq!(jargon_stem("LICENSE"), None);
+        assert_eq!(jargon_stem(".gitignore"), None);
+    }
+
+    #[test]
+    fn docs_give_names_not_emphasis() {
+        let terms = doc_terms(
+            "# squawk\n\
+             \n\
+             Local dictation for macOS. Built for talking to Claude Code in a\n\
+             terminal. Everything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3.\n\
+             No account, no API keys. IMPORTANT: NEVER commit the model.\n\
+             The `squawk-core` crate holds `VocabCache` and `apply`.\n\
+             \n\
+             ## Getting Started\n\
+             \n\
+             ```\n\
+             Cargo Build\n\
+             ```\n\
+             See [SPEC.md](SPEC.md) for the Design, and the design notes.\n\
+             \n\
+             ## License\n\
+             \n\
+             MIT\n",
+        );
+        for want in [
+            "squawk",
+            "macOS",
+            "Claude Code",
+            "Mac",
+            "NVIDIA",
+            "Parakeet TDT",
+            "TDT",
+            "API",
+            "squawk-core",
+            "VocabCache",
+            "MIT",
+        ] {
+            assert!(terms.iter().any(|t| t == want), "{want} in {terms:?}");
+        }
+        for unwanted in [
+            "Local",
+            "Built",
+            "Everything",
+            "IMPORTANT",
+            "NEVER",
+            "apply",
+            "Getting Started",
+            "Cargo Build",
+            "See",
+            "SPEC",
+            "Design",
+            "License",
+            "Code",
+        ] {
+            assert!(
+                !terms.iter().any(|t| t == unwanted),
+                "{unwanted} in {terms:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn walk_outside_git_skips_dependencies_and_hidden_dirs() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        for f in [
+            "notes.md",
+            "src/main.py",
+            "node_modules/x/index.js",
+            ".cache/blob.bin",
+            ".env",
+        ] {
+            std::fs::create_dir_all(root.join(f).parent().unwrap()).unwrap();
+            std::fs::write(root.join(f), "").unwrap();
+        }
+        assert_eq!(files(root), [".env", "notes.md", "src/main.py"]);
+    }
+}
