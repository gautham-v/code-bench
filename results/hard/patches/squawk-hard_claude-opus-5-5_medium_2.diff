@@ -0,0 +1,229 @@
+//! Repo terms in the repo's spelling.
+//!
+//! A term matches the words that sound like it: "parakeet" for `Parakeet`,
+//! "vocab cache" for `VocabCache`, "squawk core" for `squawk-core`. Words
+//! may be split only where the term itself has a seam (a capital, a digit,
+//! a `_` or `-`), the same rule the dictionary uses, so `together` never
+//! swallows "to get her".
+
+use std::collections::HashMap;
+
+use super::spoken::{self, joined, Kind};
+use crate::text::Chunk;
+
+/// A term is never spoken as more chunks than this.
+const MAX_SPAN: usize = 6;
+
+/// A lowercase compound with one of these inside (`launch_at_login`) reads
+/// as plain English when said as separate words, and is left alone.
+const FUNCTION_WORDS: &[&str] = &[
+    "a", "an", "and", "are", "as", "at", "be", "by", "do", "for", "from", "i", "if", "in", "into",
+    "is", "it", "my", "no", "not", "of", "off", "on", "or", "out", "over", "that", "the", "this",
+    "to", "up", "we", "with", "you",
+];
+
+/// A span of chunks and what it sounds like.
+struct Span {
+    start: usize,
+    len: usize,
+    /// The key of each chunk that counts (a spoken "underscore" does not).
+    said: Vec<String>,
+    /// "underscore" or "dash" was said between the words.
+    explicit: bool,
+}
+
+pub(super) fn rewrite(chunks: Vec<Chunk>, frozen: &[bool], words: &[String]) -> Vec<Chunk> {
+    if words.is_empty() {
+        return chunks;
+    }
+    let tokens = spoken::tokens(&chunks);
+    let usable =
+        |i: usize| tokens[i].kind != Kind::Stop && !frozen.get(i).copied().unwrap_or(false);
+    let chunk_key = |i: usize, last: bool| -> String {
+        match (last, possessive(&chunks[i].core)) {
+            (true, Some((base, _))) => spoken::key(base),
+            _ => tokens[i].key.clone(),
+        }
+    };
+
+    let mut spans: Vec<Span> = Vec::new();
+    let mut by_key: HashMap<String, Vec<usize>> = HashMap::new();
+    for start in (0..chunks.len()).filter(|&i| usable(i)) {
+        for len in 1..=MAX_SPAN.min(chunks.len() - start) {
+            let end = start + len - 1;
+            if len > 1 && !(usable(end) && joined(&chunks, end - 1)) {
+                break;
+            }
+            let keys: Vec<String> = (start..=end).map(|i| chunk_key(i, i == end)).collect();
+            let mut add = |said: Vec<String>, explicit: bool| {
+                by_key.entry(said.concat()).or_default().push(spans.len());
+                spans.push(Span {
+                    start,
+                    len,
+                    said,
+                    explicit,
+                });
+            };
+            let separator = |i: usize| {
+                matches!(tokens[i].kind, Kind::Underscore | Kind::Dash) && i != start && i != end
+            };
+            if (start..=end).any(separator) {
+                let said = (start..=end)
+                    .filter(|&i| !separator(i))
+                    .map(|i| keys[i - start].clone())
+                    .collect();
+                add(said, true);
+            }
+            add(keys, false);
+        }
+    }
+
+    // What each span should become; `None` once two terms disagree.
+    let mut wanted: HashMap<(usize, usize), Option<&str>> = HashMap::new();
+    for word in words {
+        let parts = parts(word);
+        let Some(hits) = by_key.get(&parts.concat()) else {
+            continue;
+        };
+        for span in hits.iter().map(|&s| &spans[s]) {
+            if !sounds_like(span, &parts, word) {
+                continue;
+            }
+            wanted
+                .entry((span.start, span.len))
+                .and_modify(|w| {
+                    if *w != Some(word.as_str()) {
+                        *w = None;
+                    }
+                })
+                .or_insert(Some(word.as_str()));
+        }
+    }
+    if wanted.is_empty() {
+        return chunks;
+    }
+
+    let mut order: Vec<(usize, usize)> = wanted.keys().copied().collect();
+    order.sort_by_key(|&(start, len)| (std::cmp::Reverse(len), start));
+    let mut claimed = vec![false; chunks.len()];
+    let mut replace: HashMap<usize, (usize, String)> = HashMap::new();
+    for (start, len) in order {
+        if claimed[start..start + len].iter().any(|c| *c) {
+            continue;
+        }
+        claimed[start..start + len].fill(true);
+        let Some(word) = wanted[&(start, len)] else {
+            continue;
+        };
+        let last = &chunks[start + len - 1].core;
+        let suffix = possessive(last).map_or("", |(_, s)| s);
+        // A lowercase term does not take the capital off a sentence.
+        let sentence_start = start == 0 || chunks[start - 1].ends_sentence();
+        let case_only = len == 1 && chunks[start].core.to_lowercase() == format!("{word}{suffix}");
+        if case_only && sentence_start && !word.chars().any(char::is_uppercase) {
+            continue;
+        }
+        replace.insert(start, (len, format!("{word}{suffix}")));
+    }
+
+    let mut out = Vec::with_capacity(chunks.len());
+    let mut i = 0;
+    while i < chunks.len() {
+        match replace.remove(&i) {
+            Some((len, core)) => {
+                out.push(Chunk {
+                    lead: chunks[i].lead.clone(),
+                    core,
+                    trail: chunks[i + len - 1].trail.clone(),
+                });
+                i += len;
+            }
+            None => {
+                out.push(chunks[i].clone());
+                i += 1;
+            }
+        }
+    }
+    out
+}
+
+/// Is `span` the term `word` (whose seams give `parts`) said aloud?
+fn sounds_like(span: &Span, parts: &[String], word: &str) -> bool {
+    if span.said.len() == 1 {
+        return true;
+    }
+    // Each chunk must be one or more whole parts.
+    let mut next = 0;
+    for said in &span.said {
+        let mut built = String::new();
+        while built.len() < said.len() && next < parts.len() {
+            built.push_str(&parts[next]);
+            next += 1;
+        }
+        if built != *said {
+            return false;
+        }
+    }
+    if next != parts.len() {
+        return false;
+    }
+    span.explicit
+        || word.chars().any(char::is_uppercase)
+        || !parts.iter().any(|p| FUNCTION_WORDS.contains(&p.as_str()))
+}
+
+/// `Parakeet's` → (`Parakeet`, `'s`).
+fn possessive(core: &str) -> Option<(&str, &str)> {
+    ["'s", "’s"].iter().find_map(|s| {
+        let base = core.strip_suffix(s)?;
+        (!base.is_empty()).then(|| (base, &core[base.len()..]))
+    })
+}
+
+/// A term's parts at its seams, lowercased: `VocabCache` → vocab, cache;
+/// `squawk-core` → squawk, core; `sha256` → sha, 256; `HTTPServer` → http,
+/// server; `Claude Code` → claude, code.
+fn parts(word: &str) -> Vec<String> {
+    let chars: Vec<char> = word.chars().collect();
+    let mut parts: Vec<String> = Vec::new();
+    let mut current = String::new();
+    for (i, &c) in chars.iter().enumerate() {
+        if !c.is_alphanumeric() {
+            if !current.is_empty() {
+                parts.push(std::mem::take(&mut current));
+            }
+            continue;
+        }
+        if let Some(&prev) = i.checked_sub(1).and_then(|j| chars.get(j)) {
+            let next_lower = chars.get(i + 1).is_some_and(|n| n.is_lowercase());
+            let seam = (prev.is_lowercase() && c.is_uppercase())
+                || (prev.is_uppercase() && c.is_uppercase() && next_lower)
+                || (prev.is_alphanumeric() && prev.is_numeric() != c.is_numeric());
+            if seam && !current.is_empty() {
+                parts.push(std::mem::take(&mut current));
+            }
+        }
+        current.extend(c.to_lowercase());
+    }
+    if !current.is_empty() {
+        parts.push(current);
+    }
+    parts
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn seams() {
+        assert_eq!(parts("VocabCache"), ["vocab", "cache"]);
+        assert_eq!(parts("squawk-core"), ["squawk", "core"]);
+        assert_eq!(parts("status_item"), ["status", "item"]);
+        assert_eq!(parts("sha256"), ["sha", "256"]);
+        assert_eq!(parts("HTTPServer"), ["http", "server"]);
+        assert_eq!(parts("Claude Code"), ["claude", "code"]);
+        assert_eq!(parts("macOS"), ["mac", "os"]);
+        assert_eq!(parts("README"), ["readme"]);
+    }
+}
