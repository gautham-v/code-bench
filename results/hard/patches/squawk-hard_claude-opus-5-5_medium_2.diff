+//! How a transcript's chunks read as spoken tokens: plain words, and the
+//! words people say for punctuation in a file name ("dot", "slash").
+
+use crate::text::Chunk;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Kind {
+    Word,
+    Dot,
+    Slash,
+    Underscore,
+    Dash,
+    /// "forward" before "slash": said, but means nothing.
+    Filler,
+    /// A protected chunk, or one with no letters or digits: nothing matches
+    /// across it.
+    Stop,
+}
+
+impl Kind {
+    pub fn is_connector(self) -> bool {
+        matches!(
+            self,
+            Kind::Dot | Kind::Slash | Kind::Underscore | Kind::Dash
+        )
+    }
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct Token {
+    pub kind: Kind,
+    /// Lowercased letters and digits of the chunk's core.
+    pub key: String,
+}
+
+/// Lowercased letters and digits: what a name sounds like, whatever
+/// punctuation or casing it is written with.
+pub(super) fn key(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    push_key(&mut out, s);
+    out
+}
+
+pub(super) fn push_key(out: &mut String, s: &str) {
+    for c in s.chars().filter(|c| c.is_alphanumeric()) {
+        out.extend(c.to_lowercase());
+    }
+}
+
+pub(super) fn tokens(chunks: &[Chunk]) -> Vec<Token> {
+    let mut tokens: Vec<Token> = chunks
+        .iter()
+        .map(|c| {
+            let key = key(&c.core);
+            let kind = if c.is_protected() || key.is_empty() {
+                Kind::Stop
+            } else {
+                match key.as_str() {
+                    "dot" => Kind::Dot,
+                    "slash" => Kind::Slash,
+                    "underscore" => Kind::Underscore,
+                    "dash" | "hyphen" => Kind::Dash,
+                    _ => Kind::Word,
+                }
+            };
+            Token { kind, key }
+        })
+        .collect();
+    for i in 0..tokens.len().saturating_sub(1) {
+        if tokens[i].key == "forward" && tokens[i + 1].kind == Kind::Slash && joined(chunks, i) {
+            tokens[i].kind = Kind::Filler;
+        }
+    }
+    tokens
+}
+
+/// Chunks `i` and `i + 1` were said in one breath: no punctuation between.
+pub(super) fn joined(chunks: &[Chunk], i: usize) -> bool {
+    i + 1 < chunks.len() && chunks[i].trail.is_empty() && chunks[i + 1].lead.is_empty()
+}
