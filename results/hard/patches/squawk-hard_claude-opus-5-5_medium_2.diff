+        let Ok(meta) = std::fs::metadata(&dot_git) else {
+            continue;
+        };
+        if meta.is_dir() {
+            return Some(dot_git.join("index"));
+        }
+        let pointer = std::fs::read_to_string(&dot_git).ok()?;
+        let git_dir = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+        return Some(dir.join(git_dir.trim()).join("index"));
+    }
+    None
+}
+
+pub(super) fn mtime(path: &Path) -> Option<SystemTime> {
+    std::fs::metadata(path).and_then(|m| m.modified()).ok()
+}
+
+/// Tracked files plus untracked ones git does not ignore (what Claude just
+/// wrote is what gets talked about), minus those deleted from the worktree,
+/// relative to `cwd`. `None` outside git or if git cannot be run.
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    git_index(cwd)?;
+    let mut child = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        .args([
+            "ls-files",
+            "-z",
+            "-t",
+            "--cached",
+            "--others",
+            "--deleted",
+            "--exclude-standard",
+        ])
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .ok()?;
+    let mut stdout = child.stdout.take()?;
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut out = Vec::new();
+        let ok = stdout.read_to_end(&mut out).is_ok();
+        let _ = tx.send(ok.then_some(out));
+    });
+    let out = match rx.recv_timeout(GIT_TIMEOUT) {
+        Ok(Some(out)) => out,
+        _ => {
+            let _ = child.kill();
+            let _ = child.wait();
+            return None;
+        }
+    };
+    if !child.wait().ok()?.success() {
+        return None;
+    }
+
+    // `-t` tags each path: H tracked, ? untracked, R deleted, S skip-worktree.
+    let mut files = Vec::new();
+    let mut gone: HashSet<&str> = HashSet::new();
+    let text = String::from_utf8_lossy(&out);
+    for entry in text.split('\0') {
+        let Some((tag, path)) = entry.split_once(' ') else {
+            continue;
+        };
+        match tag {
+            "R" | "S" => {
+                gone.insert(path);
+            }
+            _ => files.push(path),
+        }
+    }
+    Some(
+        files
+            .into_iter()
+            .filter(|f| !gone.contains(f))
+            .map(str::to_string)
+            .collect(),
+    )
+}
+
+/// Breadth first, so a cap cuts off the deep end rather than half the top.
+fn walk(cwd: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    let mut level: Vec<PathBuf> = vec![PathBuf::new()];
+    for _ in 0..=WALK_MAX_DEPTH {
+        let mut next = Vec::new();
+        for rel in &level {
+            let Ok(entries) = std::fs::read_dir(cwd.join(rel)) else {
+                continue;
+            };
+            for entry in entries.flatten() {
+                let name = entry.file_name();
+                let Some(name) = name.to_str() else { continue };
+                let Ok(kind) = entry.file_type() else {
+                    continue;
+                };
+                let path = rel.join(name);
+                if kind.is_dir() {
+                    if !name.starts_with('.') && !WALK_SKIP_DIRS.contains(&name) {
+                        next.push(path);
+                    }
+                } else if kind.is_file() && name != ".DS_Store" {
+                    files.push(path.to_string_lossy().replace('\\', "/"));
+                    if files.len() >= WALK_MAX_FILES {
+                        return files;
+                    }
+                }
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        level = next;
+    }
+    files
+}
+
+pub(super) fn words(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut out = Words::default();
+    for name in package_names(cwd, files) {
+        out.push(&name);
+    }
+    let mut docs = Docs::default();
+    for doc in DOCS {
+        if let Some(text) = read_capped(&cwd.join(doc), MAX_DOC_BYTES) {
+            docs.scan(&text);
+        }
+    }
+    for term in docs.finish() {
+        out.push(&term);
+    }
+    for file in files {
+        if let Some(stem) = jargon_stem(file) {
+            out.push(stem);
+        }
+    }
+    out.list
+}
+
+/// Terms in the order found, without repeats.
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn push(&mut self, word: &str) {
+        if self.list.len() < MAX_WORDS && !word.is_empty() && self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+fn read_capped(path: &Path, max: u64) -> Option<String> {
+    let file = std::fs::File::open(path).ok()?;
+    let mut bytes = Vec::new();
+    file.take(max).read_to_end(&mut bytes).ok()?;
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+/// A file stem that is visibly an identifier: several parts (`status_item`,
+/// `menu-bar`), inner capitals (`VocabCache`), or one of the conventional
+/// names. One plain word (`audio`, `Cargo`, `LICENSE`) says nothing about
+/// how the repo spells anything.
+fn jargon_stem(file: &str) -> Option<&str> {
+    let base = file.rsplit('/').next()?;
+    let stem = base.split('.').next()?;
+    if stem.len() < 3 || !stem.starts_with(|c: char| c.is_alphabetic()) {
+        return None;
+    }
+    if CONVENTIONAL_NAMES.contains(&stem) {
+        return Some(stem);
+    }
+    if !stem
+        .chars()
+        .all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+    {
+        return None;
+    }
+    let parts = stem.split(['_', '-']).filter(|p| !p.is_empty()).count();
+    let camel =
+        stem.chars().any(char::is_lowercase) && stem.chars().skip(1).any(char::is_uppercase);
+    ((2..=5).contains(&parts) || camel).then_some(stem)
+}
+
+/// Names the repo's own manifests declare, shallowest manifest first.
+fn package_names(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| {
+            matches!(
+                f.rsplit('/').next(),
+                Some("Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod")
+            )
+        })
+        .collect();
+    manifests.sort_by_key(|f| f.matches('/').count());
+    let mut names = Vec::new();
+    for rel in manifests.into_iter().take(MAX_MANIFESTS) {
+        let Some(text) = read_capped(&cwd.join(rel), MAX_DOC_BYTES) else {
+            continue;
+        };
+        match rel.rsplit('/').next() {
+            Some("package.json") => {
+                let json: Option<serde_json::Value> = serde_json::from_str(&text).ok();
+                if let Some(name) = json.as_ref().and_then(|v| v.get("name")?.as_str()) {
+                    // "@scope/name" is spoken as "name".
+                    names.push(name.rsplit('/').next().unwrap_or(name).to_string());
+                }
+            }
+            Some("go.mod") => {
+                let module = text.lines().find_map(|l| l.trim().strip_prefix("module "));
+                if let Some(name) = module.and_then(|m| m.trim().rsplit('/').next()) {
+                    names.push(name.to_string());
+                }
+            }
+            _ => {
+                let Ok(doc) = text.parse::<toml::Table>() else {
+                    continue;
+                };
+                let name_at = |path: &[&str]| -> Option<String> {
+                    let mut value = doc.get(path[0])?;
+                    for key in &path[1..] {
+                        value = value.get(key)?;
+                    }
+                    Some(value.get("name")?.as_str()?.to_string())
+                };
+                let package = name_at(&["package"]);
+                // A lib is its package with underscores unless it says
+                // otherwise; listing both would make the name ambiguous.
+                let default_lib = package.as_ref().map(|p| p.replace('-', "_"));
+                names.extend(name_at(&["lib"]).filter(|lib| Some(lib) != default_lib.as_ref()));
+                names.extend(package);
+                names.extend(name_at(&["project"]));
+                names.extend(name_at(&["tool", "poetry"]));
+                for bin in doc
+                    .get("bin")
+                    .and_then(|b| b.as_array())
+                    .into_iter()
+                    .flatten()
+                {
+                    names.extend(bin.get("name").and_then(|n| n.as_str()).map(str::to_string));
+                }
+            }
+        }
+    }
+    names.retain(|n| is_identifier(n));
+    names
+}
+
+fn is_identifier(s: &str) -> bool {
+    s.len() >= 2
+        && s.starts_with(|c: char| c.is_alphabetic())
+        && s.chars()
+            .all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+}
+
+fn is_common(word: &str) -> bool {
+    COMMON.contains(&word.to_lowercase().as_str())
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Shape {
+    /// `Parakeet`
+    Capitalised,
+    /// `NVIDIA`
+    Acronym,
+    /// `macOS`, `GitHub`
+    Mixed,
+}
+
+fn shape(word: &str) -> Option<Shape> {
+    let upper = word.chars().filter(|c| c.is_uppercase()).count();
+    let lower = word.chars().filter(|c| c.is_lowercase()).count();
+    let first_upper = word.chars().next().is_some_and(char::is_uppercase);
+    match (upper, lower) {
+        (0, _) => None,
+        (_, 0) => (upper >= 2).then_some(Shape::Acronym),
+        (1, _) if first_upper => Some(Shape::Capitalised),
+        _ => Some(Shape::Mixed),
+    }
+}
+
+/// Where a run of capitalised words may be taken as one term.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Phrases {
+    Never,
+    MidSentence,
+    Anywhere,
+}
+
+/// Jargon from markdown prose.
+#[derive(Default)]
+struct Docs {
+    /// Terms that stand on their own evidence: phrases, code identifiers.
+    sure: Vec<String>,
+    /// Single capitalised words: jargon unless the docs also write them
+    /// lowercase.
+    maybe: Vec<String>,
+    lowercase: HashSet<String>,
+}
+
+impl Docs {
+    fn scan(&mut self, text: &str) {
+        let mut fenced = false;
+        let mut sentence_start = true;
+        for line in text.lines() {
+            let trimmed = line.trim();
+            if trimmed.starts_with("```") || trimmed.starts_with("~~~") {
+                fenced = !fenced;
+                sentence_start = true;
+                continue;
+            }
+            if fenced {
+                continue;
+            }
+            if trimmed.is_empty() {
+                sentence_start = true;
+                continue;
+            }
+            let heading = trimmed.starts_with('#');
+            let body = trimmed.trim_start_matches('#').trim();
+            // List items, quotes and table rows each start their own sentence.
+            if heading || trimmed.starts_with(['-', '*', '+', '>', '|']) || starts_numbered(trimmed)
+            {
+                sentence_start = true;
+            }
+            let prose = self.strip_markup(body);
+            if heading {
+                self.heading(&prose);
+                sentence_start = true;
+            } else {
+                sentence_start = self.prose(&prose, sentence_start, Phrases::MidSentence);
+            }
+        }
+    }
+
+    /// Drop link targets and tags, and pull identifiers out of code spans.
+    /// A code span leaves a `|` behind so the words around it do not join.
+    fn strip_markup(&mut self, line: &str) -> String {
+        let mut out = String::new();
+        for (i, piece) in line.split('`').enumerate() {
+            if i % 2 == 1 {
+                let code = piece.trim();
+                let distinctive = code.contains(['_', '-'])
+                    || (code.chars().any(char::is_lowercase)
+                        && code.chars().skip(1).any(char::is_uppercase));
+                if is_identifier(code) && code.len() >= 3 && distinctive {
+                    self.sure.push(code.to_string());
+                }
+                out.push_str(" | ");
+                continue;
+            }
+            let mut rest = piece;
+            while let Some(open) = rest.find("](") {
+                out.push_str(&rest[..open]);
+                out.push(' ');
+                rest = match rest[open..].find(')') {
+                    Some(close) => &rest[open + close + 1..],
+                    None => "",
+                };
+            }
+            out.push_str(rest);
+        }
+        let mut clean = String::new();
+        let mut in_tag = false;
+        for c in out.chars() {
+            match c {
+                '<' => in_tag = true,
+                '>' if in_tag => in_tag = false,
+                _ if !in_tag => clean.push(c),
+                _ => {}
+            }
+        }
+        clean
+    }
+
+    fn heading(&mut self, text: &str) {
+        let words: Vec<&str> = text.split_whitespace().collect();
+        if let [word] = words[..] {
+            let word = word.trim_matches(|c: char| !c.is_alphanumeric());
+            let lower = word.to_lowercase();
+            if is_identifier(word)
+                && word.len() >= 3
+                && !GENERIC_HEADINGS.contains(&lower.as_str())
+                && !is_common(word)
+            {
+                self.sure.push(word.to_string());
+            }
+            return;
+        }
+        // "Getting Started" is title case, not a name: only words that are
+        // distinctive on their own count there.
+        let title_case = words
+            .iter()
+            .filter(|w| !is_common(w))
+            .all(|w| w.starts_with(|c: char| c.is_uppercase()));
+        let phrases = if title_case {
+            Phrases::Never
+        } else {
+            Phrases::Anywhere
+        };
+        self.prose(text, true, phrases);
+    }
+
+    /// Returns whether the next line continues at a sentence start.
+    fn prose(&mut self, text: &str, mut sentence_start: bool, phrases: Phrases) -> bool {
+        // A run of adjacent capitalised words, and whether it opened a sentence.
+        let mut run: Vec<&str> = Vec::new();
+        let mut run_opens = false;
+        for raw in text.split_whitespace() {
+            let word = raw.trim_matches(|c: char| !c.is_alphanumeric());
+            let tail = &raw[raw.rfind(word).map_or(0, |i| i + word.len())..];
+            let ends_sentence = tail.contains(['.', '!', '?', ':']);
+            let possessive = word.ends_with("'s") || word.ends_with("’s");
+            let word = word
+                .strip_suffix("'s")
+                .or_else(|| word.strip_suffix("’s"))
+                .unwrap_or(word);
+            let plain = !word.is_empty() && word.chars().all(char::is_alphabetic);
+            let leads_clean = raw.starts_with(word) || raw.starts_with(['(', '"', '“', '*', '_']);
+
+            if !plain || !leads_clean {
+                self.flush(&mut run, run_opens, phrases);
+            } else if shape(word).is_none() || is_common(word) {
+                if shape(word).is_none() {
+                    self.lowercase.insert(word.to_string());
+                }
+                self.flush(&mut run, run_opens, phrases);
+            } else {
+                if run.is_empty() {
+                    run_opens = sentence_start;
+                }
+                run.push(word);
+            }
+            if !tail.is_empty() || possessive {
+                self.flush(&mut run, run_opens, phrases);
+            }
+            if !word.is_empty() || ends_sentence {
+                sentence_start = ends_sentence;
+            }
+        }
+        self.flush(&mut run, run_opens, phrases);
+        sentence_start
+    }
+
+    fn flush(&mut self, run: &mut Vec<&str>, opens_sentence: bool, phrases: Phrases) {
+        let words = std::mem::take(run);
+        let shapes: Vec<Shape> = words.iter().filter_map(|w| shape(w)).collect();
+        if words.is_empty() || shapes.len() != words.len() {
+            return;
+        }
+        // Three shouted words in a row is emphasis, not three acronyms.
+        if words.len() >= 3 && shapes.iter().all(|s| *s == Shape::Acronym) {
+            return;
+        }
+        let acronym_ok = |w: &str| (2..=6).contains(&w.chars().count());
+        if let [word] = words[..] {
+            let ok = match shapes[0] {
+                // The first word of a sentence is capitalised whatever it is.
+                Shape::Capitalised => !opens_sentence && word.chars().count() >= 3,
+                Shape::Acronym => acronym_ok(word),
+                Shape::Mixed => true,
+            };
+            if ok {
+                self.maybe.push(word.to_string());
+            }
+            return;
+        }
+        // "Install Rust first." opens with a capital that proves nothing, so
+        // a run that opens a sentence is a phrase only in a heading.
+        let phrase_ok = match phrases {
+            Phrases::Never => false,
+            Phrases::Anywhere => true,
+            Phrases::MidSentence => !opens_sentence || shapes[0] != Shape::Capitalised,
+        };
+        if phrase_ok && words.len() <= 4 {
+            self.sure.push(words.join(" "));
+        }
+        for (word, shape) in words.iter().zip(&shapes) {
+            match shape {
+                Shape::Acronym if acronym_ok(word) => self.maybe.push(word.to_string()),
+                Shape::Mixed => self.maybe.push(word.to_string()),
+                _ => {}
+            }
+        }
+    }
+
+    fn finish(self) -> Vec<String> {
+        let Docs {
+            mut sure,
+            maybe,
+            lowercase,
+        } = self;
+        sure.extend(
+            maybe
+                .into_iter()
+                .filter(|w| !lowercase.contains(&w.to_lowercase())),
+        );
+        sure
+    }
+}
+
+fn starts_numbered(line: &str) -> bool {
+    let digits = line.chars().take_while(char::is_ascii_digit).count();
+    digits > 0 && line[digits..].starts_with(['.', ')'])
+}
