+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,288 @@
+//! Spoken file references to @mentions.
+//!
+//! A reference is a file's name said aloud, extension included: "status item
+//! dot rs", "claude md", optionally with the folders it is in, "context
+//! slash mod dot rs". It matches a file when the letters and digits agree,
+//! stem with stem and extension with extension, so `status_item.rs`,
+//! `StatusItem.rs` and `status-item.rs` all answer to "status item dot rs".
+//!
+//! The longest run of words that names a file is the reference, and it
+//! becomes a mention only if it names exactly one. Two candidates, or a
+//! folder that matches nothing, and the words stay as they were said.
+
+use std::collections::{HashMap, HashSet};
+
+use super::spoken::{self, joined, Kind, Token};
+use super::RepoVocab;
+use crate::text::Chunk;
+
+/// A reference is never longer than this many chunks.
+const MAX_SPAN: usize = 16;
+
+/// Extensions that may be said without "dot" ("cargo toml", "claude md").
+/// Only ones that are not words: "go mod tidy" must not find `go.mod`.
+const BARE_EXTENSIONS: &[&str] = &[
+    "md", "toml", "json", "yaml", "yml", "rs", "py", "js", "ts", "tsx", "jsx", "mjs", "cjs", "txt",
+    "html", "css", "scss", "sql", "xml", "csv", "cpp", "hpp", "sh", "lock", "kt", "rb", "php",
+    "ini", "cfg", "proto", "plist", "swift", "java",
+];
+
+/// A span of chunks that reads as a file reference.
+struct Window {
+    start: usize,
+    /// Inclusive.
+    end: usize,
+    /// Folder names said before the file's, outermost first.
+    dirs: Vec<String>,
+    /// Indices into `RepoVocab::files`.
+    files: Vec<usize>,
+}
+
+/// Replace unique references with mentions. The second value marks chunks
+/// that must be left alone from here on: mentions, and references that were
+/// too ambiguous to resolve.
+pub(super) fn rewrite(chunks: Vec<Chunk>, vocab: &RepoVocab) -> (Vec<Chunk>, Vec<bool>) {
+    let tokens = spoken::tokens(&chunks);
+    let mut claimed = vec![false; chunks.len()];
+    let (mut windows, by_key, extensions) = find_windows(&chunks, &tokens);
+    if windows.is_empty() || vocab.files.is_empty() {
+        return (chunks, claimed);
+    }
+    match_files(&mut windows, &by_key, &extensions, vocab);
+
+    let mut order: Vec<&Window> = windows.iter().filter(|w| !w.files.is_empty()).collect();
+    order.sort_by_key(|w| (std::cmp::Reverse(w.end - w.start), w.start));
+    let mut mentions: HashMap<usize, (usize, &str)> = HashMap::new();
+    for w in order {
+        if claimed[w.start..=w.end].iter().any(|c| *c) {
+            continue;
+        }
+        claimed[w.start..=w.end].fill(true);
+        if let [file] = w.files[..] {
+            mentions.insert(w.start, (w.end, &vocab.files[file]));
+        }
+    }
+    if mentions.is_empty() {
+        return (chunks, claimed);
+    }
+
+    let mut out: Vec<Chunk> = Vec::with_capacity(chunks.len());
+    let mut frozen = Vec::with_capacity(chunks.len());
+    let mut i = 0;
+    while i < chunks.len() {
+        let Some(&(end, file)) = mentions.get(&i) else {
+            out.push(chunks[i].clone());
+            frozen.push(claimed[i]);
+            i += 1;
+            continue;
+        };
+        let mut lead = chunks[i].lead.clone();
+        // "the claude md" is one reference: the article goes with it.
+        if i > 0 && !claimed[i - 1] && tokens[i - 1].key == "the" && joined(&chunks, i - 1) {
+            if let Some(the) = out.pop() {
+                frozen.pop();
+                lead = the.lead;
+            }
+        }
+        let mut trail = chunks[end].trail.clone();
+        // A final period would read as part of the path.
+        if end + 1 == chunks.len() && trail == "." {
+            trail.clear();
+        }
+        out.push(Chunk {
+            lead,
+            core: format!("@{file}"),
+            trail,
+        });
+        frozen.push(true);
+        i = end + 1;
+    }
+    (out, frozen)
+}
+
+type Keys = HashMap<String, Vec<usize>>;
+
+/// Every span that could be a reference, the `stem.ext` keys each would
+/// match, and the extensions among them (to skip most files quickly).
+fn find_windows(chunks: &[Chunk], tokens: &[Token]) -> (Vec<Window>, Keys, HashSet<String>) {
+    let mut windows = Vec::new();
+    let mut by_key: Keys = HashMap::new();
+    let mut extensions = HashSet::new();
+    let linked = |i: usize| joined(chunks, i) && tokens[i].kind != Kind::Stop;
+
+    for end in 0..tokens.len() {
+        if tokens[end].kind != Kind::Word {
+            continue;
+        }
+        // The extension is the last word, or letters spelled out: "r s".
+        let mut forms = vec![(end, tokens[end].key.clone())];
+        let letter = |i: usize| tokens[i].kind == Kind::Word && tokens[i].key.chars().count() == 1;
+        let mut first = end;
+        while letter(first)
+            && first > 0
+            && linked(first - 1)
+            && letter(first - 1)
+            && end - first < 3
+        {
+            first -= 1;
+            let spelled: String = tokens[first..=end].iter().map(|t| t.key.as_str()).collect();
+            forms.push((first, spelled));
+        }
+
+        for (ext_start, ext) in forms {
+            if ext_start == 0 || !linked(ext_start - 1) {
+                continue;
+            }
+            let dotted = tokens[ext_start - 1].kind == Kind::Dot;
+            let ext_keys = extension_keys(&ext, dotted);
+            if ext_keys.is_empty() || (!dotted && tokens[ext_start - 1].kind != Kind::Word) {
+                continue;
+            }
+            // The name's tokens are [start, name_end); "dot" sits at name_end.
+            let name_end = if dotted { ext_start - 1 } else { ext_start };
+            let mut start = name_end;
+            loop {
+                let fragment =
+                    start > 0 && linked(start - 1) && tokens[start - 1].kind.is_connector();
+                if let (false, Some((dirs, stems))) =
+                    (fragment, parse_name(&tokens[start..name_end], dotted))
+                {
+                    for stem in &stems {
+                        for ext in &ext_keys {
+                            by_key
+                                .entry(format!("{stem}.{ext}"))
+                                .or_default()
+                                .push(windows.len());
+                        }
+                    }
+                    extensions.extend(ext_keys.iter().cloned());
+                    windows.push(Window {
+                        start,
+                        end,
+                        dirs,
+                        files: Vec::new(),
+                    });
+                }
+                if start == 0 || !linked(start - 1) || end - (start - 1) >= MAX_SPAN {
+                    break;
+                }
+                start -= 1;
+            }
+        }
+    }
+    (windows, by_key, extensions)
+}
+
+/// What a spoken extension may be on disk. Nothing, if it was said without
+/// "dot" and is not one of [`BARE_EXTENSIONS`].
+fn extension_keys(spoken: &str, dotted: bool) -> Vec<String> {
+    let ext = match spoken {
+        "markdown" => "md",
+        "jason" => "json",
+        "tomel" | "tommel" => "toml",
+        "text" if dotted => "txt",
+        other => other,
+    };
+    if !dotted && !BARE_EXTENSIONS.contains(&ext) {
+        return Vec::new();
+    }
+    match ext {
+        "yaml" | "yml" => vec!["yaml".to_string(), "yml".to_string()],
+        _ => vec![ext.to_string()],
+    }
+}
+
+/// Split the tokens before the extension into folders and the file's stem.
+/// The stem comes back in each form it could be on disk: with "dot",
+/// "underscore" and "dash" as punctuation, and as words (`dot_product.rs`).
+fn parse_name(tokens: &[Token], dotted: bool) -> Option<(Vec<String>, Vec<String>)> {
+    if let Some(Kind::Slash | Kind::Dash | Kind::Filler) = tokens.first().map(|t| t.kind) {
+        return None;
+    }
+    let mut parts: Vec<&[Token]> = tokens.split(|t| t.kind == Kind::Slash).collect();
+    let stem = parts.pop()?;
+    let punctuated = |part: &[Token]| -> String {
+        part.iter()
+            .filter(|t| t.kind == Kind::Word)
+            .map(|t| t.key.as_str())
+            .collect()
+    };
+    let mut dirs = Vec::with_capacity(parts.len());
+    for part in parts {
+        let dir = punctuated(part);
+        if dir.is_empty() {
+            return None;
+        }
+        dirs.push(dir);
+    }
+    let plain = punctuated(stem);
+    // Only a dotfile has nothing before its dot: "dot gitignore".
+    if plain.is_empty() && !(dotted && stem.is_empty()) {
+        return None;
+    }
+    let mut stems = vec![plain];
+    let worded: String = stem
+        .iter()
+        .filter(|t| t.kind != Kind::Filler)
+        .map(|t| t.key.as_str())
+        .collect();
+    if worded != stems[0] {
+        stems.push(worded);
+    }
+    Some((dirs, stems))
+}
+
+/// One pass over the repo's files, filling in each window's candidates.
+fn match_files(
+    windows: &mut [Window],
+    by_key: &Keys,
+    extensions: &HashSet<String>,
+    vocab: &RepoVocab,
+) {
+    let project = spoken::key(&super::project_name(&vocab.root));
+    let (mut name_key, mut ext_key) = (String::new(), String::new());
+    for (index, file) in vocab.files.iter().enumerate() {
+        // A mention cannot hold a space, and a name with none cannot be said.
+        if file.contains(char::is_whitespace) {
+            continue;
+        }
+        let base = file.rsplit('/').next().unwrap_or(file);
+        let Some((stem, ext)) = base.rsplit_once('.') else {
+            continue;
+        };
+        ext_key.clear();
+        spoken::push_key(&mut ext_key, ext);
+        if !extensions.contains(ext_key.as_str()) {
+            continue;
+        }
+        name_key.clear();
+        spoken::push_key(&mut name_key, stem);
+        name_key.push('.');
+        name_key.push_str(&ext_key);
+        let Some(hits) = by_key.get(name_key.as_str()) else {
+            continue;
+        };
+        for &w in hits {
+            let window = &mut windows[w];
+            if window.files.last() != Some(&index) && in_dirs(file, &window.dirs, &project) {
+                window.files.push(index);
+            }
+        }
+    }
+}
+
+/// Do the folders said match the folders `file` is in, innermost last? The
+/// project's own name stands for the root, so a top-level file can be told
+/// apart from its namesakes: "squawk slash cargo toml".
+fn in_dirs(file: &str, dirs: &[String], project: &str) -> bool {
+    let mut parents = file.rsplit('/').skip(1).map(spoken::key);
+    let mut at_root = false;
+    dirs.iter().rev().all(|said| match parents.next() {
+        Some(dir) => dir == *said,
+        None if !at_root => {
+            at_root = true;
+            said == project
+        }
+        None => false,
+    })
+}
