+                            open.pop();
+                        }
+                        let group = punct.map(|_| {
+                            groups.push(vec![row]);
+                            groups.len() - 1
+                        });
+                        open.push(Level {
+                            indent,
+                            punct,
+                            group,
+                        });
+                    }
+                }
+            }
+        }
+        blank = false;
+    }
+    groups
