+/// A list item line, as far as nesting and numbering go.
+struct ListItem {
+    /// How many `>` the line sits behind.
+    depth: usize,
+    /// Columns of indent in front of the marker; a tab counts four.
+    indent: usize,
+    /// The byte range of a numbered item's digits.
+    digits: Option<(usize, usize)>,
+    /// What a numbered item's value is, and the `.` or `)` after it.
+    numbered: Option<(u64, char)>,
+}
+
+impl ListItem {
+    fn number(&self) -> Option<u64> {
+        self.numbered.map(|n| n.0)
+    }
+}
+
+/// The byte length of the `> ` prefixes `line` opens with, and how many.
+fn split_quote(line: &str) -> (usize, usize) {
+    let (mut at, mut depth) = (0, 0);
+    while let Some(rest) = line[at..].trim_start_matches(' ').strip_prefix('>') {
+        depth += 1;
+        at = line.len() - rest.len();
+        if rest.starts_with(' ') {
+            at += 1;
+        }
+    }
+    (at, depth)
+}
+
+/// Columns a run of indent takes.
+fn columns(ws: &str) -> usize {
+    ws.chars().map(|c| if c == '\t' { 4 } else { 1 }).sum()
+}
+
+fn list_item(line: &str) -> Option<ListItem> {
+    let (quote, depth) = split_quote(line);
+    let rest = &line[quote..];
+    let text = rest.trim_start_matches([' ', '\t']);
+    let start = line.len() - text.len();
+    let indent = columns(&rest[..rest.len() - text.len()]);
+    if ["- ", "* ", "+ "].iter().any(|m| text.starts_with(m)) {
+        return Some(ListItem {
+            depth,
+            indent,
+            digits: None,
+            numbered: None,
+        });
+    }
+    let digits = text.len() - text.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 {
+        return None;
+    }
+    let mut after = text[digits..].chars();
+    let punct = after.next().filter(|c| matches!(c, '.' | ')'))?;
+    if after.next() != Some(' ') {
+        return None;
+    }
+    let n = text[..digits].parse().ok()?;
+    Some(ListItem {
+        depth,
+        indent,
+        digits: Some((start, start + digits)),
+        numbered: Some((n, punct)),
+    })
+}
+
+/// Every numbered list in `lines`, as the rows of its items: one group for
+/// each run of sibling items, so a nested list is a group of its own and so
+/// is whatever follows a paragraph, a heading or a change of marker. Blank
+/// lines do not end a list, except that a top-level `1.` after one starts
+/// the next list, as does a row in `heads`. Front matter and fenced code are
+/// stepped over.
+fn numbered_groups(lines: &[String], heads: &[usize]) -> Vec<Vec<usize>> {
+    struct Level {
+        indent: usize,
+        punct: Option<char>,
+        group: Option<usize>,
+    }
+    let mut groups: Vec<Vec<usize>> = Vec::new();
+    let mut open: Vec<Level> = Vec::new();
+    let mut depth = 0;
+    let mut blank = false;
+    let mut fence: Option<&str> = None;
+    let body =
+        crate::notes::front_matter_end(lines.iter().map(String::as_str)).map_or(0, |e| e + 1);
+    for (row, line) in lines.iter().enumerate().skip(body) {
+        let (quote, d) = split_quote(line);
+        let rest = &line[quote..];
+        let text = rest.trim_start_matches([' ', '\t']);
+        if let Some(mark) = fence {
+            if text.starts_with(mark) {
+                fence = None;
+            }
+            continue;
+        }
+        if d != depth {
+            open.clear();
+            depth = d;
+        }
+        if text.is_empty() {
+            blank = true;
+            continue;
+        }
+        let indent = columns(&rest[..rest.len() - text.len()]);
+        if let Some(mark) = ["```", "~~~"].into_iter().find(|m| text.starts_with(m)) {
+            fence = Some(mark);
+            if indent == 0 {
+                open.clear();
+            }
+            continue;
+        }
+        match list_item(line) {
+            None => {
+                // an indented line belongs to the item above it
+                if open.first().is_none_or(|l| indent <= l.indent) {
+                    open.clear();
+                }
+            }
+            Some(item) => {
+                while open.last().is_some_and(|l| l.indent > indent) {
+                    open.pop();
+                }
+                let punct = item.numbered.map(|n| n.1);
+                let restart =
+                    blank && open.len() == 1 && (item.number() == Some(1) || heads.contains(&row));
+                match open.last() {
+                    Some(l) if l.indent == indent && l.punct == punct && !restart => {
+                        if let Some(g) = l.group {
