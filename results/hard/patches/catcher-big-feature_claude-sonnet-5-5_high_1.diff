@@ -0,0 +1,560 @@
+//! Lists in the buffer: who belongs to which list, the numbers of an ordered
+//! one, and nesting an item under the one above it.
+//!
+//! Everything here is a pure function over the buffer's lines. The editor
+//! calls [`renumber_after`] once an edit is done, with the lines as they were
+//! before it, and calls [`indent`] / [`outdent`] for Tab and Shift+Tab.
+
+/// A list item's marker.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Item {
+    pub ordered: bool,
+    /// `.` or `)` for a numbered item, the bullet itself otherwise.
+    pub delim: char,
+    pub num: u64,
+    /// Byte range of the digits in the line; empty for a bullet.
+    pub at: usize,
+    pub end: usize,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Kind {
+    Blank,
+    Item(Item),
+    Other,
+}
+
+/// One line, taken apart.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Parsed {
+    /// How many `>` bars the line sits behind.
+    pub quote: usize,
+    /// Byte length of those bars.
+    pub prefix: usize,
+    /// Byte length of the whitespace after them.
+    pub indent: usize,
+    /// That whitespace in columns, a tab being two like the renderer has it.
+    pub width: usize,
+    pub kind: Kind,
+}
+
+pub fn parse(line: &str) -> Parsed {
+    let mut quote = 0;
+    let mut prefix = 0;
+    loop {
+        let t = line[prefix..].trim_start_matches(' ');
+        let Some(after) = t.strip_prefix('>') else {
+            break;
+        };
+        quote += 1;
+        prefix = line.len() - after.len();
+        if line[prefix..].starts_with(' ') {
+            prefix += 1;
+        }
+    }
+    let rest = &line[prefix..];
+    let body = rest.trim_start_matches([' ', '\t']);
+    let indent = rest.len() - body.len();
+    let width = rest[..indent].chars().map(|c| if c == '\t' { 2 } else { 1 }).sum();
+    let kind = if body.is_empty() {
+        Kind::Blank
+    } else if let Some(item) = item_of(body, prefix + indent) {
+        Kind::Item(item)
+    } else {
+        Kind::Other
+    };
+    Parsed {
+        quote,
+        prefix,
+        indent,
+        width,
+        kind,
+    }
+}
+
+/// The marker `body` starts with; `base` is where `body` begins in its line.
+fn item_of(body: &str, base: usize) -> Option<Item> {
+    let first = body.chars().next()?;
+    if matches!(first, '-' | '*' | '+') {
+        return body[1..].starts_with(' ').then_some(Item {
+            ordered: false,
+            delim: first,
+            num: 0,
+            at: base,
+            end: base,
+        });
+    }
+    let digits = body.len() - body.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 || digits > 9 {
+        return None;
+    }
+    let after = &body[digits..];
+    let delim = after.chars().next().filter(|c| matches!(c, '.' | ')'))?;
+    after[1..].starts_with(' ').then_some(Item {
+        ordered: true,
+        delim,
+        num: body[..digits].parse().ok()?,
+        at: base,
+        end: base + digits,
+    })
+}
+
+/// A run of sibling items: same bar depth, same indent, same kind of marker.
+#[derive(Clone, Debug)]
+pub struct List {
+    pub quote: usize,
+    pub width: usize,
+    pub ordered: bool,
+    pub delim: char,
+    /// Rows of the items, in order.
+    pub items: Vec<usize>,
+    /// The item this list is nested under, when it is nested.
+    pub parent: Option<usize>,
+    /// The last row that belongs to the list, nested lines included.
+    pub last: usize,
+}
+
+impl List {
+    fn same_kind(&self, quote: usize, width: usize, item: &Item) -> bool {
+        self.quote == quote
+            && self.width == width
+            && self.ordered == item.ordered
+            && self.delim == item.delim
+    }
+}
+
+/// Every list in the buffer, outer ones before the lists nested in them. Fenced
+/// code is not list.
+pub fn lists(lines: &[String]) -> Vec<List> {
+    let mut all: Vec<List> = Vec::new();
+    let mut stack: Vec<usize> = Vec::new();
+    let mut fence = false;
+    for (i, text) in lines.iter().enumerate() {
+        if fence {
+            fence = !crate::md::is_fence(text);
+            for &s in &stack {
+                all[s].last = i;
+            }
+            continue;
+        }
+        let line = parse(text);
+        if line.kind == Kind::Blank {
+            continue;
+        }
+        while stack.last().is_some_and(|&s| all[s].quote != line.quote) {
+            stack.pop();
+        }
+        match &line.kind {
+            Kind::Item(item) => {
+                while stack.last().is_some_and(|&s| all[s].width > line.width) {
+                    stack.pop();
+                }
+                match stack.last().copied() {
+                    Some(s) if all[s].same_kind(line.quote, line.width, item) => {
+                        all[s].items.push(i);
+                    }
+                    top => {
+                        // a sibling of another kind ends that list; anything
+                        // wider than the top one is nested in its last item
+                        let parent = match top {
+                            Some(s) if all[s].width == line.width => {
+                                stack.pop();
+                                stack.last().map(|&p| *all[p].items.last().unwrap())
+                            }
+                            Some(s) => Some(*all[s].items.last().unwrap()),
+                            None => None,
+                        };
+                        all.push(List {
+                            quote: line.quote,
+                            width: line.width,
+                            ordered: item.ordered,
+                            delim: item.delim,
+                            items: vec![i],
+                            parent,
+                            last: i,
+                        });
+                        stack.push(all.len() - 1);
+                    }
+                }
+            }
+            _ => {
+                while stack.last().is_some_and(|&s| all[s].width >= line.width) {
+                    stack.pop();
+                }
+                fence = crate::md::is_fence(text);
+            }
+        }
+        for &s in &stack {
+            all[s].last = i;
+        }
+    }
+    all
+}
+
+/// The last row of the item on `row` and everything under it: the lines after
+/// it that are indented further, blank lines between them included.
+pub fn subtree_end(lines: &[String], row: usize) -> usize {
+    let me = parse(&lines[row]);
+    let mut end = row;
+    let mut fence = false;
+    for (j, text) in lines.iter().enumerate().skip(row + 1) {
+        if fence {
+            fence = !crate::md::is_fence(text);
+            end = j;
+            continue;
+        }
+        let line = parse(text);
+        if line.kind == Kind::Blank {
+            continue;
+        }
+        if line.quote != me.quote || line.width <= me.width {
+            break;
+        }
+        fence = crate::md::is_fence(text);
+        end = j;
+    }
+    end
+}
+
+/// The list the item on `row` is in.
+fn list_of(all: &[List], row: usize) -> Option<&List> {
+    all.iter().find(|l| l.items.contains(&row))
+}
+
+fn item_at(lines: &[String], row: usize) -> Option<Item> {
+    match parse(&lines[row]).kind {
+        Kind::Item(item) => Some(item),
+        _ => None,
+    }
+}
+
+/// Whether the numbered list the item on `row` is in repeats one number
+/// (`1.` on every item): the style to keep going when a new item is added.
+pub fn repeats_number(lines: &[String], row: usize) -> bool {
+    let all = lists(lines);
+    match list_of(&all, row) {
+        Some(l) if l.ordered => repeating(lines, &l.items),
+        _ => false,
+    }
+}
+
+fn repeating(lines: &[String], rows: &[usize]) -> bool {
+    let mut nums = rows.iter().filter_map(|&r| item_at(lines, r)).map(|i| i.num);
+    let Some(first) = nums.next() else {
+        return false;
+    };
+    rows.len() > 1 && nums.all(|n| n == first)
+}
+
+/// Where a column on a row lands after an edit to that row: from `at` on,
+/// columns move by `delta` (but never back past `at`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Shift {
+    pub row: usize,
+    pub at: usize,
+    pub delta: isize,
+}
+
+impl Shift {
+    pub fn apply(&self, col: usize) -> usize {
+        if col < self.at {
+            col
+        } else {
+            col.saturating_add_signed(self.delta).max(self.at)
+        }
+    }
+}
+
+fn chars_to(line: &str, byte: usize) -> usize {
+    line[..byte].chars().count()
+}
+
+/// Write `num` over the digits of the item on `row`.
+fn set_number(lines: &mut [String], row: usize, num: u64) -> Option<Shift> {
+    let item = item_at(lines, row)?;
+    if !item.ordered || item.num == num {
+        return None;
+    }
+    let digits = num.to_string();
+    let delta = digits.len() as isize - (item.end - item.at) as isize;
+    let at = if delta >= 0 { item.end } else { item.at + digits.len() };
+    let at = chars_to(&lines[row], at);
+    lines[row].replace_range(item.at..item.end, &digits);
+    Some(Shift { row, at, delta })
+}
+
+/// What decides whether an edit to a line can have moved a number: the line's
+/// place in a list, not its words.
+fn shape(line: &str) -> (usize, usize, Option<(bool, char, u64)>) {
+    let p = parse(line);
+    let item = match p.kind {
+        Kind::Item(i) => Some((i.ordered, i.delim, i.num)),
+        _ => None,
+    };
+    (p.quote, p.width, item)
+}
+
+/// Put the numbers of the ordered lists an edit touched back in order. `before`
+/// is the buffer as it was; `lines` is the buffer as the edit left it.
+///
+/// A list counts from the number it starts at, so `5. 6. 7.` stays at 5, and a
+/// list whose items all carry one number (`1.` throughout) is left alone. A
+/// list the edit did not reach is left alone too.
+pub fn renumber_after(before: &[String], lines: &mut [String]) -> Vec<Shift> {
+    let (nb, na) = (before.len(), lines.len());
+    let mut p = 0;
+    while p < nb.min(na) && before[p] == lines[p] {
+        p += 1;
+    }
+    if p == nb && p == na {
+        return Vec::new();
+    }
+    let mut s = 0;
+    while s < nb.min(na) - p && before[nb - 1 - s] == lines[na - 1 - s] {
+        s += 1;
+    }
+    let new_end = na - s;
+    if na == nb && (p..new_end).all(|r| shape(&before[r]) == shape(&lines[r])) {
+        return Vec::new();
+    }
+    if na == 0 {
+        return Vec::new();
+    }
+    // the rows an edit can have changed the numbering around: the changed
+    // ones and the line either side of them
+    let (lo, hi) = (p.saturating_sub(1), new_end.min(na - 1));
+    let new_lists = lists(lines);
+    let mut old_lists: Option<Vec<List>> = None;
+    let mut shifts = Vec::new();
+    for list in &new_lists {
+        if !list.ordered || !list.items.iter().any(|r| (lo..=hi).contains(r))
+        {
+            continue;
+        }
+        // told apart from the new ones by what they were before the edit
+        let untouched: Vec<usize> = list
+            .items
+            .iter()
+            .copied()
+            .filter(|r| !(p..new_end).contains(r))
+            .collect();
+        if repeating(lines, if untouched.len() >= 2 { &untouched } else { &list.items }) {
+            continue;
+        }
+        let first = list.items[0];
+        let mut start = item_at(lines, first).map_or(0, |i| i.num);
+        // a first item that was moved or deleted takes the old start with it
+        if (p..=new_end).contains(&first) {
+            let old = old_lists.get_or_insert_with(|| lists(before));
+            let row = if first >= new_end { first + nb - na } else { p };
+            // unless one line was edited where it stands: a number being
+            // retyped is the list's new start, not an item that went away
+            let retyped = nb == na && new_end - p == 1;
+            let old_list = old.iter().find(|o| {
+                !retyped
+                    && o.ordered == list.ordered
+                    && o.delim == list.delim
+                    && o.quote == list.quote
+                    && o.width == list.width
+                    && o.items[0] >= p
+                    && o.items[0] <= row
+                    && row <= o.last
+            });
+            if let Some(o) = old_list {
+                let body = |ls: &[String], r: usize| {
+                    item_at(ls, r).map(|i| ls[r][i.end..].to_string())
+                };
+                let survived = o.items.iter().any(|&r| body(before, r) == body(lines, first));
+                if survived {
+                    start = item_at(before, o.items[0]).map_or(start, |i| i.num);
+                }
+            }
+        }
+        for (k, &row) in list.items.iter().enumerate() {
+            if let Some(shift) = set_number(lines, row, start.saturating_add(k as u64)) {
+                shifts.push(shift);
+            }
+        }
+    }
+    shifts
+}
+
+/// Nest the items on `from..=to` under the item above each, taking whatever is
+/// nested in them along. An item with nothing above it in its list stays.
+/// Returns where the lines' columns moved; empty when nothing did.
+pub fn indent(lines: &mut [String], from: usize, to: usize, tab: usize) -> Vec<Shift> {
+    let all = lists(lines);
+    let mut moved: Vec<(usize, usize, String)> = Vec::new();
+    let mut covered = 0;
+    for r in from..=to.min(lines.len().saturating_sub(1)) {
+        if r < covered {
+            continue;
+        }
+        let Some(list) = list_of(&all, r) else {
+            continue;
+        };
+        let k = list.items.iter().position(|&x| x == r).unwrap();
+        if k == 0 {
+            continue;
+        }
+        let prev = list.items[k - 1];
+        // follow the way the item above already nests its own, if it does
+        let raw = |row: usize| {
+            let p = parse(&lines[row]);
+            lines[row][p.prefix..p.prefix + p.indent].to_string()
+        };
+        let parent_indent = raw(prev);
+        let add = all
+            .iter()
+            .find(|l| l.parent == Some(prev))
+            .map(|l| raw(l.items[0]))
+            .and_then(|child| child.strip_prefix(&parent_indent).map(String::from))
+            .filter(|a| !a.is_empty())
+            .unwrap_or_else(|| " ".repeat(tab.max(1)));
+        let end = subtree_end(lines, r);
+        covered = end + 1;
+        moved.push((r, end, add));
+    }
+    let mut shifts = Vec::new();
+    for (r, end, add) in &moved {
+        for row in *r..=*end {
+            let p = parse(&lines[row]);
+            if p.kind == Kind::Blank {
+                continue;
+            }
+            let at = p.prefix + p.indent;
+            lines[row].insert_str(at, add);
+            shifts.push(Shift {
+                row,
+                at: chars_to(&lines[row], at),
+                delta: add.chars().count() as isize,
+            });
+        }
+    }
+    // an item that now opens a list of its own starts it at 1
+    let all = lists(lines);
+    for (r, _, _) in &moved {
+        if list_of(&all, *r).is_some_and(|l| l.items[0] == *r) {
+            shifts.extend(set_number(lines, *r, 1));
+        }
+    }
+    shifts
+}
+
+/// Bring the items on `from..=to` out one level, to where the item they are
+/// nested under stands, with whatever is nested in them. Whatever followed them
+/// in their list stays where it was, and so is now under them.
+pub fn outdent(lines: &mut [String], from: usize, to: usize, tab: usize) -> Vec<Shift> {
+    let all = lists(lines);
+    let mut moved: Vec<(usize, usize, usize)> = Vec::new();
+    let mut covered = 0;
+    for r in from..=to.min(lines.len().saturating_sub(1)) {
+        if r < covered {
+            continue;
+        }
+        let p = parse(&lines[r]);
+        if p.indent == 0 || p.kind == Kind::Blank {
+            continue;
+        }
+        let indent = &lines[r][p.prefix..p.prefix + p.indent];
+        let by = match (&p.kind, list_of(&all, r).and_then(|l| l.parent)) {
+            (Kind::Item(_), Some(parent)) => {
+                let q = parse(&lines[parent]);
+                let up = &lines[parent][q.prefix..q.prefix + q.indent];
+                if q.quote == p.quote && indent.starts_with(up) && up.len() < indent.len() {
+                    indent.chars().count() - up.chars().count()
+                } else {
+                    strip_len(indent, tab)
+                }
+            }
+            _ => strip_len(indent, tab),
+        };
+        let end = if matches!(p.kind, Kind::Item(_)) {
+            subtree_end(lines, r)
+        } else {
+            r
+        };
+        covered = end + 1;
+        moved.push((r, end, by));
+    }
+    let mut shifts = Vec::new();
+    for &(r, end, by) in &moved {
+        for row in r..=end {
+            let p = parse(&lines[row]);
+            if p.kind == Kind::Blank {
+                continue;
+            }
+            let ws = &lines[row][p.prefix..p.prefix + p.indent];
+            let take: usize = ws.chars().take(by).map(char::len_utf8).sum();
+            let removed = ws[..take].chars().count();
+            lines[row].replace_range(p.prefix..p.prefix + take, "");
+            if removed > 0 {
+                shifts.push(Shift {
+                    row,
+                    at: chars_to(&lines[row], p.prefix),
+                    delta: -(removed as isize),
+                });
+            }
+        }
+    }
+    // what followed an item out of its list now opens a list under it
+    let all = lists(lines);
+    for &(_, end, _) in &moved {
+        let Some(next) = (end + 1..lines.len()).find(|&j| parse(&lines[j]).kind != Kind::Blank)
+        else {
+            continue;
+        };
+        if moved.iter().any(|&(r, e, _)| (r..=e).contains(&next)) {
+            continue;
+        }
+        if list_of(&all, next).is_some_and(|l| l.items[0] == next) {
+            shifts.extend(set_number(lines, next, 1));
+        }
+    }
+    shifts
+}
+
+/// How much of `indent` a plain outdent takes: a tab, or up to `tab` spaces.
+fn strip_len(indent: &str, tab: usize) -> usize {
+    if indent.starts_with('\t') {
+        1
+    } else {
+        indent.chars().take_while(|c| *c == ' ').count().min(tab.max(1))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn v(text: &str) -> Vec<String> {
+        text.lines().map(String::from).collect()
+    }
+
+    #[test]
+    fn items_and_their_widths() {
+        let p = parse("  12) x");
+        assert_eq!(p.width, 2);
+        assert!(matches!(p.kind, Kind::Item(Item { ordered: true, num: 12, delim: ')', .. })));
+        assert_eq!(parse("\t- x").width, 2);
+        assert_eq!(parse("> 3. x").quote, 1);
+        assert_eq!(parse("3.x").kind, Kind::Other);
+        assert_eq!(parse("  ").kind, Kind::Blank);
+    }
+
+    #[test]
+    fn lists_nest_and_end() {
+        let ls = lists(&v("1. a\n   1. b\n2. c\n\ntext\n1. d"));
+        assert_eq!(ls.len(), 3);
+        assert_eq!(ls[0].items, [0, 2]);
+        assert_eq!(ls[1].items, [1]);
+        assert_eq!(ls[1].parent, Some(0));
+        assert_eq!(ls[2].items, [5]);
+    }
+
+    #[test]
+    fn fenced_code_is_not_a_list() {
+        let ls = lists(&v("```\n1. a\n3. b\n```"));
+        assert!(ls.is_empty());
+    }
+}
