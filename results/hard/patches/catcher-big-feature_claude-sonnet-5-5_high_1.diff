+    fn tracked<R>(&mut self, edit: impl FnOnce(&mut Editor) -> R) -> R {
+        if self.tracking > 0 {
+            return edit(self);
+        }
+        let before = self.lines.clone();
+        self.tracking += 1;
+        let out = edit(self);
+        self.tracking -= 1;
+        let shifts = crate::listnum::renumber_after(&before, &mut self.lines);
+        self.follow_shifts(&shifts);
+        out
+    }
