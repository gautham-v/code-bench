+        let mut e = Editor::new("```\n1. a\n2. b\n```");
+        e.anchor = Some((1, 0));
+        e.cursor = (2, 0);
+        e.delete_selection();
+        assert_eq!(e.text(), "```\n2. b\n```");
+    }
+
+    #[test]
+    fn a_list_numbered_all_ones_stays_that_way() {
+        let ones = "1. a\n1. b\n1. c";
+        let mut e = at(ones, (1, 4));
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n1. b\n1. \n1. c");
+        e.insert_str("new");
+        assert_eq!(e.text(), "1. a\n1. b\n1. new\n1. c");
+        let mut e = at(ones, (2, 4));
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n1. b\n1. c\n1. ");
+        let mut e = Editor::new(ones);
+        e.anchor = Some((0, 0));
+        e.cursor = (1, 0);
+        e.delete_selection();
+        assert_eq!(e.text(), "1. b\n1. c");
+        let mut e = at(ones, (0, 0));
+        e.move_selected_lines(true);
+        assert_eq!(e.text(), "1. b\n1. a\n1. c");
+        // items pasted in take on the list's habit
+        let mut e = at(ones, (2, 4));
+        e.insert_str("\n1. x\n2. y");
+        assert_eq!(e.text(), "1. a\n1. b\n1. c\n1. x\n1. y");
+        // and a list of one, numbered 1, is just a list that has begun
+        let mut e = at("1. a", (0, 4));
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n2. ");
+    }
+
+    #[test]
+    fn tab_nests_an_item_under_the_one_above_with_what_hangs_under_it() {
+        let mut e = at("1. a\n2. b\n   1. x\n   2. y\n3. c", (1, 4));
+        assert!(tab(&mut e));
+        assert_eq!(e.text(), "1. a\n   1. b\n      1. x\n      2. y\n2. c");
+        assert_eq!(e.cursor, (1, 7));
+        e.undo();
+        assert_eq!(e.text(), "1. a\n2. b\n   1. x\n   2. y\n3. c");
+        assert_eq!(e.cursor, (1, 4));
+    }
+
+    #[test]
+    fn tab_carries_on_the_numbers_of_the_list_it_joins() {
+        let mut e = at("1. a\n   1. p\n   2. q\n2. b\n   1. x\n3. c", (3, 3));
+        tab(&mut e);
+        assert_eq!(
+            e.text(),
+            "1. a\n   1. p\n   2. q\n   3. b\n      1. x\n2. c"
+        );
+    }
+
+    #[test]
+    fn tab_follows_the_width_and_bullets_nest_too() {
+        let mut e = at("- a\n- b", (1, 3));
+        e.tab_width = 4;
+        tab(&mut e);
+        assert_eq!(e.text(), "- a\n    - b");
+        let mut e = at("- a\n\t- b\n- c", (2, 0));
+        tab(&mut e);
+        assert_eq!(e.text(), "- a\n\t- b\n\t- c");
+        // under a bullet, two spaces are inside it
+        let mut e = at("- a\n- b", (1, 3));
+        tab(&mut e);
+        assert_eq!(e.text(), "- a\n  - b");
+    }
+
+    #[test]
+    fn a_nested_item_is_far_enough_in_for_markdown_to_nest_it() {
+        // two spaces do not reach the text of `1. a`, so the item would
+        // be its sibling on the page
+        let mut e = at("1. a\n2. b\n10. c", (1, 4));
+        tab(&mut e);
+        assert_eq!(e.text(), "1. a\n   1. b\n2. c");
+        let mut e = at("9. a\n10. b\n11. c", (1, 4));
+        e.tab_width = 8;
+        tab(&mut e);
+        assert_eq!(e.text(), "9. a\n        1. b\n10. c");
+        let mut e = at("10. a\n11. b", (1, 4));
+        tab(&mut e);
+        assert_eq!(e.text(), "10. a\n    1. b");
+    }
+
+    #[test]
+    fn tab_on_the_first_item_has_nowhere_to_go() {
+        let mut e = at("1. a\n2. b", (0, 2));
+        assert!(!tab(&mut e));
+        assert_eq!(e.text(), "1. a\n2. b");
+        // the first of a sublist cannot go deeper either
+        let mut e = at("1. a\n   1. b\n   2. c", (1, 2));
+        assert!(!tab(&mut e));
+        assert_eq!(e.text(), "1. a\n   1. b\n   2. c");
+    }
+
+    #[test]
+    fn tab_outside_a_list_is_still_spaces() {
+        let mut e = at("plain", (0, 5));
+        tab(&mut e);
+        assert_eq!(e.text(), "plain  ");
+        assert!(!back_tab(&mut e));
+        assert_eq!(e.text(), "plain  ");
+    }
+
+    #[test]
+    fn shift_tab_brings_an_item_and_its_children_back_out() {
+        let mut e = at("1. a\n   1. b\n      1. x\n      2. y\n2. c", (1, 7));
+        assert!(back_tab(&mut e));
+        assert_eq!(e.text(), "1. a\n2. b\n   1. x\n   2. y\n3. c");
+        assert_eq!(e.cursor, (1, 4));
+        e.undo();
+        assert_eq!(e.text(), "1. a\n   1. b\n      1. x\n      2. y\n2. c");
+    }
+
+    #[test]
+    fn shift_tab_on_a_last_child_leaves_its_siblings_numbered() {
+        let mut e = at("1. a\n   1. b\n   2. c\n2. d", (2, 6));
+        back_tab(&mut e);
+        assert_eq!(e.text(), "1. a\n   1. b\n2. c\n3. d");
+        // and on one with siblings after it they become its children
+        let mut e = at("1. a\n   1. b\n   2. c\n   3. d\n2. e", (2, 6));
+        back_tab(&mut e);
+        assert_eq!(e.text(), "1. a\n   1. b\n2. c\n   1. d\n3. e");
+    }
+
+    #[test]
+    fn shift_tab_at_the_margin_does_nothing() {
+        let mut e = at("1. a\n2. b", (1, 4));
+        assert!(!back_tab(&mut e));
+        assert_eq!(e.text(), "1. a\n2. b");
+    }
+
+    #[test]
+    fn a_selection_of_items_nests_together() {
+        let mut e = Editor::new("1. a\n2. b\n3. c\n4. d");
+        e.anchor = Some((1, 1));
+        e.cursor = (2, 2);
+        tab(&mut e);
+        assert_eq!(e.text(), "1. a\n   1. b\n   2. c\n2. d");
+        assert_eq!(e.anchor, Some((1, 4)));
+        assert_eq!(e.cursor, (2, 5));
+        back_tab(&mut e);
+        assert_eq!(e.text(), "1. a\n2. b\n3. c\n4. d");
+    }
+
+    #[test]
+    fn nesting_inside_a_nested_list_numbers_its_own_level() {
+        let mut e = at("1. a\n   1. b\n   2. c\n3. d", (2, 6));
+        tab(&mut e);
+        assert_eq!(e.text(), "1. a\n   1. b\n      1. c\n2. d");
+    }
+
+    #[test]
+    fn quoted_lists_number_too() {
+        let mut e = at("> [!note]\n> 1. a\n> 2. b", (1, 6));
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "> [!note]\n> 1. a\n> 2. \n> 3. b");
+        tab(&mut e);
+        assert_eq!(e.text(), "> [!note]\n> 1. a\n>    1. \n> 2. b");
+    }
+
+    #[test]
+    fn enter_then_tab_starts_a_sublist() {
+        let mut e = at("1. a\n2. b", (0, 4));
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n2. \n3. b");
+        assert!(tab(&mut e));
+        assert_eq!(e.text(), "1. a\n   1. \n2. b");
+        assert_eq!(e.cursor, (1, 6));
+        e.insert_str("new");
+        assert_eq!(e.text(), "1. a\n   1. new\n2. b");
+    }
 }
