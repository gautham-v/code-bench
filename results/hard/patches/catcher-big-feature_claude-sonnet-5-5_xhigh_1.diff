+    /// Run `f`, then put right the numbers of the ordered lists it left out of
+    /// step. `always` is for edits that only move lines about. Nested calls
+    /// leave it to the outermost, so a paste is renumbered once, whole.
+    fn renumbering<R>(&mut self, always: bool, f: impl FnOnce(&mut Self) -> R) -> R {
+        if self.in_list_edit {
+            return f(self);
+        }
+        self.in_list_edit = true;
+        let before = self.lines.clone();
+        let out = f(self);
+        self.in_list_edit = false;
+        for r in lists::renumber(&before, &mut self.lines, always) {
+            self.respell(r.row, r.at, r.old, r.new);
+        }
+        out
+    }
+
+    /// Keep the cursor and the selection where they were in the text when
+    /// `old` chars at `at` on `row` have become `new` chars.
+    fn respell(&mut self, row: usize, at: usize, old: usize, new: usize) {
+        for pos in [Some(&mut self.cursor), self.anchor.as_mut()]
+            .into_iter()
+            .flatten()
+        {
+            if pos.0 != row {
+                continue;
+            }
+            if pos.1 >= at + old {
+                pos.1 = pos.1 + new - old;
+            } else if pos.1 > at + new {
+                pos.1 = at + new;
+            }
+        }
+    }
+
+    /// Tab and ⇧Tab on list items: nest each selected item under the one
+    /// above it, or bring it back out, with whatever is under it. `None` when
+    /// no selected line is an item, which leaves the key to the caller; `Some`
+    /// says whether anything moved.
+    fn shift_items(&mut self, back: bool) -> Option<bool> {
+        let rows = self.selected_rows();
+        let shift = if back {
+            lists::unnest(&self.lines, rows, self.tab_width)
+        } else {
+            lists::nest(&self.lines, rows, self.tab_width)
+        };
+        let edits = match shift {
+            lists::Shift::NotAList => return None,
+            lists::Shift::Nowhere => {
+                self.last_kind = None;
+                return Some(false);
