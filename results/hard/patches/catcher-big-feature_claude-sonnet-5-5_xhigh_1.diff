index 0000000..b028650
--- /dev/null
+++ b/src/lists.rs
@@ -0,0 +1,700 @@
+//! Lists as the buffer holds them: which lines are items, how they nest, and
+//! which ones number each other. The editor asks two things of it — put the
+//! numbers right in the list an edit touched, and nest or un-nest an item with
+//! whatever hangs under it — and both are plain functions of the lines.
+//!
+//! Nesting follows indentation alone, the way the editor draws it: an item is
+//! a child of the nearest item above it that is indented less. That is looser
+//! than CommonMark (which wants the child under its parent's text) and is what
+//! the Tab key produces, whatever `tab_width` is.
+
+use crate::md::{self, BlockKind};
+use std::collections::{BTreeSet, HashMap};
+use std::ops::Range;
+
+/// What a list line starts with.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Mark {
+    Bullet,
+    /// `n` and its delimiter; `digits` is where the number sits in the line,
+    /// as a byte range.
+    Number {
+        n: u64,
+        delim: char,
+        digits: Range<usize>,
+    },
+}
+
+/// One list item line.
+#[derive(Clone, Debug)]
+pub struct Item {
+    pub row: usize,
+    /// How many `>` the line is quoted under, and the bytes they take.
+    pub quote: usize,
+    pub prefix: usize,
+    /// The whitespace between the quote and the marker: bytes, and columns
+    /// (a tab counts four).
+    pub ws: usize,
+    pub indent: usize,
+    pub mark: Mark,
+    /// Blank lines sit directly above it.
+    pub gap: bool,
+    pub parent: Option<usize>,
+    pub region: usize,
+}
+
+/// Items that number each other: siblings, in a row, of one kind.
+#[derive(Clone, Debug)]
+pub struct Group {
+    pub items: Vec<usize>,
+    pub nested: bool,
+}
+
+#[derive(Default)]
+pub struct Scan {
+    pub items: Vec<Item>,
+    pub groups: Vec<Group>,
+    /// First and last line of each list, nested lists and the lines that hang
+    /// under items included.
+    pub regions: Vec<(usize, usize)>,
+    pub group_of: Vec<usize>,
+    by_row: HashMap<usize, usize>,
+}
+
+/// The `> ` quote marks a line opens with: how many, and how many bytes.
+fn split_quote(line: &str) -> (usize, usize) {
+    let (mut depth, mut at) = (0, 0);
+    loop {
+        let rest = &line[at..];
+        let ws = rest.len() - rest.trim_start_matches([' ', '\t']).len();
+        if !rest[ws..].starts_with('>') {
+            return (depth, at);
+        }
+        depth += 1;
+        at += ws + 1;
+        if line[at..].starts_with(' ') {
+            at += 1;
+        }
+    }
+}
+
+/// Columns a run of leading whitespace spans.
+fn columns(ws: &str) -> usize {
+    ws.chars().map(|c| if c == '\t' { 4 } else { 1 }).sum()
+}
+
+fn is_blank(rest: &str) -> bool {
+    rest.trim().is_empty()
+}
+
+/// The item a line is, if it is one. `row`, `gap`, `parent` and `region` are
+/// the scan's to fill in.
+pub fn parse_item(line: &str) -> Option<Item> {
+    let (quote, prefix) = split_quote(line);
+    let rest = &line[prefix..];
+    let body = rest.trim_start_matches([' ', '\t']);
+    let ws = rest.len() - body.len();
+    let at = prefix + ws;
+    let mark = if body.starts_with(['-', '*', '+']) && body[1..].starts_with(' ') {
+        Mark::Bullet
+    } else {
+        let digits = body.len() - body.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+        if digits == 0 || digits > 9 {
+            return None;
+        }
+        let delim = body[digits..]
+            .chars()
+            .next()
+            .filter(|c| matches!(c, '.' | ')'))?;
+        if !matches!(body[digits + 1..].chars().next(), Some(' ') | None) {
+            return None;
+        }
+        Mark::Number {
+            n: body[..digits].parse().ok()?,
+            delim,
+            digits: at..at + digits,
+        }
+    };
+    Some(Item {
+        row: 0,
+        quote,
+        prefix,
+        ws,
+        indent: columns(&rest[..ws]),
+        mark,
+        gap: false,
+        parent: None,
+        region: 0,
+    })
+}
+
+impl Item {
+    /// The column its text starts at: what a child has to be indented to
+    /// for markdown to read it as nested.
+    fn content_col(&self) -> usize {
+        let mark = match &self.mark {
+            Mark::Bullet => 1,
+            Mark::Number { digits, .. } => digits.len() + 1,
+        };
+        self.indent + mark + 1
+    }
+
+    pub fn number(&self) -> Option<u64> {
+        match self.mark {
+            Mark::Number { n, .. } => Some(n),
+            Mark::Bullet => None,
+        }
+    }
+
+    fn delim(&self) -> Option<char> {
+        match self.mark {
+            Mark::Number { delim, .. } => Some(delim),
+            Mark::Bullet => None,
+        }
+    }
+}
+
+/// Lines that are not markdown to read lists out of: code, maths, comments,
+/// front matter, tables, rules.
+fn set_apart(lines: &[String]) -> Vec<bool> {
+    let mut apart = vec![false; lines.len()];
+    let from = match crate::notes::front_matter_end(lines.iter().map(String::as_str)) {
+        Some(end) => {
+            apart.iter_mut().take(end + 1).for_each(|a| *a = true);
+            end + 1
+        }
+        None => 0,
+    };
+    for b in md::blocks_from(lines, from) {
+        if b.kind != BlockKind::Callout {
+            apart[b.start..=b.end].iter_mut().for_each(|a| *a = true);
+        }
+    }
+    apart
+}
+
+/// The list being read: where it started, what it is quoted under, and the
+/// items still open to take a child.
+struct Open {
+    region: usize,
+    quote: usize,
+    stack: Vec<usize>,
+    blank: bool,
+    indent: usize,
+}
+
+/// Read the lists out of `lines`.
+pub fn scan(lines: &[String]) -> Scan {
+    let apart = set_apart(lines);
+    let mut s = Scan::default();
+    let mut open: Option<Open> = None;
+    for (row, line) in lines.iter().enumerate() {
+        let (quote, prefix) = split_quote(line);
+        let rest = &line[prefix..];
+        let Some(o) = open.as_mut() else {
+            if !apart[row] {
+                start_item(&mut s, &mut open, line, row);
+            }
+            continue;
+        };
+        if is_blank(rest) {
+            if quote == o.quote {
+                o.blank = true;
+            } else {
+                open = None;
+            }
+            continue;
+        }
+        let indented = rest.starts_with([' ', '\t']);
+        if apart[row] {
+            // a fence or a table under an item belongs to it; one at the
+            // margin ends the list
+            if indented && quote == o.quote {
+                o.blank = false;
+                s.regions[o.region].1 = row;
+            } else {
+                open = None;
+            }
+            continue;
+        }
+        if let Some(item) = parse_item(line) {
+            if item.quote == o.quote {
+                add_item(&mut s, o, item, row);
+            } else {
+                open = None;
+                start_item(&mut s, &mut open, line, row);
+            }
+            continue;
+        }
+        // text: a lazy line of the item above, or a paragraph indented under
+        // it — unless a blank line came first and it is not indented, or it
+        // opens something of its own
+        let col = columns(&rest[..rest.len() - rest.trim_start_matches([' ', '\t']).len()]);
+        let continues = quote == o.quote
+            && if o.blank {
+                col > o.indent
+            } else {
+                indented || crate::fold::heading_level(rest).is_none()
+            };
+        if continues {
+            o.blank = false;
+            s.regions[o.region].1 = row;
+        } else {
+            open = None;
+        }
+    }
+    group(&mut s);
+    s
+}
+
+fn start_item(s: &mut Scan, open: &mut Option<Open>, line: &str, row: usize) {
+    let Some(item) = parse_item(line) else {
+        return;
+    };
+    s.regions.push((row, row));
+    let mut o = Open {
+        region: s.regions.len() - 1,
+        quote: item.quote,
+        stack: Vec::new(),
+        blank: false,
+        indent: 0,
+    };
+    add_item(s, &mut o, item, row);
+    *open = Some(o);
+}
+
+fn add_item(s: &mut Scan, o: &mut Open, mut item: Item, row: usize) {
+    while o
+        .stack
+        .last()
+        .is_some_and(|&t| s.items[t].indent >= item.indent)
+    {
+        o.stack.pop();
+    }
+    item.row = row;
+    item.gap = o.blank;
+    item.parent = o.stack.last().copied();
+    item.region = o.region;
+    o.stack.push(s.items.len());
+    o.blank = false;
+    o.indent = item.indent;
+    s.regions[o.region].1 = row;
+    s.by_row.insert(row, s.items.len());
+    s.items.push(item);
+}
+
+/// Sort the items into the runs that number each other. An item starts a new
+/// one when the kind of marker changes, or when a blank line comes before a
+/// `1.`: that is a list begun again, not the old one carrying on.
+fn group(s: &mut Scan) {
+    let mut open: HashMap<(usize, Option<usize>), usize> = HashMap::new();
+    for (i, it) in s.items.iter().enumerate() {
+        let key = (it.region, it.parent);
+        let joined = open.get(&key).copied().filter(|&g| {
+            let last = &s.items[*s.groups[g].items.last().unwrap()];
+            last.delim() == it.delim() && !(it.gap && it.number() == Some(1))
+        });
+        let g = joined.unwrap_or_else(|| {
+            s.groups.push(Group {
+                items: Vec::new(),
+                nested: it.parent.is_some(),
+            });
+            open.insert(key, s.groups.len() - 1);
+            s.groups.len() - 1
+        });
+        s.groups[g].items.push(i);
+        s.group_of.push(g);
+    }
+}
+
+impl Scan {
+    pub fn item_at(&self, row: usize) -> Option<usize> {
+        self.by_row.get(&row).copied()
+    }
+
+    fn descends(&self, mut i: usize, from: usize) -> bool {
+        while let Some(p) = self.items[i].parent {
+            if p == from {
+                return true;
+            }
+            i = p;
+        }
+        false
+    }
+
+    /// The lines an item takes with it: its own, everything nested under it
+    /// and what is written beneath either, to the next item that is not its.
+    fn subtree(&self, lines: &[String], i: usize) -> Range<usize> {
+        let it = &self.items[i];
+        let mut j = i + 1;
+        while j < self.items.len() && self.items[j].region == it.region && self.descends(j, i) {
+            j += 1;
+        }
+        let mut end = match self.items.get(j) {
+            Some(next) if next.region == it.region => next.row,
+            _ => self.regions[it.region].1 + 1,
+        };
+        while end > it.row + 1 && is_blank(&lines[end - 1][split_quote(&lines[end - 1]).1..]) {
+            end -= 1;
+        }
+        it.row..end
+    }
+
+    /// The item above at the same level, if there is one to nest under.
+    fn previous_sibling(&self, i: usize) -> Option<usize> {
+        let it = &self.items[i];
+        let k = (0..i)
+            .rev()
+            .take_while(|&k| self.items[k].region == it.region)
+            .find(|&k| self.items[k].indent <= it.indent)?;
+        (self.items[k].indent == it.indent).then_some(k)
+    }
+}
+
+/// A number rewritten: on `row`, the `old` chars at char column `at` are now
+/// `new` chars long. The editor moves its cursor by the difference.
+pub struct Respell {
+    pub row: usize,
+    pub at: usize,
+    pub old: usize,
+    pub new: usize,
+}
+
+/// What a line is as far as its list is concerned, for telling an edit that
+/// reshaped a list from one that only typed in an item.
+fn shape(line: &str) -> Option<(usize, usize, Option<char>)> {
+    parse_item(line).map(|it| (it.quote, it.indent, it.delim()))
+}
+
+/// Put the numbers right in the ordered lists that `after` has and `before`
+/// did not: the edit between them is found by comparing the two. Only lists
+/// the edit touched are looked at, and each keeps its own habits — the number
+/// it started at, and `1. 1. 1.` if that is how it was numbered. `always`
+/// says the edit moved lines about, which can need renumbering even though
+/// every line is the same kind as before.
+pub fn renumber(before: &[String], after: &mut [String], always: bool) -> Vec<Respell> {
+    let common = before
+        .iter()
+        .zip(after.iter())
+        .take_while(|(a, b)| a == b)
+        .count();
+    let tail = before[common..]
+        .iter()
+        .rev()
+        .zip(after[common..].iter().rev())
+        .take_while(|(a, b)| a == b)
+        .count();
+    // the edit, as the lines it left in `after` and the ones it replaced
+    let (from, to) = (common, after.len() - tail);
+    let was_to = before.len() - tail;
+    if from == to && from == was_to {
+        return Vec::new();
+    }
+    if !always
+        && before.len() == after.len()
+        && (from..to).all(|r| shape(&before[r]) == shape(&after[r]))
+    {
+        return Vec::new();
+    }
+    // most edits are prose beside prose: no need to read the lists for those
+    let near_item = |lines: &[String], end: usize| {
+        (from.saturating_sub(1)..=end)
+            .filter_map(|r| lines.get(r))
+            .any(|l| parse_item(l).is_some())
+    };
+    if !near_item(before, was_to) && !near_item(after, to) {
+        return Vec::new();
+    }
+    let (was, now) = (scan(before), scan(after));
+    let first_rows: HashMap<usize, usize> = was
+        .groups
+        .iter()
+        .enumerate()
+        .filter(|(_, g)| was.items[g.items[0]].number().is_some())
+        .map(|(g, grp)| (was.items[grp.items[0]].row, g))
+        .collect();
+    let touched: BTreeSet<usize> = (from.saturating_sub(1)..=to)
+        .filter_map(|row| now.item_at(row))
+        .map(|i| now.group_of[i])
+        .collect();
+    let mut out = Vec::new();
+    for g in touched {
+        let group = &now.groups[g];
+        let first = &now.items[group.items[0]];
+        let Some(have) = first.number() else {
+            continue;
+        };
+        let nums: Vec<u64> = group
+            .items
+            .iter()
+            .map(|&i| now.items[i].number().unwrap())
+            .collect();
+        // the list this one was before the edit: the one an item the edit
+        // left alone was in, else the one that began on the same line
+        let pre_row = |row: usize| match row {
+            r if r < from => Some(r),
+            r if r >= to => Some(r + was_to - to),
+            _ => None,
+        };
+        let through_item = group
+            .items
+            .iter()
+            .find_map(|&i| pre_row(now.items[i].row).and_then(|r| was.item_at(r)))
+            .map(|i| was.group_of[i]);
+        let kin = through_item.or_else(|| first_rows.get(&first.row).copied());
+        let kin = kin.map(|g| &was.groups[g]).filter(|g| {
+            let old = &was.items[g.items[0]];
+            old.delim() == first.delim() && old.quote == first.quote
+        });
+        // it carries on as that list unless the edit split it, cutting this
+        // part off from the item the numbers began at
+        let kin = kin.filter(|g| {
+            let head = was.items[g.items[0]].row;
+            pre_row(first.row) == Some(head) || (from..=was_to).contains(&head)
+        });
+        let (start, constant) = match kin {
+            Some(g) => {
+                let seen: Vec<u64> = g
+                    .items
+                    .iter()
+                    .map(|&i| was.items[i].number().unwrap())
+                    .collect();
+                (
+                    seen[0],
+                    seen.len() > 1 && seen.iter().all(|&n| n == seen[0]),
+                )
+            }
+            // a list begun by this edit; one numbered all alike was meant so
+            None if nums.len() > 1 && nums.iter().all(|&n| n == nums[0]) => continue,
+            None => (if group.nested { 1 } else { have }, false),
+        };
+        for (k, &i) in group.items.iter().enumerate() {
+            let want = if constant { start } else { start + k as u64 };
+            let item = &now.items[i];
+            let Mark::Number { n, digits, .. } = &item.mark else {
+                continue;
+            };
+            if *n == want {
+                continue;
+            }
+            let line = &mut after[item.row];
+            out.push(Respell {
+                row: item.row,
+                at: line[..digits.start].chars().count(),
+                old: digits.len(),
+                new: want.to_string().len(),
+            });
+            line.replace_range(digits.clone(), &want.to_string());
+        }
+    }
+    out
+}
+
+/// One change to a line: `removed` chars at char column `at` become `added`.
+pub struct Splice {
+    pub row: usize,
+    pub at: usize,
+    pub removed: usize,
+    pub added: String,
+}
+
+pub enum Shift {
+    /// None of the lines is a list item.
+    NotAList,
+    /// They are, and there is nowhere for them to go.
+    Nowhere,
+    Edits(Vec<Splice>),
+}
+
+/// The items among `rows` that no other item among them is the parent of:
+/// moving those moves the rest.
+fn tops(s: &Scan, rows: (usize, usize)) -> Vec<usize> {
+    let picked: Vec<usize> = (rows.0..=rows.1).filter_map(|r| s.item_at(r)).collect();
+    picked
+        .iter()
+        .copied()
+        .filter(|&i| !picked.iter().any(|&p| s.descends(i, p)))
+        .collect()
+}
+
+fn leading_ws(line: &str, it: &Item) -> String {
+    line[it.prefix..it.prefix + it.ws].to_string()
+}
+
+/// Nest the items on `rows` one level under the item above them, `width`
+/// spaces in (a tab, in a list that is indented with them) or as far as that
+/// item's text, if that is further. Whatever is under an item goes the same
+/// way.
+pub fn nest(lines: &[String], rows: (usize, usize), width: usize) -> Shift {
+    let s = scan(lines);
+    let tops = tops(&s, rows);
+    let Some(&first) = tops.first() else {
+        return Shift::NotAList;
+    };
+    let Some(above) = s.previous_sibling(first) else {
+        return Shift::Nowhere;
+    };
+    let region = s.items[first].region;
+    let tabbed = s
+        .items
+        .iter()
+        .filter(|it| it.region == region)
+        .any(|it| lines[it.row][it.prefix..it.prefix + it.ws].contains('\t'));
+    // `width` spaces, but never fewer than reach the text of the item it goes
+    // under: `  1. b` is not inside `1. a` as far as markdown is concerned
+    let reach = s.items[above]
+        .content_col()
+        .saturating_sub(s.items[first].indent);
+    let unit = if tabbed {
+        "\t".to_string()
+    } else {
+        " ".repeat(width.max(reach).max(1))
+    };
+    let mut edits = Vec::new();
+    for i in tops {
+        for row in s.subtree(lines, i) {
+            let (_, prefix) = split_quote(&lines[row]);
+            if !is_blank(&lines[row][prefix..]) {
+                edits.push(Splice {
+                    row,
+                    at: lines[row][..prefix].chars().count(),
+                    removed: 0,
+                    added: unit.clone(),
+                });
+            }
+        }
+    }
+    Shift::Edits(edits)
+}
+
+/// Bring the items on `rows` back out to the level of their parent, and
+/// whatever is under them with them. An item with no parent loses up to
+/// `width` spaces of indent, or a tab.
+pub fn unnest(lines: &[String], rows: (usize, usize), width: usize) -> Shift {
+    let s = scan(lines);
+    let tops = tops(&s, rows);
+    if tops.is_empty() {
+        return Shift::NotAList;
+    }
+    let mut edits = Vec::new();
+    for i in tops {
+        let it = &s.items[i];
+        let line = &lines[it.row];
+        let old = leading_ws(line, it);
+        let new = match it.parent {
+            Some(p) => leading_ws(&lines[s.items[p].row], &s.items[p]),
+            None if old.starts_with('\t') => old[1..].to_string(),
+            None => old[old.len().min(width.max(1))..].to_string(),
+        };
+        if new == old {
+            continue;
+        }
+        let gone = columns(&old).saturating_sub(columns(&new));
+        for row in s.subtree(lines, i) {
+            let (_, prefix) = split_quote(&lines[row]);
+            let (at, removed, added) = if row == it.row {
+                (prefix, old.chars().count(), new.clone())
+            } else {
+                let ws = lines[row][prefix..].len()
+                    - lines[row][prefix..].trim_start_matches([' ', '\t']).len();
+                let mut taken = 0;
+                let n = lines[row][prefix..prefix + ws]
+                    .chars()
+                    .take_while(|&c| {
+                        let w = if c == '\t' { 4 } else { 1 };
+                        taken += w;
+                        taken <= gone
+                    })
+                    .count();
+                (prefix, n, String::new())
+            };
+            if removed > 0 || !added.is_empty() {
+                edits.push(Splice {
+                    row,
+                    at: lines[row][..at].chars().count(),
+                    removed,
+                    added,
+                });
+            }
+        }
+    }
+    if edits.is_empty() {
+        Shift::Nowhere
+    } else {
+        Shift::Edits(edits)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lines(text: &str) -> Vec<String> {
+        text.lines().map(String::from).collect()
+    }
+
+    /// What `after` becomes once `renumber` has seen it, `before` being the
+    /// buffer ahead of the edit.
+    fn fixed(before: &str, after: &str, always: bool) -> String {
+        let mut after = lines(after);
+        renumber(&lines(before), &mut after, always);
+        after.join("\n")
+    }
+
+    #[test]
+    fn items_nest_by_indent_and_number_in_their_own_run() {
+        let s = scan(&lines("1. a\n   1. b\n   2. c\n2. d\n- e\n3. f"));
+        let parents: Vec<_> = s.items.iter().map(|i| i.parent).collect();
+        assert_eq!(parents, [None, Some(0), Some(0), None, None, None]);
+        let runs: Vec<Vec<usize>> = s.groups.iter().map(|g| g.items.clone()).collect();
+        // a and d number each other, the bullet breaks the run, f starts one
+        assert_eq!(runs, [vec![0, 3], vec![1, 2], vec![4], vec![5]]);
+    }
+
+    #[test]
+    fn a_blank_line_then_a_one_starts_a_list_again() {
+        let s = scan(&lines("1. a\n2. b\n\n1. c\n\n3. d"));
+        let runs: Vec<Vec<usize>> = s.groups.iter().map(|g| g.items.clone()).collect();
+        assert_eq!(runs, [vec![0, 1], vec![2, 3]]);
+    }
+
+    #[test]
+    fn code_and_prose_are_not_items() {
+        let s = scan(&lines("1. a\n```\n2. b\n```\n3. c\n\ntext\n\n4. d"));
+        let rows: Vec<usize> = s.items.iter().map(|i| i.row).collect();
+        assert_eq!(rows, [0, 4, 8]);
+        // the fence ends the first list; the paragraph ends the second
+        assert_eq!(s.regions.len(), 3);
+    }
+
+    #[test]
+    fn an_edit_that_only_types_in_an_item_is_left_alone() {
+        assert_eq!(fixed("1. a\n3. b", "1. ax\n3. b", false), "1. ax\n3. b");
+    }
+
+    #[test]
+    fn a_list_the_edit_did_not_touch_keeps_its_numbers() {
+        let before = "1. a\n2. b\n\ntext\n\n1. x\n3. y";
+        let after = "1. a\n2. b\n3. new\n\ntext\n\n1. x\n3. y";
+        assert_eq!(fixed(before, after, false), after);
+        let after = "1. a\n3. b\n\ntext\n\n1. x\n3. y";
+        assert_eq!(
+            fixed(before, &after.replace("3. b", "3. b\n3. new"), false),
+            "1. a\n2. b\n3. new\n\ntext\n\n1. x\n3. y"
+        );
+    }
+
+    #[test]
+    fn nest_and_unnest_move_the_children_too() {
+        let l = lines("1. a\n2. b\n   1. x\n3. c");
+        let Shift::Edits(e) = nest(&l, (1, 1), 2) else {
+            panic!("expected edits");
+        };
+        let rows: Vec<usize> = e.iter().map(|s| s.row).collect();
+        assert_eq!(rows, [1, 2]);
+        assert!(e.iter().all(|s| s.added == "   " && s.removed == 0));
+        assert!(matches!(nest(&l, (0, 0), 2), Shift::Nowhere));
+        assert!(matches!(unnest(&l, (1, 1), 2), Shift::Nowhere));
+        assert!(matches!(nest(&lines("text"), (0, 0), 2), Shift::NotAList));
+    }
+}
