+            lists::Shift::Edits(edits) => edits,
+        };
+        self.renumbering(true, |e| {
+            e.record(EditKind::Other);
+            for s in edits {
+                let from = e.byte_index((s.row, s.at));
+                let to = e.byte_index((s.row, s.at + s.removed));
+                e.lines[s.row].replace_range(from..to, &s.added);
+                e.respell(s.row, s.at, s.removed, s.added.chars().count());
+            }
+            e.follow_cursor = true;
+            e.last_kind = None;
+        });
+        Some(true)
+    }
