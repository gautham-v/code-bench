+/// Drop the rendered lines a fold hides. A line the renderer made up — the
+/// blank between blocks — goes when the source line after it does.
+fn drop_hidden(lines: &mut Vec<crate::render::PLine>, visible: &crate::fold::Visible) {
+    let mut hidden = vec![false; lines.len()];
+    let mut next: Option<bool> = None;
+    for (i, l) in lines.iter().enumerate().rev() {
+        if let Some(src) = l.src_line {
+            next = Some(visible.is_hidden(src));
+        }
+        hidden[i] = next.unwrap_or(false);
+    }
+    // a trailing blank has nothing after it: it follows what came before
+    let tail = lines
+        .iter()
+        .rposition(|l| l.src_line.is_some())
+        .map_or(0, |i| i + 1);
+    if let Some(last) = lines[..tail].last().and_then(|l| l.src_line) {
+        hidden[tail..]
+            .iter_mut()
+            .for_each(|h| *h = visible.is_hidden(last));
+    }
+    let mut keep = hidden.into_iter().map(|h| !h);
+    lines.retain(|_| keep.next().unwrap_or(true));
+}
+
+/// [`fold_note`] for the reading view's cells.
+fn fold_cells(cells: &mut Vec<PCell>, label: &str, width: usize) {
+    let used = crate::render::cells_width(cells);
+    let need = crate::md::str_width(label) + 2;
+    if used + need > width {
+        return;
+    }
+    let style = dim();
+    let pad = std::iter::repeat(' ').take(width - used - need + 2);
+    cells.extend(pad.chain(label.chars()).map(|ch| PCell {
+        ch,
+        style,
+        link: None,
+        src: None,
+    }));
+}
