+/// Close the folded sections of a rendered page, so the reading view shows a
+/// note the way the editor does: a line `hidden` says is under a fold is not
+/// on the page at all, and a heading `folded` says is closed gets the editor's
+/// `▸ ` in front of it. Both are asked by source line, counted from the top of
+/// the file.
+///
+/// A row with no source line of its own — the blank the renderer puts above a
+/// block, a rail-only row inside a quote — goes with the row after it, and at
+/// the very end of the page with the one before.
+pub fn fold_page(r: &mut Rendered, hidden: impl Fn(usize) -> bool, folded: impl Fn(usize) -> bool) {
+    let mut gone = vec![false; r.lines.len()];
+    let mut after: Option<bool> = None;
+    for (i, line) in r.lines.iter().enumerate().rev() {
+        match line.src_line {
+            Some(l) => {
+                gone[i] = hidden(l);
+                after = Some(gone[i]);
+            }
+            None => gone[i] = after.unwrap_or(false),
+        }
+    }
+    let mut before = false;
+    let mut tail = r.lines.len();
+    for (i, line) in r.lines.iter().enumerate() {
+        if line.src_line.is_some() {
+            before = gone[i];
+            tail = i + 1;
+        }
+    }
+    for g in &mut gone[tail..] {
+        *g = before;
+    }
+    let mut marked = None;
+    for (i, line) in r.lines.iter_mut().enumerate() {
+        let Some(l) = line.src_line.filter(|&l| !gone[i] && folded(l)) else {
+            continue;
+        };
+        // a heading long enough to have been wrapped is marked once
+        if marked == Some(l) {
+            continue;
+        }
+        marked = Some(l);
+        let marker = theme::FOLDED.chars().map(|ch| PCell {
+            ch,
+            style: theme::fold(),
+            link: None,
+            // the first `#`, as in the editor: a click on the marker that
+            // lands in the buffer lands at the start of the line
+            src: Some((l, 0)),
+        });
+        line.cells.splice(0..0, marker);
+    }
+    let mut gone = gone.into_iter();
+    r.lines.retain(|_| !gone.next().unwrap_or(false));
+}
