+/// The page row a source line is on: the row that drew it, or the block it is
+/// inside when it drew nothing of its own (a fence line, a table's rule), or
+/// failing both the first row after it. Every row of a code block or a table
+/// carries the block's first line as its source line, so the cells are asked
+/// first: they know the line each character came from.
+fn row_of_line(rows: &[Row], line: usize) -> Option<usize> {
+    let drew = |r: &Row| r.cells.iter().any(|c| c.src.is_some_and(|(l, _)| l == line));
