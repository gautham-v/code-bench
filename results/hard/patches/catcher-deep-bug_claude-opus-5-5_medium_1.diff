+        .or_else(|| rows.iter().position(|r| r.src_line == Some(line)))
+        .or_else(|| {
+            let block = rows.iter().filter_map(|r| r.src_line).filter(|&l| l < line).max()?;
+            rows.iter().position(|r| r.src_line == Some(block))
+        })
+        .or_else(|| rows.iter().position(|r| r.src_line.is_some_and(|l| l > line)))
