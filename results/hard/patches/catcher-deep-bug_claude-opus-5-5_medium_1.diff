+/// The line of `lines` that reads `text`, nearest to `line` — `line` itself
+/// when it still does, or when no line does any more.
+fn nearest_line(lines: &[String], text: &str, line: usize) -> usize {
+    (0..lines.len())
+        .filter(|&r| lines[r] == text)
+        .min_by_key(|&r| r.abs_diff(line))
+        .unwrap_or(line)
+}
