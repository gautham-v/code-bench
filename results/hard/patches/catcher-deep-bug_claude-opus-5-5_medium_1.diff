+    /// Bring the folds of `path` across a buffer that was swapped wholesale —
+    /// a reload after another program wrote the file, an undo back out of
+    /// one. `old` is the buffer the folds were made on and `lines` the one
+    /// that replaced it. A fold goes where its own heading line went, which
+    /// only the two buffers side by side can say: the text alone cannot tell
+    /// two `## Notes` apart, and the row alone is some other line by now. A
+    /// heading the rewrite changed or removed loses its fold, as in `settle`.
+    pub fn carry(&mut self, path: &Path, old: &[String], lines: &[String], blocks: &[Block]) {
+        let Some(m) = self.by_note.get_mut(path) else {
+            return;
+        };
+        let to = line_map(old, lines);
+        let once = |all: &[String], text: &String| {
+            let mut hits = (0..all.len()).filter(|&r| &all[r] == text);
+            hits.next().filter(|_| hits.next().is_none())
+        };
+        for (row, text) in std::mem::take(m) {
+            let at = to
+                .get(row)
+                .copied()
+                .flatten()
+                .filter(|&r| lines[r] == text)
+                // a section moved past its neighbours is still the same
+                // section, when there is only one line it can be
+                .or_else(|| once(old, &text).and_then(|_| once(lines, &text)));
+            if let Some(at) = at.filter(|&r| hidden_span(lines, blocks, r).is_some()) {
+                m.insert(at, text);
+            }
+        }
+        if m.is_empty() {
+            self.by_note.remove(path);
+        }
+    }
+
+    /// The note at `old` is at `new` now — renamed, or moved to another
+    /// folder. Its folds go with it: they belong to the note, not to what
+    /// its file happens to be called.
+    pub fn rename(&mut self, old: &Path, new: &Path) {
+        if old == new {
+            return;
+        }
+        match self.by_note.remove(old) {
+            Some(m) => {
+                self.by_note.insert(new.to_path_buf(), m);
+            }
+            // whatever was folded in a file that used to have this name
+            None => {
+                self.by_note.remove(new);
+            }
+        }
+    }
+}
+
+/// The most cells the line-matching table may take. Past it — two buffers
+/// that differ over thousands of lines each — nothing in the differing part
+/// is matched and the folds there fall back on their heading text.
+const MAP_LIMIT: usize = 4_000_000;
+
+/// Where each line of `old` is in `new`, or `None` for a line that is not
+/// there any more: the longest run of lines the two share, in order. The
+/// common head and tail are matched directly, so an edit in one place costs
+/// only the lines around it.
+fn line_map(old: &[String], new: &[String]) -> Vec<Option<usize>> {
+    let mut map = vec![None; old.len()];
+    let head = old.iter().zip(new).take_while(|(a, b)| a == b).count();
+    let tail = old[head..]
+        .iter()
+        .rev()
+        .zip(new[head..].iter().rev())
+        .take_while(|(a, b)| a == b)
+        .count();
+    for (i, slot) in map.iter_mut().enumerate().take(head) {
+        *slot = Some(i);
+    }
+    for k in 1..=tail {
+        map[old.len() - k] = Some(new.len() - k);
+    }
+    let a = &old[head..old.len() - tail];
+    let b = &new[head..new.len() - tail];
+    if a.is_empty() || b.is_empty() || a.len().saturating_mul(b.len()) > MAP_LIMIT {
+        return map;
+    }
+    // lcs[i][j]: the longest shared run of a[i..] and b[j..]
+    let w = b.len() + 1;
+    let mut lcs = vec![0u32; (a.len() + 1) * w];
+    for i in (0..a.len()).rev() {
+        for j in (0..b.len()).rev() {
+            lcs[i * w + j] = if a[i] == b[j] {
+                lcs[(i + 1) * w + j + 1] + 1
+            } else {
+                lcs[(i + 1) * w + j].max(lcs[i * w + j + 1])
+            };
+        }
+    }
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() && j < b.len() {
+        if a[i] == b[j] {
+            map[head + i] = Some(head + j);
+            i += 1;
+            j += 1;
+        } else if lcs[(i + 1) * w + j] >= lcs[i * w + j + 1] {
+            i += 1;
+        } else {
+            j += 1;
+        }
+    }
+    map
 }
 
