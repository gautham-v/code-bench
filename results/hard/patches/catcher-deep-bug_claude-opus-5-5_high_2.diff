+    /// note does. Every fold stays on its row and takes the text now there,
+    /// rather than being dropped as a heading somebody edited.
+    pub fn rewritten(&mut self, path: &Path, lines: &[String], blocks: &[Block]) {
+        let Some(m) = self.by_note.get_mut(path) else {
+            return;
+        };
+        let rows: Vec<usize> = m.keys().copied().collect();
+        m.clear();
+        for row in rows {
+            if hidden_span(lines, blocks, row).is_some() {
+                m.insert(row, fold_of(lines, blocks, row));
+            }
+        }
+        if m.is_empty() {
+            self.by_note.remove(path);
+        }
+    }
+
+    /// The note at `old` now lives at `new` — renamed, or moved to another
+    /// folder. Its folds go with it: they are about the note, and the note is
+    /// the same one whatever its file is called.
+    pub fn rename(&mut self, old: &Path, new: &Path) {
+        if old == new {
+            return;
+        }
+        if let Some(m) = self.by_note.remove(old) {
+            self.by_note.insert(new.to_path_buf(), m);
+        }
+    }
+
+    /// Drop every fold of `path`: the note is gone, and a note made later
+    /// under the same name must not open with someone else's sections shut.
+    pub fn forget(&mut self, path: &Path) {
+        self.by_note.remove(path);
+    }
 }
 
