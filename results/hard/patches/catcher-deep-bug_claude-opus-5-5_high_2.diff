+/// Close the folded sections of an already-rendered page, the way the editor
+/// draws them: every row that came from a hidden line is dropped, and a
+/// folded heading gets the `▸ ` marker in front and, where the row has room,
+/// the count of what it hides at its right edge.
+///
+/// Done to the rendered page rather than to the markdown: cutting lines out
+/// of the source would renumber everything under them, and the source lines
+/// the rows carry are what a click on the page is turned back into.
+///
+/// `hidden` says whether a source line is inside a fold; `label` gives what a
+/// folded heading's line says about it, and `None` for every other line. A
+/// row the renderer invented — the blank above a block — goes with the block
+/// under it, so a folded section leaves no gap behind.
+pub fn fold_page(
+    r: &mut Rendered,
+    width: usize,
+    hidden: impl Fn(usize) -> bool,
+    label: impl Fn(usize) -> Option<String>,
+) {
+    let mut drop = vec![false; r.lines.len()];
+    // bottom up, so a row with no source line of its own takes the answer of
+    // the next row down that has one
+    let mut below: Option<bool> = None;
+    for (i, line) in r.lines.iter().enumerate().rev() {
+        if let Some(l) = line.src_line {
+            below = Some(hidden(l));
+        }
+        drop[i] = below.unwrap_or(false);
+    }
+    // rows after the last sourced one have nothing below to ask: they belong
+    // to whatever came before them
+    if let Some(last) = r.lines.iter().rposition(|l| l.src_line.is_some()) {
+        let above = drop[last];
+        drop[last + 1..].iter_mut().for_each(|d| *d = above);
+    }
+    let mut keep = drop.iter().map(|d| !d);
+    r.lines.retain(|_| keep.next().unwrap_or(true));
+
+    let mut marked: Option<usize> = None;
+    for line in &mut r.lines {
+        let Some(src) = line.src_line else { continue };
+        // only the first row a heading drew: a wrapped heading says it once
+        if marked == Some(src) {
+            continue;
+        }
+        let Some(label) = label(src) else { continue };
+        marked = Some(src);
+        line.cells
+            .splice(0..0, str_cells(theme::FOLDED, theme::fold()));
+        let used = cells_width(&line.cells);
+        let need = crate::md::str_width(&label) + 2;
+        if width != usize::MAX && used + need <= width {
+            line.cells
+                .extend(str_cells(&" ".repeat(width - used - need + 2), theme::PLAIN));
+            line.cells.extend(str_cells(&label, theme::marker()));
+        }
+    }
+}
