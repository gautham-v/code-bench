+/// The page row source line `line` is drawn on. A row's own source line is
+/// where its block began — every row of a code fence carries the fence's
+/// first line — so the cells are asked first: they remember the line each
+/// character came from. A line that drew nothing of its own (front matter, a
+/// table's rule) falls back to the block it sits in, and only then to
+/// whatever comes after it.
+fn goto_row(rows: &[Row], line: usize) -> Option<usize> {
+    let drew = |r: &Row| r.cells.iter().any(|c| c.src.is_some_and(|(l, _)| l == line));
+    rows.iter().position(drew).or_else(|| {
+        let block = rows
+            .iter()
+            .filter_map(|r| r.src_line)
+            .filter(|&l| l <= line)
+            .max();
+        match block {
+            Some(b) => rows.iter().position(|r| r.src_line == Some(b)),
+            None => rows.iter().position(|r| r.src_line.is_some()),
+        }
+    })
+}
