diff --git a/crates/squawk-core/src/context/tokens.rs b/crates/squawk-core/src/context/tokens.rs
new file mode 100644
index 0000000..47ed044
--- /dev/null
+++ b/crates/squawk-core/src/context/tokens.rs
@@ -0,0 +1,120 @@
+//! Byte-accurate tokens over a dictation, so context can edit in place and
+//! leave every other byte of what was said alone.
+//!
+//! A token is a whitespace-delimited piece (see [`crate::text::Chunk`]) plus a
+//! `key`: its core lowercased with everything but letters and digits dropped,
+//! set only for plain words. Spoken file names and repo terms are compared by
+//! key, so "status item", "status_item" and "Status-Item" are all `statusitem`.
+
+use crate::text::Chunk;
+
+pub(super) struct Tok {
+    /// The raw piece is `text[start..end]`.
+    pub start: usize,
+    pub end: usize,
+    pub chunk: Chunk,
+    /// Normalised core; empty unless this is a plain, unprotected word.
+    pub key: String,
+    /// A lone `/` (a speech recogniser's way of writing "slash").
+    pub slash: bool,
+}
+
+impl Tok {
+    fn new(text: &str, start: usize, end: usize) -> Tok {
+        let raw = &text[start..end];
+        let chunk = Chunk::parse(raw);
+        let key = if !chunk.is_protected() && is_plain_word(&chunk.core) {
+            norm(&chunk.core)
+        } else {
+            String::new()
+        };
+        Tok {
+            start,
+            end,
+            chunk,
+            key,
+            slash: raw == "/",
+        }
+    }
+
+    pub fn is_word(&self) -> bool {
+        !self.key.is_empty()
+    }
+
+    pub fn core_start(&self) -> usize {
+        self.start + self.chunk.lead.len()
+    }
+
+    pub fn core_end(&self) -> usize {
+        self.core_start() + self.chunk.core.len()
+    }
+
+    /// Nothing stuck to the front of this token that would break a phrase.
+    fn lead_plain(&self) -> bool {
+        self.slash || self.chunk.lead.is_empty()
+    }
+
+    fn trail_plain(&self) -> bool {
+        self.slash || self.chunk.trail.is_empty()
+    }
+}
+
+/// Split on whitespace, keeping byte offsets.
+pub(super) fn tokenize(text: &str) -> Vec<Tok> {
+    let mut toks = Vec::new();
+    let mut start = None;
+    for (i, c) in text.char_indices() {
+        if c.is_whitespace() {
+            if let Some(s) = start.take() {
+                toks.push(Tok::new(text, s, i));
+            }
+        } else if start.is_none() {
+            start = Some(i);
+        }
+    }
+    if let Some(s) = start {
+        toks.push(Tok::new(text, s, text.len()));
+    }
+    toks
+}
+
+/// Are `toks[a]` and `toks[a + 1]` neighbours with no punctuation between
+/// them, so that both can belong to one spoken phrase?
+pub(super) fn adjacent(toks: &[Tok], a: usize) -> bool {
+    a + 1 < toks.len() && toks[a].trail_plain() && toks[a + 1].lead_plain()
+}
+
+/// Letters and digits only, lowercased.
+pub(super) fn norm(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// Letters, digits and the joiners inside a word ("don't", "squawk-core").
+fn is_plain_word(core: &str) -> bool {
+    core.chars().any(char::is_alphanumeric)
+        && core
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '\'' | '’' | '-' | '_'))
+}
+
+pub(super) struct Edit {
+    pub start: usize,
+    pub end: usize,
+    pub text: String,
+}
+
+/// Replace the byte ranges in `edits` (sorted, non-overlapping).
+pub(super) fn splice(text: &str, edits: &[Edit]) -> String {
+    let mut out = String::with_capacity(text.len() + 16);
+    let mut at = 0;
+    for e in edits {
+        out.push_str(&text[at..e.start]);
+        out.push_str(&e.text);
+        at = e.end;
+    }
+    out.push_str(&text[at..]);
+    out
+}
diff --git a/crates/squawk-core/src/context/vocab.rs b/crates/squawk-core/src/context/vocab.rs
new file mode 100644
index 0000000..37b419e
--- /dev/null
+++ b/crates/squawk-core/src/context/vocab.rs
@@ -0,0 +1,1013 @@
+//! What a repo offers: its file list, and its jargon.
+//!
+//! Files come from the git index, parsed directly (no `git` subprocess, so it
+//! works from a GUI app with a bare PATH and takes milliseconds); outside git,
+//! or when the index has nothing for this directory, from a bounded walk.
+//!
+//! Jargon comes from three places: file stems (`status_item`), package names
+//! (`Cargo.toml`, `package.json`, `pyproject.toml`, `go.mod`) and the prose of
+//! README.md / CLAUDE.md / CONTEXT.md / AGENTS.md. Prose is mined for terms
+//! the author clearly *meant* as terms: CamelCase and acronyms, `code spans`,
+//! the title, and proper nouns capitalised in the middle of a sentence and
+//! never written lowercase.
+
+use std::collections::{BTreeSet, HashSet};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant, SystemTime};
+
+use super::RepoVocab;
+
+/// A directory with more files than this (outside git) is not a repo.
+const WALK_MAX_FILES: usize = 50_000;
+const WALK_MAX_DEPTH: usize = 12;
+const WALK_BUDGET: Duration = Duration::from_millis(250);
+/// Above this many tracked files, trust the index instead of checking each
+/// file still exists.
+const VERIFY_MAX_FILES: usize = 60_000;
+const MAX_STEM_WORDS: usize = 20_000;
+const MAX_DOC_BYTES: u64 = 256 * 1024;
+const MAX_MANIFESTS: usize = 64;
+
+/// Never worth mentioning, never worth walking.
+const SKIP_DIRS: &[&str] = &[
+    ".git",
+    ".hg",
+    ".svn",
+    ".idea",
+    ".cache",
+    ".gradle",
+    ".next",
+    ".build",
+    ".tox",
+    ".venv",
+    ".mypy_cache",
+    ".pytest_cache",
+    ".direnv",
+    "node_modules",
+    "target",
+    "dist",
+    "venv",
+    "__pycache__",
+    "Pods",
+    "DerivedData",
+];
+
+const DOC_NAMES: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let files = list_files(cwd);
+    let words = collect_words(cwd, &files);
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words,
+    }
+}
+
+/// What invalidates a cached vocab for `cwd`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Stamp {
+    /// `.git/index` mtime; `None` outside git (or before the first `add`).
+    pub index: Option<SystemTime>,
+    /// How many of the doc files exist, and the newest mtime among them.
+    pub docs: (usize, Option<SystemTime>),
+}
+
+pub(super) fn stamp(cwd: &Path) -> Stamp {
+    let index = find_git(cwd)
+        .and_then(|g| std::fs::metadata(g.gitdir.join("index")).ok())
+        .and_then(|m| m.modified().ok());
+    let mtimes: Vec<SystemTime> = doc_paths(cwd)
+        .iter()
+        .filter_map(|p| std::fs::metadata(p).ok()?.modified().ok())
+        .collect();
+    Stamp {
+        index,
+        docs: (mtimes.len(), mtimes.into_iter().max()),
+    }
+}
+
+// ---------------------------------------------------------------- files ----
+
+pub(super) struct GitRepo {
+    pub worktree: PathBuf,
+    pub gitdir: PathBuf,
+}
+
+/// The repo `cwd` is inside: the nearest ancestor with a `.git` directory, or
+/// a `.git` file (worktrees, submodules) pointing at one.
+pub(super) fn find_git(cwd: &Path) -> Option<GitRepo> {
+    for dir in cwd.ancestors().take(64) {
+        let dotgit = dir.join(".git");
+        let Ok(meta) = std::fs::metadata(&dotgit) else {
+            continue;
+        };
+        if meta.is_dir() {
+            return Some(GitRepo {
+                worktree: dir.to_path_buf(),
+                gitdir: dotgit,
+            });
+        }
+        let text = std::fs::read_to_string(&dotgit).ok()?;
+        let target = text.trim().strip_prefix("gitdir:")?.trim();
+        return Some(GitRepo {
+            worktree: dir.to_path_buf(),
+            gitdir: dir.join(target),
+        });
+    }
+    None
+}
+
+fn list_files(cwd: &Path) -> Vec<String> {
+    if let Some(files) = find_git(cwd).and_then(|repo| tracked_files(cwd, &repo)) {
+        if !files.is_empty() {
+            return files;
+        }
+    }
+    walk(cwd)
+}
+
+/// `git ls-files`, relative to `cwd`: tracked files below it that are still
+/// on disk (a file deleted but not yet `git rm`ed is not worth mentioning).
+fn tracked_files(cwd: &Path, repo: &GitRepo) -> Option<Vec<String>> {
+    let below = cwd.strip_prefix(&repo.worktree).ok()?;
+    let mut prefix = below
+        .components()
+        .map(|c| c.as_os_str().to_str())
+        .collect::<Option<Vec<_>>>()?
+        .join("/");
+    if !prefix.is_empty() {
+        prefix.push('/');
+    }
+    let mut files: Vec<String> = read_index(&repo.gitdir.join("index"))?
+        .into_iter()
+        .filter_map(|p| p.strip_prefix(prefix.as_str()).map(str::to_string))
+        .filter(|p| !p.is_empty())
+        .collect();
+    files.sort_unstable();
+    files.dedup();
+    if files.len() <= VERIFY_MAX_FILES {
+        files.retain(|f| cwd.join(f).symlink_metadata().is_ok());
+    }
+    Some(files)
+}
+
+/// Every non-ignorable file under `cwd`, or nothing at all if there are too
+/// many (or it takes too long): a partial list could make a name look unique
+/// that is not.
+fn walk(cwd: &Path) -> Vec<String> {
+    let deadline = Instant::now() + WALK_BUDGET;
+    let mut files = Vec::new();
+    let mut stack = vec![(cwd.to_path_buf(), String::new(), 0usize)];
+    while let Some((dir, rel, depth)) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let name = entry.file_name();
+            let Some(name) = name.to_str() else {
+                continue;
+            };
+            let path = format!("{rel}{name}");
+            if kind.is_dir() {
+                if depth < WALK_MAX_DEPTH && !SKIP_DIRS.contains(&name) {
+                    stack.push((entry.path(), format!("{path}/"), depth + 1));
+                }
+            } else if kind.is_file() && name != ".DS_Store" {
+                files.push(path);
+            }
+        }
+        if files.len() > WALK_MAX_FILES || Instant::now() > deadline {
+            return Vec::new();
+        }
+    }
+    files.sort_unstable();
+    files
+}
+
+/// The paths in a git index file (versions 2-4). `None` for anything it does
+/// not fully understand: split and sparse indexes, other versions, damage.
+pub(super) fn read_index(path: &Path) -> Option<Vec<String>> {
+    let data = std::fs::read(path).ok()?;
+    // SHA-1 repositories, then SHA-256 ones.
+    parse_index(&data, 20).or_else(|| parse_index(&data, 32))
+}
+
+fn parse_index(data: &[u8], hash: usize) -> Option<Vec<String>> {
+    let be32 = |at: usize| -> Option<u32> {
+        Some(u32::from_be_bytes(data.get(at..at + 4)?.try_into().ok()?))
+    };
+    if data.len() < 12 + hash || &data[..4] != b"DIRC" {
+        return None;
+    }
+    let version = be32(4)?;
+    if !(2..=4).contains(&version) {
+        return None;
+    }
+    let count = be32(8)? as usize;
+    let end = data.len() - hash;
+    let mut pos = 12;
+    let mut names = Vec::new();
+    let mut prev: Vec<u8> = Vec::new();
+    for _ in 0..count {
+        let start = pos;
+        let mode = be32(pos + 24)?;
+        pos += 40 + hash;
+        let flags = u16::from_be_bytes(data.get(pos..pos + 2)?.try_into().ok()?);
+        pos += 2;
+        if version >= 3 && flags & 0x4000 != 0 {
+            pos += 2;
+        }
+        let name = if version == 4 {
+            // Prefix-compressed: drop `strip` bytes of the previous name,
+            // append the NUL-terminated rest.
+            let (strip, used) = varint(data, pos)?;
+            pos += used;
+            let tail = data.get(pos..end)?.iter().position(|&b| b == 0)?;
+            let keep = prev.len().checked_sub(strip)?;
+            let mut name = prev[..keep].to_vec();
+            name.extend_from_slice(&data[pos..pos + tail]);
+            pos += tail + 1;
+            prev.clone_from(&name);
+            name
+        } else {
+            let stored = (flags & 0xfff) as usize;
+            let len = if stored < 0xfff {
+                stored
+            } else {
+                data.get(pos..end)?.iter().position(|&b| b == 0)?
+            };
+            if *data.get(pos + len)? != 0 {
+                return None;
+            }
+            let name = data[pos..pos + len].to_vec();
+            // Entries are NUL-padded to a multiple of eight bytes.
+            pos = start + ((pos + len - start + 8) & !7);
+            name
+        };
+        if pos > end {
+            return None;
+        }
+        // Regular files and symlinks; not gitlinks (submodules) or sparse dirs.
+        if matches!(mode & 0o170000, 0o100000 | 0o120000) {
+            if let Ok(name) = String::from_utf8(name) {
+                names.push(name);
+            }
+        }
+    }
+    // Extensions: skip them, but refuse the ones that make the entry list
+    // incomplete.
+    while pos < end {
+        let sig = data.get(pos..pos + 4)?;
+        if sig == b"link" || sig == b"sdir" {
+            return None;
+        }
+        pos = pos.checked_add(8)?.checked_add(be32(pos + 4)? as usize)?;
+    }
+    (pos == end).then_some(names)
+}
+
+/// Git's offset varint: 7 bits at a time, with a +1 carried into each
+/// continuation.
+fn varint(data: &[u8], at: usize) -> Option<(usize, usize)> {
+    let mut i = at;
+    let mut c = *data.get(i)?;
+    i += 1;
+    let mut value = (c & 0x7f) as usize;
+    while c & 0x80 != 0 {
+        c = *data.get(i)?;
+        i += 1;
+        value = value
+            .checked_add(1)?
+            .checked_mul(128)?
+            .checked_add((c & 0x7f) as usize)?;
+    }
+    Some((value, i - at))
+}
+
+// ---------------------------------------------------------------- words ----
+
+fn collect_words(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut words: BTreeSet<String> = BTreeSet::new();
+    for path in manifest_paths(cwd, files) {
+        package_names(&path, &mut words);
+    }
+    for path in doc_paths(cwd) {
+        if let Some(text) = read_small(&path) {
+            doc_terms(&text, &mut words);
+        }
+    }
+    let mut stems: BTreeSet<String> = BTreeSet::new();
+    for file in files {
+        let name = file.rsplit('/').next().unwrap_or(file);
+        if let Some(stem) = stem_of(name) {
+            stems.insert(stem);
+        }
+    }
+    words.extend(stems.into_iter().take(MAX_STEM_WORDS));
+    words.into_iter().collect()
+}
+
+/// README.md and friends, in `cwd` and the directories above it up to the
+/// repo root.
+fn doc_paths(cwd: &Path) -> Vec<PathBuf> {
+    let top = find_git(cwd).map(|g| g.worktree);
+    let mut paths = Vec::new();
+    for dir in cwd.ancestors().take(8) {
+        for name in DOC_NAMES {
+            let p = dir.join(name);
+            if p.is_file() {
+                paths.push(p);
+            }
+        }
+        if top.as_deref().is_none_or(|t| t == dir) {
+            break;
+        }
+    }
+    paths
+}
+
+fn read_small(path: &Path) -> Option<String> {
+    if std::fs::metadata(path).ok()?.len() > MAX_DOC_BYTES {
+        return None;
+    }
+    std::fs::read_to_string(path).ok()
+}
+
+fn manifest_paths(cwd: &Path, files: &[String]) -> Vec<PathBuf> {
+    files
+        .iter()
+        .filter(|f| {
+            matches!(
+                f.rsplit('/').next(),
+                Some("Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod")
+            )
+        })
+        .take(MAX_MANIFESTS)
+        .map(|f| cwd.join(f))
+        .collect()
+}
+
+/// Crate, npm, Python and Go module names.
+fn package_names(path: &Path, out: &mut BTreeSet<String>) {
+    let Some(text) = read_small(path) else {
+        return;
+    };
+    let file = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+    let mut add = |name: &str| {
+        // `@scope/pkg` and `github.com/you/pkg` are spoken as `pkg`.
+        let name = name.rsplit('/').next().unwrap_or(name).trim();
+        if name.chars().count() >= 2 && is_identifier(name) {
+            out.insert(name.to_string());
+        }
+    };
+    match file {
+        "Cargo.toml" | "pyproject.toml" => {
+            let Ok(doc) = text.parse::<toml::Table>() else {
+                return;
+            };
+            let name_in = |table: Option<&toml::Value>| {
+                table
+                    .and_then(|t| t.get("name"))
+                    .and_then(|n| n.as_str())
+                    .map(str::to_string)
+            };
+            let mut names = vec![
+                name_in(doc.get("package")),
+                name_in(doc.get("lib")),
+                name_in(doc.get("project")),
+                name_in(doc.get("tool").and_then(|t| t.get("poetry"))),
+            ];
+            if let Some(bins) = doc.get("bin").and_then(|b| b.as_array()) {
+                names.extend(bins.iter().map(|b| name_in(Some(b))));
+            }
+            names.into_iter().flatten().for_each(|n| add(&n));
+        }
+        "package.json" => {
+            if let Some(name) = serde_json::from_str::<serde_json::Value>(&text)
+                .ok()
+                .and_then(|v| v.get("name")?.as_str().map(str::to_string))
+            {
+                add(&name);
+            }
+        }
+        "go.mod" => {
+            if let Some(module) = text.lines().find_map(|l| l.trim().strip_prefix("module ")) {
+                add(module.trim().trim_matches('"'));
+            }
+        }
+        _ => {}
+    }
+}
+
+fn is_identifier(s: &str) -> bool {
+    s.chars().next().is_some_and(char::is_alphabetic)
+        && s.chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '_' | '-'))
+}
+
+/// `status_item` for `status_item.rs`. Not dotfiles, not `a.b.c` names, and
+/// not file-naming conventions rather than terms: ALL-CAPS docs (`README`,
+/// `LICENSE`, `CLAUDE`) and plain Title-case names (`Cargo`, `Makefile`).
+fn stem_of(name: &str) -> Option<String> {
+    if name.starts_with('.') {
+        return None;
+    }
+    let (stem, ext) = match name.rsplit_once('.') {
+        Some((s, e)) => (s, Some(e)),
+        None => (name, None),
+    };
+    let edge_ok = |c: Option<char>| c.is_some_and(char::is_alphanumeric);
+    if stem.chars().count() < 2
+        || stem.contains('.')
+        || !edge_ok(stem.chars().next())
+        || !edge_ok(stem.chars().last())
+        || stem.chars().all(|c| c.is_ascii_digit())
+    {
+        return None;
+    }
+    let shouting = !stem.chars().any(char::is_lowercase);
+    let doc_like = ext.is_none_or(|e| matches!(e, "md" | "txt" | "rst" | "adoc"));
+    // `Cargo` (Cargo.toml) and `Button` (Button.tsx) are how files are named,
+    // not how the word is spelled.
+    let title_case = super::jargon::parts_of(stem) == 1
+        && stem.chars().next().is_some_and(char::is_uppercase)
+        && stem.chars().skip(1).all(char::is_lowercase);
+    (!(shouting && doc_like) && !title_case).then(|| stem.to_string())
+}
+
+// ------------------------------------------------------- terms in prose ----
+
