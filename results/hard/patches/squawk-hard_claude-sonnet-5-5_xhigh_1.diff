+    let _without = spawn_named("claude", b_dir.path());
+    std::thread::sleep(Duration::from_millis(1500));
+    with_tty.pty.last_used(3600);
+    let session = detect(&terminal()).expect("a session");
+    assert_eq!(session.pid, with_tty.pid());
+}
