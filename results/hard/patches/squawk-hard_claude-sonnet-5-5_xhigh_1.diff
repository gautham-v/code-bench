+/// What one document has shown so far.
+#[derive(Default)]
+struct Evidence {
+    /// Words written entirely lowercase: a capitalised word that is also in
+    /// here is an ordinary word at the start of a sentence.
+    lower: HashSet<String>,
+    /// Capitalised words seen mid-sentence, and acronyms.
+    singles: Vec<String>,
+    /// Runs of capitalised words: "Claude Code".
+    phrases: Vec<Vec<String>>,
+}
+
+/// Words that never belong at the edge of a name: "The Claude Code" is
+/// "Claude Code".
+const FUNCTION_WORDS: &[&str] = &[
+    "a", "an", "and", "as", "at", "by", "for", "from", "if", "in", "is", "it", "its", "my", "no",
+    "not", "of", "on", "or", "our", "so", "that", "the", "then", "this", "to", "we", "with", "you",
+    "your",
+];
+
+/// Pull terms out of one markdown document.
+fn doc_terms(md: &str, out: &mut BTreeSet<String>) {
+    let mut ev = Evidence::default();
+    let mut in_fence = false;
+    let mut seen_title = false;
+
+    for line in md.lines() {
+        let line = line.trim();
+        if line.starts_with("```") || line.starts_with("~~~") {
+            in_fence = !in_fence;
+            continue;
+        }
+        if in_fence || line.is_empty() {
+            continue;
+        }
+        let rest = line.trim_start_matches('#');
+        let (level, body) = if rest.len() < line.len() && rest.starts_with(' ') {
+            (line.len() - rest.len(), rest.trim())
+        } else {
+            (0, line)
+        };
+        if level == 1 && !seen_title {
+            seen_title = true;
+            title_term(body, out);
+        }
+
+        // Split out `code spans`; the odd pieces are code.
+        let mut prose = String::with_capacity(body.len());
+        for (i, piece) in body.split('`').enumerate() {
+            if i % 2 == 1 {
+                code_term(piece, out);
+                prose.push(' ');
+            } else {
+                prose.push_str(piece);
+            }
+        }
+        scan_prose(&strip_links(&prose), level > 0, &mut ev, out);
+    }
+
+    let ordinary = |w: &str| ev.lower.contains(&w.to_lowercase()) || is_common(w);
+    for word in &ev.singles {
+        if !ordinary(word) {
+            out.insert(word.clone());
+        }
+    }
+    // A phrase of words that all turn up lowercase elsewhere ("Open Source")
+    // is a title, not a name.
+    for phrase in &ev.phrases {
+        if phrase.iter().any(|w| !ordinary(w)) {
+            out.insert(phrase.join(" "));
+        }
+    }
+}
+
+fn is_common(word: &str) -> bool {
+    COMMON.contains(&word.to_lowercase().as_str())
+}
+
+/// The H1 of a README is the project's name: "Squawk", or the part before a
+/// colon or dash in "Squawk: local dictation".
+fn title_term(title: &str, out: &mut BTreeSet<String>) {
+    let first = title
+        .split([':', '—', '–', '|'])
+        .next()
+        .unwrap_or(title)
+        .split(" - ")
+        .next()
+        .unwrap_or(title)
+        .trim()
+        .trim_matches(['*', '_']);
+    if !first.contains(char::is_whitespace)
+        && first.chars().count() >= 3
+        && is_identifier(first)
+        && !first.chars().all(char::is_lowercase)
+        && !COMMON.contains(&first.to_lowercase().as_str())
+    {
+        out.insert(first.to_string());
+    }
+}
+
+/// `claude_code_mode`, `ChatGPT`, `squawk-core` in backticks. Single plain
+/// lowercase words and anything path-like are not terms.
+fn code_term(code: &str, out: &mut BTreeSet<String>) {
+    let code = code.trim();
+    if code.chars().count() >= 3
+        && is_identifier(code)
+        && (code.contains(['_', '-'])
+            || has_mixed_case(code)
+            || code.chars().any(|c| c.is_ascii_digit()))
+    {
+        out.insert(code.to_string());
+    }
+}
+
+fn has_mixed_case(w: &str) -> bool {
+    crate::text::has_inner_case(w) && w.chars().any(char::is_lowercase)
+}
+
+/// `[text](url)` becomes `text`.
+fn strip_links(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut rest = s;
+    while let Some(i) = rest.find("](") {
+        let Some(close) = rest[i..].find(')') else {
+            break;
+        };
+        out.push_str(&rest[..i]);
+        out.push(' ');
+        rest = &rest[i + close + 1..];
+    }
+    out.push_str(rest);
+    out.replace('[', " ")
+}
+
+/// Walk the words of one line of prose. Records lowercase words, adds terms
+/// that need no further evidence (CamelCase), and collects capitalised words
+/// and runs of them for [`doc_terms`] to judge once it has seen everything.
+fn scan_prose(line: &str, heading: bool, ev: &mut Evidence, out: &mut BTreeSet<String>) {
+    let mut sentence_start = true;
+    // Consecutive capitalised words, and whether each opened a sentence.
+    let mut run: Vec<(String, bool)> = Vec::new();
+    for raw in line.split_whitespace() {
+        let possessive = raw.ends_with("'s") || raw.ends_with("’s");
+        let word = raw
+            .trim_start_matches(|c: char| !c.is_alphanumeric())
+            .trim_end_matches(|c: char| !c.is_alphanumeric());
+        let word = word
+            .strip_suffix("'s")
+            .or_else(|| word.strip_suffix("’s"))
+            .unwrap_or(word);
+        let ends_clause = possessive || raw.ends_with(['.', '!', '?', ':', ';', ',', ')', '—']);
+        let word_ok = word.chars().any(char::is_alphanumeric)
+            && word
+                .chars()
+                .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '\''))
+            && !raw.starts_with('@')
+            && !raw.contains("://");
+
+        let mut capitalised = false;
+        if word_ok {
+            if word == word.to_lowercase() {
+                ev.lower.insert(word.to_string());
+            } else if has_mixed_case(word) && word.chars().count() >= 3 {
+                // GitHub, macOS, ChatGPT: written that way on purpose.
+                out.insert(word.to_string());
+            } else if is_acronym(word) {
+                ev.singles.push(word.to_string());
+                capitalised = !heading;
+            } else if is_title_word(word) {
+                // Headings are Title Case by habit: no evidence in them.
+                capitalised = !heading;
+            }
+        }
+        if capitalised {
+            run.push((word.to_string(), sentence_start));
+        }
+        if !capitalised || ends_clause {
+            flush_run(&mut run, ev);
+        }
+        sentence_start = raw.ends_with(['.', '!', '?', ':']) && !possessive;
+    }
+    flush_run(&mut run, ev);
+}
+
+/// A run of one is a proper noun if it was not just opening a sentence; a run
+/// of two or more is a name, minus function words at either end.
+fn flush_run(run: &mut Vec<(String, bool)>, ev: &mut Evidence) {
+    let items = std::mem::take(run);
+    let is_function = |w: &str| FUNCTION_WORDS.contains(&w.to_lowercase().as_str());
+    let lead = items.iter().take_while(|(w, _)| is_function(w)).count();
+    let mut items = items[lead..].to_vec();
+    while items.last().is_some_and(|(w, _)| is_function(w)) {
+        items.pop();
+    }
+    match items.as_slice() {
+        [] => {}
+        [(word, opens)] => {
+            if (lead > 0 || !opens) && is_title_word(word) {
+                ev.singles.push(word.clone());
+            }
+        }
+        _ => ev.phrases.push(items.into_iter().map(|(w, _)| w).collect()),
+    }
+}
+
+/// `Parakeet`, `Hands-free`: a capital, then no more capitals.
+fn is_title_word(w: &str) -> bool {
+    let mut chars = w.chars();
+    chars.next().is_some_and(char::is_uppercase)
+        && w.chars().count() >= 3
+        && chars.all(|c| !c.is_uppercase())
+        && w.chars().any(char::is_lowercase)
+}
+
+/// `NVIDIA`, `TDT`, `MIT`: three or more capitals (digits allowed).
+fn is_acronym(w: &str) -> bool {
+    w.chars().count() >= 3
+        && w.chars().count() <= 10
+        && w.chars().all(|c| c.is_uppercase() || c.is_ascii_digit())
+        && w.chars().filter(|c| c.is_uppercase()).count() >= 3
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn terms(md: &str) -> Vec<String> {
+        let mut out = BTreeSet::new();
+        doc_terms(md, &mut out);
+        out.into_iter().collect()
+    }
+
+    #[test]
+    fn readme_terms() {
+        let md =
+            "# Squawk\n\nLocal dictation for macOS. Hold fn, talk, let go: the words land in\n\
+                  whatever has focus. Built for talking to Claude Code in a terminal.\n\n\
+                  Everything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3. We never\n\
+                  phone home. NEVER do that. Written in Go and Rust.\n\n\
+                  ## Usage\n\nSet `claude_code_mode` in `config.toml` or run `cargo test`.\n\n\
+                  ```\nSecret Handshake\n```\n\n\
+                  ## License\n\nMIT\n";
+        let got = terms(md);
+        for want in [
+            "Squawk",
+            "macOS",
+            "Claude Code",
+            "NVIDIA",
+            "Parakeet TDT",
+            "TDT",
+            "Mac",
+            "MIT",
+            "claude_code_mode",
+        ] {
+            assert!(got.iter().any(|g| g == want), "{want} missing from {got:?}");
+        }
+        for not in [
+            "Local",
+            "Everything",
+            "Usage",
+            "License",
+            "Go",
+            "NEVER",
+            "Written",
+            "Secret Handshake",
+            "config.toml",
+            "cargo test",
+        ] {
+            assert!(!got.iter().any(|g| g == not), "{not} in {got:?}");
+        }
+    }
+
+    #[test]
+    fn capitalised_words_that_also_appear_lowercase_are_ordinary() {
+        let got = terms("Open the pane. Use the Pane when you can; a pane is a pane.");
+        assert!(got.is_empty(), "{got:?}");
+    }
+
+    #[test]
+    fn stems() {
+        assert_eq!(stem_of("status_item.rs").as_deref(), Some("status_item"));
+        assert_eq!(stem_of("SQLite.swift").as_deref(), Some("SQLite"));
+        assert_eq!(stem_of("audio.rs").as_deref(), Some("audio"));
+        for skip in [
+            "README.md",
+            "LICENSE",
+            "CLAUDE.md",
+            ".gitignore",
+            "jest.config.js",
+            "__init__.py",
+            "a.rs",
+            "Cargo.toml",
+            "Makefile",
+            "Button.tsx",
+        ] {
+            assert_eq!(stem_of(skip), None, "{skip}");
+        }
+        assert_eq!(stem_of("TODO.rs").as_deref(), Some("TODO"));
+    }
+
+    #[test]
+    fn index_round_trip() {
+        // Entries are the fixed 62 bytes + name, NUL-padded to 8.
+        fn entry(name: &str, mode: u32) -> Vec<u8> {
+            let mut e = vec![0u8; 24];
+            e.extend_from_slice(&mode.to_be_bytes());
+            e.extend_from_slice(&[0u8; 12]);
+            e.extend_from_slice(&[7u8; 20]);
+            e.extend_from_slice(&(name.len() as u16).to_be_bytes());
+            e.extend_from_slice(name.as_bytes());
+            let padded = (e.len() + 8) & !7;
+            e.resize(padded, 0);
+            e
+        }
+        let mut data = b"DIRC".to_vec();
+        data.extend_from_slice(&2u32.to_be_bytes());
+        data.extend_from_slice(&3u32.to_be_bytes());
+        data.extend(entry("a.rs", 0o100644));
+        data.extend(entry("sub", 0o160000));
+        data.extend(entry("src/b.rs", 0o120000));
+        data.extend_from_slice(b"TREE");
+        data.extend_from_slice(&2u32.to_be_bytes());
+        data.extend_from_slice(&[1, 2]);
+        data.extend_from_slice(&[0u8; 20]);
+        assert_eq!(parse_index(&data, 20).unwrap(), ["a.rs", "src/b.rs"]);
+        // Garbage, a split index, and a truncated file are all "don't know".
+        assert!(parse_index(b"nope", 20).is_none());
+        let mut split = data.clone();
+        split.truncate(split.len() - 20);
+        split.extend_from_slice(b"link\0\0\0\0");
+        split.extend_from_slice(&[0u8; 20]);
+        assert!(parse_index(&split, 20).is_none());
+        assert!(parse_index(&data[..data.len() - 30], 20).is_none());
+    }
+
+    #[test]
+    fn varint_matches_git() {
+        assert_eq!(varint(&[0x05], 0), Some((5, 1)));
+        assert_eq!(varint(&[0x80, 0x00], 0), Some((128, 2)));
+        assert_eq!(varint(&[0xff, 0x7f], 0), Some((16511, 2)));
+        assert_eq!(varint(&[0x80], 0), None);
+    }
+}
