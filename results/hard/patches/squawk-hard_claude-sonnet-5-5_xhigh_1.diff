+        say(&app, "take a look at status item dot rs"),
+        "Take a look at @src/status_item.rs"
+    );
+    // Three crates have a lib.rs: said bare, it stays words.
+    assert_eq!(
+        say(crates.parent().unwrap(), "open lib dot rs"),
+        "Open lib dot rs."
+    );
+
+    let core = crates.join("squawk-core");
+    assert_eq!(
+        say(&core, "look at context slash mod dot rs"),
+        "Look at @src/context/mod.rs"
+    );
+    // store/mod.rs and context/mod.rs: the folder decides, a wrong one is no answer.
+    assert_eq!(
+        say(&core, "look at store slash mod dot rs"),
+        "Look at @src/store/mod.rs"
+    );
+    assert_eq!(say(&core, "look at mod dot rs"), "Look at mod dot rs.");
+    assert_eq!(
+        say(&core, "look at cleanup dot rs and text dot rs"),
+        "Look at @src/cleanup.rs and @src/text.rs"
+    );
+    assert_eq!(
+        say(&core, "run it from squawk core"),
+        "Run it from squawk-core."
+    );
+}
