+/// The contract in context/mod.rs: a warm `get` is cheap, a cold one is
+/// bounded, `apply` is a few milliseconds. Release builds only; debug
+/// builds are far slower than what ships.
+#[test]
+fn timing_on_a_large_repo() {
+    if cfg!(debug_assertions) || !have_git() {
+        return;
+    }
+    let dir = tempfile::tempdir().unwrap();
+    for d in 0..400 {
+        for f in 0..100 {
+            let p = dir
+                .path()
+                .join(format!("pkg{d}/mod{}/file_{d}_{f}.rs", d % 7));
+            std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+            std::fs::write(p, "").unwrap();
+        }
+    }
+    git(dir.path(), &["init", "-q"]);
+    git(dir.path(), &["add", "-A"]);
+    let mut cache = VocabCache::new();
+    let t = std::time::Instant::now();
+    let vocab = cache.get(dir.path());
+    let cold = t.elapsed();
+    let t = std::time::Instant::now();
+    let _ = cache.get(dir.path());
+    let warm = t.elapsed();
+    let ctx = context(dir.path(), (*vocab).clone());
+    let t = std::time::Instant::now();
+    let out = apply(
+        "please open file 7 dot rs and then the cargo toml and sqlite",
+        &ctx,
+    );
+    let applied = t.elapsed();
+    println!(
+        "{} files: cold {cold:?}, warm {warm:?}, apply {applied:?}: {out}",
+        vocab.files.len()
+    );
+    assert!(cold.as_millis() < 200, "cold get {cold:?}");
+    assert!(warm.as_millis() < 20, "warm get {warm:?}");
+    assert!(applied.as_millis() < 5, "apply {applied:?}");
+}
