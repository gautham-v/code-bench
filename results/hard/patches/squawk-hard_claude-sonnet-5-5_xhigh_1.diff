+
+fn git(dir: &Path, args: &[&str]) {
+    let out = Command::new("git")
+        .args([
+            "-c",
+            "user.name=t",
+            "-c",
+            "user.email=t@t",
+            "-c",
+            "commit.gpgsign=false",
+        ])
+        .args(args)
+        .current_dir(dir)
+        .output()
+        .expect("run git");
+    assert!(
+        out.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
+
+fn write(root: &Path, files: &[(&str, &str)]) {
+    for (path, body) in files {
+        let p = root.join(path);
+        std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+        std::fs::write(p, body).unwrap();
+    }
+}
+
+fn context(root: &Path, vocab: RepoVocab) -> Context {
+    Context {
+        session: Session {
+            agent: Agent::Claude,
+            pid: 1,
+            cwd: root.to_path_buf(),
+            tty: None,
+        },
+        vocab: Arc::new(vocab),
+    }
+}
+
+const WORKSPACE: &[(&str, &str)] = &[
+    (
+        "Cargo.toml",
+        "[workspace]\nmembers = [\"crates/squawk-core\", \"crates/squawk-app\"]\n",
+    ),
+    (
+        "crates/squawk-core/Cargo.toml",
+        "[package]\nname = \"squawk-core\"\nversion = \"0.1.0\"\n",
+    ),
+    (
+        "crates/squawk-app/Cargo.toml",
+        "[package]\nname = \"squawk-app\"\n[[bin]]\nname = \"squawk\"\npath = \"src/main.rs\"\n",
+    ),
+    ("crates/squawk-core/src/lib.rs", ""),
+    ("crates/squawk-core/src/context/mod.rs", ""),
+    ("crates/squawk-core/src/store/mod.rs", ""),
+    ("crates/squawk-app/src/lib.rs", ""),
