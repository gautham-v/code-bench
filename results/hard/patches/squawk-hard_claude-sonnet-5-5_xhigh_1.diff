+/// A pty, and an agent that has its slave side as controlling terminal.
+/// The pty is closed before the agent is reaped: a session leader cannot
+/// finish exiting while its terminal is still held open elsewhere.
+struct PtyAgent {
+    pty: Pty,
+    agent: Spawned,
+}
+
+struct Pty {
+    master: i32,
+    slave: i32,
+    name: PathBuf,
+}
+
+impl PtyAgent {
+    fn start(argv0: &str, cwd: &std::path::Path) -> PtyAgent {
+        let pty = Pty::open();
+        let slave = pty.slave;
+        let mut cmd = Command::new("sleep");
+        cmd.arg0(argv0)
+            .arg("60")
+            .current_dir(cwd)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null());
+        // SAFETY: only async-signal-safe calls between fork and exec.
+        unsafe {
+            cmd.pre_exec(move || {
+                libc::setsid();
+                libc::ioctl(slave, libc::TIOCSCTTY as _, 0);
+                Ok(())
+            });
+        }
+        let child = cmd.spawn().unwrap();
+        wait_for_exec(&child);
+        PtyAgent {
+            pty,
+            agent: Spawned(child),
+        }
+    }
+
+    fn pid(&self) -> i32 {
+        self.agent.0.id() as i32
+    }
+}
+
+impl Pty {
+    fn open() -> Pty {
+        let (mut master, mut slave) = (0, 0);
+        // SAFETY: out parameters only; the optional ones are null.
+        let rc = unsafe {
+            libc::openpty(
+                &mut master,
+                &mut slave,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+            )
+        };
+        assert_eq!(rc, 0, "openpty");
+        // SAFETY: `slave` is a tty, so ttyname returns a NUL-terminated name.
+        let name = unsafe { std::ffi::CStr::from_ptr(libc::ttyname(slave)) };
+        Pty {
+            master,
+            slave,
+            name: PathBuf::from(name.to_str().unwrap()),
+        }
+    }
+
+    /// Pretend the terminal was last used `secs` seconds ago. Real activity
+    /// does move these times, but the kernel stamps them when it gets round
+    /// to it, up to a second or more late, which no test can order reliably.
+    fn last_used(&self, secs: i64) {
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_secs() as i64;
+        let at = libc::timespec {
+            tv_sec: (now - secs) as _,
+            tv_nsec: 0,
+        };
+        let path = std::ffi::CString::new(self.name.to_str().unwrap()).unwrap();
+        // SAFETY: a valid path and a two-element timespec array.
+        let rc = unsafe { libc::utimensat(libc::AT_FDCWD, path.as_ptr(), [at, at].as_ptr(), 0) };
+        assert_eq!(rc, 0, "utimensat {:?}", self.name);
+    }
+}
+
+impl Drop for Pty {
+    fn drop(&mut self) {
+        // SAFETY: closing fds this struct opened.
+        unsafe {
+            libc::close(self.master);
+            libc::close(self.slave);
+        }
+    }
+}
+
+#[test]
+fn the_most_recently_used_tty_wins() {
+    let _turn = serial();
+    let (a_dir, b_dir) = (tempfile::tempdir().unwrap(), tempfile::tempdir().unwrap());
+    let a = PtyAgent::start("claude", a_dir.path());
+    let b = PtyAgent::start("claude", b_dir.path());
+    // Let the kernel finish stamping the new terminals before overriding them.
+    std::thread::sleep(Duration::from_millis(1500));
+
+    a.pty.last_used(100);
+    b.pty.last_used(50);
+    let session = detect(&terminal()).expect("a session");
+    assert_eq!(session.pid, b.pid());
+    assert_eq!(session.tty.as_deref(), Some(b.pty.name.as_path()));
+    assert_eq!(canonical(&session.cwd), canonical(b_dir.path()));
+
+    a.pty.last_used(5);
+    let session = detect(&terminal()).expect("a session");
+    assert_eq!(session.pid, a.pid());
+    assert_eq!(session.tty.as_deref(), Some(a.pty.name.as_path()));
+    assert_eq!(canonical(&session.cwd), canonical(a_dir.path()));
+}
