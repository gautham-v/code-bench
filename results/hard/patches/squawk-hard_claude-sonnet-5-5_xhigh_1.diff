index 0000000..a905af0
--- /dev/null
+++ b/crates/squawk-core/src/context/jargon.rs
@@ -0,0 +1,345 @@
+//! Repo terms, spelled the way the repo spells them.
+//!
+//! A heard word or run of words is a term when its letters and digits add up
+//! to the term's: "sqlite", "SQLITE" and "Sqlite" are `SQLite`; "git hub" is
+//! `GitHub`; "squawk core" is `squawk-core`. A run of several words only
+//! counts when the term itself has that many parts (`GitHub` has two,
+//! `SQLite` one), so ordinary neighbours are not glued together.
+//!
+//! Two kinds of term are left alone because there is nothing to fix:
+//! a plain lowercase word ("audio", "gpui") cannot be improved on whatever
+//! case the speech model gave it ("API" stays "API" even if the repo has an
+//! `api.rs`), and a term whose only part is wrapped in punctuation
+//! (`__init__`) would hijack the plain word inside it.
+
+use std::collections::HashMap;
+
+use super::tokens::{adjacent, norm, splice, tokenize, Edit, Tok};
+use super::RepoVocab;
+
+struct Term<'a> {
+    written: &'a str,
+    /// Words it is made of: `GitHub` is two, `squawk-core` is two.
+    parts: usize,
+}
+
+/// Longest run of heard words considered.
+const MAX_RUN: usize = 6;
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab) -> String {
+    if vocab.words.is_empty() {
+        return text.to_string();
+    }
+    let toks = tokenize(text);
+    // Only the keys this dictation can produce are worth looking up, so the
+    // (possibly huge) vocabulary is filtered against them, not indexed.
+    let wanted = Wanted::of(&toks);
+    if wanted.keys.is_empty() {
+        return text.to_string();
+    }
+    let terms = index(&vocab.words, &wanted);
+    if terms.is_empty() {
+        return text.to_string();
+    }
+    let mut edits: Vec<Edit> = Vec::new();
+    let mut i = 0;
+    while i < toks.len() {
+        let Some((len, term, tail)) = find(&toks, i, &terms) else {
+            i += 1;
+            continue;
+        };
+        let last = i + len - 1;
+        let start = toks[i].core_start();
+        let end = toks[last].core_end() - tail;
+        let mut written = term.written.to_string();
+        // A term that starts lowercase still opens a sentence with a capital.
+        let opens = i == 0 || toks[i - 1].chunk.ends_sentence();
+        let heard_capital = text[start..].chars().next().is_some_and(char::is_uppercase);
+        if opens
+            && heard_capital
+            && !crate::text::has_inner_case(&written)
+            && written.chars().next().is_some_and(char::is_lowercase)
+        {
+            written = crate::text::capitalize(&written);
+        }
+        if text[start..end] != written {
+            edits.push(Edit {
+                start,
+                end,
+                text: written,
+            });
+        }
+        i += len;
+    }
+    if edits.is_empty() {
+        text.to_string()
+    } else {
+        splice(text, &edits)
+    }
+}
+
+/// How many tokens starting at `toks[i]` can be one spoken term: plain words
+/// with nothing between them.
+fn run_len(toks: &[Tok], i: usize) -> usize {
+    if !toks[i].is_word() {
+        return 0;
+    }
+    let mut run = 1;
+    while run < MAX_RUN
+        && i + run < toks.len()
+        && adjacent(toks, i + run - 1)
+        && toks[i + run].is_word()
+    {
+        run += 1;
+    }
+    run
+}
+
+/// The key of the `len` tokens from `toks[i]`, and the byte length of a
+/// possessive ("'s") trailing the last one, which is not part of the term.
+fn window_key(toks: &[Tok], i: usize, len: usize) -> (String, usize) {
+    let mut key: String = toks[i..i + len - 1]
+        .iter()
+        .map(|t| t.key.as_str())
+        .collect();
+    let core = &toks[i + len - 1].chunk.core;
+    let tail = possessive(core);
+    key.push_str(&norm(&core[..core.len() - tail]));
+    (key, tail)
+}
+
+/// The longest term that starts at `toks[i]`: how many tokens it takes, the
+/// term, and the possessive that trails the last token.
+fn find<'a, 'b>(
+    toks: &[Tok],
+    i: usize,
+    terms: &'b HashMap<String, Term<'a>>,
+) -> Option<(usize, &'b Term<'a>, usize)> {
+    for len in (1..=run_len(toks, i)).rev() {
+        let (key, tail) = window_key(toks, i, len);
+        if let Some(term) = terms.get(&key) {
+            if len <= term.parts {
+                return Some((len, term, tail));
+            }
+        }
+    }
+    None
+}
+
+/// Every key a run of heard words could have, with a cheap fingerprint of
+/// (first letter, length) to turn most of a big vocabulary away unread.
+struct Wanted {
+    keys: std::collections::HashSet<String>,
+    seen: [u64; FINGERPRINT_WORDS],
+}
+
+const FINGERPRINT_WORDS: usize = 16;
+
+impl Wanted {
+    fn of(toks: &[Tok]) -> Wanted {
+        let mut wanted = Wanted {
+            keys: std::collections::HashSet::new(),
+            seen: [0; FINGERPRINT_WORDS],
+        };
+        for i in 0..toks.len() {
+            for len in 1..=run_len(toks, i) {
+                let (key, _) = window_key(toks, i, len);
+                if let Some(first) = key.chars().next() {
+                    let bit = fingerprint(first, key.chars().count());
+                    wanted.seen[bit / 64] |= 1 << (bit % 64);
+                }
+                wanted.keys.insert(key);
+            }
+        }
+        wanted
+    }
+
+    fn may_contain(&self, first: char, len: usize) -> bool {
+        let bit = fingerprint(first, len);
+        self.seen[bit / 64] & (1 << (bit % 64)) != 0
+    }
+}
+
+fn fingerprint(first: char, len: usize) -> usize {
+    (first as usize).wrapping_mul(31).wrapping_add(len) % (FINGERPRINT_WORDS * 64)
+}
+
+/// Letters and digits in `s`, and the first one lowercased.
+fn shape(s: &str) -> Option<(usize, char)> {
+    let mut count = 0;
+    let mut first = None;
+    for c in s.chars().filter(|c| c.is_alphanumeric()) {
+        if first.is_none() {
+            first = c.to_lowercase().next();
+        }
+        count += 1;
+    }
+    first.map(|f| (count, f))
+}
+
+/// Byte length of a trailing `'s` / `’s`.
+fn possessive(core: &str) -> usize {
+    for suffix in ["'s", "’s"] {
+        if core.len() > suffix.len() && core.ends_with(suffix) {
+            return suffix.len();
+        }
+    }
+    0
+}
+
+/// The vocabulary words that could be what was heard, by key.
+fn index<'a>(words: &'a [String], wanted: &Wanted) -> HashMap<String, Term<'a>> {
+    let mut terms: HashMap<String, Term> = HashMap::new();
+    for word in words {
+        let written = word.trim();
+        match shape(written) {
+            Some((len, first)) if len >= 2 && wanted.may_contain(first, len) => {}
+            _ => continue,
+        }
+        let key = norm(written);
+        if !wanted.keys.contains(&key) {
+            continue;
+        }
+        let parts = parts_of(written);
+        if parts == 0 || is_inert(written, parts) || written.contains(['/', '@', '`', ':']) {
+            continue;
+        }
+        // Two spellings of one term: the one with more capitals is the
+        // deliberate one ("GitHub" over "Github").
+        let keep = terms
+            .get(&key)
+            .is_none_or(|old| capitals(written) > capitals(old.written));
+        if keep {
+            terms.insert(key, Term { written, parts });
+        }
+    }
+    terms
+}
+
+fn capitals(s: &str) -> usize {
+    s.chars().filter(|c| c.is_uppercase()).count()
+}
+
+/// Nothing to fix, or nothing safe to fix.
+fn is_inert(written: &str, parts: usize) -> bool {
+    if parts == 1 {
+        // "audio": any case it was heard in is fine. "__init__": would
+        // capture "init".
+        return written.chars().all(char::is_lowercase)
+            || written.chars().any(|c| !c.is_alphanumeric());
+    }
+    false
+}
+
+/// Words a term is made of: split at spaces, `-`, `_`, `.`, a lowercase
+/// letter followed by a capital, and letter/digit changes.
+pub(super) fn parts_of(term: &str) -> usize {
+    let mut parts = 0;
+    let mut prev: Option<char> = None;
+    for c in term.chars() {
+        if !c.is_alphanumeric() {
+            prev = None;
+            continue;
+        }
+        let boundary = match prev {
+            None => true,
+            Some(p) => {
+                (p.is_lowercase() && c.is_uppercase()) || p.is_ascii_digit() != c.is_ascii_digit()
+            }
+        };
+        if boundary {
+            parts += 1;
+        }
+        prev = Some(c);
+    }
+    parts
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn say(words: &[&str], text: &str) -> String {
+        let vocab = RepoVocab {
+            root: PathBuf::from("/code/x"),
+            files: Vec::new(),
+            words: words.iter().map(|w| w.to_string()).collect(),
+        };
+        apply(text, &vocab)
+    }
+
+    #[test]
+    fn casing_and_splits() {
+        let words = [
+            "SQLite",
+            "GitHub",
+            "gpt5",
+            "squawk-core",
+            "Claude Code",
+            "Node.js",
+        ];
+        assert_eq!(say(&words, "we use sqlite here"), "we use SQLite here");
+        assert_eq!(say(&words, "push to git hub, then"), "push to GitHub, then");
+        assert_eq!(say(&words, "the github's api"), "the GitHub's api");
+        assert_eq!(say(&words, "try gpt 5 or GPT5"), "try gpt5 or gpt5");
+        assert_eq!(say(&words, "see squawk core now"), "see squawk-core now");
+        assert_eq!(say(&words, "ask claude code to"), "ask Claude Code to");
+        assert_eq!(say(&words, "run node js"), "run Node.js");
+    }
+
+    #[test]
+    fn lowercase_plain_words_are_inert() {
+        let words = ["audio", "ipc", "__init__", "A"];
+        let text = "The Audio and IPC init a";
+        assert_eq!(say(&words, text), text);
+    }
+
+    #[test]
+    fn multi_word_runs_need_a_multi_part_term() {
+        // "SQLite" is one part: "sql lite" is not it.
+        assert_eq!(say(&["SQLite"], "use sql lite"), "use sql lite");
+        // "in flow" is not "inflow" unless the term has two parts.
+        assert_eq!(say(&["Inflow"], "go in flow"), "go in flow");
+        assert_eq!(say(&["InFlow"], "go in flow"), "go InFlow");
+    }
+
+    #[test]
+    fn protected_chunks_are_not_entered() {
+        let words = ["GitHub"];
+        assert_eq!(
+            say(
+                &words,
+                "see @github/readme.md and github.com/x and `github`"
+            ),
+            "see @github/readme.md and github.com/x and `github`"
+        );
+    }
+
+    #[test]
+    fn sentence_start_keeps_its_capital() {
+        let words = ["squawk-core", "Squawk"];
+        assert_eq!(
+            say(&words, "It broke. Squawk core is fine"),
+            "It broke. Squawk-core is fine"
+        );
+        assert_eq!(say(&words, "so squawk core"), "so squawk-core");
+        assert_eq!(say(&words, "squawk is it"), "Squawk is it");
+    }
+
+    #[test]
+    fn two_spellings_the_deliberate_one_wins() {
+        assert_eq!(say(&["Github", "GitHub"], "on github"), "on GitHub");
+    }
+
+    #[test]
+    fn parts() {
+        assert_eq!(parts_of("GitHub"), 2);
+        assert_eq!(parts_of("SQLite"), 1);
+        assert_eq!(parts_of("squawk-core"), 2);
+        assert_eq!(parts_of("gpt5"), 2);
+        assert_eq!(parts_of("launch_at_login"), 3);
+        assert_eq!(parts_of("Claude Code"), 2);
+        assert_eq!(parts_of("--"), 0);
