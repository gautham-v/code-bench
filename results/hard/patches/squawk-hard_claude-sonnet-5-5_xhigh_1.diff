+        ];
+        assert_eq!(say(files, "edit dot gitignore"), "edit @.gitignore");
+        assert_eq!(
+            say(files, "edit dot github slash workflows slash ci dot yml"),
+            "edit @.github/workflows/ci.yml"
+        );
+        assert_eq!(
+            say(files, "edit jest dot config dot js"),
+            "edit @jest.config.js"
+        );
+        assert_eq!(say(files, "edit jest config js"), "edit jest config js");
+    }
+
+    #[test]
+    fn the_longer_name_wins() {
+        let files = &["src/audio.rs", "src/mic_audio.rs"];
+        assert_eq!(
+            say(files, "open mic audio dot rs"),
+            "open @src/mic_audio.rs"
+        );
+        assert_eq!(say(files, "open the audio dot rs"), "open @src/audio.rs");
+    }
+
+    #[test]
+    fn punctuation_and_protected_chunks() {
+        assert_eq!(
+            say(REPO, "Look at audio dot rs, then lib dot rs."),
+            "Look at @src/audio.rs, then @src/lib.rs"
+        );
+        assert_eq!(
+            say(REPO, "Why is audio dot rs slow?"),
+            "Why is @src/audio.rs slow?"
+        );
+        assert_eq!(
+            say(REPO, "Fix audio dot rs. Then lib dot rs."),
+            "Fix @src/audio.rs. Then @src/lib.rs"
+        );
+        // Chunks that are already files or mentions are not touched.
+        assert_eq!(
+            say(REPO, "see audio.rs and @src/lib.rs"),
+            "see audio.rs and @src/lib.rs"
+        );
+        assert_eq!(say(REPO, "(status item dot rs)"), "(@src/status_item.rs)");
+        // Punctuation inside the phrase breaks it.
+        assert_eq!(say(REPO, "status, item dot rs"), "status, item dot rs");
+    }
+
+    #[test]
+    fn paths_with_spaces_are_left_alone() {
+        assert_eq!(say(REPO, "open my notes dot md"), "open my notes dot md");
+    }
+
+    #[test]
+    fn whitespace_is_kept_where_nothing_changed() {
+        assert_eq!(
+            say(REPO, "a  b   audio dot rs  c"),
+            "a  b   @src/audio.rs  c"
+        );
+        assert_eq!(say(REPO, "a  b   c"), "a  b   c");
+    }
+}
