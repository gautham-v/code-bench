diff --git a/crates/squawk-core/src/context/mentions.rs b/crates/squawk-core/src/context/mentions.rs
new file mode 100644
index 0000000..7b61809
--- /dev/null
+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,443 @@
+//! Spoken file names to `@mentions`.
+//!
+//! "status item dot rs" is `status_item.rs`; "context slash mod dot rs" is
+//! the `mod.rs` whose folder is `context`; "cargo toml" and "the claude md"
+//! leave the dot out (and a "the" in front is part of the reference). Each
+//! spoken phrase is checked against the repo's file
+//! list *backwards from its extension*, and only a phrase that names exactly
+//! one file becomes a mention. Anything else (no such file, two files with
+//! that name, a folder that does not fit) stays as it was said.
+//!
+//! Names are compared by letters and digits only, so separators and case
+//! never matter: "status item" = `status_item`, "claude" = `CLAUDE`.
+
+use super::tokens::{adjacent, norm, splice, tokenize, Edit, Tok};
+use super::RepoVocab;
+
+/// Extensions that may be spoken without "dot" ("cargo toml"). Anything
+/// that is also an ordinary word or a command ("go mod", "build log") is out:
+/// there "dot" has to be said.
+const BARE_EXTENSIONS: &[&str] = &[
+    "rs", "md", "mdx", "toml", "json", "jsonc", "yaml", "yml", "py", "js", "jsx", "mjs", "cjs",
+    "ts", "tsx", "css", "scss", "html", "sh", "txt", "lock", "swift", "kt", "java", "rb", "php",
+    "sql", "xml", "ini", "cfg", "conf", "cpp", "hpp", "cs", "zig", "lua", "vue", "svelte", "plist",
+    "proto", "gradle",
+];
+
+/// Words in a bare phrase's stem must add up to at least this many letters:
+/// "ui rs" is too thin to trust.
+const BARE_MIN_STEM: usize = 3;
+/// A spoken name longer than this many words is not a name.
+const MAX_GROUP_WORDS: usize = 8;
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab) -> String {
+    if vocab.files.is_empty() {
+        return text.to_string();
+    }
+    let toks = tokenize(text);
+    let root = root_name(vocab);
+    let mut edits: Vec<Edit> = Vec::new();
+    let mut covered = 0;
+    for j in 0..toks.len() {
+        let Some(bare) = extension_at(&toks, j) else {
+            continue;
+        };
+        let Some((first, path)) = resolve(&toks, j, bare, &vocab.files, &root) else {
+            continue;
+        };
+        // "the claude md" is one reference: the article goes with it.
+        let first = if first > 0 && toks[first - 1].key == "the" && adjacent(&toks, first - 1) {
+            first - 1
+        } else {
+            first
+        };
+        if toks[first].start < covered {
+            continue;
+        }
+        let start = toks[first].core_start();
+        let mut end = toks[j].core_end();
+        // A full stop that only closes the dictation would read as part of
+        // the path.
+        if j + 1 == toks.len() && toks[j].chunk.trail == "." {
+            end = toks[j].end;
+        }
+        covered = end;
+        edits.push(Edit {
+            start,
+            end,
+            text: format!("@{path}"),
+        });
+    }
+    if edits.is_empty() {
+        text.to_string()
+    } else {
+        splice(text, &edits)
+    }
+}
+
+/// Is `toks[j]` the extension of a spoken file name? `Some(false)` after a
+/// spoken "dot", `Some(true)` for a bare extension word.
+fn extension_at(toks: &[Tok], j: usize) -> Option<bool> {
+    let t = &toks[j];
+    if !t.is_word() {
+        return None;
+    }
+    if j > 0 && is_dot(&toks[j - 1]) && adjacent(toks, j - 1) {
+        return Some(false);
+    }
+    (t.key.len() >= 2 && BARE_EXTENSIONS.contains(&t.key.as_str())).then_some(true)
+}
+
+fn is_dot(t: &Tok) -> bool {
+    t.key == "dot"
+}
+
+/// The cwd's own name: "squawk slash src slash lib dot rs" may start there.
+fn root_name(vocab: &RepoVocab) -> String {
+    vocab
+        .root
+        .file_name()
+        .map(|n| norm(&n.to_string_lossy()))
+        .unwrap_or_default()
+}
+
+/// The one file the phrase ending at `toks[j]` names, and the first token of
+/// that phrase. Of the files that fit, the phrase that says the most wins; if
+/// that leaves more than one file, there is no answer.
+fn resolve<'a>(
+    toks: &[Tok],
+    j: usize,
+    bare: bool,
+    files: &'a [String],
+    root: &str,
+) -> Option<(usize, &'a str)> {
+    let ext = toks[j].key.as_str();
+    // The word spoken just before the extension must end the file's stem;
+    // checking that first keeps the full match off nearly every file.
+    let tail_at = if bare {
+        j.checked_sub(1)
+    } else {
+        j.checked_sub(2)
+    };
+    let tail = tail_at
+        .filter(|&t| toks[t].is_word() && adjacent(toks, t))
+        .map(|t| toks[t].key.as_str());
+    let mut best: Option<usize> = None;
+    let mut hits: Vec<&str> = Vec::new();
+    for file in files {
+        if !has_extension(file, ext) || !could_end_with(file, ext.len(), tail) {
+            continue;
+        }
+        let Some(first) = match_file(file, toks, j, bare, root) else {
+            continue;
+        };
+        match best {
+            Some(b) if first > b => {}
+            Some(b) if first == b => hits.push(file),
+            _ => {
+                best = Some(first);
+                hits.clear();
+                hits.push(file);
+            }
+        }
+    }
+    hits.sort_unstable();
+    hits.dedup();
+    match (best, hits.as_slice()) {
+        // A path with whitespace cannot be a bare @mention.
+        (Some(first), [path]) if !path.chars().any(char::is_whitespace) => Some((first, path)),
+        _ => None,
+    }
+}
+
+/// `file` ends in `.ext` (ASCII case aside).
+fn has_extension(file: &str, ext: &str) -> bool {
+    let (f, e) = (file.as_bytes(), ext.as_bytes());
+    f.len() > e.len()
+        && f[f.len() - e.len() - 1] == b'.'
+        && f[f.len() - e.len()..].eq_ignore_ascii_case(e)
+}
+
+/// Cheap necessary condition for a match: the last word of the stem (the
+/// piece of the name between the last two dots or slashes) ends with the
+/// last word spoken. An empty piece is a hidden file or a dotted name, left
+/// to [`match_file`].
+fn could_end_with(file: &str, ext_len: usize, spoken: Option<&str>) -> bool {
+    let before = &file[..file.len() - ext_len - 1];
+    let piece = before.rsplit(['/', '.']).next().unwrap_or("");
+    if piece.is_empty() {
+        return true;
+    }
+    let Some(spoken) = spoken else {
+        return false;
+    };
+    let mut want = spoken.chars().rev();
+    let mut next = want.next();
+    for c in piece.chars().rev().filter(|c| c.is_alphanumeric()) {
+        let Some(n) = next else {
+            return true;
+        };
+        if c.to_lowercase().next() != Some(n) {
+            return false;
+        }
+        next = want.next();
+    }
+    next.is_none()
+}
+
+/// Does the speech before (and including) `toks[j]` spell `path`? Returns the
+/// first token of the phrase.
+fn match_file(path: &str, toks: &[Tok], j: usize, bare: bool, root: &str) -> Option<usize> {
+    let (dirs, name) = path.rsplit_once('/').unwrap_or(("", path));
+    let parts: Vec<&str> = name.split('.').collect();
+    let last = parts.len() - 1;
+    if last == 0 || norm(parts[last]) != toks[j].key {
+        return None;
+    }
+    if bare && (last != 1 || norm(parts[0]).len() < BARE_MIN_STEM) {
+        return None;
+    }
+
+    // The name: stem, then each extension, "dot" between all of them. A
+    // hidden file (`.gitignore`) has an empty stem, just the dot.
+    let mut first = j;
+    for m in (0..last).rev() {
+        if !bare {
+            if first == 0 || !is_dot(&toks[first - 1]) || !adjacent(toks, first - 1) {
+                return None;
+            }
+            first -= 1;
+        }
+        let want = norm(parts[m]);
+        if want.is_empty() {
+            if m == 0 && parts[0].is_empty() {
+                continue;
+            }
+            return None;
+        }
+        first = group_before(toks, first, &want)?;
+    }
+
+    // The folders, nearest first, each introduced by "slash".
+    let mut folders = dirs.rsplit('/').filter(|d| !d.is_empty());
+    let mut root_used = false;
+    while let Some(slash) = slash_before(toks, first) {
+        let (want, hidden) = match folders.next() {
+            Some(d) => (norm(d), d.starts_with('.')),
+            None if !root_used => {
+                root_used = true;
+                (root.to_string(), false)
+            }
+            None => return None,
+        };
+        if want.is_empty() {
+            return None;
+        }
+        first = group_before(toks, slash, &want)?;
+        if hidden && first > 0 && is_dot(&toks[first - 1]) && adjacent(toks, first - 1) {
+            first -= 1;
+        }
+    }
+    Some(first)
+}
+
+/// The "slash" (or "forward slash", or a lone `/`) right before `toks[at]`:
+/// the index of its first token.
+fn slash_before(toks: &[Tok], at: usize) -> Option<usize> {
+    let k = at.checked_sub(1)?;
+    if !(toks[k].slash || toks[k].key == "slash") || !adjacent(toks, k) {
+        return None;
+    }
+    if k > 0 && toks[k - 1].key == "forward" && adjacent(toks, k - 1) {
+        return Some(k - 1);
+    }
+    Some(k)
+}
+
+/// Walk back from `toks[end]` over whole words whose letters add up to
+/// exactly `want`. Returns the index of the first of them.
+fn group_before(toks: &[Tok], end: usize, want: &str) -> Option<usize> {
+    let mut have = String::new();
+    let mut i = end;
+    while have.len() < want.len() {
+        let k = i.checked_sub(1)?;
+        if !toks[k].is_word() || !adjacent(toks, k) || end - k > MAX_GROUP_WORDS {
+            return None;
+        }
+        have.insert_str(0, &toks[k].key);
+        if !want.ends_with(&have) {
+            return None;
+        }
+        i = k;
+    }
+    Some(i)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn vocab(files: &[&str]) -> RepoVocab {
+        RepoVocab {
+            root: PathBuf::from("/code/squawk"),
+            files: files.iter().map(|f| f.to_string()).collect(),
+            words: Vec::new(),
+        }
+    }
+
+    fn say(files: &[&str], text: &str) -> String {
+        apply(text, &vocab(files))
+    }
+
+    const REPO: &[&str] = &[
+        "Cargo.toml",
+        "CLAUDE.md",
+        ".gitignore",
+        "src/audio.rs",
+        "src/status_item.rs",
+        "src/lib.rs",
+        "src/context/mod.rs",
+        "src/store/mod.rs",
+        "src/ui/mod.rs",
+        "crates/core/Cargo.toml",
+        "docs/My Notes.md",
+        "go.mod",
+    ];
+
+    #[test]
+    fn dotted_names() {
+        assert_eq!(
+            say(REPO, "take a look at status item dot rs"),
+            "take a look at @src/status_item.rs"
+        );
+        assert_eq!(say(REPO, "open audio dot rs now"), "open @src/audio.rs now");
+        assert_eq!(say(REPO, "open Audio Dot RS"), "open @src/audio.rs");
+    }
+
+    #[test]
+    fn folder_disambiguates() {
+        assert_eq!(
+            say(REPO, "see context slash mod dot rs"),
+            "see @src/context/mod.rs"
+        );
+        assert_eq!(
+            say(REPO, "see src slash store slash mod dot rs"),
+            "see @src/store/mod.rs"
+        );
+        assert_eq!(say(REPO, "see ui / mod dot rs"), "see @src/ui/mod.rs");
+        assert_eq!(
+            say(REPO, "see the context forward slash mod dot rs please"),
+            "see @src/context/mod.rs please"
+        );
+        // The cwd's own name is allowed in front.
+        assert_eq!(
+            say(REPO, "see squawk slash src slash audio dot rs"),
+            "see @src/audio.rs"
+        );
+    }
+
+    #[test]
+    fn ambiguous_or_unknown_stays_spoken() {
+        for text in [
+            "see mod dot rs",
+            "see cargo toml",
+            "see cargo dot toml",
+            "see network slash mod dot rs",
+            "see core slash mod dot rs",
+            "see status dot rs",
+            "see missing dot rs",
+            "see audio dot py",
+            "see src slash slash audio dot rs",
+            "see my notes md",
+        ] {
+            assert_eq!(say(REPO, text), text, "{text}");
+        }
+    }
+
+    #[test]
+    fn bare_extensions() {
+        let files = &["Cargo.toml", "CLAUDE.md", "src/main.rs", "go.mod", "ui.rs"];
+        assert_eq!(say(files, "read cargo toml"), "read @Cargo.toml");
+        assert_eq!(
+            say(files, "ask about the claude md"),
+            "ask about @CLAUDE.md"
+        );
+        assert_eq!(
+            say(files, "check main rs, then run it"),
+            "check @src/main.rs, then run it"
+        );
+        // "go mod" is a command; "ui rs" is too thin to trust.
+        assert_eq!(say(files, "run go mod tidy"), "run go mod tidy");
+        assert_eq!(say(files, "open ui rs"), "open ui rs");
+        assert_eq!(say(files, "open ui dot rs"), "open @ui.rs");
+    }
+
+    #[test]
+    fn hidden_and_multi_dot_names() {
+        let files = &[
+            ".gitignore",
+            ".github/workflows/ci.yml",
+            "jest.config.js",
