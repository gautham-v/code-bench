new file mode 100644
index 0000000..bc37ea7
--- /dev/null
+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,346 @@
+//! Finding the coding agent behind the front terminal.
+//!
+//! libproc and sysctl only, no `ps`/`lsof`: walk the terminal's descendants,
+//! keep the ones that are `claude` or `codex`, and when there are several
+//! (split panes, tabs) take the one whose tty was touched last.
+
+use super::{is_terminal, FrontApp, Session};
+
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    if !is_terminal(&front.bundle_id) || front.pid <= 0 {
+        return None;
+    }
+    imp::detect(front.pid)
+}
+
+#[cfg(target_os = "macos")]
+mod imp {
+    use std::collections::{HashSet, VecDeque};
+    use std::ffi::{c_char, c_int, CStr};
+    use std::mem::size_of;
+    use std::path::{Path, PathBuf};
+    use std::time::SystemTime;
+
+    use super::super::{Agent, Session, AGENT_PROCESS_NAMES};
+
+    /// `PROC_PPID_ONLY` from <sys/proc_info.h>: list the children of a pid.
+    const PROC_PPID_ONLY: u32 = 6;
+    /// `SZOMB`: exited, not yet reaped.
+    const SZOMB: u32 = 5;
+    const MAX_DEPTH: usize = 16;
+    const MAX_PROCS: usize = 4096;
+    /// Interpreters an agent may be launched through: `node /usr/bin/claude`.
+    const RUNTIMES: &[&str] = &["node", "bun", "deno", "sh", "bash", "zsh", "dash", "env"];
+
+    extern "C" {
+        /// Thread-safe `devname(3)`; the `libc` crate only has the static-buffer one.
+        fn devname_r(
+            dev: libc::dev_t,
+            mode: libc::mode_t,
+            buf: *mut c_char,
+            len: c_int,
+        ) -> *mut c_char;
+    }
+
+    struct Candidate {
+        session: Session,
+        /// Last read or write on the controlling tty.
+        active: Option<SystemTime>,
+        depth: usize,
+        started: (u64, u64),
+    }
+
+    pub fn detect(root: i32) -> Option<Session> {
+        let mut seen: HashSet<i32> = HashSet::from([root]);
+        let mut queue: VecDeque<(i32, usize)> = VecDeque::from([(root, 0)]);
+        let mut best: Option<Candidate> = None;
+        while let Some((pid, depth)) = queue.pop_front() {
+            if depth > 0 {
+                if let Some(c) = candidate(pid, depth) {
+                    let better = best.as_ref().is_none_or(|b| rank(&c) > rank(b));
+                    if better {
+                        best = Some(c);
+                    }
+                }
+            }
+            if depth < MAX_DEPTH && seen.len() < MAX_PROCS {
+                for child in children(pid) {
+                    if seen.insert(child) {
+                        queue.push_back((child, depth + 1));
+                    }
+                }
+            }
+        }
+        best.map(|c| c.session)
+    }
+
+    /// Most recently used tty first; then the process the user launched (not
+    /// something it spawned); then the newest.
+    fn rank(
+        c: &Candidate,
+    ) -> (
+        Option<SystemTime>,
+        std::cmp::Reverse<usize>,
+        (u64, u64),
+        i32,
+    ) {
+        (
+            c.active,
+            std::cmp::Reverse(c.depth),
+            c.started,
+            c.session.pid,
+        )
+    }
+
+    fn candidate(pid: i32, depth: usize) -> Option<Candidate> {
+        let info = bsd_info(pid)?;
+        if info.pbi_status == SZOMB {
+            return None;
+        }
+        let agent = agent_of(pid, &info)?;
+        let cwd = cwd_of(pid)?;
+        let tty = tty_of(info.e_tdev);
+        let active = tty.as_deref().and_then(last_used);
+        Some(Candidate {
+            session: Session {
+                agent,
+                pid,
+                cwd,
+                tty,
+            },
+            active,
+            depth,
+            started: (info.pbi_start_tvsec, info.pbi_start_tvusec),
+        })
+    }
+
+    fn children(pid: i32) -> Vec<i32> {
+        let unit = size_of::<c_int>();
+        // SAFETY: libproc fills at most `buffersize` bytes of `buf`.
+        unsafe {
+            let need = libc::proc_listpids(PROC_PPID_ONLY, pid as u32, std::ptr::null_mut(), 0);
+            if need <= 0 {
+                return Vec::new();
+            }
+            // The size query is an estimate; leave room for new children.
+            let mut buf = vec![0 as c_int; need as usize / unit + 16];
+            let got = libc::proc_listpids(
+                PROC_PPID_ONLY,
+                pid as u32,
+                buf.as_mut_ptr().cast(),
+                (buf.len() * unit) as c_int,
+            );
+            if got <= 0 {
+                return Vec::new();
+            }
+            buf.truncate(got as usize / unit);
+            buf.retain(|&p| p > 0);
+            buf
+        }
+    }
+
+    fn bsd_info(pid: i32) -> Option<libc::proc_bsdinfo> {
+        // SAFETY: plain-old-data out parameter, size checked against the return value.
+        unsafe {
+            let mut info: libc::proc_bsdinfo = std::mem::zeroed();
+            let size = size_of::<libc::proc_bsdinfo>() as c_int;
+            let got = libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                (&mut info as *mut libc::proc_bsdinfo).cast(),
+                size,
+            );
+            (got == size).then_some(info)
+        }
+    }
+
+    fn cwd_of(pid: i32) -> Option<PathBuf> {
+        // SAFETY: as above; `vip_path` is a NUL-terminated MAXPATHLEN buffer.
+        unsafe {
+            let mut info: libc::proc_vnodepathinfo = std::mem::zeroed();
+            let size = size_of::<libc::proc_vnodepathinfo>() as c_int;
+            let got = libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                (&mut info as *mut libc::proc_vnodepathinfo).cast(),
+                size,
+            );
+            if got != size {
+                return None;
+            }
+            let ptr = info.pvi_cdir.vip_path.as_ptr().cast::<c_char>();
+            let path = CStr::from_ptr(ptr).to_str().ok()?;
+            let path = PathBuf::from(path);
+            path.is_absolute().then_some(path)
+        }
+    }
+
+    fn exe_of(pid: i32) -> Option<PathBuf> {
+        let mut buf = vec![0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        // SAFETY: the buffer length is passed along.
+        let n = unsafe { libc::proc_pidpath(pid, buf.as_mut_ptr().cast(), buf.len() as u32) };
+        if n <= 0 {
+            return None;
+        }
+        buf.truncate(n as usize);
+        String::from_utf8(buf).ok().map(PathBuf::from)
+    }
+
+    /// argv of `pid`, from `KERN_PROCARGS2`. Empty when it cannot be read.
+    fn args_of(pid: i32) -> Vec<String> {
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        let mut size: libc::size_t = 0;
+        // SAFETY: standard two-step sysctl read; the buffer is `size` bytes.
+        unsafe {
+            let null = std::ptr::null_mut();
+            if libc::sysctl(mib.as_mut_ptr(), 3, null, &mut size, null, 0) != 0 || size < 8 {
+                return Vec::new();
+            }
+            let mut buf = vec![0u8; size];
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                buf.as_mut_ptr().cast(),
+                &mut size,
+                null,
+                0,
+            ) != 0
+            {
+                return Vec::new();
+            }
+            buf.truncate(size);
+            parse_procargs(&buf)
+        }
+    }
+
+    /// `argc` (native int), the exec path, NUL padding, then argc strings.
+    pub(super) fn parse_procargs(buf: &[u8]) -> Vec<String> {
+        let Some(head) = buf.get(..4) else {
+            return Vec::new();
+        };
+        let argc = i32::from_ne_bytes([head[0], head[1], head[2], head[3]]).max(0) as usize;
+        buf[4..]
+            .split(|&b| b == 0)
+            .skip(1)
+            .skip_while(|s| s.is_empty())
+            .take(argc)
+            .map(|s| String::from_utf8_lossy(s).into_owned())
+            .collect()
+    }
+
+    fn cstr(chars: &[c_char]) -> String {
+        let bytes: Vec<u8> = chars
+            .iter()
+            .take_while(|&&c| c != 0)
+            .map(|&c| c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    fn agent_named(name: &str) -> Option<Agent> {
+        AGENT_PROCESS_NAMES
+            .iter()
+            .find(|(n, _)| *n == name)
+            .map(|&(_, a)| a)
+    }
+
+    fn base(path: &str) -> &str {
+        Path::new(path)
+            .file_name()
+            .and_then(|n| n.to_str())
+            .unwrap_or(path)
+    }
+
+    /// `claude`, `codex`, or an interpreter running a script of that name.
+    fn agent_of(pid: i32, info: &libc::proc_bsdinfo) -> Option<Agent> {
+        let comm = cstr(&info.pbi_comm);
+        let name = cstr(&info.pbi_name);
+        let exe = exe_of(pid);
+        let exe_base = exe.as_deref().and_then(Path::to_str).map(base);
+        let direct = [comm.as_str(), name.as_str()]
+            .into_iter()
+            .chain(exe_base)
+            .find_map(agent_named);
+        if direct.is_some() {
+            return direct;
+        }
+        // A versioned binary (`.../versions/2.1.5`) or a script keeps its
+        // name only in argv.
+        let args = args_of(pid);
+        let argv0 = args.first().map(|a| base(a))?;
+        if let Some(agent) = agent_named(argv0) {
+            return Some(agent);
+        }
+        let interpreter = [comm.as_str(), argv0]
+            .into_iter()
+            .chain(exe_base)
+            .any(|n| RUNTIMES.contains(&n) || n.starts_with("python"));
+        if !interpreter {
+            return None;
+        }
+        let script = base(args.get(1)?);
+        let script = script.rsplit_once('.').map_or(script, |(stem, ext)| {
+            if matches!(ext, "js" | "mjs" | "cjs" | "ts" | "py" | "sh") {
+                stem
+            } else {
+                script
+            }
+        });
+        agent_named(script)
+    }
+
+    /// `/dev/ttys004` for a controlling terminal device number.
+    fn tty_of(dev: u32) -> Option<PathBuf> {
+        if dev == u32::MAX || dev == 0 {
+            return None;
+        }
+        let mut buf = [0 as c_char; 64];
+        // SAFETY: devname_r writes at most `len` bytes and NUL-terminates.
+        let name = unsafe {
+            let p = devname_r(dev as libc::dev_t, libc::S_IFCHR, buf.as_mut_ptr(), 64);
+            if p.is_null() {
+                return None;
+            }
+            CStr::from_ptr(p).to_str().ok()?.to_string()
+        };
+        name.starts_with("tty")
+            .then(|| Path::new("/dev").join(name))
+    }
+
+    fn last_used(tty: &Path) -> Option<SystemTime> {
+        let meta = std::fs::metadata(tty).ok()?;
+        match (meta.accessed().ok(), meta.modified().ok()) {
+            (Some(a), Some(m)) => Some(a.max(m)),
+            (a, m) => a.or(m),
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn procargs_skips_exec_path_and_padding() {
+            let mut buf = 3i32.to_ne_bytes().to_vec();
+            buf.extend_from_slice(b"/usr/local/bin/node\0\0\0");
+            buf.extend_from_slice(b"node\0/usr/local/bin/claude\0--resume\0HOME=/x\0");
+            assert_eq!(
+                parse_procargs(&buf),
+                ["node", "/usr/local/bin/claude", "--resume"]
+            );
+            assert!(parse_procargs(&[1, 2]).is_empty());
+        }
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+mod imp {
+    use super::super::Session;
+
+    /// Process inspection is libproc; there is nothing to look at elsewhere.
+    pub fn detect(_root: i32) -> Option<Session> {
+        None
+    }
+}
diff --git a/crates/squawk-core/src/context/jargon.rs b/crates/squawk-core/src/context/jargon.rs
