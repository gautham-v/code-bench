+fn is_common(word: &str) -> bool {
+    COMMON.binary_search(&word.to_lowercase().as_str()).is_ok()
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Shape {
+    /// Lowercase, a number, or not a word at all.
+    Plain,
+    /// `Parakeet`: only the first letter is a capital.
+    Capitalised,
+    /// `NVIDIA`, `macOS`, `VocabCache`: casing a sentence start cannot explain.
+    Distinct,
+}
+
+fn shape(word: &str) -> Shape {
+    let letters = word.chars().filter(|c| c.is_alphabetic()).count();
+    if letters < 2 || !word.chars().all(|c| c.is_alphanumeric() || c == '-') {
+        return Shape::Plain;
+    }
+    if crate::text::has_inner_case(word) {
+        let shouting = !word.chars().any(char::is_lowercase);
+        // SHOUTED words are emphasis more often than acronyms.
+        if shouting && (word.chars().count() > 6 || is_common(word)) {
+            return Shape::Plain;
+        }
+        return Shape::Distinct;
+    }
+    if word.chars().next().is_some_and(char::is_uppercase) {
+        Shape::Capitalised
+    } else {
+        Shape::Plain
+    }
+}
+
+/// One word of a doc line.
+struct DocWord {
+    text: String,
+    shape: Shape,
+    /// First word of a line or sentence, where a capital means nothing.
+    opens: bool,
+    /// Punctuation (or a non-word) stands between this word and the last.
+    breaks: bool,
+}
+
+/// Headings and capitalised terms from one markdown doc.
+fn doc_terms(text: &str, words: &mut Words) {
+    let mut lines: Vec<Vec<DocWord>> = Vec::new();
+    let mut fenced = false;
+    for line in text.lines() {
+        let line = line.trim();
+        if line.starts_with("```") || line.starts_with("~~~") {
+            fenced = !fenced;
+            continue;
+        }
+        if fenced || line.is_empty() {
+            continue;
+        }
+        let hashes = line.chars().take_while(|&c| c == '#').count();
+        if (1..=6).contains(&hashes) && line[hashes..].starts_with(' ') {
+            let heading = line[hashes..].trim().trim_end_matches('#').trim();
+            let parsed = doc_words(heading, words);
+            if !heading_term(&parsed, words) {
+                lines.push(parsed);
+            }
+        } else {
+            lines.push(doc_words(line, words));
+        }
+    }
+
+    // A capital at a sentence start counts only if the word is also
+    // capitalised somewhere it did not have to be.
+    let mid: HashSet<&str> = lines
+        .iter()
+        .flatten()
+        .filter(|w| w.shape == Shape::Capitalised && !w.opens)
+        .map(|w| w.text.as_str())
+        .collect();
+    let is_term = |w: &DocWord| match w.shape {
+        Shape::Distinct => true,
+        Shape::Capitalised => !w.opens || mid.contains(w.text.as_str()),
+        Shape::Plain => false,
+    };
+    let mut found: Vec<String> = Vec::new();
+    for line in &lines {
+        let mut i = 0;
+        while i < line.len() {
+            if !is_term(&line[i]) {
+                i += 1;
+                continue;
+            }
+            let mut end = i + 1;
+            while end < line.len() && !line[end].breaks && is_term(&line[end]) {
+                end += 1;
+            }
+            let run = &line[i..end];
+            if (2..=4).contains(&run.len()) {
+                let phrase: Vec<&str> = run.iter().map(|w| w.text.as_str()).collect();
+                found.push(phrase.join(" "));
+            }
+            for w in run {
+                if w.shape == Shape::Distinct || !is_common(&w.text) {
+                    found.push(w.text.clone());
+                }
+            }
+            i = end;
+        }
+    }
+    for term in found {
+        words.add(&term);
+    }
+}
+
+/// A heading that names something: one word, or a few that are all
+/// capitalised ("Claude Code"). "How it works" is prose, not a term.
+fn heading_term(heading: &[DocWord], words: &mut Words) -> bool {
+    if heading.is_empty() || heading.len() > 3 || heading.iter().skip(1).any(|w| w.breaks) {
+        return false;
+    }
+    if heading.iter().all(|w| is_common(&w.text)) {
+        return true;
+    }
+    let single = heading.len() == 1 && heading[0].text.chars().any(char::is_alphabetic);
+    if !single && heading.iter().any(|w| w.shape == Shape::Plain) {
+        return false;
+    }
+    let text: Vec<&str> = heading.iter().map(|w| w.text.as_str()).collect();
+    words.add(&text.join(" "));
+    true
+}
+
+/// Split a markdown line into words. CamelCase identifiers in `inline code`
+/// are added to `words` on the way; other code spans only break the line.
+fn doc_words(line: &str, words: &mut Words) -> Vec<DocWord> {
+    let mut prose = String::new();
+    for (i, piece) in line.split('`').enumerate() {
+        if i % 2 == 0 {
+            prose.push_str(piece);
+            continue;
+        }
+        let ident = piece.chars().all(char::is_alphanumeric)
+            && piece.chars().any(char::is_lowercase)
+            && piece.chars().skip(1).any(char::is_uppercase);
+        if ident {
+            words.add(piece);
+        }
+        prose.push_str(" ` ");
+    }
+    let prose = strip_link_targets(&prose);
+
+    let mut out = Vec::new();
+    let mut opens = true;
+    let mut breaks = true;
+    let lead: &[char] = &['(', '[', '"', '\'', '*', '_', '“', '‘'];
+    for raw in prose.split_whitespace() {
+        let body = raw.trim_start_matches(lead);
+        let had_lead = body.len() != raw.len();
+        let core = body.trim_end_matches(|c: char| !c.is_alphanumeric());
+        let trail = &body[core.len()..];
+        // "NVIDIA's" names NVIDIA, and ends the run.
+        let (core, possessive) = match core.strip_suffix("'s").or(core.strip_suffix("’s")) {
+            Some(owner) => (owner, true),
+            None => (core, false),
+        };
+        let is_word = core.chars().any(char::is_alphabetic)
+            && core.chars().all(|c| c.is_alphanumeric() || c == '-');
+        if is_word {
+            out.push(DocWord {
+                text: core.to_string(),
+                shape: shape(core),
+                opens,
+                breaks: breaks || had_lead,
+            });
+        }
+        // List markers and quote marks do not start the sentence.
+        let marker = out.is_empty() && !core.chars().any(char::is_alphabetic);
+        if !marker {
+            opens = trail.contains(['.', '?', '!', ':']);
+        }
+        let closes = trail.contains(|c: char| !matches!(c, '*' | '_'));
+        breaks = !is_word || possessive || closes;
+    }
+    out
+}
+
+/// `[text](url)` → `text`.
+fn strip_link_targets(line: &str) -> String {
+    let mut out = String::new();
+    let mut rest = line;
+    while let Some(at) = rest.find("](") {
+        out.push_str(&rest[..at]);
+        out.push(' ');
+        rest = match rest[at..].find(')') {
+            Some(close) => &rest[at + close + 1..],
+            None => "",
+        };
+    }
+    out.push_str(rest);
+    out
+}
+
+/// What a cached vocab was built against.
+#[derive(Debug, Clone, PartialEq)]
+pub(super) struct Stamp {
+    /// `.git/index` and its mtime at build time; `None` outside git.
+    index: Option<(PathBuf, Option<SystemTime>)>,
+    built: Instant,
+}
+
+/// Outside git nothing says when files change, so the vocab is short-lived.
+const TTL: Duration = Duration::from_secs(10);
+/// In git the index does not move when an untracked file appears, so even
+/// an unchanged index is trusted only this long.
+const GIT_TTL: Duration = Duration::from_secs(60);
+
+impl Stamp {
+    pub(super) fn now(cwd: &Path) -> Stamp {
+        let index = git_index(cwd).map(|path| {
+            let mtime = mtime(&path);
+            (path, mtime)
+        });
+        Stamp {
+            index,
+            built: Instant::now(),
+        }
+    }
+
+    pub(super) fn is_fresh(&self) -> bool {
+        match &self.index {
+            Some((path, seen)) => mtime(path) == *seen && self.built.elapsed() < GIT_TTL,
+            None => self.built.elapsed() < TTL,
+        }
+    }
+}
+
+fn mtime(path: &Path) -> Option<SystemTime> {
+    std::fs::metadata(path).and_then(|m| m.modified()).ok()
+}
+
+/// The index file of the repo `cwd` is in: `.git/index`, or the index of a
+/// worktree whose `.git` is a `gitdir:` pointer.
+fn git_index(cwd: &Path) -> Option<PathBuf> {
+    let dot_git = cwd
+        .ancestors()
+        .map(|d| d.join(".git"))
+        .find(|p| p.exists())?;
+    if dot_git.is_dir() {
+        return Some(dot_git.join("index"));
+    }
+    let pointer = std::fs::read_to_string(&dot_git).ok()?;
+    let dir = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+    Some(dot_git.parent()?.join(dir.trim()).join("index"))
+}
