@@ -0,0 +1,792 @@
+//! Rewriting a transcript against a repo: spoken file names to @mentions,
+//! then repo jargon to its canonical spelling.
+//!
+//! Both passes work on chunks and match by *squashed* form: lowercase
+//! letters and digits only, so "status item", "StatusItem" and
+//! `status_item` are all `statusitem`. A squashed hit is then checked
+//! against the real name's structure — word boundaries in what was said
+//! must fall on boundaries in the name — and against the other candidates:
+//! anything short of exactly one file is left as spoken.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex, Weak};
+
+use super::vocab::file_stem;
+use super::RepoVocab;
+use crate::text::{self, Chunk};
+
+/// Extensions that are recognised without a spoken "dot" ("cargo toml").
+/// None of them is an English word; `go`, `c`, `lock`, `sh` need the dot.
+const DOTLESS_EXTS: &[&str] = &[
+    "rs", "md", "toml", "json", "yaml", "yml", "ts", "tsx", "js", "jsx", "py", "txt", "html", "css",
+];
+
+/// How an extension is heard, and what was meant.
+const EXT_HEARD: &[(&str, &str)] = &[
+    ("jason", "json"),
+    ("tommel", "toml"),
+    ("tomel", "toml"),
+    ("yammel", "yaml"),
+    ("yamel", "yaml"),
+    ("yaml", "yml"),
+    ("yml", "yaml"),
+];
+
+/// Longest spoken file name, in words ("dot" included).
+const MAX_NAME_WORDS: usize = 8;
+/// Longest spoken folder name, in words.
+const MAX_DIR_WORDS: usize = 4;
+/// Longest spoken jargon term, in words.
+const MAX_JARGON_WORDS: usize = 6;
+
+/// Lookup tables for one vocab.
+#[derive(Debug, Default)]
+pub(super) struct Index {
+    /// Squashed base name → indices into `RepoVocab::files`.
+    names: HashMap<String, Vec<u32>>,
+    /// Squashed term → how it is written.
+    jargon: HashMap<String, Jargon>,
+    max_jargon_words: usize,
+}
+
+#[derive(Debug)]
+struct Jargon {
+    written: String,
+    /// The term's squashed parts: `VocabCache` → `vocab`, `cache`.
+    parts: Vec<String>,
+    /// May be matched across several spoken words.
+    split: bool,
+}
+
+/// Lowercase letters and digits of `s`.
+fn squash(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+impl Index {
+    pub(super) fn build(vocab: &RepoVocab) -> Index {
+        let mut names: HashMap<String, Vec<u32>> = HashMap::new();
+        let mut stems: HashSet<&str> = HashSet::new();
+        for (i, file) in vocab.files.iter().enumerate() {
+            let name = base_name(file);
+            if let Some(stem) = file_stem(name) {
+                stems.insert(stem);
+            }
+            // A path with a space in it cannot be an @mention.
+            if !name.contains('.') || file.contains(char::is_whitespace) {
+                continue;
+            }
+            let key = squash(name);
+            if !key.is_empty() {
+                names.entry(key).or_default().push(i as u32);
+            }
+        }
+
+        // `None` marks a term the repo writes two ways: neither is canonical.
+        let mut jargon: HashMap<String, Option<Jargon>> = HashMap::new();
+        for word in &vocab.words {
+            let word = word.trim();
+            let plain = word
+                .chars()
+                .all(|c| c.is_alphanumeric() || matches!(c, ' ' | '-' | '_'));
+            if !plain || word.chars().filter(|c| c.is_alphabetic()).count() < 2 {
+                continue;
+            }
+            let parts = jargon_parts(word);
+            let is_stem = stems.contains(word);
+            // "cargo" must not become "Cargo" because Cargo.toml exists.
+            if parts.len() == 1 && is_stem {
+                continue;
+            }
+            let separated = word.chars().any(|c| !c.is_alphanumeric());
+            let entry = Jargon {
+                written: word.to_string(),
+                parts,
+                // "launch at login" is prose even when launch_at_login.rs exists.
+                split: !(separated && is_stem),
+            };
+            match jargon.entry(squash(word)) {
+                std::collections::hash_map::Entry::Vacant(v) => {
+                    v.insert(Some(entry));
+                }
+                std::collections::hash_map::Entry::Occupied(mut o) => {
+                    if o.get().as_ref().is_some_and(|j| j.written != word) {
+                        o.insert(None);
+                    }
+                }
+            }
+        }
+        let jargon: HashMap<String, Jargon> = jargon
+            .into_iter()
+            .filter_map(|(key, j)| Some((key, j?)))
+            // A plain lowercase word has nothing to correct.
+            .filter(|(_, j)| j.parts.len() > 1 || j.written.chars().any(char::is_uppercase))
+            .collect();
+        let max_jargon_words = jargon
+            .values()
+            .map(|j| j.parts.len())
+            .max()
+            .unwrap_or(0)
+            .min(MAX_JARGON_WORDS);
+        Index {
+            names,
+            jargon,
+            max_jargon_words,
+        }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.names.is_empty() && self.jargon.is_empty()
+    }
+}
+
+/// The index for `vocab`, built once per `Arc` and kept while it lives.
+pub(super) fn index_for(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+    static CACHE: Mutex<Vec<(Weak<RepoVocab>, Arc<Index>)>> = Mutex::new(Vec::new());
+    let find = |cache: &Vec<(Weak<RepoVocab>, Arc<Index>)>| {
+        cache
+            .iter()
+            .find(|(weak, _)| weak.as_ptr() == Arc::as_ptr(vocab) && weak.strong_count() > 0)
+            .map(|(_, index)| index.clone())
+    };
+    if let Some(index) = find(&CACHE.lock().unwrap_or_else(|e| e.into_inner())) {
+        return index;
+    }
+    let index = Arc::new(Index::build(vocab));
+    let mut cache = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    cache.retain(|(weak, _)| weak.strong_count() > 0);
+    if let Some(index) = find(&cache) {
+        return index;
+    }
+    cache.push((Arc::downgrade(vocab), index.clone()));
+    index
+}
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab, index: &Index) -> String {
+    if index.is_empty() {
+        return text.to_string();
+    }
+    let chunks = text::chunks(text);
+    let (chunks, mentioned) = mention_pass(chunks, vocab, index);
+    let (chunks, respelled) = jargon_pass(chunks, index);
+    if mentioned || respelled {
+        text::join(&chunks)
+    } else {
+        text.to_string()
+    }
+}
+
+fn base_name(file: &str) -> &str {
+    file.rsplit('/').next().unwrap_or(file)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Word,
+    Dot,
+    Slash,
+}
+
+/// A chunk as a spoken word, if it can be part of a name.
+#[derive(Debug, Clone)]
+struct Tok {
+    text: String,
+    kind: Kind,
+}
+
+fn tok(chunk: &Chunk) -> Option<Tok> {
+    if chunk.is_protected()
+        || !chunk
+            .core
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_'))
+    {
+        return None;
+    }
+    let text = squash(&chunk.core);
+    let kind = match text.as_str() {
+        "" => return None,
+        "dot" => Kind::Dot,
+        "slash" => Kind::Slash,
+        _ => Kind::Word,
+    };
+    Some(Tok { text, kind })
+}
+
+/// `toks[a]` and `toks[a + 1]` are spoken together: both usable, and no
+/// punctuation between them.
+fn joined(chunks: &[Chunk], toks: &[Option<Tok>], a: usize) -> bool {
+    toks[a].is_some()
+        && toks[a + 1].is_some()
+        && chunks[a].trail.is_empty()
+        && chunks[a + 1].lead.is_empty()
+}
+
+fn mention_pass(chunks: Vec<Chunk>, vocab: &RepoVocab, index: &Index) -> (Vec<Chunk>, bool) {
+    if index.names.is_empty() {
+        return (chunks, false);
+    }
+    let toks: Vec<Option<Tok>> = chunks.iter().map(tok).collect();
+    // (first chunk, last chunk, file) of each mention, in order.
+    let mut found: Vec<(usize, usize, u32)> = Vec::new();
+    // Chunks before this one are already part of a mention.
+    let mut floor = 0;
+    for end in 0..chunks.len() {
+        if !matches!(&toks[end], Some(t) if t.kind == Kind::Word) {
+            continue;
+        }
+        if let Some((start, file)) = mention_ending_at(end, floor, &chunks, &toks, vocab, index) {
+            found.push((start, end, file));
+            floor = end + 1;
+        }
+    }
+    if found.is_empty() {
+        return (chunks, false);
+    }
+    let mut out = Vec::with_capacity(chunks.len());
+    let mut next = found.iter().peekable();
+    let mut i = 0;
+    while i < chunks.len() {
+        match next.peek() {
+            Some(&&(start, end, file)) if start == i => {
+                out.push(Chunk {
+                    lead: chunks[start].lead.clone(),
+                    core: format!("@{}", vocab.files[file as usize]),
+                    trail: chunks[end].trail.clone(),
+                });
+                next.next();
+                i = end + 1;
+            }
+            _ => {
+                out.push(chunks[i].clone());
+                i += 1;
+            }
+        }
+    }
+    (out, true)
+}
+
+/// The file named by the words ending at `end`, and where the reference
+/// starts, if they name exactly one.
+fn mention_ending_at(
+    end: usize,
+    floor: usize,
+    chunks: &[Chunk],
+    toks: &[Option<Tok>],
+    vocab: &RepoVocab,
+    index: &Index,
+) -> Option<(usize, u32)> {
+    // The longest run of words that is some file's name: "status item dot
+    // rs" is status_item.rs even if there is an item.rs.
+    let mut best: Option<(usize, Vec<u32>)> = None;
+    let mut start = end;
+    while start > floor && end - start + 1 < MAX_NAME_WORDS && joined(chunks, toks, start - 1) {
+        start -= 1;
+        if toks[start].as_ref().is_some_and(|t| t.kind == Kind::Slash) {
+            break;
+        }
+        let files = files_named(start, end, toks, vocab, index);
+        if !files.is_empty() {
+            best = Some((start, files));
+        }
+    }
+    let (mut start, mut files) = best?;
+
+    // Folders said before it: "context slash mod dot rs".
+    let mut depth = 0;
+    let mut said_slash = false;
+    while start > floor
+        && joined(chunks, toks, start - 1)
+        && toks[start - 1]
+            .as_ref()
+            .is_some_and(|t| t.kind == Kind::Slash)
+    {
+        let mut dir_end = start - 1;
+        // "forward slash"
+        if dir_end > floor
+            && joined(chunks, toks, dir_end - 1)
+            && toks[dir_end - 1]
+                .as_ref()
+                .is_some_and(|t| t.text == "forward")
+        {
+            dir_end -= 1;
+        }
+        // A folder that is not there means the file is not the one meant.
+        let (dir_start, kept) = folder_before(dir_end, floor, depth, &files, chunks, toks, vocab)?;
+        start = dir_start;
+        files = kept;
+        depth += 1;
+        said_slash = true;
+    }
+    // Without "slash", a folder name is only taken as one when the file
+    // name alone does not settle it and the folder does.
+    if !said_slash && files.len() > 1 {
+        if let Some((dir_start, kept)) = folder_before(start, floor, 0, &files, chunks, toks, vocab)
+        {
+            if kept.len() == 1 {
+                start = dir_start;
+                files = kept;
+            }
+        }
+    }
+    if files.len() != 1 {
+        return None;
+    }
+
+    // "the claude md" → "@CLAUDE.md"
+    if start > floor
+        && joined(chunks, toks, start - 1)
+        && toks[start - 1].as_ref().is_some_and(|t| t.text == "the")
+    {
+        start -= 1;
+    }
+    Some((start, files[0]))
+}
+
+/// Files whose base name is what `toks[start..=end]` say.
+fn files_named(
+    start: usize,
+    end: usize,
+    toks: &[Option<Tok>],
+    vocab: &RepoVocab,
+    index: &Index,
+) -> Vec<u32> {
+    let mut said: Vec<Tok> = toks[start..=end].iter().flatten().cloned().collect();
+    let heard = said.last().map(|t| t.text.clone()).unwrap_or_default();
+    let mut exts = vec![heard.clone()];
+    exts.extend(
+        EXT_HEARD
+            .iter()
+            .filter(|(h, _)| *h == heard)
+            .map(|(_, meant)| meant.to_string()),
+    );
+    let mut files = Vec::new();
+    for ext in exts {
+        if let Some(last) = said.last_mut() {
+            last.text = ext;
+        }
+        let key: String = said
+            .iter()
+            .filter(|t| t.kind != Kind::Dot)
+            .map(|t| t.text.as_str())
+            .collect();
+        for &file in index.names.get(&key).map(Vec::as_slice).unwrap_or(&[]) {
+            let name = base_name(&vocab.files[file as usize]);
+            if name_matches(name, &said) && !files.contains(&file) {
+                files.push(file);
+            }
+        }
+    }
+    files
+}
+
+/// Does `said` spell out `name`? Every dot in the name must fall between
+/// two spoken words; it must be *said* when it leads the name (`.env`) or
+/// when the extension could pass for a word (`main dot go`).
+fn name_matches(name: &str, said: &[Tok]) -> bool {
+    let segments: Vec<String> = name.split('.').map(squash).collect();
+    if segments.len() < 2 {
+        return false;
+    }
+    let mut t = 0;
+    for (i, segment) in segments.iter().enumerate() {
+        if i > 0 {
+            if said.get(t).is_some_and(|tok| tok.kind == Kind::Dot) {
+                t += 1;
+            } else {
+                let leading = i == 1 && segments[0].is_empty();
+                let last = i + 1 == segments.len();
+                if leading || (last && !DOTLESS_EXTS.contains(&segment.as_str())) {
+                    return false;
+                }
+            }
+        }
+        if segment.is_empty() {
+            if i == 0 {
+                continue;
+            }
+            return false;
+        }
+        let mut rest = segment.as_str();
+        while !rest.is_empty() {
+            let Some(tok) = said.get(t).filter(|tok| tok.kind != Kind::Dot) else {
+                return false;
+            };
+            let Some(after) = rest.strip_prefix(tok.text.as_str()) else {
+                return false;
+            };
+            rest = after;
+            t += 1;
+        }
+    }
+    t == said.len()
+}
+
+/// The folder named by the words just before chunk `end`: the longest run
+/// that is the `depth`-th parent folder of one of `files`. Returns where it
+/// starts and the files under it.
+fn folder_before(
+    end: usize,
+    floor: usize,
+    depth: usize,
+    files: &[u32],
+    chunks: &[Chunk],
+    toks: &[Option<Tok>],
+    vocab: &RepoVocab,
+) -> Option<(usize, Vec<u32>)> {
+    let folders: Vec<(u32, String)> = files
+        .iter()
+        .filter_map(|&file| {
+            let folder = vocab.files[file as usize].rsplit('/').nth(depth + 1)?;
+            Some((file, squash(folder)))
+        })
+        .collect();
+    let mut best = None;
+    let mut key = String::new();
+    let mut start = end;
+    while start > floor && end - start < MAX_DIR_WORDS && joined(chunks, toks, start - 1) {
+        start -= 1;
+        let tok = toks[start].as_ref()?;
+        if tok.kind != Kind::Word {
+            break;
+        }
+        key.insert_str(0, &tok.text);
+        let kept: Vec<u32> = folders
+            .iter()
+            .filter(|(_, folder)| *folder == key)
+            .map(|(file, _)| *file)
+            .collect();
+        if !kept.is_empty() {
+            best = Some((start, kept));
+        }
+    }
+    best
+}
+
+/// `VocabCache` → `vocab`, `cache`; `squawk-core` → `squawk`, `core`;
+/// `gpt5` → `gpt`, `5`. An uppercase run gives its last letter to a
+/// following lowercase run (`SQLite` → `sq`, `lite`), as the dictionary does.
+fn jargon_parts(word: &str) -> Vec<String> {
+    let mut parts = Vec::new();
+    for piece in word.split(|c: char| !c.is_alphanumeric()) {
+        let chars: Vec<char> = piece.chars().collect();
+        let mut cur = String::new();
+        for (i, &c) in chars.iter().enumerate() {
+            if i > 0 {
+                let prev = chars[i - 1];
+                let next_lower = chars.get(i + 1).is_some_and(|n| n.is_lowercase());
+                let boundary = (prev.is_lowercase() && c.is_uppercase())
+                    || (prev.is_uppercase() && c.is_uppercase() && next_lower)
+                    || (prev.is_ascii_digit() != c.is_ascii_digit());
+                if boundary && !cur.is_empty() {
+                    parts.push(squash(&cur));
+                    cur.clear();
+                }
+            }
+            cur.push(c);
+        }
+        if !cur.is_empty() {
+            parts.push(squash(&cur));
+        }
+    }
+    parts
+}
+
+/// Each spoken word is one or more whole parts of the term: "vocab cache"
+/// and "vocabcache" are `VocabCache`, "vo cab cache" is not.
+fn on_part_boundaries(said: &[String], parts: &[String]) -> bool {
+    let mut p = 0;
+    for word in said {
+        let mut rest = word.as_str();
+        while !rest.is_empty() {
+            let Some(after) = parts
+                .get(p)
+                .and_then(|part| rest.strip_prefix(part.as_str()))
+            else {
+                return false;
+            };
+            rest = after;
+            p += 1;
+        }
+    }
+    p == parts.len()
+}
+
+fn jargon_pass(chunks: Vec<Chunk>, index: &Index) -> (Vec<Chunk>, bool) {
+    if index.jargon.is_empty() {
+        return (chunks, false);
+    }
+    // Each chunk as a spoken word, with a possessive set aside.
+    let said: Vec<Option<(String, &str)>> = chunks
+        .iter()
+        .map(|chunk| {
+            let (core, possessive) = ["'s", "’s"]
+                .iter()
+                .find_map(|s| Some((chunk.core.strip_suffix(s)?, *s)))
+                .unwrap_or((chunk.core.as_str(), ""));
+            let word = Chunk {
+                lead: String::new(),
+                core: core.to_string(),
+                trail: String::new(),
+            };
+            Some((tok(&word)?.text, possessive))
+        })
+        .collect();
+
+    let mut out = Vec::with_capacity(chunks.len());
+    let mut changed = false;
+    let mut i = 0;
+    'chunks: while i < chunks.len() {
+        let longest = index.max_jargon_words.min(chunks.len() - i);
+        for len in (1..=longest).rev() {
+            let last = i + len - 1;
+            let together = (i..last).all(|a| {
+                said[a].as_ref().is_some_and(|(_, poss)| poss.is_empty())
+                    && said[a + 1].is_some()
+                    && chunks[a].trail.is_empty()
+                    && chunks[a + 1].lead.is_empty()
+            });
+            if !together || said[last].is_none() {
+                continue;
+            }
+            let words: Vec<String> = said[i..=last]
+                .iter()
+                .flatten()
+                .map(|(word, _)| word.clone())
+                .collect();
+            let Some(term) = index.jargon.get(&words.concat()) else {
+                continue;
+            };
+            if (len > 1 && !term.split) || !on_part_boundaries(&words, &term.parts) {
+                continue;
+            }
+            let possessive = said[last].as_ref().map_or("", |(_, poss)| poss);
+            let core = format!("{}{possessive}", term.written);
+            changed |= len > 1 || core != chunks[i].core;
+            out.push(Chunk {
+                lead: chunks[i].lead.clone(),
+                core,
+                trail: chunks[last].trail.clone(),
+            });
+            i = last + 1;
+            continue 'chunks;
+        }
+        out.push(chunks[i].clone());
+        i += 1;
+    }
+    (out, changed)
+}
