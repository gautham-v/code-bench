+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn terms(doc: &str) -> Vec<String> {
+        let mut words = Words::default();
+        doc_terms(doc, &mut words);
+        words.list
+    }
+
+    #[test]
+    fn common_words_are_sorted_for_the_search() {
+        assert!(COMMON.windows(2).all(|w| w[0] < w[1]));
+    }
+
+    #[test]
+    fn capitalised_terms() {
+        let found = terms(
+            "# squawk\n\nLocal dictation for macOS. Built for talking to Claude Code in a\n\
+             terminal. Everything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3.\n\
+             This is IMPORTANT: see `VocabCache` and `cargo test`.\n\n## License\n\nMIT\n",
+        );
+        for want in [
+            "squawk",
+            "macOS",
+            "Claude Code",
+            "Claude",
+            "Mac",
+            "NVIDIA",
+            "Parakeet TDT",
+            "Parakeet",
+            "TDT",
+            "VocabCache",
+            "MIT",
+        ] {
+            assert!(found.iter().any(|w| w == want), "{want} in {found:?}");
+        }
+        for not in [
+            "Local",
+            "Built",
+            "Everything",
+            "Code",
+            "This",
+            "IMPORTANT",
+            "License",
+        ] {
+            assert!(!found.iter().any(|w| w == not), "{not} in {found:?}");
+        }
+    }
+
+    #[test]
+    fn headings() {
+        let found =
+            terms("# Hotkey Engine\n## How it works\n## Getting Started\n```\n# Nope\n```\n");
+        assert_eq!(found, ["Hotkey Engine"]);
+    }
+
+    #[test]
+    fn stems() {
+        assert_eq!(file_stem("status_item.rs"), Some("status_item"));
+        assert_eq!(file_stem("foo.test.ts"), Some("foo"));
+        assert_eq!(file_stem(".gitignore"), None);
+    }
+
+    #[test]
+    fn walks_outside_git() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        std::fs::create_dir_all(root.join("src/ui")).unwrap();
+        std::fs::create_dir_all(root.join("node_modules/x")).unwrap();
+        std::fs::write(root.join("src/ui/theme.rs"), "").unwrap();
+        std::fs::write(root.join("node_modules/x/index.js"), "").unwrap();
+        std::fs::write(root.join("README.md"), "# Demo\n\nUses FluidAudio.\n").unwrap();
+        std::fs::write(
+            root.join("Cargo.toml"),
+            "[package]\nname = \"demo-core\"\nversion = \"0.1.0\"\n",
+        )
+        .unwrap();
+        let vocab = build(root);
+        assert_eq!(vocab.root, root);
+        assert_eq!(vocab.files, ["Cargo.toml", "README.md", "src/ui/theme.rs"]);
+        for want in ["theme", "demo-core", "Demo", "FluidAudio"] {
+            assert!(vocab.words.iter().any(|w| w == want), "{want}");
+        }
+    }
+}
