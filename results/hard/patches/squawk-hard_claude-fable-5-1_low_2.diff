+//! Scanning a repo for what `apply` needs: its files and its jargon.
+//!
+//! Files come from git (tracked, plus untracked files git would not ignore,
+//! so a file Claude just created can be mentioned) or, outside a repo, from
+//! a bounded walk. Jargon comes from file stems, package manifests and the
+//! repo's top-level docs. Everything here errs towards leaving a word out:
+//! a term that is missing costs nothing, a common word mistaken for a term
+//! would be re-cased in every dictation.
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant, SystemTime};
+
+use super::RepoVocab;
+
+/// The docs read for headings and capitalised terms.
+const DOC_FILES: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+const MAX_DOC_BYTES: u64 = 256 * 1024;
+
+const MAX_FILES: usize = 200_000;
+const MAX_MANIFESTS: usize = 64;
+
+/// Limits for the walk outside git.
+const WALK_MAX_FILES: usize = 20_000;
+const WALK_MAX_DEPTH: usize = 10;
+const WALK_BUDGET: Duration = Duration::from_millis(150);
+const WALK_SKIP_DIRS: &[&str] = &[
+    "node_modules",
+    "target",
+    "dist",
+    "build",
+    "vendor",
+    "venv",
+    "__pycache__",
+];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let mut files = git_files(cwd)
+        .filter(|f| !f.is_empty())
+        .unwrap_or_else(|| walk_files(cwd));
+    files.truncate(MAX_FILES);
+
+    let mut words = Words::default();
+    for file in &files {
+        let name = file.rsplit('/').next().unwrap_or(file);
+        if let Some(stem) = file_stem(name) {
+            words.add(stem);
+        }
+    }
+    let mut manifests: Vec<&String> = files.iter().filter(|f| is_manifest(f)).collect();
+    manifests.sort_by_key(|f| f.matches('/').count());
+    for file in manifests.into_iter().take(MAX_MANIFESTS) {
+        if let Some(name) = package_name(&cwd.join(file)) {
+            words.add(&name);
+        }
+    }
+    for doc in DOC_FILES {
+        if let Some(text) = read_capped(&cwd.join(doc)) {
+            doc_terms(&text, &mut words);
+        }
+    }
+
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words: words.list,
+    }
+}
+
+/// Words in first-seen order, no repeats.
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn add(&mut self, word: &str) {
+        let word = word.trim();
+        if !word.is_empty() && self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+/// `status_item` for `status_item.rs`, `foo` for `foo.test.ts`; nothing for
+/// dotfiles.
+pub(super) fn file_stem(name: &str) -> Option<&str> {
+    let stem = name.split('.').next()?;
+    stem.chars().any(char::is_alphabetic).then_some(stem)
+}
+
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        .args([
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+        ])
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let mut files: Vec<String> = out
+        .stdout
+        .split(|&b| b == 0)
+        .filter(|f| !f.is_empty())
+        .filter_map(|f| String::from_utf8(f.to_vec()).ok())
+        .collect();
+    files.sort();
+    files.dedup();
+    Some(files)
+}
+
+fn walk_files(cwd: &Path) -> Vec<String> {
+    let deadline = Instant::now() + WALK_BUDGET;
+    let mut files = Vec::new();
+    let mut dirs: Vec<(PathBuf, String, usize)> = vec![(cwd.to_path_buf(), String::new(), 0)];
+    while let Some((dir, prefix, depth)) = dirs.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            if files.len() >= WALK_MAX_FILES || Instant::now() > deadline {
+                files.sort();
+                return files;
+            }
+            let Ok(name) = entry.file_name().into_string() else {
+                continue;
+            };
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let rel = format!("{prefix}{name}");
+            if kind.is_dir() {
+                let skip = name.starts_with('.') || WALK_SKIP_DIRS.contains(&name.as_str());
+                if !skip && depth < WALK_MAX_DEPTH {
+                    dirs.push((entry.path(), format!("{rel}/"), depth + 1));
+                }
+            } else if kind.is_file() {
+                files.push(rel);
+            }
+        }
+    }
+    files.sort();
+    files
+}
+
+fn read_capped(path: &Path) -> Option<String> {
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > MAX_DOC_BYTES {
+        return None;
+    }
+    std::fs::read_to_string(path).ok()
+}
+
+fn is_manifest(file: &str) -> bool {
+    matches!(
+        file.rsplit('/').next().unwrap_or(file),
+        "Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod"
+    )
+}
+
+fn package_name(path: &Path) -> Option<String> {
+    let text = read_capped(path)?;
+    let name = match path.file_name()?.to_str()? {
+        "Cargo.toml" => {
+            let doc: toml::Value = toml::from_str(&text).ok()?;
+            doc.get("package")?.get("name")?.as_str()?.to_string()
+        }
+        "pyproject.toml" => {
+            let doc: toml::Value = toml::from_str(&text).ok()?;
+            let project = doc.get("project").and_then(|p| p.get("name"));
+            let poetry = || doc.get("tool")?.get("poetry")?.get("name");
+            project.or_else(poetry)?.as_str()?.to_string()
+        }
+        "package.json" => {
+            let doc: serde_json::Value = serde_json::from_str(&text).ok()?;
+            let name = doc.get("name")?.as_str()?;
+            // `@scope/name` is spoken as `name`.
+            name.rsplit('/').next()?.to_string()
+        }
+        "go.mod" => {
+            let module = text
+                .lines()
+                .find_map(|l| l.trim().strip_prefix("module "))?;
+            module.trim().rsplit('/').next()?.to_string()
+        }
+        _ => return None,
+    };
+    (!name.is_empty()).then_some(name)
+}
+
+/// Words too ordinary to be a repo's term, however a doc capitalises them.
