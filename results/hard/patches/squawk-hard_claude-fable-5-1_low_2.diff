+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,414 @@
+//! Finding the agent session under the front terminal.
+//!
+//! The process table is read once (pid, ppid, names, tty), the terminal's
+//! descendants are walked, and the first `claude`/`codex` on each branch is a
+//! session. An agent's own children (subagents, shells it spawned) are not
+//! looked at: the session is the outermost one.
+//!
+//! Naming is the awkward part. A native Claude Code install execs
+//! `~/.local/share/claude/versions/2.1.3`, so the kernel's name for it is
+//! "2.1.3"; an npm install is `node .../claude`. So a process is judged by
+//! its kernel names first and its argv second.
+
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use super::{Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// One row of the process table.
+#[derive(Debug, Clone, Default)]
+pub(super) struct Proc {
+    pub pid: i32,
+    pub ppid: i32,
+    /// The kernel's names for it (`p_comm`, `p_name`).
+    pub names: Vec<String>,
+    /// Controlling terminal device, when it has one.
+    pub tdev: Option<u32>,
+}
+
+/// Runtimes whose first argument is the program that is really running.
+const INTERPRETERS: &[&str] = &["node", "bun", "deno"];
+
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    if !super::is_terminal(&front.bundle_id) {
+        return None;
+    }
+    let table = sys::process_table();
+    let found = agents_under(front.pid, &table, |p| {
+        agent_from_names(&p.names).or_else(|| agent_from_args(&p.names, sys::args(p.pid)?))
+    });
+    found
+        .into_iter()
+        .filter_map(|(i, agent)| {
+            let p = &table[i];
+            let cwd = sys::cwd(p.pid)?;
+            let tty = p.tdev.and_then(sys::tty_path);
+            let used = tty.as_deref().and_then(last_used);
+            Some((
+                used,
+                Session {
+                    agent,
+                    pid: p.pid,
+                    cwd,
+                    tty,
+                },
+            ))
+        })
+        // Most recently used tty; a session without one loses, and a tie
+        // goes to the younger process.
+        .max_by_key(|(used, s)| (*used, s.pid))
+        .map(|(_, s)| s)
+}
+
+/// The outermost agent processes among `root`'s descendants, as indices
+/// into `table`.
+pub(super) fn agents_under(
+    root: i32,
+    table: &[Proc],
+    mut classify: impl FnMut(&Proc) -> Option<Agent>,
+) -> Vec<(usize, Agent)> {
+    let mut children: HashMap<i32, Vec<usize>> = HashMap::new();
+    for (i, p) in table.iter().enumerate() {
+        children.entry(p.ppid).or_default().push(i);
+    }
+    let mut found = Vec::new();
+    let mut seen: HashSet<i32> = HashSet::from([root]);
+    let mut stack = vec![root];
+    while let Some(pid) = stack.pop() {
+        for &i in children.get(&pid).map(Vec::as_slice).unwrap_or(&[]) {
+            let p = &table[i];
+            if !seen.insert(p.pid) {
+                continue;
+            }
+            match classify(p) {
+                Some(agent) => found.push((i, agent)),
+                None => stack.push(p.pid),
+            }
+        }
+    }
+    found
+}
+
+/// `claude`, `codex`, or codex's per-platform binary (`codex-aarch64-apple-darwin`,
+/// cut to 16 bytes by the kernel).
+pub(super) fn agent_from_name(name: &str) -> Option<Agent> {
+    let name = name.rsplit('/').next().unwrap_or(name).to_lowercase();
+    if let Some((_, agent)) = AGENT_PROCESS_NAMES.iter().find(|(n, _)| *n == name) {
+        return Some(*agent);
+    }
+    let arch = name.strip_prefix("codex-")?;
+    (arch.starts_with("aarch64") || arch.starts_with("x86_64")).then_some(Agent::Codex)
+}
+
+fn agent_from_names(names: &[String]) -> Option<Agent> {
+    names.iter().find_map(|n| agent_from_name(n))
+}
+
+/// Judge a process by its executable path and first arguments.
+pub(super) fn agent_from_args(names: &[String], args: (String, Vec<String>)) -> Option<Agent> {
+    let (exe, argv) = args;
+    if exe.contains("/claude/versions/") {
+        return Some(Agent::Claude);
+    }
+    if let Some(agent) = agent_from_name(&exe).or_else(|| agent_from_name(argv.first()?)) {
+        return Some(agent);
+    }
+    let interpreted = names
+        .iter()
+        .chain([&exe])
+        .any(|n| INTERPRETERS.contains(&n.rsplit('/').next().unwrap_or(n)));
+    if !interpreted {
+        return None;
+    }
+    // `node /opt/homebrew/bin/claude`, `node .../@anthropic-ai/claude-code/cli.js`.
+    let script = argv.iter().skip(1).find(|a| !a.starts_with('-'))?;
+    if script.contains("/claude-code/") {
+        return Some(Agent::Claude);
+    }
+    if script.contains("/@openai/codex/") {
+        return Some(Agent::Codex);
+    }
+    let base = script.rsplit('/').next().unwrap_or(script);
+    agent_from_name(base.split('.').next().unwrap_or(base))
+}
+
+/// When the tty last saw input or output.
+fn last_used(tty: &std::path::Path) -> Option<SystemTime> {
+    let meta = std::fs::metadata(tty).ok()?;
+    match (meta.accessed().ok(), meta.modified().ok()) {
+        (Some(a), Some(m)) => Some(a.max(m)),
+        (a, m) => a.or(m),
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    use super::{PathBuf, Proc};
+    use std::ffi::CStr;
+    use std::mem;
+    use std::os::raw::{c_char, c_int, c_void};
+
+    extern "C" {
+        fn devname_r(
+            dev: libc::dev_t,
+            mode: libc::mode_t,
+            buf: *mut c_char,
+            len: c_int,
+        ) -> *mut c_char;
+    }
+
+    fn c_string(bytes: &[c_char]) -> String {
+        let bytes: Vec<u8> = bytes
+            .iter()
+            .take_while(|&&c| c != 0)
+            .map(|&c| c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    pub fn process_table() -> Vec<Proc> {
+        // SAFETY: proc_listallpids fills at most `buffersize` bytes of pids
+        // and proc_pidinfo at most `size` bytes of a plain-data struct.
+        unsafe {
+            let count = libc::proc_listallpids(std::ptr::null_mut(), 0);
+            if count <= 0 {
+                return Vec::new();
+            }
+            let mut pids = vec![0 as libc::pid_t; count as usize + 64];
+            let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as c_int;
+            let n = libc::proc_listallpids(pids.as_mut_ptr() as *mut c_void, bytes);
+            if n <= 0 {
+                return Vec::new();
+            }
+            pids.truncate(n as usize);
+
+            let size = mem::size_of::<libc::proc_bsdinfo>() as c_int;
+            let mut table = Vec::with_capacity(pids.len());
+            for pid in pids {
+                let mut info: libc::proc_bsdinfo = mem::zeroed();
+                let got = libc::proc_pidinfo(
+                    pid,
+                    libc::PROC_PIDTBSDINFO,
+                    0,
+                    &mut info as *mut _ as *mut c_void,
+                    size,
+                );
+                if got != size {
+                    continue;
+                }
+                let mut names = vec![c_string(&info.pbi_name), c_string(&info.pbi_comm)];
+                names.retain(|n| !n.is_empty());
+                names.dedup();
+                table.push(Proc {
+                    pid,
+                    ppid: info.pbi_ppid as i32,
+                    names,
+                    tdev: (info.e_tdev != u32::MAX && info.e_tdev != 0).then_some(info.e_tdev),
+                });
+            }
+            table
+        }
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        // SAFETY: as above; the path is NUL-terminated within MAXPATHLEN.
+        unsafe {
+            let mut info: libc::proc_vnodepathinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_vnodepathinfo>() as c_int;
+            let got = libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            );
+            if got != size {
+                return None;
+            }
+            let path = CStr::from_ptr(info.pvi_cdir.vip_path.as_ptr() as *const c_char);
+            let path = path.to_string_lossy();
+            (!path.is_empty()).then(|| PathBuf::from(path.into_owned()))
+        }
+    }
+
+    /// `/dev/ttys004` for a device number.
+    pub fn tty_path(dev: u32) -> Option<PathBuf> {
+        let mut buf = [0 as c_char; 128];
+        // SAFETY: devname_r writes a NUL-terminated name into `buf`.
+        let name = unsafe {
+            let p = devname_r(
+                dev as libc::dev_t,
+                libc::S_IFCHR,
+                buf.as_mut_ptr(),
+                buf.len() as c_int,
+            );
+            if p.is_null() {
+                return None;
+            }
+            c_string(&buf)
+        };
+        (!name.is_empty() && !name.starts_with('?')).then(|| PathBuf::from("/dev").join(name))
+    }
+
+    /// The executable path and the first few arguments (KERN_PROCARGS2).
+    pub fn args(pid: i32) -> Option<(String, Vec<String>)> {
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        let mut size: libc::size_t = 0;
+        // SAFETY: the first call asks for the size, the second fills at most
+        // `size` bytes of `buf`.
+        let buf = unsafe {
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                std::ptr::null_mut(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+                || size == 0
+            {
+                return None;
+            }
+            let mut buf = vec![0u8; size];
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                buf.as_mut_ptr() as *mut c_void,
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+            {
+                return None;
+            }
+            buf.truncate(size);
+            buf
+        };
+        // argc, exec path, NUL padding, then argv.
+        let argc = i32::from_ne_bytes(buf.get(..4)?.try_into().ok()?).max(0) as usize;
+        let rest = &buf[4..];
+        let exe_end = rest.iter().position(|&b| b == 0)?;
+        let exe = String::from_utf8_lossy(&rest[..exe_end]).into_owned();
+        let rest = &rest[exe_end..];
+        let start = rest.iter().position(|&b| b != 0).unwrap_or(rest.len());
+        let argv = rest[start..]
+            .split(|&b| b == 0)
+            .take(argc.min(4))
+            .map(|a| String::from_utf8_lossy(a).into_owned())
+            .collect();
+        Some((exe, argv))
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+mod sys {
+    use super::{PathBuf, Proc};
+
+    pub fn process_table() -> Vec<Proc> {
+        Vec::new()
+    }
+    pub fn cwd(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+    pub fn tty_path(_dev: u32) -> Option<PathBuf> {
+        None
+    }
+    pub fn args(_pid: i32) -> Option<(String, Vec<String>)> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn p(pid: i32, ppid: i32, name: &str) -> Proc {
+        Proc {
+            pid,
+            ppid,
+            names: vec![name.to_string()],
+            tdev: None,
+        }
+    }
+
+    #[test]
+    fn names() {
+        assert_eq!(agent_from_name("claude"), Some(Agent::Claude));
+        assert_eq!(agent_from_name("/usr/local/bin/codex"), Some(Agent::Codex));
+        assert_eq!(agent_from_name("codex-aarch64-ap"), Some(Agent::Codex));
+        assert_eq!(agent_from_name("claudebar"), None);
+        assert_eq!(agent_from_name("codex-notes"), None);
+        assert_eq!(agent_from_name("zsh"), None);
+    }
+
+    #[test]
+    fn argv_names_a_versioned_or_interpreted_binary() {
+        let args = |exe: &str, argv: &[&str]| {
+            (
+                exe.to_string(),
+                argv.iter().map(|a| a.to_string()).collect::<Vec<_>>(),
+            )
+        };
+        let native = args("/Users/u/.local/share/claude/versions/2.1.3", &["claude"]);
+        assert_eq!(
+            agent_from_args(&["2.1.3".into()], native),
+            Some(Agent::Claude)
+        );
+        let npm = args(
+            "/opt/homebrew/bin/node",
+            &["node", "/opt/homebrew/bin/claude"],
+        );
+        assert_eq!(agent_from_args(&["node".into()], npm), Some(Agent::Claude));
+        let other = args("/opt/homebrew/bin/node", &["node", "server.js", "claude"]);
+        assert_eq!(agent_from_args(&["node".into()], other), None);
+        let grep = args("/usr/bin/grep", &["grep", "claude"]);
+        assert_eq!(agent_from_args(&["grep".into()], grep), None);
+    }
+
+    #[test]
+    fn outermost_agents_under_the_terminal() {
+        let table = vec![
+            p(10, 1, "ghostty"),
+            p(11, 10, "login"),
+            p(12, 11, "zsh"),
+            p(13, 12, "claude"),
+            p(14, 13, "claude"), // a subagent: not a session of its own
+            p(20, 10, "zsh"),
+            p(21, 20, "codex"),
+            p(30, 1, "claude"), // another terminal's
+        ];
+        let mut found: Vec<(i32, Agent)> =
+            agents_under(10, &table, |p| agent_from_name(&p.names[0]))
+                .into_iter()
+                .map(|(i, a)| (table[i].pid, a))
+                .collect();
+        found.sort_by_key(|(pid, _)| *pid);
+        assert_eq!(found, [(13, Agent::Claude), (21, Agent::Codex)]);
+        assert!(agents_under(99, &table, |p| agent_from_name(&p.names[0])).is_empty());
+    }
+
+    #[test]
+    fn not_a_terminal_is_no_session() {
+        let front = FrontApp {
+            bundle_id: "com.apple.Safari".into(),
+            name: "Safari".into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(detect(&front), None);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn reads_this_process() {
+        let me = std::process::id() as i32;
+        let table = sys::process_table();
+        assert!(table.iter().any(|p| p.pid == me));
+        assert_eq!(
+            sys::cwd(me).and_then(|p| p.canonicalize().ok()),
+            std::env::current_dir().unwrap().canonicalize().ok()
+        );
+        let (exe, argv) = sys::args(me).unwrap();
+        assert!(!exe.is_empty() && !argv.is_empty());
+    }
+}
