+//! Numbered lists as the editor keeps them: which lines are items, which
+//! items are siblings, and what their numbers should read after an edit.
+//!
+//! Pure functions on the buffer's lines. A list here is a run of item lines
+//! and their indented continuations; a blank line, a line of plain text at
+//! the margin or a fence ends it, so two lists a blank line apart stay two
+//! lists and an edit in one never reaches the other. Within a run, items at
+//! the same indentation are siblings and a deeper one starts a list of its
+//! own under the item above it.
+
+/// One list item line, taken apart. Everything before the body is ASCII, so
+/// these byte offsets are char columns too.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Item {
+    /// Where the indentation starts: past any `> ` quote bars.
+    pub quote: usize,
+    /// How many quote bars the line is under.
+    pub depth: usize,
+    /// Length of the indentation, and its width in columns.
+    pub indent: usize,
+    pub width: usize,
+    /// The number of a `1.` / `1)` item, and how many digits spell it.
+    pub number: Option<u64>,
+    pub digits: usize,
+    /// `.` or `)` for a numbered item, the bullet itself otherwise.
+    pub delim: char,
+    /// Length of the marker, its trailing space included.
+    pub marker: usize,
+}
+
+impl Item {
+    /// Column the indentation ends and the marker starts at.
+    pub fn marker_start(&self) -> usize {
+        self.quote + self.indent
+    }
+}
+
+/// The quote bars and the indentation in front of `line`: where the
+/// indentation starts, the quote depth, the indentation's length and its
+/// width in columns (a tab runs to the next multiple of four).
+pub fn leading(line: &str) -> (usize, usize, usize, usize) {
+    let bytes = line.as_bytes();
+    let (mut quote, mut depth) = (0, 0);
+    loop {
+        let mut i = quote;
+        while bytes.get(i) == Some(&b' ') {
+            i += 1;
+        }
+        if bytes.get(i) != Some(&b'>') {
+            break;
+        }
+        quote = i + 1;
+        if bytes.get(quote) == Some(&b' ') {
+            quote += 1;
+        }
+        depth += 1;
+    }
+    let (mut indent, mut width) = (0, 0);
+    while let Some(b) = bytes.get(quote + indent) {
+        match b {
+            b' ' => width += 1,
+            b'\t' => width += 4 - width % 4,
+            _ => break,
+        }
+        indent += 1;
+    }
+    (quote, depth, indent, width)
+}
+
+/// `line` as a list item — `- `, `* `, `+ `, `1. `, `1) ` — or `None`.
+pub fn item(line: &str) -> Option<Item> {
+    let (quote, depth, indent, width) = leading(line);
+    let rest = &line[quote + indent..];
+    let first = rest.chars().next()?;
+    let (number, digits, delim) = if matches!(first, '-' | '*' | '+') {
+        (None, 0, first)
+    } else {
+        let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+        let delim = rest[digits..]
+            .chars()
+            .next()
+            .filter(|c| matches!(c, '.' | ')'))?;
+        (Some(rest[..digits].parse().ok()?), digits, delim)
+    };
+    if !rest[digits + 1..].starts_with(' ') {
+        return None;
+    }
+    Some(Item {
+        quote,
+        depth,
+        indent,
+        width,
+        number,
+        digits,
+        delim,
+        marker: digits + 2,
+    })
+}
+
+/// The numbered items that are each other's siblings: one list, without
+/// whatever is nested in it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Group {
+    /// The run of list lines this group sits in.
+    pub block: usize,
+    /// The rows of its items, top to bottom, and the number each carries.
+    pub rows: Vec<usize>,
+    pub numbers: Vec<u64>,
+}
+
+impl Group {
+    fn top(&self) -> usize {
+        self.rows[0]
+    }
+
+    /// Every item numbered the same, `1.` all the way down: a list written
+    /// that way on purpose, which keeps its numbers.
+    fn uniform(&self) -> bool {
+        self.numbers.len() > 1 && self.numbers.iter().all(|n| *n == self.numbers[0])
+    }
+}
+
+/// The lists of a buffer.
+#[derive(Default)]
+pub struct Scan {
+    pub groups: Vec<Group>,
+    /// The run each row belongs to; `None` for a row outside any list.
+    pub blocks: Vec<Option<usize>>,
+    /// Each row that is an item, taken apart.
+    pub items: Vec<Option<Item>>,
+}
+
+impl Scan {
+    fn with_top(&self, row: usize) -> Option<&Group> {
+        self.groups.iter().find(|g| g.top() == row)
+    }
+
+    fn containing(&self, row: usize) -> Option<&Group> {
+        self.groups.iter().find(|g| g.rows.contains(&row))
+    }
+}
+
+/// A list still open while scanning: its indentation, its marker's
+/// delimiter, and the group collecting it when it is numbered.
+struct Open {
+    width: usize,
+    delim: char,
+    group: Option<usize>,
+}
+
+/// Find every list in `lines`. Lines inside a fence are code, never items.
+pub fn scan(lines: &[String]) -> Scan {
+    let mut out = Scan {
+        groups: Vec::new(),
+        blocks: vec![None; lines.len()],
+        items: vec![None; lines.len()],
+    };
+    let mut open: Vec<Open> = Vec::new();
+    // the run being read, and the quote depth it sits at
+    let mut block: Option<(usize, usize)> = None;
+    let mut next_block = 0;
+    let mut fenced = false;
+    for (row, line) in lines.iter().enumerate() {
+        let (quote, depth, _, width) = leading(line);
+        let fence = crate::md::is_fence(&line[quote..]);
+        let found = if fenced || fence { None } else { item(line) };
+        if fence {
+            fenced = !fenced;
+        }
+        let inside = block.filter(|(_, d)| *d == depth);
+        let Some(it) = found else {
+            // indented under an item: its continuation, and the end of any
+            // list nested as deep as it is or deeper
+            match inside {
+                Some((b, _)) if width > 0 && !line[quote..].trim().is_empty() => {
+                    out.blocks[row] = Some(b);
+                    while open.last().is_some_and(|o| o.width >= width) {
+                        open.pop();
+                    }
+                }
+                _ => {
+                    block = None;
+                    open.clear();
+                }
+            }
+            continue;
+        };
+        let b = match inside {
+            Some((b, _)) => b,
+            None => {
+                open.clear();
+                next_block += 1;
+                block = Some((next_block, depth));
+                next_block
+            }
+        };
+        out.blocks[row] = Some(b);
+        // bullets are one kind whichever character draws them
+        let delim = if it.number.is_some() { it.delim } else { '-' };
+        while open.last().is_some_and(|o| o.width > it.width) {
+            open.pop();
+        }
+        // a different kind of marker at the same depth is a new list
+        if open
+            .last()
+            .is_some_and(|o| o.width == it.width && o.delim != delim)
+        {
+            open.pop();
+        }
+        if !open.last().is_some_and(|o| o.width == it.width) {
+            let group = it.number.map(|_| {
+                out.groups.push(Group {
+                    block: b,
+                    rows: Vec::new(),
+                    numbers: Vec::new(),
+                });
+                out.groups.len() - 1
+            });
+            open.push(Open {
+                width: it.width,
+                delim,
+                group,
+            });
+        }
+        if let (Some(n), Some(g)) = (it.number, open.last().and_then(|o| o.group)) {
+            out.groups[g].rows.push(row);
+            out.groups[g].numbers.push(n);
+        }
+        out.items[row] = Some(it);
+    }
+    out
+}
+
+/// One edit, as the renumbering needs to know it.
+pub struct Edit<'a> {
+    /// The lists as they stood before it.
+    pub before: &'a Scan,
+    /// The rows the cursor and selection covered before it.
+    pub from: usize,
+    pub to: usize,
+    /// The rows they cover after it, `from` included.
+    pub lo: usize,
+    pub hi: usize,
+    /// How many lines it added, or took away.
+    pub delta: isize,
+    /// Whether a list the edit made starts at 1: nesting an item does,
+    /// where a pasted list keeps the numbers it came with.
+    pub fresh: bool,
+}
+
+/// A marker rewritten on `row`: the column its digits used to end at, and
+/// how many columns everything after them moved by.
+pub struct Moved {
+    pub row: usize,
+    pub at: usize,
+    pub by: isize,
+}
+
+/// Put the numbers of the lists `edit` touched back in sequence. A list
+/// counts from where it started before the edit; one whose items all carried
+/// the same number keeps that number on every item; and a list the edit left
+/// with the numbers it had is not looked at twice, however they read.
+pub fn renumber(lines: &mut [String], edit: &Edit) -> Vec<Moved> {
+    let after = scan(lines);
+    let last = lines.len().saturating_sub(1);
+    let near = edit.lo.saturating_sub(1)..=(edit.hi + 1).min(last);
+    let touched: Vec<usize> = after.blocks[near].iter().flatten().copied().collect();
+    let mut moved = Vec::new();
+    for g in after.groups.iter().filter(|g| touched.contains(&g.block)) {
+        let was = origin(g, edit);
+        let n = g.numbers.len();
+        // a list of ones stays one; and a single item cannot say which it
+        // is, so the lists the rest came out of speak for it: the two halves
+        // of a list of ones, joined back up, are a list of ones again
+        let ones = |w: &Group| {
+            w.uniform()
+                || w.numbers.len() == 1
+                    && g.rows
+                        .iter()
+                        .filter_map(|r| edit.before.containing(old_row(*r, edit)?))
+                        .any(|k| k.uniform() && k.numbers[0] == w.numbers[0])
+        };
+        let want: Vec<u64> = match was {
+            Some(w) if w.numbers == g.numbers => continue,
+            Some(w) if ones(w) => vec![w.numbers[0]; n],
+            Some(w) => (w.numbers[0]..).take(n).collect(),
+            None if edit.fresh && !g.uniform() => (1..).take(n).collect(),
+            None => continue,
+        };
+        for ((&row, &have), want) in g.rows.iter().zip(&g.numbers).zip(want) {
+            if have == want {
+                continue;
+            }
+            let Some(it) = item(&lines[row]) else {
+                continue;
+            };
+            let start = it.marker_start();
+            let text = want.to_string();
+            lines[row].replace_range(start..start + it.digits, &text);
+            moved.push(Moved {
+                row,
+                at: start + it.digits,
+                by: text.len() as isize - it.digits as isize,
+            });
+        }
+    }
+    moved
+}
+
+/// The row a line was on before the edit: where it is now above the edit,
+/// as many lines off as the edit added below it, and nowhere in between.
+fn old_row(row: usize, edit: &Edit) -> Option<usize> {
+    if edit.delta == 0 || row <= edit.from {
+        Some(row)
+    } else if row > edit.hi {
+        usize::try_from(row as isize - edit.delta).ok()
+    } else {
+        None
+    }
+}
+
+/// The list `g` was before the edit, if it was one. Lists are told apart by
+/// the row their first item is on: above the edit that row is where it was,
+/// below it the row has moved by as many lines as the edit added. A list
+/// whose head the edit removed is the one its new first item belonged to.
+fn origin<'a>(g: &Group, edit: &'a Edit) -> Option<&'a Group> {
+    let old = old_row(g.rows[0], edit)?;
+    edit.before.with_top(old).or_else(|| {
+        edit.before
+            .containing(old)
+            .filter(|w| (edit.from..=edit.to).contains(&w.rows[0]))
+    })
+}
