+    /// for an edit that makes a list of its own out of an item, which then
+    /// starts at 1. The cursor keeps its place on a line whose marker grew.
+    fn relisting<R>(&mut self, fresh: bool, edit: impl FnOnce(&mut Self) -> R) -> R {
+        let before = lists::scan(&self.lines);
+        let count = self.lines.len();
+        let (from, to) = self.span();
+        let out = edit(self);
+        let (lo, hi) = self.span();
+        let edit = lists::Edit {
+            before: &before,
+            from,
+            to,
+            lo: lo.min(from),
+            hi,
+            delta: self.lines.len() as isize - count as isize,
+            fresh,
+        };
