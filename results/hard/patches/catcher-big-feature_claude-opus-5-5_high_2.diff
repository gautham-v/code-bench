+    fn siblings_share_an_indent_and_nesting_starts_a_list() {
+        assert_eq!(
+            numbers("1. a\n   1. x\n   2. y\n2. b\n   continued\n3. c"),
+            [vec![1, 2, 3], vec![1, 2]]
+        );
+        // a bullet between two numbers, or the other delimiter, splits them
+        assert_eq!(numbers("1. a\n- b\n1. c"), [vec![1], vec![1]]);
+        assert_eq!(numbers("1. a\n2) b"), [vec![1], vec![2]]);
+    }
+
+    #[test]
+    fn a_blank_line_text_at_the_margin_or_a_fence_ends_a_list() {
+        assert_eq!(numbers("1. a\n\n2. b"), [vec![1], vec![2]]);
+        assert_eq!(numbers("1. a\ntext\n2. b"), [vec![1], vec![2]]);
+        assert_eq!(numbers("1. a\n> 2. b\n> 3. c"), [vec![1], vec![2, 3]]);
+        assert!(numbers("```\n1. a\n2. b\n```").is_empty());
+    }
+}
