+//! Finding the agent session behind the front terminal.
+//!
+//! The process table is read once, the terminal's descendants are walked
+//! breadth-first, and every `claude`/`codex` found is a candidate. A
+//! terminal with several tabs has several; the one the user is looking at
+//! cannot be read without Accessibility, so the tty that last took input
+//! (its device's atime, then mtime) stands in for it.
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::path::{Path, PathBuf};
+
+use super::{is_terminal, Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// One row of the process table: what the walk needs.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Proc {
+    pub pid: i32,
+    pub ppid: i32,
+    pub pgid: i32,
+    /// Foreground process group of the controlling tty, 0 if unknown.
+    pub tpgid: i32,
+    /// Controlling tty device number, if it has one.
+    pub tdev: Option<u64>,
+    pub name: String,
+}
+
+pub(crate) fn detect(front: &FrontApp) -> Option<Session> {
+    if !is_terminal(&front.bundle_id) || front.pid <= 0 {
+        return None;
+    }
+    let procs = sys::list();
+    let mut found: Vec<(Rank, &Proc, Agent, Option<PathBuf>)> = descendants(&procs, front.pid)
+        .into_iter()
+        .map(|(order, proc, agent)| {
+            let tty = sys::tty(proc);
+            (rank(proc, tty.as_deref(), order), proc, agent, tty)
+        })
+        .collect();
+    found.sort_by_key(|f| std::cmp::Reverse(f.0));
+    // A process whose cwd cannot be read (gone already, another user's) is
+    // no use; the next best one is.
+    found.into_iter().find_map(|(_, proc, agent, tty)| {
+        Some(Session {
+            agent,
+            pid: proc.pid,
+            cwd: sys::cwd(proc.pid)?,
+            tty,
+        })
+    })
+}
+
+/// Agents under `root`, in breadth-first order. The walk does not go below
+/// an agent: what it spawns (tools, a nested `claude -p`) is not a session
+/// the user is typing into.
+fn descendants(procs: &[Proc], root: i32) -> Vec<(usize, &Proc, Agent)> {
+    let mut children: HashMap<i32, Vec<&Proc>> = HashMap::new();
+    for p in procs {
+        children.entry(p.ppid).or_default().push(p);
+    }
+    let mut out = Vec::new();
+    let mut seen: HashSet<i32> = HashSet::from([root]);
+    let mut queue: VecDeque<i32> = VecDeque::from([root]);
+    while let Some(pid) = queue.pop_front() {
+        for p in children.get(&pid).map(Vec::as_slice).unwrap_or_default() {
+            if !seen.insert(p.pid) {
+                continue;
+            }
+            match agent_of(p) {
+                Some(agent) => out.push((out.len(), *p, agent)),
+                None => queue.push_back(p.pid),
+            }
+        }
+    }
+    out
+}
+
+/// Higher is better: in the foreground of its tty, then the tty that took
+/// input last, then the one written to last, then the shallower process.
+type Rank = (bool, (i64, i64), (i64, i64), std::cmp::Reverse<usize>);
+
+fn rank(proc: &Proc, tty: Option<&Path>, order: usize) -> Rank {
+    let (atime, mtime) = tty.and_then(tty_times).unwrap_or_default();
+    let foreground = proc.tdev.is_some() && proc.tpgid != 0 && proc.tpgid == proc.pgid;
+    (foreground, atime, mtime, std::cmp::Reverse(order))
+}
+
+#[cfg(unix)]
+fn tty_times(tty: &Path) -> Option<((i64, i64), (i64, i64))> {
+    use std::os::unix::fs::MetadataExt;
+    let m = std::fs::metadata(tty).ok()?;
+    Some(((m.atime(), m.atime_nsec()), (m.mtime(), m.mtime_nsec())))
+}
+
+#[cfg(not(unix))]
+fn tty_times(_tty: &Path) -> Option<((i64, i64), (i64, i64))> {
+    None
+}
+
+fn agent_of(proc: &Proc) -> Option<Agent> {
+    if let Some(agent) = agent_named(&proc.name) {
+        return Some(agent);
+    }
+    let exe = sys::exe(proc.pid);
+    // The args are only read for interpreters: `node …/bin/claude`.
+    let interpreted = is_interpreter(&proc.name)
+        || exe
+            .as_deref()
+            .and_then(base_name)
+            .is_some_and(is_interpreter);
+    let args = if interpreted {
+        sys::args(proc.pid)
+    } else {
+        Vec::new()
+    };
+    classify(exe.as_deref(), &args)
+}
+
+/// A process name that is exactly an agent's.
+fn agent_named(name: &str) -> Option<Agent> {
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(n, _)| *n == name)
+        .map(|(_, agent)| *agent)
+}
+
+fn is_interpreter(name: &str) -> bool {
+    matches!(name, "node" | "nodejs" | "bun" | "deno")
+}
+
+fn base_name(path: &Path) -> Option<&str> {
+    path.file_name()?.to_str()
+}
+
+/// For a process whose name says nothing: the executable (`…/bin/claude`,
+/// the native installer's `…/claude/versions/2.1.0`), or the script an
+/// interpreter is running (`node …/@openai/codex/bin/codex.js`).
+fn classify(exe: Option<&Path>, args: &[String]) -> Option<Agent> {
+    if let Some(exe) = exe {
+        if let Some(agent) = base_name(exe).and_then(agent_named) {
+            return Some(agent);
+        }
+        if exe.to_string_lossy().contains("/claude/versions/") {
+            return Some(Agent::Claude);
+        }
+    }
+    if let Some(agent) = args
+        .first()
+        .and_then(|a| base_name(Path::new(a)))
+        .and_then(agent_named)
+    {
+        return Some(agent);
+    }
+    let script = args.iter().skip(1).find(|a| !a.starts_with('-'))?;
+    if let Some(agent) = Path::new(script)
+        .file_stem()
+        .and_then(|s| s.to_str())
+        .and_then(agent_named)
+    {
+        return Some(agent);
+    }
+    if script.contains("/@anthropic-ai/claude-code/") {
+        return Some(Agent::Claude);
+    }
+    if script.contains("/@openai/codex/") {
+        return Some(Agent::Codex);
+    }
+    None
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    use std::ffi::{c_void, OsString};
+    use std::mem;
+    use std::os::unix::ffi::OsStringExt;
+    use std::os::unix::fs::{FileTypeExt, MetadataExt};
+    use std::path::PathBuf;
+
+    use super::Proc;
+
+    const PROC_ALL_PIDS: u32 = 1;
+    const NODEV: u32 = u32::MAX;
+    const KERN_ARGMAX: libc::c_int = 8;
+
+    pub fn list() -> Vec<Proc> {
+        // SAFETY: a null buffer asks for the size; the second call writes at
+        // most `bytes` into a buffer that long.
+        let pids = unsafe {
+            let need = libc::proc_listpids(PROC_ALL_PIDS, 0, std::ptr::null_mut(), 0);
+            if need <= 0 {
+                return Vec::new();
+            }
+            // Room for processes born between the two calls.
+            let mut pids =
+                vec![0 as libc::pid_t; need as usize / mem::size_of::<libc::pid_t>() + 64];
+            let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as libc::c_int;
+            let got = libc::proc_listpids(PROC_ALL_PIDS, 0, pids.as_mut_ptr().cast(), bytes);
+            pids.truncate(got.max(0) as usize / mem::size_of::<libc::pid_t>());
+            pids
+        };
+        pids.into_iter()
+            .filter(|pid| *pid > 0)
+            .filter_map(info)
+            .collect()
+    }
+
+    fn info(pid: libc::pid_t) -> Option<Proc> {
+        // SAFETY: both structs are plain data, valid when zeroed, and
+        // proc_pidinfo writes at most the size it is given.
+        unsafe {
+            let mut bsd: libc::proc_bsdinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_bsdinfo>() as libc::c_int;
+            let ptr = (&mut bsd as *mut libc::proc_bsdinfo).cast::<c_void>();
+            if libc::proc_pidinfo(pid, libc::PROC_PIDTBSDINFO, 0, ptr, size) == size {
+                let name = match text(&bsd.pbi_name) {
+                    name if name.is_empty() => text(&bsd.pbi_comm),
+                    name => name,
+                };
+                return Some(Proc {
+                    pid,
+                    ppid: bsd.pbi_ppid as i32,
+                    pgid: bsd.pbi_pgid as i32,
+                    tpgid: bsd.e_tpgid as i32,
+                    tdev: (bsd.e_tdev != NODEV && bsd.e_tdev != 0).then_some(bsd.e_tdev as u64),
+                    name,
+                });
+            }
+            // Another user's process (`login`, between Terminal.app and the
+            // shell): the short form still gives the parent, which is what
+            // keeps the tree connected.
+            let mut short: libc::proc_bsdshortinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_bsdshortinfo>() as libc::c_int;
+            let ptr = (&mut short as *mut libc::proc_bsdshortinfo).cast::<c_void>();
+            if libc::proc_pidinfo(pid, libc::PROC_PIDT_SHORTBSDINFO, 0, ptr, size) == size {
+                return Some(Proc {
+                    pid,
+                    ppid: short.pbsi_ppid as i32,
+                    pgid: short.pbsi_pgid as i32,
+                    tpgid: 0,
+                    tdev: None,
+                    name: text(&short.pbsi_comm),
+                });
+            }
+        }
+        None
+    }
+
+    fn text(raw: &[libc::c_char]) -> String {
+        let bytes: Vec<u8> = raw
+            .iter()
+            .take_while(|c| **c != 0)
+            .map(|c| *c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    pub fn exe(pid: i32) -> Option<PathBuf> {
+        let mut buf = vec![0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        // SAFETY: proc_pidpath writes at most `buf.len()` bytes.
+        let n = unsafe { libc::proc_pidpath(pid, buf.as_mut_ptr().cast(), buf.len() as u32) };
+        if n <= 0 {
+            return None;
+        }
+        buf.truncate(n as usize);
+        Some(PathBuf::from(OsString::from_vec(buf)))
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        // SAFETY: plain data, valid when zeroed; proc_pidinfo writes at most
+        // `size` bytes, and the path is read as bytes up to its NUL.
+        let bytes = unsafe {
+            let mut info: libc::proc_vnodepathinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_vnodepathinfo>() as libc::c_int;
+            let ptr = (&mut info as *mut libc::proc_vnodepathinfo).cast::<c_void>();
+            if libc::proc_pidinfo(pid, libc::PROC_PIDVNODEPATHINFO, 0, ptr, size) != size {
+                return None;
+            }
+            let path = &info.pvi_cdir.vip_path;
+            let raw =
+                std::slice::from_raw_parts(path.as_ptr().cast::<u8>(), mem::size_of_val(path));
+            raw.iter()
+                .take_while(|b| **b != 0)
+                .copied()
+                .collect::<Vec<u8>>()
+        };
+        (!bytes.is_empty()).then(|| PathBuf::from(OsString::from_vec(bytes)))
+    }
+
+    /// argv, from `sysctl kern.procargs2`: argc, the exec path, padding,
+    /// then the arguments, each NUL-terminated.
+    pub fn args(pid: i32) -> Vec<String> {
+        // SAFETY: sysctl writes at most `len` bytes and updates `len`.
+        let buf = unsafe {
+            let mut argmax: libc::c_int = 0;
+            let mut len = mem::size_of::<libc::c_int>();
+            let mut mib = [libc::CTL_KERN, KERN_ARGMAX];
+            let argmax_ptr = (&mut argmax as *mut libc::c_int).cast::<c_void>();
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                2,
+                argmax_ptr,
+                &mut len,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+                || argmax <= 0
+            {
+                return Vec::new();
+            }
+            let mut buf = vec![0u8; argmax as usize];
+            let mut len = buf.len();
+            let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                buf.as_mut_ptr().cast(),
+                &mut len,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+            {
+                return Vec::new();
+            }
+            buf.truncate(len);
+            buf
+        };
+        let Some(argc) = buf
+            .get(..4)
+            .map(|b| i32::from_ne_bytes([b[0], b[1], b[2], b[3]]))
+        else {
+            return Vec::new();
+        };
+        let rest = &buf[4..];
+        let path_end = rest.iter().position(|b| *b == 0).unwrap_or(rest.len());
+        let rest = &rest[path_end..];
+        let args_start = rest.iter().position(|b| *b != 0).unwrap_or(rest.len());
+        rest[args_start..]
+            .split(|b| *b == 0)
+            .take(argc.max(0) as usize)
+            .map(|a| String::from_utf8_lossy(a).into_owned())
+            .collect()
+    }
+
+    /// The tty's path. A pty slave is `/dev/ttysNNN` with NNN its minor
+    /// number; anything else is looked up in /dev by device number.
+    /// (`devname(3)` answers from a static buffer, which two threads would
+    /// share.)
+    pub fn tty(proc: &Proc) -> Option<PathBuf> {
+        let dev = proc.tdev?;
+        let is_dev = |path: &PathBuf| {
+            std::fs::metadata(path).is_ok_and(|m| m.file_type().is_char_device() && m.rdev() == dev)
+        };
+        let guess = PathBuf::from(format!("/dev/ttys{:03}", dev & 0x00ff_ffff));
+        if is_dev(&guess) {
+            return Some(guess);
+        }
+        std::fs::read_dir("/dev")
+            .ok()?
+            .flatten()
+            .filter(|e| e.file_name().to_string_lossy().starts_with("tty"))
+            .map(|e| e.path())
+            .find(is_dev)
+    }
+}
+
+#[cfg(target_os = "linux")]
+mod sys {
+    use std::path::PathBuf;
+
+    use super::Proc;
+
+    pub fn list() -> Vec<Proc> {
+        let Ok(dir) = std::fs::read_dir("/proc") else {
+            return Vec::new();
+        };
+        dir.flatten()
+            .filter_map(|e| e.file_name().to_str()?.parse::<i32>().ok())
+            .filter_map(info)
+            .collect()
+    }
+
+    /// `/proc/<pid>/stat`: `pid (comm) state ppid pgrp session tty_nr tpgid …`.
+    /// The comm may hold spaces and parentheses, so split at the last `)`.
+    fn info(pid: i32) -> Option<Proc> {
+        let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+        let open = stat.find('(')?;
+        let close = stat.rfind(')')?;
+        let fields: Vec<&str> = stat.get(close + 1..)?.split_whitespace().collect();
+        let tty_nr: i64 = fields.get(4)?.parse().ok()?;
+        Some(Proc {
+            pid,
+            ppid: fields.get(1)?.parse().ok()?,
+            pgid: fields.get(2)?.parse().ok()?,
+            tpgid: fields.get(5)?.parse::<i32>().ok()?.max(0),
+            tdev: (tty_nr > 0).then_some(tty_nr as u64),
+            name: stat.get(open + 1..close)?.to_string(),
+        })
+    }
+
+    pub fn exe(pid: i32) -> Option<PathBuf> {
+        std::fs::read_link(format!("/proc/{pid}/exe")).ok()
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        std::fs::read_link(format!("/proc/{pid}/cwd")).ok()
+    }
+
+    pub fn args(pid: i32) -> Vec<String> {
+        let Ok(raw) = std::fs::read(format!("/proc/{pid}/cmdline")) else {
+            return Vec::new();
+        };
+        raw.split(|b| *b == 0)
+            .filter(|a| !a.is_empty())
+            .map(|a| String::from_utf8_lossy(a).into_owned())
+            .collect()
+    }
+
+    /// The controlling tty is almost always what stdin is.
+    pub fn tty(proc: &Proc) -> Option<PathBuf> {
+        proc.tdev?;
+        (0..=2)
+            .filter_map(|fd| std::fs::read_link(format!("/proc/{}/fd/{fd}", proc.pid)).ok())
+            .find(|p| p.starts_with("/dev/pts") || p.to_string_lossy().starts_with("/dev/tty"))
+    }
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+mod sys {
+    use std::path::PathBuf;
+
+    use super::Proc;
+
+    pub fn list() -> Vec<Proc> {
+        Vec::new()
+    }
+
+    pub fn exe(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+
+    pub fn cwd(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+
+    pub fn args(_pid: i32) -> Vec<String> {
+        Vec::new()
+    }
+
+    pub fn tty(_proc: &Proc) -> Option<PathBuf> {
+        None
+    }
+}
