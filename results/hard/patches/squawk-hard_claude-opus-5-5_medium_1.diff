@@ -0,0 +1,950 @@
+//! Scanning a repo: the files a mention may point at and the words it
+//! spells its own way.
+//!
+//! Files come from the git index, read directly (no `git` process on the
+//! dictation path; `/usr/bin/git` on a Mac without the developer tools is a
+//! dialog, not a program). Words come from the manifests, the top-level
+//! docs and the file names. Both are picked timidly: a word only goes in
+//! when the repo plainly writes it one way.
+
+use std::collections::{HashSet, VecDeque};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant, SystemTime};
+
+use super::mentions;
+use super::RepoVocab;
+use crate::text::{self, Chunk};
+
+/// Docs read for terms, at the root only.
+const DOCS: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+/// Nothing bigger than this is read for words.
+const MAX_READ: u64 = 256 * 1024;
+const MAX_MANIFESTS: usize = 40;
+const MAX_WORDS: usize = 4000;
+/// Above this, tracked files are not checked against the disk.
+const MAX_STAT: usize = 20_000;
+
+const WALK_MAX_FILES: usize = 5000;
+const WALK_MAX_DEPTH: usize = 6;
+const WALK_BUDGET: Duration = Duration::from_millis(150);
+/// Directories a walk outside git never enters (besides dot-directories).
+const WALK_SKIP: &[&str] = &[
+    "node_modules",
+    "target",
+    "build",
+    "dist",
+    "out",
+    "vendor",
+    "venv",
+    "__pycache__",
+    "Pods",
+    "DerivedData",
+];
+
+/// All-caps words that are emphasis, not acronyms.
+const SHOUTED: &[&str] = &[
+    "AFTER",
+    "ALL",
+    "ALWAYS",
+    "AND",
+    "ANY",
+    "ARE",
+    "AS",
+    "AT",
+    "BE",
+    "BEFORE",
+    "BY",
+    "CAN",
+    "CANNOT",
+    "CAUTION",
+    "CRITICAL",
+    "DO",
+    "DONE",
+    "EVER",
+    "EVERY",
+    "FIXME",
+    "FOR",
+    "HERE",
+    "IF",
+    "IMPORTANT",
+    "IN",
+    "IS",
+    "IT",
+    "MAY",
+    "MUST",
+    "NEVER",
+    "NEW",
+    "NO",
+    "NOT",
+    "NOTE",
+    "NOW",
+    "OF",
+    "OK",
+    "ON",
+    "ONLY",
+    "OPTIONAL",
+    "OR",
+    "OWNED",
+    "PLEASE",
+    "READ",
+    "REQUIRED",
+    "SHALL",
+    "SHOULD",
+    "STOP",
+    "STUB",
+    "TBD",
+    "THE",
+    "THIS",
+    "TIP",
+    "TO",
+    "TODO",
+    "USE",
+    "WARNING",
+    "WILL",
+    "WIP",
+    "WITH",
+    "WITHOUT",
+    "YES",
+    "YOU",
+    "YOUR",
+];
+
+pub(crate) fn build(cwd: &Path) -> RepoVocab {
+    let abs = resolve(cwd);
+    let files = git_files(&abs)
+        .filter(|files| !files.is_empty())
+        .unwrap_or_else(|| walk(&abs));
+    let words = words(&abs, &files);
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words,
+    }
+}
+
+fn resolve(cwd: &Path) -> PathBuf {
+    cwd.canonicalize()
+        .or_else(|_| std::path::absolute(cwd))
+        .unwrap_or_else(|_| cwd.to_path_buf())
+}
+
+/// What `VocabCache` compares to decide whether a vocab is still good.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Stamp {
+    /// `.git/index` mtime and size, inside git.
+    index: Option<(SystemTime, u64)>,
+    /// The directory's own mtime, outside git.
+    root: Option<SystemTime>,
+    docs: Vec<Option<SystemTime>>,
+}
+
+impl Stamp {
+    /// How long a vocab is trusted with an unchanged stamp. The index does
+    /// not move when a file is renamed or deleted by hand, and outside git
+    /// nothing moves at all, so neither is trusted forever.
+    pub(crate) fn max_age(&self) -> Duration {
+        if self.index.is_some() {
+            Duration::from_secs(60)
+        } else {
+            Duration::from_secs(10)
+        }
+    }
+}
+
+pub(crate) fn stamp(cwd: &Path) -> Stamp {
+    let abs = resolve(cwd);
+    let mtime = |path: &Path| std::fs::metadata(path).and_then(|m| m.modified()).ok();
+    let index = find_git(&abs)
+        .and_then(|git| std::fs::metadata(git.index).ok())
+        .and_then(|m| Some((m.modified().ok()?, m.len())));
+    Stamp {
+        root: if index.is_none() { mtime(&abs) } else { None },
+        index,
+        docs: DOCS.iter().map(|doc| mtime(&abs.join(doc))).collect(),
+    }
+}
+
+struct Git {
+    /// The worktree's top directory: index paths are relative to it.
+    top: PathBuf,
+    index: PathBuf,
+}
+
+/// The repo `abs` is in: the nearest ancestor with a `.git` directory, or a
+/// `.git` file pointing at one (a worktree, a submodule).
+fn find_git(abs: &Path) -> Option<Git> {
+    for dir in abs.ancestors() {
+        let dot = dir.join(".git");
+        let Ok(meta) = std::fs::metadata(&dot) else {
+            continue;
+        };
+        let git_dir = if meta.is_dir() {
+            dot
+        } else {
+            let pointer = std::fs::read_to_string(&dot).ok()?;
+            let target = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+            dir.join(target.trim())
+        };
+        return Some(Git {
+            top: dir.to_path_buf(),
+            index: git_dir.join("index"),
+        });
+    }
+    None
+}
+
+/// Tracked files under `abs`, relative to it, that are still on disk.
+/// `None` outside git.
+fn git_files(abs: &Path) -> Option<Vec<String>> {
+    let git = find_git(abs)?;
+    let listed = match std::fs::read(&git.index) {
+        Ok(data) => parse_index(&data).map(|paths| {
+            let mut prefix = abs
+                .strip_prefix(&git.top)
+                .map(|p| p.to_string_lossy().replace('\\', "/"))
+                .unwrap_or_default();
+            if !prefix.is_empty() {
+                prefix.push('/');
+            }
+            paths
+                .into_iter()
+                .filter_map(|p| p.strip_prefix(prefix.as_str()).map(str::to_string))
+                .collect::<Vec<_>>()
+        }),
+        // No index yet: a repo with nothing added.
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Some(Vec::new()),
+        Err(_) => None,
+    };
+    // An index this does not read (split, sha256, a future version) is
+    // git's to list.
+    let mut files = listed.or_else(|| ls_files(abs))?;
+    if files.len() <= MAX_STAT {
+        files.retain(|f| abs.join(f).symlink_metadata().is_ok());
+    }
+    Some(files)
+}
+
+/// The paths in a git index (versions 2 to 4), in index order. Submodules,
+/// sparse directories and skip-worktree entries are not files here. `None`
+/// for anything unexpected.
+fn parse_index(data: &[u8]) -> Option<Vec<String>> {
+    let be32 = |at: usize| Some(u32::from_be_bytes(data.get(at..at + 4)?.try_into().ok()?));
+    let be16 = |at: usize| Some(u16::from_be_bytes(data.get(at..at + 2)?.try_into().ok()?));
+    let nul_from = |at: usize| Some(at + data.get(at..)?.iter().position(|b| *b == 0)?);
+
+    if data.get(..4)? != b"DIRC" {
+        return None;
+    }
+    let version = be32(4)?;
+    if !(2..=4).contains(&version) {
+        return None;
+    }
+    let count = be32(8)? as usize;
+    let mut paths: Vec<String> = Vec::with_capacity(count.min(1 << 20));
+    let mut path: Vec<u8> = Vec::new();
+    let mut pos = 12;
+    for _ in 0..count {
+        let mode = be32(pos + 24)?;
+        let flags = be16(pos + 60)?;
+        let mut at = pos + 62;
+        let mut skip_worktree = false;
+        if flags & 0x4000 != 0 {
+            if version < 3 {
+                return None;
+            }
+            skip_worktree = be16(at)? & 0x4000 != 0;
+            at += 2;
+        }
+        if version == 4 {
+            // Prefix-compressed: how much of the previous path to drop,
+            // then the new tail.
+            let mut byte = *data.get(at)?;
+            at += 1;
+            let mut strip = (byte & 0x7f) as usize;
+            while byte & 0x80 != 0 {
+                byte = *data.get(at)?;
+                at += 1;
+                strip = ((strip + 1) << 7) + (byte & 0x7f) as usize;
+            }
+            let keep = path.len().checked_sub(strip)?;
+            let nul = nul_from(at)?;
+            path.truncate(keep);
+            path.extend_from_slice(&data[at..nul]);
+            pos = nul + 1;
+        } else {
+            let nul = nul_from(at)?;
+            path.clear();
+            path.extend_from_slice(&data[at..nul]);
+            // NUL-padded so the entry is a multiple of eight bytes.
+            pos += (nul - pos + 8) & !7;
+        }
+        let declared = (flags & 0x0fff) as usize;
+        if declared < 0x0fff && declared != path.len() {
+            return None;
+        }
+        match mode >> 12 {
+            0o10 | 0o12 => {}
+            0o16 | 0o04 => continue,
+            _ => return None,
+        }
+        if skip_worktree {
+            continue;
+        }
+        let Ok(p) = std::str::from_utf8(&path) else {
+            continue;
+        };
+        // A conflicted path is there once per stage.
+        if paths.last().map(String::as_str) != Some(p) {
+            paths.push(p.to_string());
+        }
+    }
+    // Extensions, up to the trailing checksum. A split index keeps most
+    // entries in another file.
+    let end = data.len().saturating_sub(20);
+    while pos + 8 <= end {
+        if &data[pos..pos + 4] == b"link" {
+            return None;
+        }
+        pos += 8 + be32(pos + 4)? as usize;
+    }
+    Some(paths)
+}
+
+fn ls_files(abs: &Path) -> Option<Vec<String>> {
+    let out = std::process::Command::new("git")
+        .arg("-C")
+        .arg(abs)
+        .args(["ls-files", "-z"])
+        .stdin(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    Some(
+        out.stdout
+            .split(|b| *b == 0)
+            .filter(|p| !p.is_empty())
+            .filter_map(|p| std::str::from_utf8(p).ok().map(str::to_string))
+            .collect(),
+    )
+}
+
+/// Outside git: a breadth-first walk, so that when a bound cuts it short it
+/// is the deep files that are missing.
+fn walk(abs: &Path) -> Vec<String> {
+    let started = Instant::now();
+    let mut files = Vec::new();
+    let mut queue: VecDeque<(PathBuf, String, usize)> =
+        VecDeque::from([(abs.to_path_buf(), String::new(), 0)]);
+    'dirs: while let Some((dir, prefix, depth)) = queue.pop_front() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            if files.len() >= WALK_MAX_FILES || started.elapsed() > WALK_BUDGET {
+                break 'dirs;
+            }
+            let Ok(name) = entry.file_name().into_string() else {
+                continue;
+            };
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            if kind.is_dir() {
+                if depth < WALK_MAX_DEPTH
+                    && !name.starts_with('.')
+                    && !WALK_SKIP.contains(&name.as_str())
+                {
+                    queue.push_back((entry.path(), format!("{prefix}{name}/"), depth + 1));
+                }
+            } else if name != ".DS_Store" && (kind.is_file() || entry.path().is_file()) {
+                files.push(format!("{prefix}{name}"));
+            }
+        }
+    }
+    files.sort();
+    files
+}
+
+/// Words in insertion order, each once.
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn push(&mut self, word: &str) {
+        if self.list.len() < MAX_WORDS && is_term(word) && self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+/// Something that can stand as a word in a sentence: letters, digits, `_`
+/// and `-`, single spaces between the words of a name.
+fn is_term(word: &str) -> bool {
+    (2..=48).contains(&word.len())
+        && word.starts_with(char::is_alphanumeric)
+        && word.ends_with(char::is_alphanumeric)
+        && word.chars().any(char::is_alphabetic)
+        && word
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '_' | '-' | ' '))
+}
+
+fn words(abs: &Path, files: &[String]) -> Vec<String> {
+    let mut words = Words::default();
+
+    let depth = |f: &&String| f.matches('/').count();
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| {
+            matches!(
+                f.rsplit('/').next(),
+                Some("Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod")
+            )
+        })
+        .collect();
+    manifests.sort_by_key(depth);
+    for manifest in manifests.into_iter().take(MAX_MANIFESTS) {
+        if let Some(body) = read_small(&abs.join(manifest)) {
+            for name in package_names(manifest, &body) {
+                words.push(&name);
+            }
+        }
+    }
+
+    let mut scan = DocScan::default();
+    for doc in DOCS {
+        if let Some(body) = read_small(&abs.join(doc)) {
+            scan.read(&body, *doc == "README.md");
+        }
+    }
+    for term in scan.terms() {
+        words.push(&term);
+    }
+
+    for file in files {
+        let name = file.rsplit('/').next().unwrap_or(file);
+        let stem = name.split('.').next().unwrap_or_default();
+        // A one-word stem with capitals (`README`, `Cargo`, `CLAUDE`) is a
+        // file's name, not how the repo writes the word.
+        if mentions::parts(stem).len() > 1 || !stem.chars().any(char::is_uppercase) {
+            words.push(stem);
+        }
+    }
+    words.list
+}
+
+fn read_small(path: &Path) -> Option<String> {
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > MAX_READ {
+        return None;
+    }
+    std::fs::read_to_string(path).ok()
+}
+
+/// The package a manifest declares and the ones it depends on.
+fn package_names(manifest: &str, body: &str) -> Vec<String> {
+    let mut names = Vec::new();
+    match manifest.rsplit('/').next().unwrap_or(manifest) {
+        "Cargo.toml" | "pyproject.toml" => {
+            let Ok(doc) = body.parse::<toml::Table>() else {
+                return names;
+            };
+            let at = |path: &[&str]| {
+                path.iter()
+                    .try_fold(&doc, |table, key| table.get(*key)?.as_table())
+            };
+            for table in [&["package"][..], &["project"], &["tool", "poetry"]] {
+                if let Some(name) = at(table).and_then(|t| t.get("name")?.as_str()) {
+                    names.push(name.to_string());
+                }
+            }
+            for table in [
+                &["dependencies"][..],
+                &["dev-dependencies"],
+                &["build-dependencies"],
+                &["workspace", "dependencies"],
+            ] {
+                names.extend(at(table).into_iter().flat_map(|t| t.keys().cloned()));
+            }
+        }
+        "package.json" => {
+            let Ok(doc) = serde_json::from_str::<serde_json::Value>(body) else {
+                return names;
+            };
+            // `@scope/name` is spoken as its name.
+            let bare = |name: &str| name.rsplit('/').next().unwrap_or(name).to_string();
+            if let Some(name) = doc.get("name").and_then(|n| n.as_str()) {
+                names.push(bare(name));
+            }
+            for table in ["dependencies", "devDependencies", "peerDependencies"] {
+                if let Some(deps) = doc.get(table).and_then(|d| d.as_object()) {
+                    names.extend(deps.keys().map(|k| bare(k)));
+                }
+            }
+        }
+        "go.mod" => {
+            let module = body.lines().find_map(|l| l.trim().strip_prefix("module "));
+            if let Some(name) = module.and_then(|m| m.trim().rsplit('/').next()) {
+                names.push(name.to_string());
+            }
+        }
+        _ => {}
+    }
+    names
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Shape {
+    /// `audio`
+    Lower,
+    /// `Parakeet`
+    Capitalised,
+    /// `TDT`
+    Acronym,
+    /// `GitHub`, `status_item`, `gpt5`: written a way no sentence would.
+    Compound,
+    Other,
+}
+
+fn shape(word: &str) -> Shape {
+    if !word
+        .chars()
+        .all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+    {
+        return Shape::Other;
+    }
+    let letters = word.chars().filter(|c| c.is_alphabetic()).count();
+    let upper = word.chars().filter(|c| c.is_uppercase()).count();
+    let lower = word.chars().filter(|c| c.is_lowercase()).count();
+    if letters == 0 {
+        return Shape::Other;
+    }
+    if word.contains(['_', '-']) {
+        // `two-track` is prose; `status_item` and `Wi-Fi` are not.
+        return if letters >= 3 && (word.contains('_') || upper > 0) {
+            Shape::Compound
+        } else {
+            Shape::Other
+        };
+    }
+    if word.chars().any(|c| c.is_numeric()) {
+        return if letters >= 3 {
+            Shape::Compound
+        } else {
+            Shape::Other
+        };
+    }
+    if upper == 0 {
+        Shape::Lower
+    } else if lower == 0 {
+        if letters >= 2 {
+            Shape::Acronym
+        } else {
+            Shape::Other
+        }
+    } else if upper == 1 && word.starts_with(char::is_uppercase) {
+        Shape::Capitalised
+    } else {
+        Shape::Compound
+    }
+}
+
+/// Terms read out of the docs. A capital only counts where it is not owed
+/// to its position (the start of a sentence, a heading), and a word the
+/// docs also write in lower case is not a term at all.
+#[derive(Default)]
+struct DocScan {
+    /// Candidate and whether a lower-case sighting vetoes it.
+    found: Vec<(String, bool)>,
+    lower: HashSet<String>,
+}
+
+impl DocScan {
+    fn terms(self) -> Vec<String> {
+        let DocScan { found, lower } = self;
+        found
+            .into_iter()
+            .filter(|(term, vetoable)| !(*vetoable && lower.contains(&term.to_lowercase())))
+            .map(|(term, _)| term)
+            .collect()
+    }
+
+    fn read(&mut self, doc: &str, readme: bool) {
+        let mut fenced = false;
+        let mut title_seen = false;
+        for line in doc.lines() {
+            let line = line.trim_start();
+            if line.starts_with("```") || line.starts_with("~~~") {
+                fenced = !fenced;
+                continue;
+            }
+            if fenced {
+                continue;
+            }
+            let hashes = line.chars().take_while(|c| *c == '#').count();
+            let heading = (1..=6).contains(&hashes) && line[hashes..].starts_with(' ');
+            let title = heading && hashes == 1 && readme && !title_seen;
+            title_seen |= heading;
+            self.line(if heading { &line[hashes..] } else { line }, heading, title);
+        }
+    }
+
+    fn line(&mut self, line: &str, heading: bool, title: bool) {
+        let (prose, code) = strip_markup(line);
+        for span in code {
+            if shape(&span) == Shape::Compound || is_kebab(&span) {
+                self.found.push((span, false));
+            }
+        }
+
+        // A run of capitalised words is one name: "Claude Code" is a term,
+        // "Code" is not.
+        let mut run: Vec<(String, Shape)> = Vec::new();
+        let mut run_counts = false;
+        let mut acronyms: Vec<String> = Vec::new();
+        let mut shouting = 0;
+        let mut any_lower = false;
+        let mut sentence_start = true;
+        let mut words = 0;
+        let mut only: Option<(String, Shape)> = None;
+
+        for raw in prose.split_whitespace() {
+            if text::is_protected(raw) {
+                self.flush(&mut run, run_counts);
+                sentence_start = false;
+                shouting = 0;
+                words += 1;
+                continue;
+            }
+            let chunk = Chunk::parse(raw);
+            if chunk.core.is_empty() {
+                // A dash, a table bar, a list marker: what follows starts over.
+                self.flush(&mut run, run_counts);
+                sentence_start = true;
+                continue;
+            }
+            let (word, possessive) = match chunk
+                .core
+                .strip_suffix("'s")
+                .or_else(|| chunk.core.strip_suffix("’s"))
+            {
+                Some(base) => (base, true),
+                None => (chunk.core.as_str(), false),
+            };
+            let kind = shape(word);
+            words += 1;
+            only = Some((word.to_string(), kind));
+            if !chunk.lead.is_empty() {
+                self.flush(&mut run, run_counts);
+            }
+            shouting = if kind == Shape::Acronym {
+                shouting + 1
+            } else {
+                0
+            };
+            match kind {
+                Shape::Lower => {
+                    any_lower = true;
+                    self.lower.insert(word.to_string());
+                }
+                Shape::Compound => self.found.push((word.to_string(), false)),
+                Shape::Acronym if shouting >= 3 => acronyms.clear(),
+                Shape::Acronym => acronyms.push(word.to_string()),
+                _ => {}
+            }
+            // An acronym stands on its own: "Parakeet TDT" is two terms.
+            let cased = kind == Shape::Capitalised
+                || (kind == Shape::Compound && word.starts_with(char::is_uppercase));
+            if cased {
+                if run.is_empty() {
+                    run_counts = !sentence_start && !heading;
+                }
+                run.push((word.to_string(), kind));
+            }
+            if !cased || possessive || !chunk.trail.is_empty() {
+                self.flush(&mut run, run_counts);
+            }
+            sentence_start = chunk.ends_sentence() || chunk.trail.ends_with(':');
+        }
+        self.flush(&mut run, run_counts);
+
+        // An acronym among ordinary words; a line all in capitals is a shout.
+        if any_lower && shouting < 3 {
+            for acronym in acronyms {
+                if !SHOUTED.contains(&acronym.as_str()) {
+                    self.found.push((acronym, true));
+                }
+            }
+        }
+        // `# squawk`: the README's title, when it is one word, is the
+        // project's name.
+        if let (true, 1, Some((word, kind))) = (title, words, only) {
+            match kind {
+                Shape::Lower => self.found.push((word, false)),
+                Shape::Capitalised => self.found.push((word, true)),
+                _ => {}
+            }
+        }
+    }
+
+    fn flush(&mut self, run: &mut Vec<(String, Shape)>, counts: bool) {
+        let taken = std::mem::take(run);
+        if !counts {
+            return;
+        }
+        match taken.as_slice() {
+            [(word, Shape::Capitalised)] => self.found.push((word.clone(), true)),
+            [_, ..] if (2..=4).contains(&taken.len()) => {
+                let name: Vec<&str> = taken.iter().map(|(w, _)| w.as_str()).collect();
+                self.found.push((name.join(" "), false));
+            }
+            _ => {}
+        }
+    }
+}
+
+/// `squawk-core` in backticks is a name; in a sentence, `two-track` is not.
+fn is_kebab(span: &str) -> bool {
+    span.contains('-')
+        && span
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+        && span.split('-').all(|part| !part.is_empty())
+        && span.chars().filter(char::is_ascii_lowercase).count() >= 3
+}
+
+/// A markdown line as prose: code spans lifted out (and returned), link
+/// targets and HTML tags dropped.
+fn strip_markup(line: &str) -> (String, Vec<String>) {
+    let mut prose = String::with_capacity(line.len());
+    let mut code = Vec::new();
+    let mut rest = line;
+    while let Some(c) = rest.chars().next() {
+        let after = &rest[c.len_utf8()..];
+        let skip_to = |close: char| after.find(close).map(|i| &after[i + close.len_utf8()..]);
+        match c {
+            '`' => match after.find('`') {
+                Some(end) => {
+                    code.push(after[..end].trim().to_string());
+                    // A stand-in, so the words either side are not neighbours.
+                    prose.push_str(" x ");
+                    rest = &after[end + 1..];
+                }
+                None => rest = after,
+            },
+            ']' if after.starts_with('(') => {
+                prose.push(']');
+                rest = skip_to(')').unwrap_or_default();
+            }
+            '<' if after.starts_with(|n: char| n.is_alphabetic() || n == '/' || n == '!') => {
+                prose.push(' ');
+                rest = skip_to('>').unwrap_or_default();
+            }
+            _ => {
+                prose.push(c);
+                rest = after;
+            }
+        }
+    }
+    (prose, code)
+}
