+        write(d, "src/main.rs", "");
+        write(d, "src/status_item.rs", "");
+        write(d, "src/ui/mod.rs", "");
+        write(d, "target/debug/junk.rs", "");
+        write(d, ".gitignore", "/target\n");
+        git(d, &["add", "."]);
+        dir
+    }
+
+    #[test]
+    fn lists_tracked_files_relative_to_the_cwd() {
+        let dir = repo();
+        let vocab = build(dir.path());
+        assert_eq!(vocab.root, dir.path());
+        assert_eq!(
+            vocab.files,
+            [
+                ".gitignore",
+                "Cargo.toml",
+                "README.md",
+                "src/main.rs",
+                "src/status_item.rs",
+                "src/ui/mod.rs"
+            ]
+        );
+        let sub = build(&dir.path().join("src"));
+        assert_eq!(sub.files, ["main.rs", "status_item.rs", "ui/mod.rs"]);
+    }
+
+    #[test]
+    fn untracked_and_deleted_files_are_not_listed() {
+        let dir = repo();
+        write(dir.path(), "src/new.rs", "");
+        std::fs::remove_file(dir.path().join("src/main.rs")).unwrap();
+        let vocab = build(dir.path());
+        assert!(!vocab.files.iter().any(|f| f == "src/new.rs"));
+        assert!(!vocab.files.iter().any(|f| f == "src/main.rs"));
+        assert!(vocab.files.iter().any(|f| f == "src/status_item.rs"));
+    }
+
+    #[test]
+    fn reads_every_index_version_like_git_does() {
+        for version in ["2", "3", "4"] {
+            let dir = repo();
+            let d = dir.path();
+            write(d, "src/intent.rs", "");
+            git(d, &["add", "-N", "src/intent.rs"]);
+            git(d, &["update-index", "--index-version", version]);
+            let data = std::fs::read(d.join(".git/index")).unwrap();
+            let mut ours = parse_index(&data).expect("parsed");
+            let mut theirs = ls_files(d).unwrap();
+            ours.sort();
+            theirs.sort();
+            assert_eq!(ours, theirs, "index v{version}");
+            assert!(ours.len() >= 7);
+        }
+        assert_eq!(parse_index(b"DIRC\0\0\0\x09\0\0\0\0"), None);
+        assert_eq!(parse_index(b"nope"), None);
+    }
+
+    #[test]
+    fn walks_outside_git() {
+        let dir = tempfile::tempdir().unwrap();
+        let d = dir.path();
+        write(d, "notes.md", "");
+        write(d, "src/app.py", "");
+        write(d, "node_modules/x/index.js", "");
+        write(d, ".cache/blob", "");
+        assert_eq!(build(d).files, ["notes.md", "src/app.py"]);
+    }
+
+    #[test]
+    fn a_repo_with_nothing_added_is_walked() {
+        let dir = tempfile::tempdir().unwrap();
+        git(dir.path(), &["init", "-q"]);
+        write(dir.path(), "main.py", "");
+        assert_eq!(build(dir.path()).files, ["main.py"]);
+    }
+
+    #[test]
+    fn words_come_from_manifests_docs_and_stems() {
+        let dir = repo();
+        let words = build(dir.path()).words;
+        for word in [
+            "bird-song",
+            "serde_json",
+            "birdsong",
+            "Parakeet",
+            "Mac",
+            "status_item",
+            "main",
+        ] {
+            assert!(words.iter().any(|w| w == word), "{word} in {words:?}");
+        }
+        for word in ["Cargo", "README", "Dictation", "It"] {
+            assert!(!words.iter().any(|w| w == word), "{word} in {words:?}");
+        }
+    }
+
+    #[test]
+    fn doc_terms_need_a_capital_they_do_not_owe_to_position() {
+        let terms = doc_terms(
+            "# squawk\n\n\
+             Local dictation for macOS. Built for talking to Claude Code in a terminal.\n\
+             Everything runs with NVIDIA's Parakeet TDT 0.6B v3. See [SPEC.md](SPEC.md).\n\
+             - Run `squawk-core` tests with `cargo test`, and call `VocabCache::get`.\n\n\
+             ## Getting Started\n\n\
+             ```\nExport FOO_BAR\n```\n",
+        );
+        assert_eq!(
+            terms,
+            [
+                "squawk",
+                "macOS",
+                "Claude Code",
+                "Parakeet",
+                "NVIDIA",
+                "TDT",
+                "squawk-core"
+            ]
+        );
+    }
+
+    #[test]
+    fn shouting_and_inconsistent_capitals_are_not_terms() {
+        let terms = doc_terms(
+            "IMPORTANT: you MUST NOT push. NEVER EVER DO THIS please.\n\
+             Open the History tab to see the history. Use the REST API here.\n",
+        );
+        assert_eq!(terms, ["REST", "API"]);
+    }
+
+    #[test]
+    fn stamp_follows_the_index() {
+        let dir = repo();
+        let before = stamp(dir.path());
+        assert_eq!(before, stamp(dir.path()));
+        write(dir.path(), "src/more_things.rs", "");
+        git(dir.path(), &["add", "."]);
+        assert_ne!(before, stamp(dir.path()));
+    }
+}
