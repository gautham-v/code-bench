+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Above any real pid, so a fake row never picks up a live process.
+    const B: i32 = 50_000_000;
+
+    fn proc(pid: i32, ppid: i32, name: &str) -> Proc {
+        Proc {
+            pid,
+            ppid,
+            pgid: pid,
+            tpgid: 0,
+            tdev: None,
+            name: name.into(),
+        }
+    }
+
+    #[test]
+    fn finds_agents_under_the_terminal_only() {
+        let procs = [
+            proc(B + 10, B + 1, "ghostty"),
+            proc(B + 11, B + 10, "login"),
+            proc(B + 12, B + 11, "zsh"),
+            proc(B + 13, B + 12, "claude"),
+            proc(B + 14, B + 13, "zsh"),
+            proc(B + 15, B + 14, "claude"),
+            proc(B + 20, B + 10, "zsh"),
+            proc(B + 21, B + 20, "codex"),
+            proc(B + 30, B + 1, "claude"),
+        ];
+        let found: Vec<(i32, Agent)> = descendants(&procs, B + 10)
+            .into_iter()
+            .map(|(_, p, a)| (p.pid, a))
+            .collect();
+        // Not 15 (inside another agent), not 30 (another terminal's).
+        assert_eq!(found, [(B + 21, Agent::Codex), (B + 13, Agent::Claude)]);
+        assert!(descendants(&procs, B + 20).len() == 1);
+        assert!(descendants(&procs, B + 99).is_empty());
+    }
+
+    #[test]
+    fn a_parent_cycle_ends() {
+        let procs = [proc(B + 1, B + 2, "a"), proc(B + 2, B + 1, "b")];
+        assert!(descendants(&procs, B + 1).is_empty());
+    }
+
+    #[test]
+    fn names_are_exact() {
+        assert_eq!(agent_named("claude"), Some(Agent::Claude));
+        assert_eq!(agent_named("codex"), Some(Agent::Codex));
+        assert_eq!(agent_named("claudebar"), None);
+        assert_eq!(agent_named("Claude"), None);
+    }
+
+    #[test]
+    fn classifies_by_executable_and_script() {
+        let args = |a: &[&str]| a.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(
+            classify(
+                Some(Path::new("/Users/you/.local/share/claude/versions/2.1.0")),
+                &[]
+            ),
+            Some(Agent::Claude)
+        );
+        assert_eq!(
+            classify(Some(Path::new("/opt/homebrew/bin/codex")), &[]),
+            Some(Agent::Codex)
+        );
+        assert_eq!(
+            classify(
+                Some(Path::new("/usr/local/bin/node")),
+                &args(&["node", "--no-warnings", "/usr/local/bin/claude"])
+            ),
+            Some(Agent::Claude)
+        );
+        assert_eq!(
+            classify(
+                Some(Path::new("/usr/local/bin/node")),
+                &args(&[
+                    "node",
+                    "/usr/local/lib/node_modules/@openai/codex/bin/codex.js"
+                ])
+            ),
+            Some(Agent::Codex)
+        );
+        assert_eq!(
+            classify(
+                Some(Path::new("/usr/local/bin/node")),
+                &args(&["node", "server.js", "claude"])
+            ),
+            None
+        );
+        assert_eq!(classify(Some(Path::new("/bin/zsh")), &[]), None);
+    }
+
+    #[test]
+    fn foreground_then_recent_input_wins() {
+        let mut fg = proc(5, 1, "claude");
+        fg.tdev = Some(7);
+        fg.tpgid = 5;
+        let bg = proc(6, 1, "claude");
+        assert!(rank(&fg, None, 1) > rank(&bg, None, 0));
+        assert!(rank(&bg, None, 0) > rank(&bg, None, 1));
+    }
+
+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    #[test]
+    fn detects_a_real_child() {
+        let dir = tempfile::tempdir().unwrap();
+        let cwd = dir.path().join("proj");
+        std::fs::create_dir(&cwd).unwrap();
+        let bin = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &bin).unwrap();
+        let mut child = std::process::Command::new(&bin)
+            .arg("30")
+            .current_dir(&cwd)
+            .spawn()
+            .unwrap();
+        let front = |bundle: &str| FrontApp {
+            bundle_id: bundle.into(),
+            name: "Terminal".into(),
+            pid: std::process::id() as i32,
+        };
+        // The child may not have exec'd yet on the first look.
+        let mut session = None;
+        for _ in 0..200 {
+            session = detect(&front("com.apple.Terminal"));
+            if session.is_some() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        let not_a_terminal = detect(&front("com.apple.Safari"));
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let session = session.expect("child found");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(session.pid, child.id() as i32);
+        assert_eq!(
+            session.cwd.canonicalize().unwrap(),
+            cwd.canonicalize().unwrap()
+        );
+        assert_eq!(session.project(), "proj");
+        assert_eq!(not_a_terminal, None);
+    }
+}
