+        assert_eq!(
+            m("Status item dot RS, then main dot rs."),
+            "@crates/squawk-app/src/status_item.rs, then @crates/squawk-app/src/main.rs"
+        );
+        assert_eq!(
+            m("open app dot test dot ts now"),
+            "open @web/app.test.ts now"
