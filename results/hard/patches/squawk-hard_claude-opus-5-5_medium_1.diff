+//! Rewriting a transcript against a repo: spoken file names to @mentions,
+//! then the repo's words to the repo's spelling.
+//!
+//! A file is spoken as its name with the punctuation said or dropped:
+//! "status item dot rs", "cargo toml", "context slash mod dot rs". The words
+//! are matched against file names with `_`, `-` and case ignored, the
+//! longest name first, and a mention is written only when exactly one file
+//! is left. Anything else — two files of that name, a folder that is not
+//! there — stays as it was said.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, Weak};
+
+use super::RepoVocab;
+use crate::dictionary::split_jargon;
+use crate::text::{self, Chunk};
+
+/// Most words taken for a file's stem, or for one folder.
+const MAX_STEM_WORDS: usize = 4;
+const MAX_DIR_WORDS: usize = 3;
+/// Most words taken for one dot-separated part after the stem: "r s".
+const MAX_PART_WORDS: usize = 3;
+/// Most words joined into one term.
+const MAX_TERM_WORDS: usize = 5;
+
+/// Extensions that name a file even with the "dot" left out ("cargo toml").
+/// None of them is a word anyone says for another reason.
+const BARE_EXTENSIONS: &[&str] = &[
+    "md", "toml", "json", "yaml", "yml", "rs", "py", "js", "ts", "tsx", "jsx", "txt", "html",
+    "css", "scss", "sql", "xml", "csv",
+];
+
+/// A compound holding one of these reads as a phrase ("launch at login"),
+/// so separate words are not joined into it.
+const PHRASE_WORDS: &[&str] = &[
+    "a", "an", "and", "as", "at", "be", "by", "do", "for", "from", "i", "if", "in", "is", "it",
+    "me", "my", "no", "not", "of", "off", "on", "or", "out", "that", "the", "this", "to", "up",
+    "we", "with",
+];
+
+/// Lookup tables over a [`RepoVocab`], built once per vocab.
+#[derive(Debug, Default)]
+pub(crate) struct Index {
+    /// File name, each dot-separated part folded (`statusitem.rs`), to the
+    /// indices of the files so named.
+    names: HashMap<String, Vec<u32>>,
+    /// Folded word to its term; `None` when the repo writes it two ways.
+    terms: HashMap<String, Option<Term>>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Term {
+    written: String,
+    /// `status_item` → `status`, `item`; `GitHub` → `git`, `hub`.
+    parts: Vec<String>,
+    /// Whether separate spoken words may be joined into it.
+    joins: bool,
+}
+
+/// Lowercase letters and digits only: how names and words are compared.
+fn fold(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// The pieces a word may be spoken as: split at `_`, `-`, spaces, and the
+/// dictionary's camel-case and digit boundaries.
+pub(crate) fn parts(word: &str) -> Vec<String> {
+    word.split(|c: char| !c.is_alphanumeric())
+        .filter(|piece| !piece.is_empty())
+        .flat_map(split_jargon)
+        .map(|part| part.to_lowercase())
+        .collect()
+}
+
+impl Index {
+    fn build(vocab: &RepoVocab) -> Index {
+        let mut names: HashMap<String, Vec<u32>> = HashMap::new();
+        for (i, file) in vocab.files.iter().enumerate() {
+            let name = file.rsplit('/').next().unwrap_or(file);
+            if !name.contains('.') || !mentionable(file) {
+                continue;
+            }
+            let key = name.split('.').map(fold).collect::<Vec<_>>().join(".");
+            names.entry(key).or_default().push(i as u32);
+        }
+
+        let mut terms: HashMap<String, Option<Term>> = HashMap::new();
+        for word in &vocab.words {
+            let parts = parts(word);
+            if parts.is_empty() {
+                continue;
+            }
+            let phrase = parts.iter().any(|p| PHRASE_WORDS.contains(&p.as_str()));
+            let term = Term {
+                written: word.clone(),
+                joins: parts.len() > 1 && (word.contains(' ') || !phrase),
+                parts,
+            };
+            terms
+                .entry(fold(word))
+                .and_modify(|known| {
+                    if known.as_ref().is_some_and(|k| k.written != term.written) {
+                        *known = None;
+                    }
+                })
+                .or_insert(Some(term));
+        }
+        Index { names, terms }
+    }
+}
+
+/// A path Claude Code reads back as one @mention.
+fn mentionable(path: &str) -> bool {
+    !path.is_empty() && !path.chars().any(|c| c.is_whitespace() || c.is_control())
+}
+
+/// The index for `vocab`, built on first use and kept while the vocab
+/// lives. Keyed by the `Arc`'s address; the `Weak` both pins that address
+/// and rules out a mutation behind it.
+pub(crate) fn index_for(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+    static CACHE: Mutex<Vec<(Weak<RepoVocab>, Arc<Index>)>> = Mutex::new(Vec::new());
+    const KEPT: usize = 8;
+
+    let mut cache = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    cache.retain(|(weak, _)| weak.strong_count() > 0);
+    if let Some((_, index)) = cache
+        .iter()
+        .find(|(weak, _)| std::ptr::eq(weak.as_ptr(), Arc::as_ptr(vocab)))
+    {
+        return index.clone();
+    }
+    let index = Arc::new(Index::build(vocab));
+    if cache.len() >= KEPT {
+        cache.remove(0);
+    }
+    cache.push((Arc::downgrade(vocab), index.clone()));
+    index
+}
+
+pub(crate) fn apply(text: &str, vocab: &Arc<RepoVocab>) -> String {
+    if vocab.files.is_empty() && vocab.words.is_empty() {
+        return text.to_string();
+    }
+    let index = index_for(vocab);
+    let mut words = Words::new(text::chunks(text));
+    let mut changed = mention_files(&mut words, vocab, &index);
+    changed |= spell_terms(&mut words, &index);
+    if !changed {
+        return text.to_string();
+    }
+    text::join(&words.chunks)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// As spoken.
+    Open,
+    /// A mention or a term this pass wrote.
+    Written,
+    /// Part of a file reference that could not be settled: left alone.
+    Kept,
+}
+
+/// The transcript as chunks, with each chunk's folded form if it is a
+/// plain word.
+struct Words {
+    chunks: Vec<Chunk>,
+    keys: Vec<Option<String>>,
+    states: Vec<State>,
+}
+
+impl Words {
+    fn new(chunks: Vec<Chunk>) -> Words {
+        let keys = chunks.iter().map(plain_key).collect();
+        let states = vec![State::Open; chunks.len()];
+        Words {
+            chunks,
+            keys,
+            states,
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.chunks.len()
+    }
+
+    fn key(&self, i: usize) -> Option<&str> {
+        self.keys.get(i)?.as_deref()
+    }
+
+    fn is(&self, i: usize, word: &str) -> bool {
+        self.key(i) == Some(word)
+    }
+
+    /// No punctuation between chunk `i` and the next: they were said in
+    /// one breath.
+    fn joined(&self, i: usize) -> bool {
+        i + 1 < self.len() && self.chunks[i].trail.is_empty() && self.chunks[i + 1].lead.is_empty()
+    }
+
+    /// The words `from..to` folded into one, if they are plain words run
+    /// together.
+    fn span(&self, from: usize, to: usize) -> Option<String> {
+        let mut out = String::new();
+        for i in from..to {
+            if i + 1 < to && !self.joined(i) {
+                return None;
+            }
+            out.push_str(self.key(i)?);
+        }
+        Some(out)
+    }
+
+    /// Replace `start..=end` with one chunk reading `core`.
+    fn replace(&mut self, start: usize, end: usize, core: String, state: State) {
+        let chunk = Chunk {
+            lead: self.chunks[start].lead.clone(),
+            core,
+            trail: self.chunks[end].trail.clone(),
+        };
+        self.chunks.splice(start..=end, [chunk]);
+        self.keys.splice(start..=end, [None]);
+        self.states.splice(start..=end, [state]);
+    }
+}
+
+/// A chunk that is one spoken word: not protected, nothing but letters,
+/// digits, `_` and `-`.
+fn plain_key(chunk: &Chunk) -> Option<String> {
+    let plain = !chunk.core.is_empty()
+        && !chunk.is_protected()
+        && chunk
+            .core
+            .chars()
+            .all(|c| c.is_alphanumeric() || c == '_' || c == '-');
+    plain.then(|| fold(&chunk.core))
+}
+
+/// A spoken file name found in the words.
+struct Reference<'a> {
+    start: usize,
+    end: usize,
+    files: &'a [u32],
+}
+
+fn mention_files(words: &mut Words, vocab: &RepoVocab, index: &Index) -> bool {
+    if index.names.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    // Nothing before `floor` may be taken again.
+    let mut floor = 0;
+    let mut i = 0;
+    while i < words.len() {
+        let reference = if words.is(i, "dot") {
+            dotted(words, index, i, floor)
+        } else {
+            undotted(words, index, i, floor)
+        };
+        let Some(reference) = reference else {
+            i += 1;
+            continue;
+        };
+        match settle(words, vocab, &reference, floor) {
+            Some((start, file)) => {
+                let start = take_article(words, start, reference.end, floor);
+                words.replace(start, reference.end, format!("@{file}"), State::Written);
+                changed = true;
+                floor = start + 1;
+            }
+            None => {
+                for state in &mut words.states[reference.start..=reference.end] {
+                    *state = State::Kept;
+                }
+                floor = reference.end + 1;
+            }
+        }
+        i = floor;
+    }
+    // "…look at status item dot rs." ends on the mention: a period there
+    // would read as part of the path.
+    if let (Some(State::Written), Some(last)) = (words.states.last(), words.chunks.last_mut()) {
+        if last.core.starts_with('@') && last.trail == "." {
+            last.trail.clear();
+        }
+    }
+    changed
+}
+
+/// "status item dot rs", "app dot test dot ts", "dot git ignore": the file
+/// name around the "dot" at `dot`. Of the readings that name a file, the
+/// one taking the most words.
+fn dotted<'a>(words: &Words, index: &'a Index, dot: usize, floor: usize) -> Option<Reference<'a>> {
+    let mut tails = Vec::new();
+    tails_after(words, dot, 0, &mut tails);
+
+    let mut best: Option<Reference<'a>> = None;
+    for stem_words in 0..=MAX_STEM_WORDS.min(dot - floor.min(dot)) {
+        let start = dot - stem_words;
+        // The stem runs straight into the "dot".
+        let stem = match stem_words {
+            0 => String::new(),
+            _ if !words.joined(dot - 1) => break,
+            _ => match words.span(start, dot) {
+                Some(stem) => stem,
+                None => break,
+            },
+        };
+        for (end, tail) in &tails {
+            let Some(files) = index.names.get(&format!("{stem}{tail}")) else {
+                continue;
+            };
+            if best.as_ref().is_none_or(|b| end - start > b.end - b.start) {
+                best = Some(Reference {
+                    start,
+                    end: *end,
+                    files,
+                });
+            }
+        }
+    }
+    best
+}
+
+/// Every way the words after the "dot" at `dot` read as the rest of a file
+/// name: one part of up to three words ("r s"), then perhaps another "dot".
+fn tails_after(words: &Words, dot: usize, depth: usize, out: &mut Vec<(usize, String)>) {
+    let mut part = String::new();
+    for n in 1..=MAX_PART_WORDS {
+        let at = dot + n;
+        if !words.joined(at - 1) {
+            break;
+        }
+        let Some(key) = words.key(at).filter(|k| *k != "dot") else {
+            break;
+        };
+        part.push_str(key);
+        out.push((at, format!(".{part}")));
+        if depth < 2 && words.joined(at) && words.is(at + 1, "dot") {
+            let mut longer = Vec::new();
+            tails_after(words, at + 1, depth + 1, &mut longer);
+            out.extend(
+                longer
+                    .into_iter()
+                    .map(|(end, tail)| (end, format!(".{part}{tail}"))),
+            );
+        }
+    }
+}
+
+/// "cargo toml", "the claude md": a stem and an extension with no "dot",
+/// for extensions that are not also words.
+fn undotted<'a>(words: &Words, index: &'a Index, at: usize, floor: usize) -> Option<Reference<'a>> {
+    let ext = words.key(at)?;
+    if !BARE_EXTENSIONS.contains(&ext) || at == 0 || !words.joined(at - 1) {
+        return None;
+    }
+    // "… dot rs" and "rs dot …" are the dotted form's to read.
+    if words.is(at - 1, "dot") || (words.joined(at) && words.is(at + 1, "dot")) {
+        return None;
+    }
+    (1..=MAX_STEM_WORDS.min(at - floor.min(at)))
+        .rev()
+        .find_map(|stem_words| {
+            let start = at - stem_words;
+            let stem = words.span(start, at)?;
+            let files = index.names.get(&format!("{stem}.{ext}"))?;
+            Some(Reference {
+                start,
+                end: at,
+                files,
+            })
+        })
+}
+
+/// Narrow a reference to one file, taking in the folders spoken before it:
+/// "context slash mod dot rs", or just "context mod dot rs". Returns where
+/// the reference now starts and the file, or `None` if it is not settled.
+fn settle<'a>(
+    words: &Words,
+    vocab: &'a RepoVocab,
+    reference: &Reference,
+    floor: usize,
+) -> Option<(usize, &'a str)> {
+    let dirs_of = |file: u32| -> Vec<String> {
+        let path = &vocab.files[file as usize];
+        let mut dirs: Vec<String> = path.split('/').map(fold).collect();
+        dirs.pop();
+        dirs
+    };
+    // Spoken folders, innermost first, against a file's own. A run that
+    // ends at the file's folder beats one that skips levels.
+    let narrow = |files: &[u32], spoken: &[String]| -> Vec<u32> {
+        let adjacent: Vec<u32> = files
+            .iter()
+            .copied()
+            .filter(|f| {
+                dirs_of(*f)
+                    .iter()
+                    .rev()
+                    .zip(spoken)
+                    .filter(|(a, b)| a == b)
+                    .count()
+                    == spoken.len()
+            })
+            .collect();
+        if !adjacent.is_empty() {
+            return adjacent;
+        }
+        files
+            .iter()
+            .copied()
+            .filter(|f| {
+                let dirs = dirs_of(*f);
+                let mut dirs = dirs.iter().rev();
+                spoken.iter().all(|s| dirs.any(|d| d == s))
+            })
+            .collect()
+    };
+    // The folder named by up to three words ending just before `before`.
+    let folder = |before: usize, test: &dyn Fn(&str) -> bool| -> Option<(usize, String)> {
+        (1..=MAX_DIR_WORDS.min(before - floor.min(before)))
+            .rev()
+            .find_map(|n| {
+                let start = before - n;
+                if !words.joined(before - 1) {
+                    return None;
+                }
+                let name = words.span(start, before)?;
+                test(&name).then_some((start, name))
+            })
+    };
+
+    let mut start = reference.start;
+    let mut files: Vec<u32> = reference.files.to_vec();
+    let mut spoken: Vec<String> = Vec::new();
+
+    // "folder slash …", as many as were said. A folder that matches
+    // nothing means the reference is not to these files.
+    while start > floor && words.is(start - 1, "slash") && words.joined(start - 1) {
+        let with = |name: &str| {
+            let mut all = spoken.clone();
+            all.push(name.to_string());
+            all
+        };
+        let (from, name) = folder(start - 1, &|name| !narrow(&files, &with(name)).is_empty())?;
+        spoken = with(&name);
+        files = narrow(&files, &spoken);
+        start = from;
+    }
+
+    if spoken.is_empty() {
+        if files.len() > 1 {
+            // "context mod dot rs": the folder with no "slash", when it
+            // picks one file out of several.
+            let one = |name: &str| narrow(&files, &[name.to_string()]).len() == 1;
+            let (from, name) = folder(start, &one)?;
+            files = narrow(&files, &[name]);
+            start = from;
+        } else if let Some(parent) = files.first().and_then(|f| dirs_of(*f).pop()) {
+            // "src main dot rs" for the only main.rs: the folder is part
+            // of the name, not a word to leave in front of the mention.
+            if let Some((from, _)) = folder(start, &|name| name == parent) {
+                start = from;
+            }
+        }
+    }
+
+    match files.as_slice() {
+        [file] => Some((start, vocab.files[*file as usize].as_str())),
+        _ => None,
+    }
+}
+
+/// "the claude md" is the file; "the claude md file" is a file, and keeps
+/// its article.
+fn take_article(words: &Words, start: usize, end: usize, floor: usize) -> usize {
+    let article = start > floor && words.is(start - 1, "the") && words.joined(start - 1);
+    let noun = words.joined(end) && (words.is(end + 1, "file") || words.is(end + 1, "files"));
+    if article && !noun {
+        start - 1
+    } else {
+        start
+    }
+}
+
+fn spell_terms(words: &mut Words, index: &Index) -> bool {
+    if index.terms.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < words.len() {
+        if let Some((n, written)) = term_at(words, index, i) {
+            words.replace(i, i + n - 1, written, State::Written);
+            changed = true;
+        }
+        i += 1;
+    }
+    changed
+}
+
+/// The term starting at `i`, longest first: how many chunks it takes and
+/// what to write. `None` if nothing there needs rewriting.
+fn term_at(words: &Words, index: &Index, i: usize) -> Option<(usize, String)> {
+    for n in (1..=MAX_TERM_WORDS.min(words.len() - i)).rev() {
+        if words.states[i..i + n].iter().any(|s| *s != State::Open) {
+            continue;
+        }
+        // "parakeet's": the term, then the possessive again.
+        let last = &words.chunks[i + n - 1];
+        let (last_key, suffix) = match possessive(&last.core) {
+            Some((base, suffix)) => (Some(fold(base)), suffix),
+            None => (words.key(i + n - 1).map(str::to_string), ""),
+        };
+        let (Some(head), Some(last_key)) = (words.span(i, i + n - 1), last_key) else {
+            continue;
+        };
+        if n > 1 && !words.joined(i + n - 2) {
+            continue;
+        }
+        let Some(Some(term)) = index.terms.get(&format!("{head}{last_key}")) else {
+            continue;
+        };
+        let spoken: Vec<&str> = (i..i + n - 1)
+            .filter_map(|k| words.key(k))
+            .chain([last_key.as_str()])
+            .collect();
+        if n > 1 && !(term.joins && along_parts(&spoken, &term.parts)) {
+            continue;
+        }
+        let said: Vec<&str> = words.chunks[i..i + n]
+            .iter()
+            .map(|c| c.core.as_str())
+            .collect();
+        let written = format!("{}{suffix}", term.written);
+        // Lower-casing a word says nothing about the repo: "Audio" opening
+        // a sentence is not `audio` the module.
+        let only_lowers = n == 1
+            && term.written.to_lowercase() == term.written
+            && said[0].to_lowercase() == written;
+        if said.join(" ") == written || only_lowers {
+            return None;
+        }
+        return Some((n, written));
+    }
+    None
+}
+
+fn possessive(core: &str) -> Option<(&str, &str)> {
+    ["'s", "’s"].iter().find_map(|suffix| {
+        let base = core.strip_suffix(suffix)?;
+        let plain = !base.is_empty()
+            && base
+                .chars()
+                .all(|c| c.is_alphanumeric() || c == '_' || c == '-');
+        plain.then_some((base, *suffix))
+    })
+}
+
+/// Each spoken word is one or more whole parts of the term: "git hub" for
+/// `GitHub`, never "gi thub".
+fn along_parts(spoken: &[&str], parts: &[String]) -> bool {
+    let mut parts = parts.iter();
+    spoken.iter().all(|word| {
+        let mut rest = *word;
+        while !rest.is_empty() {
+            match parts.next().and_then(|p| rest.strip_prefix(p.as_str())) {
+                Some(after) => rest = after,
+                None => return false,
+            }
+        }
+        true
+    }) && parts.next().is_none()
+}
+
+#[cfg(test)]
