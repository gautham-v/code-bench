+    }
+
+    #[test]
+    fn nothing_to_do_returns_the_text_as_given() {
+        assert_eq!(m("just  some   words"), "just  some   words");
+        assert_eq!(
+            apply("status item dot rs", &Arc::new(RepoVocab::default())),
+            "status item dot rs"
+        );
+    }
+
+    #[test]
+    fn the_index_is_built_once_per_vocab() {
+        let v = vocab(FILES, &[]);
+        assert!(Arc::ptr_eq(&index_for(&v), &index_for(&v)));
+        let other = vocab(FILES, &[]);
+        assert!(!Arc::ptr_eq(&index_for(&v), &index_for(&other)));
+    }
+
+    #[test]
+    fn parts_follow_the_dictionary() {
+        assert_eq!(parts("status_item"), ["status", "item"]);
+        assert_eq!(parts("squawk-core"), ["squawk", "core"]);
+        assert_eq!(parts("VocabCache"), ["vocab", "cache"]);
+        assert_eq!(parts("Claude Code"), ["claude", "code"]);
+        assert_eq!(parts("NVIDIA"), ["nvidia"]);
+        assert!(along_parts(&["git", "hub"], &parts("GitHub")));
+        assert!(along_parts(&["menubar", "icon"], &parts("menu_bar_icon")));
+        assert!(!along_parts(&["gi", "thub"], &parts("GitHub")));
+        assert!(!along_parts(&["git"], &parts("GitHub")));
+    }
+}
