+            .map(|(key, _)| key.as_str())
+            .collect()
+    }
+
+    fn m(text: &str) -> String {
+        apply(text, &vocab(FILES, &[]))
+    }
+
+    fn w(words: &[&str], text: &str) -> String {
+        apply(text, &vocab(&[], words))
+    }
+
+    #[test]
+    fn dotted_names_become_mentions() {
