+/// Close the folds the editor has on a rendered page: every row drawn from a
+/// hidden source line goes, and a folded heading gets the `▸ ` the editor
+/// puts in front of it. `hidden` and `folded` answer for a source line.
+///
+/// A row the renderer invented — the blank between two blocks — has no source
+/// line to ask about, so it follows the row before it: a blank after hidden
+/// text is hidden with it. That leaves the one blank that came before the
+/// folded section and drops the one that came before whatever follows it, so a
+/// column of closed headings is spaced the way a column of open ones is.
+/// Call it before [`append_mentions`]: the footer is not part of any section.
+pub fn fold_page(
+    r: &mut Rendered,
+    hidden: impl Fn(usize) -> bool,
+    folded: impl Fn(usize) -> bool,
+) {
+    let mut gone = false;
+    let mut marked: Option<usize> = None;
+    let mut kept = Vec::with_capacity(r.lines.len());
+    for mut line in std::mem::take(&mut r.lines) {
+        match line.src_line {
+            Some(l) => {
+                gone = hidden(l);
+                if gone {
+                    continue;
+                }
+                if folded(l) && marked != Some(l) {
+                    marked = Some(l);
+                    let mut cells = str_cells(theme::FOLDED, theme::fold());
+                    cells.append(&mut line.cells);
+                    line.cells = cells;
+                }
+            }
+            None if gone => continue,
+            None => {}
+        }
+        kept.push(line);
+    }
+    r.lines = kept;
+}
