+/// A folded heading's count at the right edge of its row, the way the editor
+/// puts it, when there is room for it and a gap besides.
+fn fold_label_cells(cells: &mut Vec<PCell>, label: &str, width: usize) {
+    let used = crate::render::cells_width(cells);
+    let need = crate::md::str_width(label) + 2;
+    if used + need > width {
+        return;
+    }
+    let cell = |ch: char, style: Style| PCell {
+        ch,
+        style,
+        link: None,
+        src: None,
+    };
+    cells.extend((0..width - used - need + 2).map(|_| cell(' ', Style::new())));
+    cells.extend(label.chars().map(|ch| cell(ch, dim())));
+}
