+        let mut r = render(md);
+        // One is folded: lines 5..=9 go
+        fold_page(&mut r, |l| (5..=9).contains(&l), |l| l == 4);
+        let text: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        assert_eq!(
+            text,
+            vec!["Title", "", "intro", "", "▸ One", "", "Two", "", "d"]
+        );
+        // the heading still maps back to its own line, and the marker to none
+        let one = &r.lines[4];
+        assert_eq!(one.src_line, Some(4));
+        assert_eq!(one.cells[0].src, None);
+        assert_eq!(one.cells[0].style, theme::fold());
+        assert_eq!(one.cells[2].src, Some((4, 3)));
+    }
+
+    #[test]
+    fn a_page_with_nothing_folded_comes_out_as_it_went_in() {
+        let md = "# A\n\ntext\n\n## B\n\nmore\n";
+        let mut r = render(md);
+        let before: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        fold_page(&mut r, |_| false, |_| false);
+        let after: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        assert_eq!(before, after);
+    }
 }
