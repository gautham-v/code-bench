+        assert_eq!(a("update cargo lock too"), "update @Cargo.lock too");
+        assert_eq!(a("the claude m d"), "the @CLAUDE.md");
+        // Not a file: left alone.
+        assert_eq!(a("write it in ts"), "write it in ts");
+        assert_eq!(a("the door lock"), "the door lock");
+    }
+
+    #[test]
+    fn ambiguous_stays_as_spoken() {
+        assert_eq!(a("open main dot rs"), "open main dot rs");
+        assert_eq!(a("open mod dot rs"), "open mod dot rs");
+        assert_eq!(a("open nothing dot rs"), "open nothing dot rs");
+    }
+
+    #[test]
+    fn a_folder_settles_it() {
+        assert_eq!(
+            a("open context slash mod dot rs"),
+            "open @crates/squawk-core/src/context/mod.rs"
+        );
+        assert_eq!(a("ui slash mod dot rs"), "@crates/squawk-app/src/ui/mod.rs");
+        assert_eq!(a("ui / mod dot rs"), "@crates/squawk-app/src/ui/mod.rs");
+        assert_eq!(
+            a("in squawk cli slash src slash main dot rs"),
+            "in @crates/squawk-cli/src/main.rs"
