+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,753 @@
+//! Rewriting a transcript against a repo: spoken file names to @mentions,
+//! then the repo's words to the repo's spelling.
+//!
+//! Both passes look things up in an [`Index`] built once per vocab (when the
+//! recording starts, see `VocabCache::get`), so the work after release is a
+//! few hash lookups per word.
+//!
+//! A file is matched on a *key* that survives being said aloud: lowercase,
+//! with only letters, digits and the dots kept. `status_item.rs`,
+//! `StatusItem.rs` and "status item dot rs" all have the key `statusitem.rs`.
+//! Two files with one key are ambiguous, and an ambiguous reference is left
+//! exactly as it was spoken.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, Weak};
+
+use super::RepoVocab;
+use crate::dictionary::{is_jargon, split_jargon};
+use crate::text::{self, Chunk};
+
+/// Extensions that may be said without "dot": "cargo toml", "the claude md".
+const DOTLESS_EXTENSIONS: &[&str] = &[
+    "md", "toml", "json", "yaml", "yml", "lock", "txt", "rs", "py", "ts", "tsx", "js", "jsx",
+    "html", "css",
+];
+
+/// Said between the parts of a name; they stand for a character the key
+/// drops anyway.
+const SPOKEN_SEPARATORS: &[&str] = &["underscore", "dash", "hyphen"];
+
+/// How many words back from "dot" a file name may reach.
+const MAX_NAME_WORDS: usize = 5;
+const MAX_DOTLESS_NAME_WORDS: usize = 3;
+/// How many words the first spoken folder may be ("squawk core slash …").
+const MAX_DIR_WORDS: usize = 4;
+/// How many chunks one part after "dot" may be ("dot r s", "dot git ignore").
+const MAX_EXT_CHUNKS: usize = 4;
+
+pub(super) struct Index {
+    /// File-name key → indices into `RepoVocab::files`.
+    files: HashMap<String, Vec<u32>>,
+    /// A word heard as one chunk: squashed form → canonical, `None` when two
+    /// canonical forms squash alike.
+    joined: HashMap<String, Option<String>>,
+    /// A word heard in pieces ("vocab cache"): first piece → (pieces,
+    /// canonical), longest first.
+    split: HashMap<String, Vec<(Vec<String>, String)>>,
+}
+
+/// Lowercase letters and digits only.
+fn squash(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+fn name_key(file_name: &str) -> String {
+    file_name
+        .chars()
+        .filter(|c| c.is_alphanumeric() || *c == '.')
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+impl Index {
+    fn build(vocab: &RepoVocab) -> Index {
+        let mut files: HashMap<String, Vec<u32>> = HashMap::new();
+        for (i, path) in vocab.files.iter().enumerate() {
+            // A path with a space cannot be written as a bare @mention.
+            if path.chars().any(char::is_whitespace) {
+                continue;
+            }
+            let key = name_key(path.rsplit('/').next().unwrap_or(path));
+            if key.chars().any(char::is_alphanumeric) {
+                files.entry(key).or_default().push(i as u32);
+            }
+        }
+
+        let mut joined: HashMap<String, Option<String>> = HashMap::new();
+        let mut pieces: HashMap<Vec<String>, Option<String>> = HashMap::new();
+        let note = |slot: &mut Option<String>, word: &str| {
+            if slot.as_deref().is_some_and(|c| c != word) {
+                *slot = None;
+            }
+        };
+        for word in &vocab.words {
+            let key = squash(word);
+            if key.is_empty() {
+                continue;
+            }
+            note(
+                joined.entry(key).or_insert_with(|| Some(word.clone())),
+                word,
+            );
+            let parts: Vec<String> = word
+                .split_whitespace()
+                .flat_map(|w| {
+                    if is_jargon(w) {
+                        split_jargon(w)
+                    } else {
+                        vec![w.to_string()]
+                    }
+                })
+                .map(|p| p.to_lowercase())
+                .collect();
+            if parts.len() >= 2 {
+                note(
+                    pieces.entry(parts).or_insert_with(|| Some(word.clone())),
+                    word,
+                );
+            }
+        }
+        let mut split: HashMap<String, Vec<(Vec<String>, String)>> = HashMap::new();
+        for (parts, word) in pieces {
+            if let Some(word) = word {
+                split
+                    .entry(parts[0].clone())
+                    .or_default()
+                    .push((parts, word));
+            }
+        }
+        for entries in split.values_mut() {
+            entries.sort_by(|a, b| b.0.len().cmp(&a.0.len()).then_with(|| a.1.cmp(&b.1)));
+        }
+        Index {
+            files,
+            joined,
+            split,
+        }
+    }
+}
+
+/// Indexes of the vocabs in use, found by identity. `RepoVocab` is public
+/// data with no room for a private index, and building one per `apply` would
+/// not fit its budget on a large repo.
+static INDEXES: Mutex<Vec<(Weak<RepoVocab>, Arc<Index>)>> = Mutex::new(Vec::new());
+
+pub(super) fn index_for(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+    let find = |list: &Vec<(Weak<RepoVocab>, Arc<Index>)>| {
+        list.iter()
+            .find(|(w, _)| std::ptr::eq(w.as_ptr(), Arc::as_ptr(vocab)))
+            .map(|(_, index)| index.clone())
+    };
+    {
+        let mut list = INDEXES.lock().unwrap_or_else(|e| e.into_inner());
+        list.retain(|(w, _)| w.strong_count() > 0);
+        if let Some(index) = find(&list) {
+            return index;
+        }
+    }
+    let index = Arc::new(Index::build(vocab));
+    let mut list = INDEXES.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(existing) = find(&list) {
+        return existing;
+    }
+    list.push((Arc::downgrade(vocab), index.clone()));
+    index
+}
+
+pub(super) fn apply(text: &str, vocab: &Arc<RepoVocab>) -> String {
+    let index = index_for(vocab);
+    let mut chunks = text::chunks(text);
+    let mentioned = mentions(&mut chunks, vocab, &index);
+    let respelled = jargon(&mut chunks, &index);
+    if mentioned || respelled {
+        text::join(&chunks)
+    } else {
+        text.to_string()
+    }
+}
+
+/// The chunk as a spoken word: its squashed form, if it is plain enough to
+/// be part of a name.
+fn word_key(c: &Chunk) -> Option<String> {
+    if c.is_protected()
+        || !c
+            .core
+            .chars()
+            .all(|ch| ch.is_alphanumeric() || matches!(ch, '_' | '-' | '\''))
+    {
+        return None;
+    }
+    let key = squash(&c.core);
+    (!key.is_empty()).then_some(key)
+}
+
+fn is_bare(c: &Chunk) -> bool {
+    c.lead.is_empty() && c.trail.is_empty()
+}
+
+fn is_dot(c: &Chunk) -> bool {
+    c.trail.is_empty() && c.key() == "dot"
+}
+
+fn is_slash(c: &Chunk) -> bool {
+    (is_bare(c) && c.key() == "slash") || c.render() == "/"
+}
+
+/// Run the words of a name together, without the spoken separators.
+fn concat(words: &[String]) -> String {
+    words
+        .iter()
+        .filter(|w| words.len() == 1 || !SPOKEN_SEPARATORS.contains(&w.as_str()))
+        .map(String::as_str)
+        .collect()
+}
+
+/// One way to read the words before the extension.
+struct Left {
+    /// First chunk the reading takes.
+    start: usize,
+    /// Spoken folders, outermost first.
+    dirs: Vec<String>,
+    name: String,
+}
+
+/// The readings of the words that end just before chunk `end`, most words
+/// first. Without "slash" the name is the last n words, or a folder and then
+/// the name; with it, the words between slashes are taken as said.
+fn lefts(chunks: &[Chunk], end: usize, max_name_words: usize, empty_name: bool) -> Vec<Left> {
+    // Words walking back from `end`, grouped by the slashes between them:
+    // groups[0] is the name, the last group the outermost folder.
+    let mut groups: Vec<Vec<(usize, String)>> = vec![Vec::new()];
+    let mut i = end;
+    let mut total = 0;
+    while i > 0 && total < 16 {
+        let c = &chunks[i - 1];
+        if is_slash(c) {
+            if groups.last().is_some_and(Vec::is_empty) && groups.len() > 1 {
+                return Vec::new();
+            }
+            groups.push(Vec::new());
+            i -= 1;
+            if i > 0 && is_bare(&chunks[i - 1]) && chunks[i - 1].key() == "forward" {
+                i -= 1;
+            }
+            continue;
+        }
+        let Some(key) = word_key(c) else { break };
+        if !c.trail.is_empty() || is_dot(c) {
+            break;
+        }
+        groups
+            .last_mut()
+            .expect("non-empty")
+            .insert(0, (i - 1, key));
+        total += 1;
+        i -= 1;
+        if !c.lead.is_empty() {
+            break;
+        }
+    }
+    let keys = |g: &[(usize, String)]| g.iter().map(|(_, k)| k.clone()).collect::<Vec<_>>();
+
+    let mut out = Vec::new();
+    if groups.len() == 1 {
+        let words = &groups[0];
+        for n in (1..=words.len().min(max_name_words)).rev() {
+            let taken = &words[words.len() - n..];
+            let start = taken[0].0;
+            let taken = keys(taken);
+            out.push(Left {
+                start,
+                dirs: Vec::new(),
+                name: concat(&taken),
+            });
+            for k in 1..n {
+                out.push(Left {
+                    start,
+                    dirs: vec![concat(&taken[..k])],
+                    name: concat(&taken[k..]),
+                });
+            }
+        }
+        if empty_name {
+            out.push(Left {
+                start: end,
+                dirs: Vec::new(),
+                name: String::new(),
+            });
+        }
+        return out;
+    }
+
+    let outermost = groups.pop().expect("more than one group");
+    let name_words = keys(&groups[0]);
+    if outermost.is_empty()
+        || name_words.len() > max_name_words
+        || (name_words.is_empty() && !empty_name)
+    {
+        return Vec::new();
+    }
+    let name = concat(&name_words);
+    let inner: Vec<String> = groups[1..].iter().rev().map(|g| concat(&keys(g))).collect();
+    for k in (1..=outermost.len().min(MAX_DIR_WORDS)).rev() {
+        let taken = &outermost[outermost.len() - k..];
+        let mut dirs = vec![concat(&keys(taken))];
+        dirs.extend(inner.iter().cloned());
+        out.push(Left {
+            start: taken[0].0,
+            dirs,
+            name: name.clone(),
+        });
+    }
+    out
+}
+
+/// The readings of what follows the "dot" at `dot`: (".rs", last chunk
+/// taken), longest first. A part may be spelled out ("r s") or run on
+/// ("git ignore"), and "dot" may come again ("test dot ts").
+fn rights(chunks: &[Chunk], dot: usize, depth: usize) -> Vec<(String, usize)> {
+    let mut out = Vec::new();
+    let mut part = String::new();
+    for j in dot + 1..chunks.len().min(dot + 1 + MAX_EXT_CHUNKS) {
+        let c = &chunks[j];
+        let Some(key) = word_key(c) else { break };
+        if !c.lead.is_empty() || is_dot(c) {
+            break;
+        }
+        part.push_str(&key);
+        out.push((format!(".{part}"), j));
+        if !c.trail.is_empty() {
+            break;
+        }
+        if depth < 2 && chunks.get(j + 1).is_some_and(|n| is_bare(n) && is_dot(n)) {
+            for (rest, end) in rights(chunks, j + 1, depth + 1) {
+                out.push((format!(".{part}{rest}"), end));
+            }
+        }
+    }
+    out.sort_by_key(|r| std::cmp::Reverse(r.1));
+    out
+}
+
+/// The files a reading could mean. Spoken folders must be the folders right
+/// above the file; failing that, folders above it in that order.
+fn candidates<'a>(vocab: &'a RepoVocab, index: &Index, left: &Left, ext: &str) -> Vec<&'a str> {
+    let Some(found) = index.files.get(&format!("{}{ext}", left.name)) else {
+        return Vec::new();
+    };
+    let paths = found.iter().filter_map(|i| vocab.files.get(*i as usize));
+    if left.dirs.is_empty() {
+        let all: Vec<&str> = paths.map(String::as_str).collect();
+        // With no folder said, the file at the top is the one meant: there
+        // is no folder to say for it.
+        let top: Vec<&str> = all.iter().copied().filter(|p| !p.contains('/')).collect();
+        return if top.len() == 1 { top } else { all };
+    }
+    let with_dirs: Vec<(&str, Vec<String>)> = paths
+        .map(|p| {
+            let mut comps: Vec<String> = p.split('/').map(squash).collect();
+            comps.pop();
+            (p.as_str(), comps)
+        })
+        .collect();
+    let direct: Vec<&str> = with_dirs
+        .iter()
+        .filter(|(_, comps)| comps.ends_with(&left.dirs))
+        .map(|(p, _)| *p)
+        .collect();
+    if !direct.is_empty() {
+        return direct;
+    }
+    with_dirs
+        .iter()
+        .filter(|(_, comps)| {
+            let mut comps = comps.iter();
+            left.dirs.iter().all(|d| comps.any(|c| c == d))
+        })
+        .map(|(p, _)| *p)
+        .collect()
+}
+
+/// The first reading that names any file decides: one file is a mention,
+/// several are an ambiguity and nothing is rewritten.
+fn resolve(
+    vocab: &RepoVocab,
+    index: &Index,
+    lefts: &[Left],
+    rights: &[(String, usize)],
+) -> Option<(usize, usize, String)> {
+    for (ext, end) in rights {
+        for left in lefts {
+            let found = candidates(vocab, index, left, ext);
+            match found.as_slice() {
+                [] => continue,
+                [one] => return Some((left.start, *end, one.to_string())),
+                _ => return None,
+            }
+        }
+    }
+    None
+}
+
+/// An extension said without "dot" at chunk `j`: "md", or "m d".
+fn dotless_right(chunks: &[Chunk], j: usize) -> Option<(String, usize)> {
+    let mut ext = String::new();
+    for (n, c) in chunks[j..].iter().take(3).enumerate() {
+        let key = word_key(c)?;
+        if !c.lead.is_empty() || (n > 0 && key.chars().count() != 1) {
+            return None;
+        }
+        let single = key.chars().count() == 1;
+        ext.push_str(&key);
+        if DOTLESS_EXTENSIONS.contains(&ext.as_str()) && (n > 0 || !single) {
+            return Some((format!(".{ext}"), j + n));
+        }
+        if !single || !c.trail.is_empty() {
+            return None;
+        }
+    }
+    None
+}
+
+fn mentions(chunks: &mut Vec<Chunk>, vocab: &RepoVocab, index: &Index) -> bool {
+    if index.files.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        let c = &chunks[i];
+        let found = if c.is_protected() {
+            None
+        } else if is_dot(c) {
+            // A "dot" with punctuation before it starts a name (".gitignore").
+            let left = if c.lead.is_empty() {
+                lefts(chunks, i, MAX_NAME_WORDS, true)
+            } else {
+                vec![Left {
+                    start: i,
+                    dirs: Vec::new(),
+                    name: String::new(),
+                }]
+            };
+            resolve(vocab, index, &left, &rights(chunks, i, 0))
+        } else if i > 0 && !is_dot(&chunks[i - 1]) {
+            dotless_right(chunks, i).and_then(|right| {
+                let left = lefts(chunks, i, MAX_DOTLESS_NAME_WORDS, false);
+                resolve(vocab, index, &left, &[right])
+            })
+        } else {
+            None
+        };
+        let Some((start, end, path)) = found else {
+            i += 1;
+            continue;
+        };
+        let mut trail = chunks[end].trail.clone();
+        // A period after the last word would read as part of the path.
+        if end + 1 == chunks.len() && trail == "." {
+            trail.clear();
+        }
+        let mention = Chunk {
+            lead: chunks[start].lead.clone(),
+            core: format!("@{path}"),
+            trail,
+        };
+        chunks.splice(start..=end, [mention]);
+        changed = true;
+        i = start + 1;
+    }
+    changed
+}
+
+/// `parakeet's` → (`parakeet`, `'s`).
+fn split_possessive(core: &str) -> (&str, &str) {
+    for suffix in ["'s", "’s"] {
+        if let Some(base) = core.strip_suffix(suffix) {
+            return (base, &core[base.len()..]);
+        }
+    }
+    (core, "")
+}
+
+fn is_plain_lowercase(word: &str) -> bool {
+    word.chars().all(char::is_lowercase)
+}
+
+fn is_capitalized_plain(word: &str) -> bool {
+    let mut chars = word.chars();
+    chars.next().is_some_and(char::is_uppercase) && chars.all(char::is_lowercase)
+}
+
+fn jargon(chunks: &mut Vec<Chunk>, index: &Index) -> bool {
+    if index.joined.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    'chunks: while i < chunks.len() {
+        if chunks[i].is_protected() || chunks[i].core.is_empty() {
+            i += 1;
+            continue;
+        }
+        // Heard in pieces: "vocab cache" → `VocabCache`.
+        if let Some(entries) = index.split.get(&chunks[i].key()) {
+            for (parts, canonical) in entries {
+                let n = parts.len();
+                if i + n > chunks.len() {
+                    continue;
+                }
+                let span = &chunks[i..i + n];
+                let (last, possessive) = split_possessive(&span[n - 1].core);
+                let matches = span.iter().zip(parts).enumerate().all(|(k, (c, part))| {
+                    let core = if k + 1 == n { last } else { c.core.as_str() };
+                    !c.is_protected()
+                        && core.to_lowercase() == *part
+                        && (k == 0 || c.lead.is_empty())
+                        && (k + 1 == n || c.trail.is_empty())
+                });
+                if !matches {
+                    continue;
+                }
+                let heard: Vec<&str> = span
+                    .iter()
+                    .enumerate()
+                    .map(|(k, c)| if k + 1 == n { last } else { c.core.as_str() })
+                    .collect();
+                if heard.join(" ") != *canonical {
+                    let joined = Chunk {
+                        lead: span[0].lead.clone(),
+                        core: format!("{canonical}{possessive}"),
+                        trail: span[n - 1].trail.clone(),
+                    };
+                    chunks.splice(i..i + n, [joined]);
+                    changed = true;
+                    i += 1;
+                } else {
+                    i += n;
+                }
+                continue 'chunks;
+            }
+        }
+        // Heard whole: "parakeet" → `Parakeet`, "Statusitem" → `status_item`.
+        let (heard, possessive) = split_possessive(&chunks[i].core);
+        if let Some(Some(canonical)) = index.joined.get(&squash(heard)) {
+            let sentence_start = i == 0 || chunks[i - 1].ends_sentence();
+            // An ordinary lowercase word says nothing about how a capital
+            // should be heard, except for a name the model capitalised
+            // mid-sentence ("Squawk" for `squawk`). `API` is not `api.rs`.
+            let applies = if is_plain_lowercase(canonical) {
+                is_capitalized_plain(heard) && !sentence_start
+            } else {
+                heard != canonical
+            };
+            if applies {
+                chunks[i].core = format!("{canonical}{possessive}");
+                changed = true;
+            }
+        }
+        i += 1;
+    }
+    changed
+}
