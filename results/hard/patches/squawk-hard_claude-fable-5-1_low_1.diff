+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn terms(doc: &str) -> Vec<String> {
+        doc_terms(&[doc.to_string()])
+    }
+
+    #[test]
+    fn stems() {
+        assert_eq!(stem_word("src/status_item.rs"), Some("status_item"));
+        assert_eq!(stem_word("ui/VocabCache.swift"), Some("VocabCache"));
+        assert_eq!(stem_word("src/audio.rs"), Some("audio"));
+        assert_eq!(stem_word("a/foo.test.ts"), Some("foo"));
+        assert_eq!(stem_word("ui/Session.swift"), None);
+        assert_eq!(stem_word("LICENSE"), None);
+        assert_eq!(stem_word(".gitignore"), None);
+    }
+
+    #[test]
+    fn doc_terms_keep_names_and_identifiers() {
+        let t = terms(
+            "# squawk\n\nLocal dictation for macOS. Built for talking to Claude Code in a \
+             terminal.\nEverything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3. No \
+             account, no API keys.\nSee `VocabCache` and [SPEC.md](SPEC.md).\n\n## License\n\nMIT\n",
+        );
+        for want in [
+            "squawk",
+            "macOS",
+            "Claude Code",
+            "Claude",
+            "Mac",
+            "NVIDIA",
+            "Parakeet",
+            "Parakeet TDT",
+            "TDT",
+            "v3",
+            "API",
+            "VocabCache",
+            "MIT",
+        ] {
+            assert!(t.iter().any(|w| w == want), "{want} missing from {t:?}");
+        }
+        for unwanted in [
+            "Local",
+            "Built",
+            "Everything",
+            "No",
+            "See",
+            "License",
+            "Code",
+        ] {
+            assert!(!t.iter().any(|w| w == unwanted), "{unwanted} in {t:?}");
+        }
+    }
+
+    #[test]
+    fn shouting_is_not_a_term() {
+        let t = terms("You MUST run tests. IMPORTANT: this is OWNED BY THE CONTEXT AGENT.\n");
+        assert!(t.is_empty(), "{t:?}");
+    }
+
+    #[test]
+    fn code_fences_are_skipped() {
+        let t = terms("Run it:\n\n```sh\nFooBar --flag\n```\n");
+        assert!(t.is_empty(), "{t:?}");
+    }
+
+    #[test]
+    fn a_word_also_written_lowercase_is_not_a_name() {
+        let t = terms("We keep one Session per window. A session ends on quit.\n");
+        assert!(t.is_empty(), "{t:?}");
+    }
+
+    #[test]
+    fn walk_skips_hidden_and_build_dirs() {
+        let dir = tempfile::tempdir().unwrap();
+        for f in ["src/a.rs", ".hidden/x.rs", "target/debug/y.rs", "b.md"] {
+            let p = dir.path().join(f);
+            std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+            std::fs::write(p, "").unwrap();
+        }
+        assert_eq!(walk_files(dir.path()), ["b.md", "src/a.rs"]);
+    }
+
+    #[test]
+    fn package_names_from_manifests() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(dir.path().join("web")).unwrap();
+        std::fs::write(
+            dir.path().join("Cargo.toml"),
+            "[package]\nname = \"squawk-core\"\n",
+        )
+        .unwrap();
+        std::fs::write(
+            dir.path().join("web/package.json"),
+            "{\"name\": \"@you/squawk-web\"}",
+        )
+        .unwrap();
+        let files = vec!["Cargo.toml".to_string(), "web/package.json".to_string()];
+        assert_eq!(
+            package_names(dir.path(), &files),
+            ["squawk-core", "squawk-web"]
+        );
+    }
+}
