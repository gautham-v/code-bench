index 0000000..0f74ada
--- /dev/null
+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,439 @@
+//! Finding the agent session behind the front terminal, with libproc.
+//!
+//! One pass over the process table: every process descended from the
+//! terminal is a candidate, and a candidate is an agent when its name says so.
+//! "Name" is looser than `p_comm`: a native Claude Code install runs a binary
+//! named after its version (`~/.local/share/claude/versions/2.1.0`) and an npm
+//! install runs `node …/bin/claude`, so the executable path and argv are
+//! checked too.
+
+use super::{is_terminal, Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    let _ = (front, is_terminal as fn(&str) -> bool);
+    None
+}
+
+/// `claude`, `codex`, or a platform build of one (`codex-aarch64-apple-darwin`).
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn agent_for_name(name: &str) -> Option<Agent> {
+    AGENT_PROCESS_NAMES.iter().find_map(|(n, agent)| {
+        let rest = name.strip_prefix(n)?;
+        (rest.is_empty() || rest.starts_with('-')).then_some(*agent)
+    })
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn base(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+/// The executable path: its file name, or the versioned layout of a native
+/// install (`…/claude/versions/2.1.0`).
+fn agent_for_exe(path: &str) -> Option<Agent> {
+    if let Some(agent) = agent_for_name(base(path)) {
+        return Some(agent);
+    }
+    let mut comps = path.rsplit('/').skip(1);
+    match (comps.next(), comps.next()) {
+        (Some("versions"), Some(dir)) => agent_for_name(dir),
+        _ => None,
+    }
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+/// What an interpreter is running: `node /opt/homebrew/bin/claude`,
+/// `node …/@openai/codex/bin/codex.js`.
+fn agent_for_script(path: &str) -> Option<Agent> {
+    if path.contains("/@anthropic-ai/claude-code/") {
+        return Some(Agent::Claude);
+    }
+    if path.contains("/@openai/codex/") {
+        return Some(Agent::Codex);
+    }
+    agent_for_name(base(path))
+}
+
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+fn is_interpreter(name: &str) -> bool {
+    matches!(
+        name,
+        "node" | "bun" | "deno" | "sh" | "bash" | "zsh" | "dash"
+    ) || name.starts_with("python")
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    use std::collections::HashMap;
+
+    if !is_terminal(&front.bundle_id) || front.pid <= 0 {
+        return None;
+    }
+    let procs = sys::processes();
+    let parents: HashMap<i32, i32> = procs.iter().map(|p| (p.pid, p.ppid)).collect();
+    // Steps up to the terminal, or `None` if `pid` is not under it.
+    let depth = |pid: i32| -> Option<u32> {
+        let mut cur = pid;
+        for steps in 1..=64 {
+            cur = *parents.get(&cur)?;
+            if cur == front.pid {
+                return Some(steps);
+            }
+            if cur <= 1 {
+                return None;
+            }
+        }
+        None
+    };
+
+    struct Candidate {
+        session: Session,
+        tty_used: Option<std::time::SystemTime>,
+        depth: u32,
+        started: u64,
+    }
+    let mut found: Vec<Candidate> = Vec::new();
+    for p in &procs {
+        let Some(depth) = depth(p.pid) else { continue };
+        let Some(agent) = agent_of(p) else { continue };
+        let Some(cwd) = sys::cwd(p.pid) else { continue };
+        let tty = sys::tty_path(p.tdev);
+        let tty_used = tty.as_deref().and_then(|t| {
+            let meta = std::fs::metadata(t).ok()?;
+            [meta.accessed().ok(), meta.modified().ok()]
+                .into_iter()
+                .flatten()
+                .max()
+        });
+        found.push(Candidate {
+            session: Session {
+                agent,
+                pid: p.pid,
+                cwd,
+                tty,
+            },
+            tty_used,
+            depth,
+            started: p.started,
+        });
+    }
+    // Most recently used tty first; on one tty the outermost agent (its own
+    // helpers carry its name too); then the newest.
+    found.sort_by(|a, b| {
+        b.tty_used
+            .cmp(&a.tty_used)
+            .then(a.depth.cmp(&b.depth))
+            .then(b.started.cmp(&a.started))
+    });
+    found.into_iter().next().map(|c| c.session)
+}
+
+#[cfg(target_os = "macos")]
+fn agent_of(p: &sys::Proc) -> Option<Agent> {
+    if let Some(agent) = agent_for_name(&p.comm).or_else(|| agent_for_name(&p.name)) {
+        return Some(agent);
+    }
+    let exe = sys::exe_path(p.pid);
+    if let Some(agent) = exe.as_deref().and_then(agent_for_exe) {
+        return Some(agent);
+    }
+    let args = sys::args(p.pid);
+    if let Some(agent) = args.first().and_then(|a| agent_for_name(base(a))) {
+        return Some(agent);
+    }
+    let runner = exe.as_deref().map(base).unwrap_or(&p.comm);
+    if is_interpreter(runner) {
+        return args.get(1).and_then(|a| agent_for_script(a));
+    }
+    None
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    use std::ffi::{c_char, c_int, c_void, CStr};
+    use std::mem;
+    use std::path::PathBuf;
+
+    pub struct Proc {
+        pub pid: i32,
+        pub ppid: i32,
+        pub comm: String,
+        pub name: String,
+        pub tdev: u32,
+        pub started: u64,
+    }
+
+    /// `PROC_PIDT_SHORTBSDINFO`: the little that is readable for another
+    /// user's process (`login` runs as root between the terminal and the
+    /// shell), which is enough to keep the parent chain whole.
+    const PROC_PIDT_SHORTBSDINFO: c_int = 13;
+
+    #[repr(C)]
+    struct ShortInfo {
+        pid: u32,
+        ppid: u32,
+        pgid: u32,
+        status: u32,
+        comm: [c_char; 16],
+        flags: u32,
+        uid: u32,
+        gid: u32,
+        ruid: u32,
+        rgid: u32,
+        svuid: u32,
+        svgid: u32,
+        rfu: u32,
+    }
+
+    extern "C" {
+        fn devname_r(
+            dev: libc::dev_t,
+            kind: libc::mode_t,
+            buf: *mut c_char,
+            len: c_int,
+        ) -> *mut c_char;
+    }
+
+    fn string(chars: &[c_char]) -> String {
+        let bytes: Vec<u8> = chars
+            .iter()
+            .take_while(|c| **c != 0)
+            .map(|c| *c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    fn info<T>(pid: i32, flavor: c_int) -> Option<T> {
+        let mut out = mem::MaybeUninit::<T>::zeroed();
+        let size = mem::size_of::<T>() as c_int;
+        // SAFETY: `out` is `size` writable bytes; proc_pidinfo writes at most
+        // that many and reports how many it wrote.
+        let n =
+            unsafe { libc::proc_pidinfo(pid, flavor, 0, out.as_mut_ptr() as *mut c_void, size) };
+        // SAFETY: the kernel filled the whole struct, and every T used here
+        // is plain integers and byte arrays, valid for any bit pattern.
+        (n == size).then(|| unsafe { out.assume_init() })
+    }
+
+    pub fn processes() -> Vec<Proc> {
+        // SAFETY: a null buffer asks for the count only.
+        let count = unsafe { libc::proc_listallpids(std::ptr::null_mut(), 0) };
+        if count <= 0 {
+            return Vec::new();
+        }
+        let mut pids = vec![0 as libc::pid_t; count as usize + 64];
+        let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as c_int;
+        // SAFETY: `pids` is `bytes` writable bytes.
+        let n = unsafe { libc::proc_listallpids(pids.as_mut_ptr() as *mut c_void, bytes) };
+        if n <= 0 {
+            return Vec::new();
+        }
+        pids.truncate((n as usize).min(pids.len()));
+        pids.into_iter()
+            .filter(|pid| *pid > 0)
+            .filter_map(|pid| {
+                if let Some(b) = info::<libc::proc_bsdinfo>(pid, libc::PROC_PIDTBSDINFO) {
+                    return Some(Proc {
+                        pid,
+                        ppid: b.pbi_ppid as i32,
+                        comm: string(&b.pbi_comm),
+                        name: string(&b.pbi_name),
+                        tdev: b.e_tdev,
+                        started: b.pbi_start_tvsec,
+                    });
+                }
+                let s = info::<ShortInfo>(pid, PROC_PIDT_SHORTBSDINFO)?;
+                Some(Proc {
+                    pid,
+                    ppid: s.ppid as i32,
+                    comm: string(&s.comm),
+                    name: String::new(),
+                    tdev: u32::MAX,
+                    started: 0,
+                })
+            })
+            .collect()
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        let v = info::<libc::proc_vnodepathinfo>(pid, libc::PROC_PIDVNODEPATHINFO)?;
+        // SAFETY: vip_path is MAXPATHLEN contiguous bytes (libc spells it as
+        // nested arrays), NUL-terminated by the kernel; the last byte is
+        // forced to NUL below in case it is not.
+        let path = unsafe {
+            let ptr = v.pvi_cdir.vip_path.as_ptr() as *const c_char;
+            let len = mem::size_of_val(&v.pvi_cdir.vip_path);
+            let bytes = std::slice::from_raw_parts(ptr as *const u8, len);
+            let end = bytes.iter().position(|b| *b == 0).unwrap_or(len);
+            String::from_utf8_lossy(&bytes[..end]).into_owned()
+        };
+        (!path.is_empty()).then(|| PathBuf::from(path))
+    }
+
+    pub fn exe_path(pid: i32) -> Option<String> {
+        let mut buf = vec![0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        // SAFETY: `buf` is `buf.len()` writable bytes.
+        let n =
+            unsafe { libc::proc_pidpath(pid, buf.as_mut_ptr() as *mut c_void, buf.len() as u32) };
+        (n > 0).then(|| String::from_utf8_lossy(&buf[..n as usize]).into_owned())
+    }
+
+    /// argv, from `KERN_PROCARGS2`: argc, the exec path, NUL padding, then
+    /// the arguments. Empty when the process is not ours to read.
+    pub fn args(pid: i32) -> Vec<String> {
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        let mut size: libc::size_t = 0;
+        // SAFETY: a null buffer asks for the size only.
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                std::ptr::null_mut(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || size < 4 {
+            return Vec::new();
+        }
+        let mut buf = vec![0u8; size];
+        // SAFETY: `buf` is `size` writable bytes; the kernel updates `size`
+        // to what it wrote.
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                buf.as_mut_ptr() as *mut c_void,
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || size < 4 {
+            return Vec::new();
+        }
+        buf.truncate(size);
+        let argc = i32::from_ne_bytes([buf[0], buf[1], buf[2], buf[3]]).max(0) as usize;
+        let rest = &buf[4..];
+        let exec_end = rest.iter().position(|b| *b == 0).unwrap_or(rest.len());
+        let after = &rest[exec_end..];
+        let pad = after.iter().position(|b| *b != 0).unwrap_or(after.len());
+        after[pad..]
+            .split(|b| *b == 0)
+            .take(argc)
+            .map(|a| String::from_utf8_lossy(a).into_owned())
+            .collect()
+    }
+
+    pub fn tty_path(tdev: u32) -> Option<PathBuf> {
+        if tdev == u32::MAX || tdev == 0 {
+            return None;
+        }
+        let mut buf = [0 as c_char; 128];
+        // SAFETY: `buf` is 128 writable bytes; devname_r NUL-terminates what
+        // it writes and returns null when the device has no name.
+        let name = unsafe {
+            let p = devname_r(
+                tdev as libc::dev_t,
+                libc::S_IFCHR,
+                buf.as_mut_ptr(),
+                buf.len() as c_int,
+            );
+            if p.is_null() {
+                return None;
+            }
+            CStr::from_ptr(p).to_string_lossy().into_owned()
+        };
+        (!name.is_empty() && !name.starts_with('?') && !name.starts_with('#'))
+            .then(|| PathBuf::from(format!("/dev/{name}")))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn names() {
+        assert_eq!(agent_for_name("claude"), Some(Agent::Claude));
+        assert_eq!(agent_for_name("codex"), Some(Agent::Codex));
+        assert_eq!(
+            agent_for_name("codex-aarch64-apple-darwin"),
+            Some(Agent::Codex)
+        );
+        assert_eq!(agent_for_name("claudette"), None);
+        assert_eq!(agent_for_name("zsh"), None);
+    }
+
+    #[test]
+    fn executables_and_scripts() {
+        assert_eq!(
+            agent_for_exe("/Users/you/.local/share/claude/versions/2.1.0"),
+            Some(Agent::Claude)
+        );
+        assert_eq!(agent_for_exe("/opt/homebrew/bin/codex"), Some(Agent::Codex));
+        assert_eq!(agent_for_exe("/opt/homebrew/bin/node"), None);
+        assert_eq!(
+            agent_for_script("/usr/lib/node_modules/@anthropic-ai/claude-code/cli.js"),
+            Some(Agent::Claude)
+        );
+        assert_eq!(
+            agent_for_script("/opt/homebrew/bin/claude"),
+            Some(Agent::Claude)
+        );
+        assert_eq!(agent_for_script("server.js"), None);
+    }
+
+    #[test]
+    fn not_a_terminal_is_no_session() {
+        let front = FrontApp {
+            bundle_id: "com.apple.Safari".into(),
+            name: "Safari".into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(detect(&front), None);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn finds_an_agent_under_the_front_app() {
+        // A process named `claude` under this test process, which plays the
+        // terminal.
+        let dir = tempfile::tempdir().unwrap();
+        let work = dir.path().join("proj");
+        std::fs::create_dir(&work).unwrap();
+        let exe = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &exe).unwrap();
+        let mut child = std::process::Command::new(&exe)
+            .arg("30")
+            .current_dir(&work)
+            .spawn()
+            .unwrap();
+        let front = FrontApp {
+            bundle_id: "com.mitchellh.ghostty".into(),
+            name: "Ghostty".into(),
+            pid: std::process::id() as i32,
+        };
+        // exec may not have happened yet on the first look.
+        let mut session = None;
+        for _ in 0..100 {
+            session = detect(&front).filter(|s| s.pid == child.id() as i32);
+            if session.is_some() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        child.kill().ok();
+        child.wait().ok();
+        let session = session.expect("session found");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(
+            session.cwd.canonicalize().unwrap(),
+            work.canonicalize().unwrap()
+        );
+        assert_eq!(session.project(), "proj");
+    }
+}
