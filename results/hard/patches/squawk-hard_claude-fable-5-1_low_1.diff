+//! Scanning a repo for its files and its words, and knowing when to rescan.
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::SystemTime;
+
+use super::RepoVocab;
+
+/// Read for headings and capitalised terms.
+const DOC_FILES: [&str; 3] = ["README.md", "CLAUDE.md", "CONTEXT.md"];
+const MAX_DOC_BYTES: u64 = 256 * 1024;
+const MAX_MANIFESTS: usize = 64;
+/// Above this, tracked files are not checked for existence (one stat each).
+const MAX_STAT_FILES: usize = 20_000;
+
+/// The walk outside git: how deep, how many files, and what to skip.
+const WALK_MAX_DEPTH: usize = 8;
+const WALK_MAX_FILES: usize = 20_000;
+const WALK_SKIP_DIRS: &[&str] = &[
+    "node_modules",
+    "target",
+    "build",
+    "dist",
+    "vendor",
+    "venv",
+    "__pycache__",
+];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let files = match git_files(cwd) {
+        Some(files) if !files.is_empty() => files,
+        _ => walk_files(cwd),
+    };
+    let mut words = Words::default();
+    for file in &files {
+        if let Some(stem) = stem_word(file) {
+            words.add(stem);
+        }
+    }
+    for name in package_names(cwd, &files) {
+        words.add(&name);
+    }
+    let docs: Vec<String> = DOC_FILES
+        .iter()
+        .filter_map(|name| read_capped(&cwd.join(name)))
+        .collect();
+    for term in doc_terms(&docs) {
+        words.add(&term);
+    }
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words: words.list,
+    }
+}
+
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn add(&mut self, word: &str) {
+        if self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+/// Tracked files under `cwd`, relative to it. `None` outside git (or
+/// without git).
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .arg("ls-files")
+        .arg("-z")
+        .current_dir(cwd)
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let mut files: Vec<String> = out
+        .stdout
+        .split(|b| *b == 0)
+        .filter(|p| !p.is_empty())
+        .filter_map(|p| std::str::from_utf8(p).ok().map(str::to_string))
+        .collect();
+    // A file deleted but not yet staged is still in the index; a mention of
+    // it would point at nothing.
+    if files.len() <= MAX_STAT_FILES {
+        files.retain(|f| cwd.join(f).symlink_metadata().is_ok());
+    }
+    Some(files)
+}
+
+/// Outside git: a bounded breadth-first walk, skipping hidden directories
+/// and the usual build output.
+fn walk_files(cwd: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    let mut level: Vec<PathBuf> = vec![PathBuf::new()];
+    for _ in 0..=WALK_MAX_DEPTH {
+        let mut next = Vec::new();
+        for rel in &level {
+            let Ok(read) = std::fs::read_dir(cwd.join(rel)) else {
+                continue;
+            };
+            let mut entries: Vec<_> = read.flatten().collect();
+            entries.sort_by_key(|e| e.file_name());
+            for entry in entries {
+                let Some(name) = entry.file_name().to_str().map(str::to_string) else {
+                    continue;
+                };
+                let Ok(kind) = entry.file_type() else {
+                    continue;
+                };
+                let path = rel.join(&name);
+                if kind.is_dir() {
+                    if !name.starts_with('.') && !WALK_SKIP_DIRS.contains(&name.as_str()) {
+                        next.push(path);
+                    }
+                } else if kind.is_file() && name != ".DS_Store" {
+                    if let Some(p) = path.to_str() {
+                        files.push(p.replace(std::path::MAIN_SEPARATOR, "/"));
+                    }
+                    if files.len() >= WALK_MAX_FILES {
+                        files.sort();
+                        return files;
+                    }
+                }
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        level = next;
+    }
+    files.sort();
+    files
+}
+
+fn read_capped(path: &Path) -> Option<String> {
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > MAX_DOC_BYTES {
+        return None;
+    }
+    std::fs::read_to_string(path).ok()
+}
+
+fn file_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// Letters, digits, `_` and `-`, starting with a letter: something that can
+/// be a term.
+fn is_term_word(word: &str) -> bool {
+    word.len() >= 2
+        && word.chars().next().is_some_and(char::is_alphabetic)
+        && word
+            .chars()
+            .all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+}
+
+fn is_all_caps(word: &str) -> bool {
+    word.chars().any(char::is_uppercase) && !word.chars().any(char::is_lowercase)
+}
+
+/// `Session`: a capital first letter and nothing else to go on.
+fn is_capitalized_plain(word: &str) -> bool {
+    let mut chars = word.chars();
+    chars.next().is_some_and(char::is_uppercase) && chars.all(char::is_lowercase)
+}
+
+/// The stem of a file name as a term: `status_item`, `VocabCache`, `audio`.
+/// A stem whose only capitals are its first letter or all of them
+/// (`Session.swift`, `LICENSE`) is naming convention, not spelling — taking
+/// it would capitalise "session" and "license" in ordinary prose.
+fn stem_word(path: &str) -> Option<&str> {
+    let stem = file_name(path).split('.').next()?;
+    (is_term_word(stem) && !is_capitalized_plain(stem) && !is_all_caps(stem)).then_some(stem)
+}
+
+/// Names the repo's own manifests declare: Cargo packages, npm packages,
+/// Python projects, Go modules.
+fn package_names(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| {
+            matches!(
+                file_name(f),
+                "Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod"
+            )
+        })
+        .collect();
+    manifests.sort_by_key(|f| f.matches('/').count());
+    let mut names = Vec::new();
+    for rel in manifests.into_iter().take(MAX_MANIFESTS) {
+        let Some(body) = read_capped(&cwd.join(rel)) else {
+            continue;
+        };
+        let name = match file_name(rel) {
+            "package.json" => serde_json::from_str::<serde_json::Value>(&body)
+                .ok()
+                .and_then(|v| v.get("name")?.as_str().map(str::to_string)),
+            "go.mod" => body
+                .lines()
+                .find_map(|l| l.trim().strip_prefix("module "))
+                .map(|m| m.trim().to_string()),
+            _ => body.parse::<toml::Table>().ok().and_then(|t| {
+                let name = |keys: &[&str]| {
+                    let mut v = t.get(keys[0])?;
+                    for k in &keys[1..] {
+                        v = v.get(k)?;
+                    }
+                    v.get("name")?.as_str().map(str::to_string)
+                };
+                name(&["package"])
+                    .or_else(|| name(&["project"]))
+                    .or_else(|| name(&["tool", "poetry"]))
+            }),
+        };
+        // `@scope/name` and `github.com/you/name` are known by their last part.
+        if let Some(name) = name.as_deref().map(file_name) {
+            if is_term_word(name) {
+                names.push(name.to_string());
+            }
+        }
+    }
+    names
+}
+
+/// All-caps words that are emphasis or keywords (`GET /users`), not names.
+const SHOUTED: &[&str] = &[
+    "ALL",
+    "ALWAYS",
+    "AND",
+    "ANY",
+    "BY",
+    "CRITICAL",
+    "DELETE",
+    "DO",
+    "DONT",
+    "FALSE",
+    "FIXME",
+    "FROM",
+    "GET",
+    "HEAD",
+    "IF",
+    "IMPORTANT",
+    "INSERT",
+    "MUST",
+    "NEVER",
+    "NO",
+    "NOT",
+    "NOTE",
+    "NULL",
+    "OK",
+    "ONLY",
+    "OR",
+    "PATCH",
+    "POST",
+    "PUT",
+    "SELECT",
+    "STOP",
+    "THE",
+    "TODO",
+    "TRUE",
+    "UPDATE",
+    "WARNING",
+    "WHERE",
+    "YES",
+];
+
+struct Token<'a> {
+    word: &'a str,
+    /// Nothing but the word in its chunk: no quotes, brackets or punctuation.
+    bare: bool,
+    /// The first word of a sentence, line or bracket, where a capital says
+    /// nothing.
+    opens: bool,
+}
+
+/// Terms the docs write in a particular way: the title, identifiers
+/// (`VocabCache`, `macOS`, `utf8`), acronyms, and names capitalised in the
+/// middle of a sentence ("Parakeet", "Claude Code"). Ordinary words are left
+/// out, however they are cased: a sentence opener, a Title Case heading and
+/// shouted emphasis are not how the repo spells anything.
+fn doc_terms(docs: &[String]) -> Vec<String> {
+    let lowercase: HashSet<&str> = docs
+        .iter()
+        .flat_map(|d| d.split(|c: char| !c.is_alphanumeric()))
+        .filter(|w| !w.is_empty() && w.chars().all(char::is_lowercase))
+        .collect();
+    let written_lowercase = |w: &str| lowercase.contains(w.to_lowercase().as_str());
+
+    let mut terms = Vec::new();
+    let mut title_seen = false;
+    for doc in docs {
+        let mut fenced = false;
+        for line in doc.lines() {
+            let line = line.trim();
+            if line.starts_with("```") || line.starts_with("~~~") {
+                fenced = !fenced;
+                continue;
+            }
+            if fenced {
+                continue;
+            }
+            let heading = line.starts_with('#');
+            if heading && line.starts_with("# ") && !title_seen {
+                title_seen = true;
+                let title: Vec<&str> = line[2..].split_whitespace().collect();
+                if (1..=3).contains(&title.len()) && title.iter().all(|w| is_term_word(w)) {
+                    terms.push(title.join(" "));
+                }
+            }
+            let tokens = tokenize(line, heading);
+            for (i, t) in tokens.iter().enumerate() {
+                if text_has_shape(t.word) {
+                    terms.push(t.word.to_string());
+                } else if is_all_caps(t.word) {
+                    let shouting = |j: usize| {
+                        tokens
+                            .get(j)
+                            .is_some_and(|n| is_all_caps(n.word) && !text_has_shape(n.word))
+                    };
+                    let beside_caps = (i > 0 && shouting(i - 1)) || shouting(i + 1);
+                    if !beside_caps && !SHOUTED.contains(&t.word) && !written_lowercase(t.word) {
+                        terms.push(t.word.to_string());
+                    }
+                }
+            }
+            // A run of capitalised words mid-sentence is a name.
+            let mut i = 0;
+            while i < tokens.len() {
+                let t = &tokens[i];
+                if !t.opens && is_capitalized_plain(t.word) {
+                    let mut end = i + 1;
+                    while end < tokens.len()
+                        && end - i < 4
+                        && tokens[end - 1].bare
+                        && !tokens[end].opens
+                        && tokens[end]
+                            .word
+                            .chars()
+                            .next()
+                            .is_some_and(char::is_uppercase)
+                    {
+                        end += 1;
+                    }
+                    if t.word.len() >= 3 && !written_lowercase(t.word) {
+                        terms.push(t.word.to_string());
+                    }
+                    if end - i >= 2 {
+                        let run: Vec<&str> = tokens[i..end].iter().map(|t| t.word).collect();
+                        terms.push(run.join(" "));
+                        i = end;
+                        continue;
+                    }
+                }
+                i += 1;
+            }
+        }
+    }
+    terms
+}
+
+/// Mixed case (`VocabCache`, `macOS`) or letters with digits (`utf8`): a
+/// spelling that could not be anything but deliberate.
+fn text_has_shape(word: &str) -> bool {
+    let lower = word.chars().any(char::is_lowercase);
+    let digit = word.chars().any(|c| c.is_ascii_digit());
+    (crate::text::has_inner_case(word) && lower) || digit
+}
+
+fn tokenize(line: &str, heading: bool) -> Vec<Token<'_>> {
+    let mut tokens = Vec::new();
+    let mut opens = true;
+    for raw in line.split_whitespace() {
+        let body = raw.trim_matches(|c: char| !c.is_alphanumeric());
+        let body = body
+            .strip_suffix("'s")
+            .or_else(|| body.strip_suffix("’s"))
+            .unwrap_or(body);
+        if body.is_empty() {
+            // A bullet, a dash, a table bar: what follows starts afresh.
+            opens = true;
+            continue;
+        }
+        let led = !raw.starts_with(|c: char| c.is_alphanumeric());
+        if is_term_word(body) {
+            tokens.push(Token {
+                word: body,
+                bare: body.len() == raw.len(),
+                opens: opens || led || heading,
+            });
+        } else {
+            // A path, a URL, a number: it breaks any run of names.
+            if let Some(last) = tokens.last_mut() {
+                last.bare = false;
+            }
+        }
+        opens = raw.ends_with(['.', '?', '!', ':', ';'])
+            || raw
+                .trim_end_matches(['"', '\'', ')', ']', '*', '_', '`'])
+                .ends_with(['.', '?', '!', ':']);
+    }
+    tokens
+}
+
+/// What a cached vocab was built from; a change in any of it means rebuild.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Stamp {
+    /// `.git/index`, when `cwd` is inside a repo that has one.
+    index: Option<SystemTime>,
+    docs: [Option<SystemTime>; 3],
+    /// The directory itself: changes when a file is added to or removed
+    /// from its top level.
+    root: Option<SystemTime>,
+}
+
+impl Stamp {
+    pub(super) fn read(cwd: &Path) -> Stamp {
+        let mtime = |p: &Path| std::fs::metadata(p).and_then(|m| m.modified()).ok();
+        Stamp {
+            index: git_index(cwd).and_then(|p| mtime(&p)),
+            docs: DOC_FILES.map(|name| mtime(&cwd.join(name))),
+            root: mtime(cwd),
+        }
+    }
+
+    /// Tracked by git: the index says when the file list changes.
+    pub(super) fn in_git(&self) -> bool {
+        self.index.is_some()
+    }
+}
+
+/// The index of the repo containing `cwd`: `.git/index`, or wherever a
+/// worktree's `.git` file points.
+fn git_index(cwd: &Path) -> Option<PathBuf> {
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        let Ok(meta) = std::fs::metadata(&dot_git) else {
+            continue;
+        };
+        if meta.is_dir() {
+            return Some(dot_git.join("index"));
+        }
+        let body = std::fs::read_to_string(&dot_git).ok()?;
+        let target = body.lines().find_map(|l| l.strip_prefix("gitdir:"))?.trim();
+        return Some(dir.join(target).join("index"));
+    }
+    None
+}
