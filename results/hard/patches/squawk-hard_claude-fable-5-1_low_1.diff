+        assert_eq!(a("nowhere slash mod dot rs"), "nowhere slash mod dot rs");
+    }
+
+    #[test]
+    fn dotfiles_and_double_extensions() {
+        assert_eq!(a("add it to dot git ignore"), "add it to @.gitignore");
+        assert_eq!(a("app dot test dot ts"), "@web/app.test.ts");
+    }
+
+    #[test]
+    fn paths_with_spaces_are_not_mentioned() {
+        assert_eq!(a("my file dot ts"), "my file dot ts");
+    }
+
+    #[test]
+    fn protected_chunks_are_left_alone() {
+        assert_eq!(
+            a("see src/main.rs and audio.rs"),
+            "see src/main.rs and audio.rs"
+        );
+        assert_eq!(
+            a("in @web/app.test.ts dot rs"),
+            "in @web/app.test.ts dot rs"
+        );
+        assert_eq!(a("run `vocab cache` now"), "run `vocab cache` now");
+    }
+
+    #[test]
+    fn jargon_gets_the_repo_spelling() {
+        assert_eq!(a("the vocab cache is stale"), "the VocabCache is stale");
+        assert_eq!(a("Vocab-cache, I think"), "VocabCache, I think");
+        assert_eq!(a("ask claude code"), "ask Claude Code");
+        assert_eq!(
+            a("parakeet's output on nvidia"),
+            "Parakeet's output on NVIDIA"
+        );
+        assert_eq!(a("we call Squawk here"), "we call squawk here");
+        assert_eq!(a("in Status_Item we"), "in status_item we");
+    }
+
+    #[test]
+    fn ordinary_words_keep_their_casing() {
+        assert_eq!(
+            a("Audio is choppy. Audio again."),
+            "Audio is choppy. Audio again."
+        );
+        assert_eq!(a("call the API"), "call the API");
+        assert_eq!(a("the status item flickers"), "the status item flickers");
+        assert_eq!(a("in squawk core"), "in squawk core");
+    }
+
+    #[test]
+    fn two_spellings_of_one_word_cancel() {
+        let v = vocab(&[], &["StatusItem", "status_item"]);
