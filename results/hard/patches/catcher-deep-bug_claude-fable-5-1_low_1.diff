+/// Fold an already-rendered page the way the editor has the note folded:
+/// every line `visible` hides is dropped, and each heading in `folded` gets
+/// the `▸` marker in front and the count of what it hides after it.
+///
+/// A blank line belongs to the block it comes before, so the one ahead of a
+/// hidden block goes with it; a row the renderer drew around a block — the
+/// bottom of a box — goes with the block it closes.
+pub fn fold_page(r: &mut Rendered, visible: &crate::fold::Visible, folded: &[usize]) {
+    if visible.is_plain() {
+        return;
+    }
+    let mut out: Vec<PLine> = Vec::with_capacity(r.lines.len());
+    let mut blanks: Vec<PLine> = Vec::new();
+    let mut hiding = false;
+    let mut marked = None;
+    for mut line in std::mem::take(&mut r.lines) {
+        let Some(src) = line.src_line else {
+            if line.cells.is_empty() && line.image.is_none() {
+                blanks.push(line);
+            } else if !hiding {
+                out.append(&mut blanks);
+                out.push(line);
+            }
+            continue;
+        };
+        hiding = visible.is_hidden(src);
+        if hiding {
+            blanks.clear();
+            continue;
+        }
+        out.append(&mut blanks);
+        if folded.contains(&src) && marked != Some(src) {
+            marked = Some(src);
+            let cell = |ch, style| PCell {
+                ch,
+                style,
+                link: None,
+                src: None,
+            };
+            line.cells
+                .splice(0..0, [cell('▸', theme::fold()), cell(' ', theme::fold())]);
+            let label = match visible.hidden_under(src) {
+                1 => "  1 line folded".to_string(),
+                n => format!("  {n} lines folded"),
+            };
+            line.cells
+                .extend(label.chars().map(|ch| cell(ch, theme::marker())));
+        }
+        out.push(line);
+    }
+    if !hiding {
+        out.append(&mut blanks);
+    }
+    r.lines = out;
+}
