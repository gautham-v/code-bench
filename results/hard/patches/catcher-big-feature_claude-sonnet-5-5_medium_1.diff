+/// The number an ordered list was seen to start on, and whether it numbers
+/// every item the same.
+#[derive(Clone, Copy)]
+struct ListState {
+    first: usize,
+    start: u64,
+    flat: bool,
+}
+
+/// Columns of leading whitespace; a tab counts four.
+fn width(line: &str) -> usize {
+    line.chars()
+        .take_while(|c| matches!(c, ' ' | '\t'))
+        .map(|c| if c == '\t' { 4 } else { 1 })
+        .sum()
+}
+
+/// Bytes of the number, its end, its value and the `.` or `)` after it, for
+/// an ordered item.
+fn ordered(line: &str) -> Option<(usize, usize, u64, char)> {
+    let ds = line.len() - line.trim_start_matches([' ', '\t']).len();
+    let rest = &line[ds..];
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 {
+        return None;
+    }
+    let punct = rest[digits..].chars().next().filter(|c| matches!(c, '.' | ')'))?;
+    if !rest[digits + 1..].starts_with(' ') {
+        return None;
+    }
+    let n = rest[..digits].parse().ok()?;
+    Some((ds, ds + digits, n, punct))
+}
+
+fn is_item(line: &str) -> bool {
+    let rest = line.trim_start_matches([' ', '\t']);
+    ordered(line).is_some() || ["- ", "* ", "+ "].iter().any(|m| rest.starts_with(m))
+}
+
+/// Rows of the ordered list `row` is an item of: items at its indent and with
+/// its delimiter, the rows under each (indented further) between them. A blank
+/// line or anything else at that indent ends the list.
+fn list_block(lines: &[String], row: usize) -> Option<Vec<usize>> {
+    let (_, _, _, p) = ordered(lines.get(row)?)?;
+    let w = width(&lines[row]);
+    let sibling = |l: &String| width(l) == w && ordered(l).is_some_and(|o| o.3 == p);
+    let mut members = vec![row];
+    let mut j = row;
+    while j > 0 {
+        j -= 1;
+        let l = &lines[j];
+        let lw = width(l);
+        if l.trim().is_empty() || lw < w {
+            break;
+        }
+        if lw == w {
+            if !sibling(l) {
+                break;
+            }
+            members.insert(0, j);
+        }
+    }
+    for (j, l) in lines.iter().enumerate().skip(row + 1) {
+        let lw = width(l);
+        if l.trim().is_empty() || lw < w {
+            break;
+        }
+        if lw == w {
+            if !sibling(l) {
+                break;
+            }
+            members.push(j);
+        }
+    }
+    Some(members)
+}
+
+fn list_state(lines: &[String], row: usize) -> Option<ListState> {
+    let members = list_block(lines, row)?;
+    let num = |r: usize| ordered(&lines[r]).map_or(0, |o| o.2);
+    Some(ListState {
+        first: members[0],
+        start: num(members[0]),
+        flat: members.len() >= 2 && num(members[0]) == num(members[1]),
+    })
+}
+
+/// Last row of the item on `row` and everything nested under it.
+fn subtree_end(lines: &[String], row: usize) -> usize {
+    let w = width(&lines[row]);
+    let mut end = row;
+    for (j, l) in lines.iter().enumerate().skip(row + 1) {
+        if l.trim().is_empty() {
+            continue;
+        }
+        if width(l) <= w {
+            break;
+        }
+        end = j;
+    }
+    end
+}
+
+/// Whether the item on `row` has an item above it at its own indent to nest
+/// under, with nothing but that item's own children between.
+fn has_sibling_above(lines: &[String], row: usize) -> bool {
+    let w = width(&lines[row]);
+    for l in lines[..row].iter().rev() {
+        let lw = width(l);
+        if l.trim().is_empty() || lw < w {
+            return false;
+        }
+        if lw == w {
+            return is_item(l);
+        }
+    }
+    false
+}
+
+/// Take about `cols` columns of leading whitespace off `line`.
+fn strip_width(line: &mut String, cols: usize) {
+    let mut taken = 0;
+    let mut bytes = 0;
+    for c in line.chars() {
+        if taken >= cols || !matches!(c, ' ' | '\t') {
+            break;
+        }
+        taken += if c == '\t' { 4 } else { 1 };
+        bytes += 1;
+    }
+    line.replace_range(..bytes, "");
+}
