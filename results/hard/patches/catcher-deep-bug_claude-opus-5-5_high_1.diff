+    /// A session over a folder of its own, with `open` in the editor. Built
+    /// without `launch`, so nothing here reads the settings note or writes
+    /// the recents list of whoever is running the tests.
+    fn session(name: &str, files: &[(&str, &str)], open: &str) -> App {
+        let dir = std::env::temp_dir().join(format!("catcher-app-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let dir = std::fs::canonicalize(&dir).unwrap();
+        for (file, body) in files {
+            std::fs::write(dir.join(file), body).unwrap();
+        }
+        let config = Config {
+            notes_dir: dir.clone(),
+            attachments_dir: dir.join("attachments"),
+            window_title: false,
+            linked_mentions: false,
+            ..Default::default()
+        };
+        let all = notes::load_all(&dir).unwrap();
+        let active = all
+            .iter()
+            .position(|n| n.path.file_name().is_some_and(|f| f == open))
+            .unwrap();
+        let mut app = App::with_notes(config, dir, all, active, false, Vec::new());
+        app.load_active_into_editor();
+        app
+    }
+
+    fn close(app: App) {
+        let _ = std::fs::remove_dir_all(&app.dir);
+    }
+
+    /// Fold the section under the heading on `row`, the way the key does.
+    fn fold_at(app: &mut App, row: usize) {
+        app.editor.set_cursor((row, 0));
+        app.fold_section();
+        assert!(app.folded_here(row), "row {row} did not fold");
+    }
+
+    /// The source lines the editor would draw nothing for.
+    fn hidden(app: &App) -> Vec<usize> {
+        (0..app.editor.lines().len())
+            .filter(|&r| app.visible.is_hidden(r))
+            .collect()
+    }
+
+    /// Another program writes the open note's file.
+    fn rewrite(app: &App, body: &str) {
+        std::fs::write(&app.active_note().path, body).unwrap();
+        assert_eq!(notes::check_disk(app.active_note()), notes::Disk::Changed);
+    }
+
+    /// One frame on a terminal of its own, as the rows of text it drew.
+    fn frame(app: &mut App) -> Vec<String> {
+        let backend = ratatui::backend::TestBackend::new(60, 30);
+        let mut terminal = ratatui::Terminal::new(backend).unwrap();
+        terminal.draw(|f| crate::ui::draw(f, app)).unwrap();
+        let buf = terminal.backend().buffer();
+        (0..buf.area.height)
+            .map(|y| {
+                (0..buf.area.width)
+                    .map(|x| buf[(x, y)].symbol())
+                    .collect::<String>()
+                    .trim()
+                    .to_string()
+            })
+            .collect()
+    }
+
+    fn click(app: &mut App, x: u16, y: u16) {
+        app.on_mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: x,
+            row: y,
+            modifiers: KeyModifiers::NONE,
+        });
+        app.on_mouse(MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column: x,
+            row: y,
+            modifiers: KeyModifiers::NONE,
+        });
+    }
+
