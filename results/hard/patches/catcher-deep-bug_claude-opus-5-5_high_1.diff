+    #[test]
+    fn folds_stay_with_a_note_whose_file_is_renamed_or_moved() {
+        let mut app = session("rename", &[("plan.md", PLAN)], "plan.md");
+        fold_at(&mut app, 2);
+        fold_at(&mut app, 7);
+        let old = app.active_note().path.clone();
+
+        // the title changes, and the save renames the file to follow it
+        app.editor.set_line(0, "# Plans".to_string());
+        app.sync_editor_to_note();
+        app.save_now();
+        let renamed = app.active_note().path.clone();
+        assert_eq!(renamed.file_name().unwrap(), "plans.md");
+        assert!(!old.exists());
+        assert!(app.folded_here(2) && app.folded_here(7));
+        assert_eq!(hidden(&app), vec![3, 4, 5, 6, 8]);
+
+        // moved to another folder: the same note, at another path again
+        let sub = app.dir.join("archive");
+        notes::move_file(&mut app.notes[app.active], &sub).unwrap();
+        app.carry_folds(&renamed);
+        assert_eq!(app.active_note().path, sub.join("plans.md"));
+        assert!(app.folded_here(2) && app.folded_here(7));
+        assert_eq!(hidden(&app), vec![3, 4, 5, 6, 8]);
+        // and nothing is left filed under the names it used to have
+        assert!(app.folds.of(&old).is_empty());
