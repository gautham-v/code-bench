+    #[test]
+    fn a_reload_drops_the_fold_of_a_heading_the_rewrite_removed_and_no_other() {
+        let mut app = session("reload-gone", &[("plan.md", PLAN)], "plan.md");
+        fold_at(&mut app, 7); // Two
+        fold_at(&mut app, 2); // One
+        app.editor.set_cursor((8, 0));
+        // the cursor cannot be inside a fold: it is on the heading
+        let before = app.editor.cursor.0;
+        app.leave_folds(before);
+        assert_eq!(app.editor.cursor.0, 7);
+
+        // One is renamed by the other program, and Two moves up a line
+        rewrite(
