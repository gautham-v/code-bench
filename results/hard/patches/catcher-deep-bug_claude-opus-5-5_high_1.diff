+        app.reload_from_disk();
+        assert!(app.folded_here(6));
+        assert_eq!(hidden(&app), vec![7, 8, 9]);
+        // the cursor kept its line number, which is inside Two now: it steps
+        // out to the heading rather than opening what was folded
+        assert_eq!(app.editor.cursor.0, 6);
+        assert!(!app.visible.is_hidden(app.editor.cursor.0));
