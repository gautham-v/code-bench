+/// Take the lines a fold hides off an already-rendered page. `hidden` answers
+/// for a source line; every rendered line that came from a hidden one goes —
+/// each row of a table, a code block, a picture.
+///
+/// A blank row between two blocks has no source line of its own. It is there
+/// for the block under it, so it goes when that block does and stays when it
+/// does not: a folded heading keeps its distance from the heading after it.
+pub fn hide_lines(r: &mut Rendered, hidden: impl Fn(usize) -> bool) {
+    let mut keep = vec![true; r.lines.len()];
+    // walked from the bottom, so each row with no source line already knows
+    // what became of the first row under it that has one
+    let mut below = true;
+    for (i, line) in r.lines.iter().enumerate().rev() {
+        if let Some(src) = line.src_line {
+            below = !hidden(src);
+        }
+        keep[i] = below;
+    }
+    let mut keep = keep.into_iter();
+    r.lines.retain(|_| keep.next().unwrap_or(true));
+}
