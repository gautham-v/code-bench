+    #[test]
+    fn a_folded_section_takes_no_rows_and_its_heading_carries_the_marker() {
+        let md = "# Title\n\nintro\n\n## One\n\na\n\n- b\n- c\n\n```\n# code\n```\n\n## Two\n\nd\n";
+        let lines: Vec<String> = md.lines().map(String::from).collect();
+        let blocks = crate::md::blocks(&lines);
+        let visible = crate::fold::Visible::new(&lines, &blocks, &[4]);
+        let mut r = render(md);
+        let open: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        fold_page(&mut r, &visible, &[4]);
+        let page: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        let one = page.iter().position(|l| l.contains("One")).unwrap();
+        assert!(page[one].starts_with(theme::FOLDED), "{page:?}");
+        assert_eq!(r.lines[one].cells[0].src, Some((4, 0)));
+        // one blank, then the next heading: nothing of the section is left
+        assert_eq!(page[one + 1], "");
+        assert!(page[one + 2].contains("Two"), "{page:?}");
+        assert!(page.last().unwrap().contains('d'));
+        assert!(!page.iter().any(|l| l.contains("code") || l.contains('b')));
+        // everything outside the fold is as it was
+        let two = open.iter().position(|l| l.contains("Two")).unwrap();
+        assert_eq!(page[one + 2..], open[two..]);
+        assert_eq!(page[..one], open[..one]);
+        // and nothing folded is nothing changed
+        let mut plain = render(md);
+        fold_page(&mut plain, &crate::fold::Visible::new(&lines, &blocks, &[]), &[]);
+        assert_eq!(plain.lines.len(), open.len());
+    }
+
