+/// Close the sections `visible` hides on an already-rendered page, so the
+/// reading view shows a fold the way the editor does: the lines under a
+/// folded heading take no rows, and the heading — the lines in `folded` —
+/// carries the `▸ ` marker in front.
+///
+/// A line the renderer invented has no source line of its own and goes the
+/// way of the source line before it: the blank under a folded heading stays,
+/// the blanks between the paragraphs it hides do not. Called before the
+/// mentions footer is appended, which no fold ever hides.
+pub fn fold_page(r: &mut Rendered, visible: &crate::fold::Visible, folded: &[usize]) {
+    if folded.is_empty() {
+        return;
+    }
+    let mut hiding = false;
+    let mut marked = None;
+    r.lines.retain_mut(|line| {
+        if let Some(row) = line.src_line {
+            hiding = visible.is_hidden(row);
+            if !hiding && folded.contains(&row) && marked != Some(row) {
+                marked = Some(row);
+                let marker = theme::FOLDED.chars().map(|ch| PCell {
+                    ch,
+                    style: theme::fold(),
+                    link: None,
+                    src: Some((row, 0)),
+                });
+                line.cells.splice(0..0, marker);
+            }
+        }
+        !hiding
+    });
+}
