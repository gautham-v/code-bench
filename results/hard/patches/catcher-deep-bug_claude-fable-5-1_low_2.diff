+/// Every heading in the buffer with the headings it sits under, outermost
+/// first and itself last: what a heading is, wherever its line has gone.
+fn outline(lines: &[String], blocks: &[Block]) -> Vec<(usize, Vec<String>)> {
+    let mut open: Vec<(usize, String)> = Vec::new();
+    let mut out = Vec::new();
+    for row in 0..lines.len() {
+        let Some(level) = heading_at(lines, blocks, row) else {
+            continue;
+        };
+        while open.last().is_some_and(|(l, _)| *l >= level) {
+            open.pop();
+        }
+        open.push((level, lines[row].clone()));
+        out.push((row, open.iter().map(|(_, t)| t.clone()).collect()));
+    }
+    out
+}
