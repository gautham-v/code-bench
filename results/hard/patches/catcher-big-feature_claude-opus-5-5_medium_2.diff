index 0000000..f8cd7c8
--- /dev/null
+++ b/src/lists.rs
@@ -0,0 +1,421 @@
+//! Lists as the editor needs to see them: which lines are items, which items
+//! are siblings, and what an edit should do to the numbers of an ordered one.
+//!
+//! Pure functions over the buffer's lines. A *block* is one list, nested
+//! items and all; a *run* is the ordered siblings in it that count together.
+
+/// A numbered item's number: its value, how many digits wrote it, and the
+/// `.` or `)` after it.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Number {
+    pub value: u64,
+    pub digits: usize,
+    pub punct: char,
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Kind {
+    /// A list item: its number if it is an ordered one, and the width of
+    /// its marker with the space after it (`- ` is 2, `10. ` is 4).
+    Item {
+        number: Option<Number>,
+        marker: usize,
+    },
+    Blank,
+    /// Anything else: a paragraph, a continuation line, code.
+    Text,
+}
+
+/// One line, split into its quote bars, its indent and what follows.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Row {
+    /// Bytes of leading `> ` bars, and how many bars there are.
+    pub quote: usize,
+    pub depth: usize,
+    /// Bytes of indent after the bars, and its width with a tab as four.
+    pub indent: usize,
+    pub width: usize,
+    pub kind: Kind,
+}
+
+impl Row {
+    pub fn is_item(&self) -> bool {
+        matches!(self.kind, Kind::Item { .. })
+    }
+
+    pub fn number(&self) -> Option<Number> {
+        match self.kind {
+            Kind::Item { number, .. } => number,
+            _ => None,
+        }
+    }
+}
+
+/// The ordered siblings of one level of one list, top to bottom.
+#[derive(Clone, PartialEq, Debug)]
+pub struct Run {
+    pub rows: Vec<usize>,
+    pub width: usize,
+}
+
+/// One list: lines `from..=to`, and the ordered runs in it.
+#[derive(Clone, PartialEq, Debug)]
+pub struct Block {
+    pub from: usize,
+    pub to: usize,
+    pub runs: Vec<Run>,
+}
+
+/// Where an ordered run began before an edit, what it counted from, and
+/// whether every item in it carried the same number.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Start {
+    pub row: usize,
+    pub width: usize,
+    pub number: u64,
+    pub uniform: bool,
+}
+
+/// Bytes of the `> ` bars a line opens with, and how many there are.
+fn quote(line: &str) -> (usize, usize) {
+    let b = line.as_bytes();
+    let (mut i, mut depth) = (0, 0);
+    loop {
+        let mut j = i;
+        while j < b.len() && b[j] == b' ' && j - i < 3 {
+            j += 1;
+        }
+        if j >= b.len() || b[j] != b'>' {
+            return (i, depth);
+        }
+        j += 1;
+        if j < b.len() && b[j] == b' ' {
+            j += 1;
+        }
+        i = j;
+        depth += 1;
+    }
+}
+
+/// One line on its own. A fence is not known here: [`rows`] is what keeps
+/// the lines of a code block from reading as items.
+pub fn row(line: &str) -> Row {
+    let (quote, depth) = quote(line);
+    let after = &line[quote..];
+    let rest = after.trim_start_matches([' ', '\t']);
+    let indent = after.len() - rest.len();
+    let width = after[..indent]
+        .chars()
+        .fold(0, |w, c| if c == '\t' { w + 4 - w % 4 } else { w + 1 });
+    let kind = if rest.trim().is_empty() {
+        Kind::Blank
+    } else if ["- ", "* ", "+ "].iter().any(|m| rest.starts_with(m)) {
+        Kind::Item {
+            number: None,
+            marker: 2,
+        }
+    } else {
+        let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+        let mut after = rest[digits..].chars();
+        match (after.next(), after.next()) {
+            (Some(punct @ ('.' | ')')), Some(' ')) if (1..=9).contains(&digits) => Kind::Item {
+                number: rest[..digits].parse().ok().map(|value| Number {
+                    value,
+                    digits,
+                    punct,
+                }),
+                marker: digits + 2,
+            },
+            _ => Kind::Text,
+        }
+    };
+    Row {
+        quote,
+        depth,
+        indent,
+        width,
+        kind,
+    }
+}
+
+/// Every line of the buffer. Lines inside a fenced code block are text
+/// whatever they look like.
+pub fn rows(lines: &[String]) -> Vec<Row> {
+    let mut fence: Option<(char, usize, usize)> = None;
+    lines
+        .iter()
+        .map(|line| {
+            let mut r = row(line);
+            let rest = &line[r.quote + r.indent..];
+            let run = |c: char| rest.len() - rest.trim_start_matches(c).len();
+            match fence {
+                Some((c, len, width)) => {
+                    if run(c) >= len && rest.trim_start_matches(c).trim().is_empty() {
+                        fence = None;
+                    }
+                    r.kind = Kind::Text;
+                    r.width = r.width.max(width);
+                }
+                None => {
+                    if let Some(c) = ['`', '~'].into_iter().find(|c| run(*c) >= 3) {
+                        fence = Some((c, run(c), r.width));
+                        r.kind = Kind::Text;
+                    }
+                }
+            }
+            r
+        })
+        .collect()
+}
+
+/// The lists in `rows`. A list runs from an item through the items and the
+/// indented lines after it; a blank line ends it unless what follows the
+/// blank is indented, and so still belongs to an item above.
+pub fn blocks_of(rows: &[Row]) -> Vec<Block> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < rows.len() {
+        if !rows[i].is_item() {
+            i += 1;
+            continue;
+        }
+        let depth = rows[i].depth;
+        let mut to = i;
+        let mut j = i + 1;
+        while j < rows.len() && rows[j].depth == depth {
+            match rows[j].kind {
+                Kind::Item { .. } => to = j,
+                Kind::Text if rows[j].width > 0 => to = j,
+                Kind::Blank => {
+                    let next = (j..rows.len()).find(|k| rows[*k].kind != Kind::Blank);
+                    match next {
+                        Some(k) if rows[k].depth == depth && rows[k].width > 0 => {
+                            to = k;
+                            j = k;
+                        }
+                        _ => break,
+                    }
+                }
+                Kind::Text => break,
+            }
+            j += 1;
+        }
+        out.push(Block {
+            from: i,
+            to,
+            runs: runs(rows, i, to),
+        });
+        i = to + 1;
+    }
+    out
+}
+
+/// The ordered runs of the list on lines `from..=to`. Siblings share an
+/// indent with no shallower item between them; a bullet among them, or the
+/// other punctuation, starts the count again as it does in markdown.
+fn runs(rows: &[Row], from: usize, to: usize) -> Vec<Run> {
+    let mut out: Vec<Run> = Vec::new();
+    // one entry a level: its indent, and the run still open on it
+    let mut stack: Vec<(usize, Option<(usize, char)>)> = Vec::new();
+    for (i, r) in rows.iter().enumerate().take(to + 1).skip(from) {
+        let Kind::Item { number, .. } = r.kind else {
+            continue;
+        };
+        while stack.last().is_some_and(|l| l.0 > r.width) {
+            stack.pop();
+        }
+        if stack.last().is_none_or(|l| l.0 < r.width) {
+            stack.push((r.width, None));
+        }
+        let level = stack.last_mut().expect("just pushed");
+        match (number, level.1) {
+            (Some(n), Some((run, punct))) if punct == n.punct => out[run].rows.push(i),
+            (Some(n), _) => {
+                level.1 = Some((out.len(), n.punct));
+                out.push(Run {
+                    rows: vec![i],
+                    width: r.width,
+                });
+            }
+            (None, _) => level.1 = None,
+        }
+    }
+    out
+}
+
+/// Where every ordered run starts, taken before an edit so the renumbering
+/// after it knows what a list counted from and whether it counted at all.
+pub fn starts(lines: &[String]) -> Vec<Start> {
+    let rows = rows(lines);
+    let mut out = Vec::new();
+    for block in blocks_of(&rows) {
+        for run in block.runs {
+            let numbers: Vec<u64> = run
+                .rows
+                .iter()
+                .filter_map(|r| rows[*r].number())
+                .map(|n| n.value)
+                .collect();
+            out.push(Start {
+                row: run.rows[0],
+                width: run.width,
+                number: numbers[0],
+                uniform: same(&numbers),
+            });
+        }
+    }
+    out
+}
+
+/// Two or more numbers, all alike: a list numbered `1.` throughout.
+fn same(numbers: &[u64]) -> bool {
+    numbers.len() >= 2 && numbers.iter().all(|n| *n == numbers[0])
+}
+
+/// The numbers an edit leaves wrong, as (line, the number it should carry).
+///
+/// Only the lists reaching into lines `touched.0..=touched.1` are looked at.
+/// A run counts on from what it counted from in `before`, or from its first
+/// item. `fresh` are the lines the edit brought in, `restart` the lines
+/// whose run begins again at one. A run whose items all carry one number is
+/// numbered that way on purpose: it is left alone, and a fresh item joining
+/// it takes that number.
+pub fn renumber(
+    lines: &[String],
+    before: &[Start],
+    touched: (usize, usize),
+    fresh: &[usize],
+    restart: &[usize],
+) -> Vec<(usize, u64)> {
+    let rows = rows(lines);
+    let mut out = Vec::new();
+    for block in blocks_of(&rows) {
+        if block.to < touched.0 || block.from > touched.1 {
+            continue;
+        }
+        for run in &block.runs {
+            let number = |r: &usize| rows[*r].number().map_or(0, |n| n.value);
+            let first = run.rows[0];
+            // lines below the edit have moved, so only a run that starts at
+            // or above it can be matched with the one that was there
+            let known = before
+                .iter()
+                .find(|s| first <= touched.1 && s.row == first && s.width == run.width);
+            let (new, old): (Vec<usize>, Vec<usize>) =
+                run.rows.iter().partition(|r| fresh.contains(r));
+            let old: Vec<u64> = old.iter().map(number).collect();
+            let all: Vec<u64> = run.rows.iter().map(number).collect();
+            if same(&old) {
+                out.extend(
+                    new.iter()
+                        .filter(|r| number(r) != old[0])
+                        .map(|r| (*r, old[0])),
+                );
+                continue;
+            }
+            if known.is_some_and(|k| k.uniform) || (old.is_empty() && same(&all)) {
+                continue;
+            }
+            let start = if restart.contains(&first) {
+                1
+            } else {
+                known.map_or(all[0], |k| k.number)
+            };
+            for (i, r) in run.rows.iter().enumerate() {
+                let want = start + i as u64;
+                if all[i] != want {
+                    out.push((*r, want));
+                }
+            }
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn buf(s: &str) -> Vec<String> {
+        s.lines().map(String::from).collect()
+    }
+
+    fn blocks(lines: &[String]) -> Vec<Block> {
+        blocks_of(&rows(lines))
+    }
+
+    #[test]
+    fn rows_know_their_quote_indent_and_marker() {
+        let r = row("  12) a");
+        assert_eq!((r.quote, r.indent, r.width), (0, 2, 2));
+        assert_eq!(
+            r.number(),
+            Some(Number {
+                value: 12,
+                digits: 2,
+                punct: ')'
+            })
+        );
+        let r = row(">   - a");
+        assert_eq!((r.quote, r.depth, r.indent), (2, 1, 2));
+        assert_eq!(
+            r.kind,
+            Kind::Item {
+                number: None,
+                marker: 2
+            }
+        );
+        assert_eq!(row("1.a").kind, Kind::Text);
+        assert_eq!(row("-a").kind, Kind::Text);
+        assert_eq!(row(">").kind, Kind::Blank);
+    }
+
+    #[test]
+    fn a_blank_line_ends_a_list_unless_what_follows_is_indented() {
+        let b = blocks(&buf("1. a\n2. b\n\n1. c\n\n   more\n2. d\ntext\n- e"));
+        let spans: Vec<(usize, usize)> = b.iter().map(|b| (b.from, b.to)).collect();
+        assert_eq!(spans, [(0, 1), (3, 6), (8, 8)]);
+        assert_eq!(
+            b[1].runs,
+            [Run {
+                rows: vec![3, 6],
+                width: 0
+            }]
+        );
+    }
+
+    #[test]
+    fn runs_are_siblings_and_a_bullet_or_other_punctuation_breaks_them() {
+        let b = blocks(&buf("1. a\n   1. x\n   2. y\n2. b\n- c\n3. d\n4) e"));
+        let runs: Vec<Vec<usize>> = b[0].runs.iter().map(|r| r.rows.clone()).collect();
+        assert_eq!(runs, [vec![0, 3], vec![1, 2], vec![5], vec![6]]);
+    }
+
+    #[test]
+    fn fenced_code_is_never_a_list() {
+        let b = blocks(&buf(
+            "```\n1. a\n3. b\n```\n1. c\n   ```\n   7. x\n   ```\n2. d",
+        ));
+        assert_eq!(b.len(), 1);
+        assert_eq!(
+            b[0].runs,
+            [Run {
+                rows: vec![4, 8],
+                width: 0
+            }]
+        );
+    }
+
+    #[test]
+    fn renumbering_counts_on_and_leaves_same_numbered_lists() {
+        let lines = buf("1. a\n2. b\n1. c\n2. d");
+        assert_eq!(
+            renumber(&lines, &[], (2, 3), &[2, 3], &[]),
+            [(2, 3), (3, 4)]
+        );
+        let lines = buf("1. a\n1. b\n2. c\n1. d");
+        assert_eq!(renumber(&lines, &[], (2, 2), &[2], &[]), [(2, 1)]);
+        let lines = buf("1. a\n1. b\n1. c");
+        assert_eq!(renumber(&lines, &[], (0, 2), &[0, 1, 2], &[]), []);
+    }
+}
