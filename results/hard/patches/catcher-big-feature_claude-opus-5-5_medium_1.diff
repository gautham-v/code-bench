@@ -0,0 +1,593 @@
+//! Numbered lists as the editor keeps them: which lines are items, which
+//! items are siblings, and what their numbers should read after an edit.
+//!
+//! Everything here is a pure function over the buffer's lines. The editor
+//! hands over the lines as they were before an edit and as they are after,
+//! and gets back the markers to rewrite — only in the list the edit touched,
+//! and never in a list that numbers every item the same on purpose.
+
+use std::collections::{HashMap, HashSet};
+
+/// A list item's marker, located in its line. Offsets are bytes, and chars
+/// too: everything in front of a marker is ASCII.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Item {
+    /// How many `>` the line opens with; a list in a quote is its own list.
+    pub quote: usize,
+    /// Where the item's own indent starts, past any quote prefix.
+    pub indent_at: usize,
+    /// Where the marker starts, which is where the indent ends.
+    pub marker_at: usize,
+    /// The indent in columns, a tab counting four.
+    pub width: usize,
+    /// The number and the `.` or `)` after it; `None` for a bullet.
+    pub number: Option<(u64, char)>,
+    /// How many digits the number is written with.
+    pub digits: usize,
+}
+
+/// The quote depth of `line`, and the byte its own indent starts at.
+fn quote_prefix(line: &str) -> (usize, usize) {
+    let bytes = line.as_bytes();
+    let (mut depth, mut at) = (0, 0);
+    loop {
+        let mut j = at;
+        while matches!(bytes.get(j), Some(b' ' | b'\t')) {
+            j += 1;
+        }
+        if bytes.get(j) != Some(&b'>') {
+            return (depth, at);
+        }
+        depth += 1;
+        at = j + 1;
+        if bytes.get(at) == Some(&b' ') {
+            at += 1;
+        }
+    }
+}
+
+fn indent_width(indent: &str) -> usize {
+    indent.chars().map(|c| if c == '\t' { 4 } else { 1 }).sum()
+}
+
+/// The quote depth, indent start, indent end and indent width of any line.
+fn shape(line: &str) -> (usize, usize, usize, usize) {
+    let (quote, indent_at) = quote_prefix(line);
+    let rest = &line[indent_at..];
+    let indent = rest.len() - rest.trim_start_matches([' ', '\t']).len();
+    let end = indent_at + indent;
+    (quote, indent_at, end, indent_width(&line[indent_at..end]))
+}
+
+/// `line` as a list item: `- `, `* `, `+ `, `1. ` or `1) `, at any indent
+/// and inside any depth of quote.
+pub fn item(line: &str) -> Option<Item> {
+    let (quote, indent_at, marker_at, width) = shape(line);
+    let rest = &line[marker_at..];
+    let bullet = ["- ", "* ", "+ "].iter().any(|m| rest.starts_with(m));
+    let (number, digits) = if bullet {
+        (None, 0)
+    } else {
+        let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+        let mut after = rest[digits..].chars();
+        let punct = after.next().filter(|c| matches!(c, '.' | ')'))?;
+        if digits == 0 || after.next() != Some(' ') {
+            return None;
+        }
+        (Some((rest[..digits].parse().ok()?, punct)), digits)
+    };
+    Some(Item {
+        quote,
+        indent_at,
+        marker_at,
+        width,
+        number,
+        digits,
+    })
+}
+
+/// What a line is to the list around it.
+#[derive(Clone, Debug, PartialEq)]
+enum Row {
+    Item(Item),
+    /// An indented line that is not an item: more of the item above it.
+    Text {
+        quote: usize,
+        width: usize,
+    },
+    /// A blank line, unindented text, or anything inside a code fence or the
+    /// front matter. A list stops here.
+    End,
+}
+
+impl Row {
+    fn quote(&self) -> Option<usize> {
+        match self {
+            Row::Item(it) => Some(it.quote),
+            Row::Text { quote, .. } => Some(*quote),
+            Row::End => None,
+        }
+    }
+
+    fn width(&self) -> usize {
+        match self {
+            Row::Item(it) => it.width,
+            Row::Text { width, .. } => *width,
+            Row::End => 0,
+        }
+    }
+}
+
+/// Every line classified. The scan runs from the top because a fence does:
+/// a `1. step` inside a code sample is code, not an item.
+fn rows(lines: &[String]) -> Vec<Row> {
+    let mut out = Vec::with_capacity(lines.len());
+    let front = lines.first().is_some_and(|l| l.trim_end() == "---")
+        && lines.iter().skip(1).any(|l| l.trim_end() == "---");
+    let mut in_front = front;
+    let mut fence: Option<char> = None;
+    for (i, line) in lines.iter().enumerate() {
+        if in_front {
+            in_front = i == 0 || line.trim_end() != "---";
+            out.push(Row::End);
+            continue;
+        }
+        let (quote, _, at, width) = shape(line);
+        let rest = &line[at..];
+        let mark = ['`', '~']
+            .into_iter()
+            .find(|c| rest.starts_with(&c.to_string().repeat(3)));
+        match (fence, mark) {
+            (None, Some(c)) => fence = Some(c),
+            (Some(open), Some(c)) if open == c => fence = None,
+            (None, None) => {
+                out.push(match item(line) {
+                    Some(it) => Row::Item(it),
+                    None if width > 0 && !rest.is_empty() => Row::Text { quote, width },
+                    None => Row::End,
+                });
+                continue;
+            }
+            _ => {}
+        }
+        out.push(Row::End);
+    }
+    out
+}
+
+/// The list around `row` as an inclusive range of lines: the run of items and
+/// their indented text at one quote depth. `None` when `row` is in no list.
+fn block_of(rows: &[Row], row: usize) -> Option<(usize, usize)> {
+    let quote = rows.get(row)?.quote()?;
+    let (mut start, mut end) = (row, row);
+    while start > 0 && rows[start - 1].quote() == Some(quote) {
+        start -= 1;
+    }
+    while end + 1 < rows.len() && rows[end + 1].quote() == Some(quote) {
+        end += 1;
+    }
+    Some((start, end))
+}
+
+/// The numbered items of one list that are siblings: the same indent under
+/// the same parent, one after another, with the same `.` or `)`.
+#[derive(Debug)]
+struct Group {
+    rows: Vec<usize>,
+    numbers: Vec<u64>,
+    width: usize,
+    quote: usize,
+}
+
+impl Group {
+    /// Every item carries the same number, which nobody types by accident.
+    fn uniform(&self) -> bool {
+        self.numbers.len() > 1 && self.numbers.iter().all(|n| *n == self.numbers[0])
+    }
+}
+
+/// The sibling groups of the list in `start..=end`, in the order they open.
+fn groups_in(rows: &[Row], start: usize, end: usize, out: &mut Vec<Group>) {
+    // one entry per open nesting level: its indent, and the group its
+    // numbered items are currently joining, with that group's punctuation
+    let mut open: Vec<(usize, Option<(usize, char)>)> = Vec::new();
+    for (row, line) in rows.iter().enumerate().take(end + 1).skip(start) {
+        let Row::Item(it) = line else {
+            continue;
+        };
+        while open.last().is_some_and(|l| l.0 > it.width) {
+            open.pop();
+        }
+        if open.last().is_none_or(|l| l.0 < it.width) {
+            open.push((it.width, None));
+        }
+        let level = open.last_mut().expect("a level was just pushed");
+        let Some((n, punct)) = it.number else {
+            // a bullet between two numbered runs makes two lists of them
+            level.1 = None;
+            continue;
+        };
+        let g = match level.1 {
+            Some((g, p)) if p == punct => g,
+            _ => {
+                out.push(Group {
+                    rows: Vec::new(),
+                    numbers: Vec::new(),
+                    width: it.width,
+                    quote: it.quote,
+                });
+                out.len() - 1
+            }
+        };
+        level.1 = Some((g, punct));
+        out[g].rows.push(row);
+        out[g].numbers.push(n);
+    }
+}
+
+/// The groups of every list with a line in `from..=to`.
+fn groups_near(rows: &[Row], from: usize, to: usize) -> Vec<Group> {
+    let mut out = Vec::new();
+    let mut row = from;
+    while row <= to && row < rows.len() {
+        match block_of(rows, row) {
+            Some((start, end)) => {
+                groups_in(rows, start, end, &mut out);
+                row = end + 1;
+            }
+            None => row += 1,
+        }
+    }
+    out
+}
+
+/// One marker to rewrite: the line, where its digits are, how many there
+/// were, and the number that goes there.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Renumber {
+    pub row: usize,
+    pub at: usize,
+    pub digits: usize,
+    pub number: u64,
+}
+
+/// The markers that are out of order in `after`, for an edit that turned
+/// `before` into it. Only the lists the edit reached are looked at, and of
+/// those only the sibling groups it changed: a group that has the items it
+/// had is left as it is, right or wrong.
+///
+/// A group goes on counting from where it counted before the edit, so a
+/// list that started at 5 still does, and one whose first item was deleted
+/// or moved gets its start back. A group that numbered every item the same
+/// keeps doing that, whatever was put into it.
+///
+/// `nested` names the rows Tab or Shift+Tab moved to another level: a group
+/// one of them opens starts from 1 rather than from the number it brought.
+pub fn renumber(before: &[String], after: &[String], nested: Option<&[usize]>) -> Vec<Renumber> {
+    let short = before.len().min(after.len());
+    let head = (0..short).take_while(|&i| before[i] == after[i]).count();
+    let tail = (0..short - head)
+        .take_while(|&i| before[before.len() - 1 - i] == after[after.len() - 1 - i])
+        .count();
+    // the edit is before[head..was_end] turned into after[head..now_end]
+    let (was_end, now_end) = (before.len() - tail, after.len() - tail);
+    let was_row = |row: usize| {
+        if row < head {
+            Some(row)
+        } else if row >= now_end {
+            Some(row - now_end + was_end)
+        } else {
+            None
+        }
+    };
+
+    let was_rows = rows(before);
+    let now_rows = rows(after);
+    let was = groups_near(&was_rows, head.saturating_sub(1), was_end);
+    let now = groups_near(&now_rows, head.saturating_sub(1), now_end);
+    let mut home: HashMap<usize, usize> = HashMap::new();
+    for (g, group) in was.iter().enumerate() {
+        for row in &group.rows {
+            home.insert(*row, g);
+        }
+    }
+
+    let mut claimed: HashSet<usize> = HashSet::new();
+    let mut out = Vec::new();
+    for group in &now {
+        let kept: Vec<usize> = group.rows.iter().filter_map(|r| was_row(*r)).collect();
+        let mut from = kept.first().and_then(|r| home.get(r)).copied();
+        if kept.len() == group.rows.len()
+            && from.is_some_and(|g| was[g].rows == kept)
+            && kept.iter().all(|r| home.get(r) == from.as_ref())
+        {
+            if let Some(g) = from {
+                claimed.insert(g);
+            }
+            continue;
+        }
+        // nothing of it was there before: it may still be an old group whose
+        // every line the edit rewrote, as when two items swap places
+        if from.is_none() && nested.is_none() {
+            from = was.iter().position(|w| {
+                w.width == group.width
+                    && w.quote == group.quote
+                    && w.rows.iter().any(|r| (head..was_end).contains(r))
+            });
+        }
+        let first = group.numbers[0];
+        let fresh = nested.is_some_and(|n| n.contains(&group.rows[0]));
+        let number: Box<dyn Fn(usize) -> u64> = match from {
+            Some(g) if was[g].uniform() => {
+                let n = was[g].numbers[0];
+                Box::new(move |_| n)
+            }
+            // the first group to come out of an old one carries its start on;
+            // what an edit split off below it is a list of its own
+            Some(g) if claimed.insert(g) => {
+                let start = was[g].numbers[0];
+                Box::new(move |i| start.saturating_add(i as u64))
+            }
+            _ if group.uniform() => continue,
+            Some(_) if nested.is_some() => Box::new(|i| 1 + i as u64),
+            None if fresh => Box::new(|i| 1 + i as u64),
+            _ => Box::new(move |i| first.saturating_add(i as u64)),
+        };
+        for (i, row) in group.rows.iter().enumerate() {
+            let Row::Item(it) = &now_rows[*row] else {
+                continue;
+            };
+            if group.numbers[i] != number(i) {
+                out.push(Renumber {
+                    row: *row,
+                    at: it.marker_at,
+                    digits: it.digits,
+                    number: number(i),
+                });
+            }
+        }
+    }
+    out
+}
+
+/// What Tab or Shift+Tab does to the list item on `from`: the rows that move
+/// (the item, the rest of the selection, and everything nested under them)
+/// and the indent they gain or lose.
+#[derive(Debug, PartialEq)]
+pub struct Nest {
+    pub from: usize,
+    pub to: usize,
+    /// The indent each row gains; empty when nesting out.
+    pub add: String,
+    /// The bytes of indent each row loses; zero when nesting in.
+    pub remove: usize,
+    /// The items that change level themselves, not the ones carried along.
+    pub items: Vec<usize>,
+}
+
+/// Where the indent of `line` starts, past any quote prefix, and how many
+/// bytes of it there are.
+pub fn indent_of(line: &str) -> (usize, usize) {
+    let (_, at, end, _) = shape(line);
+    (at, end - at)
+}
+
+/// Plan nesting the items on `from..=to` one level in, or `out` again.
+/// `None` when `from` is not a list item, so Tab can be a tab there;
+/// `Some(None)` when it is one with nowhere to go — the first item of its
+/// list has nothing to nest under, and a top-level item is already out.
+pub fn nest(
+    lines: &[String],
+    from: usize,
+    to: usize,
+    out: bool,
+    tab: usize,
+) -> Option<Option<Nest>> {
+    let rows = rows(lines);
+    let Row::Item(it) = rows.get(from)? else {
+        return None;
+    };
+    let (start, end) = block_of(&rows, from)?;
+    let indent = &lines[from][it.indent_at..it.marker_at];
+    let tabs = (start..=end).any(|r| {
+        let (at, len) = indent_of(&lines[r]);
+        lines[r][at..at + len].contains('\t')
+    });
+    let unit = if tabs {
+        "\t".to_string()
+    } else {
+        " ".repeat(tab.max(1))
+    };
+    let (add, remove) = if out {
+        if it.width == 0 {
+            return Some(None);
+        }
+        let parent = (start..from).rev().find_map(|r| match &rows[r] {
+            Row::Item(a) if a.width < it.width => Some(&lines[r][a.indent_at..a.marker_at]),
+            _ => None,
+        });
+        let remove = match parent {
+            Some(p) if indent.starts_with(p) => indent.len() - p.len(),
+            _ if indent.starts_with('\t') => 1,
+            _ => indent.len().min(unit.len()),
+        };
+        (String::new(), remove)
+    } else {
+        // the item to nest under: the nearest one above at this indent, with
+        // nothing shallower in between
+        let mut sibling = None;
+        for r in (start..from).rev() {
+            match &rows[r] {
+                Row::Item(a) if a.width == it.width => sibling = Some(r),
+                Row::Item(a) if a.width > it.width => continue,
+                Row::Item(_) => {}
+                _ => continue,
+            }
+            break;
+        }
+        let Some(sibling) = sibling else {
+            return Some(None);
+        };
+        // join the children the item above already has, at their indent
+        let child = (sibling + 1..from).find_map(|r| match &rows[r] {
+            Row::Item(a) if a.width > it.width => Some(&lines[r][a.indent_at..a.marker_at]),
+            _ => None,
+        });
+        let add = match child.and_then(|c| c.strip_prefix(indent)) {
+            Some(more) if !more.is_empty() => more.to_string(),
+            _ => unit,
+        };
+        (add, 0)
+    };
+    // everything deeper than the item, below the selection, goes with it
+    let mut last = to.clamp(from, end);
+    while last < end && rows[last + 1].width() > it.width {
+        last += 1;
+    }
+    let items = (from..=to.clamp(from, end))
+        .filter(|r| matches!(&rows[*r], Row::Item(a) if a.width <= it.width))
+        .collect();
+    Some(Some(Nest {
+        from,
+        to: last,
+        add,
+        remove,
+        items,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lines(s: &str) -> Vec<String> {
+        s.lines().map(String::from).collect()
+    }
+
+    /// `after` with the renumbering for `before` → `after` applied.
+    fn fixed(before: &str, after: &str) -> String {
+        let (before, mut after) = (lines(before), lines(after));
+        for r in renumber(&before, &after, None) {
+            after[r.row].replace_range(r.at..r.at + r.digits, &r.number.to_string());
+        }
+        after.join("\n")
+    }
+
+    #[test]
+    fn items_are_found_at_any_indent_and_in_quotes() {
+        assert_eq!(item("12. a").unwrap().number, Some((12, '.')));
+        assert_eq!(item("  3) a").unwrap().width, 2);
+        assert_eq!(item("\t- a").unwrap().width, 4);
+        assert_eq!(item("> 1. a").unwrap().quote, 1);
+        assert_eq!(item("> 1. a").unwrap().marker_at, 2);
+        assert_eq!(item("- a").unwrap().number, None);
+        assert_eq!(item("1.a"), None);
+        assert_eq!(item("2024 was long"), None);
+        assert_eq!(item("plain"), None);
+    }
+
+    #[test]
+    fn a_paste_under_a_list_counts_on_from_it() {
+        assert_eq!(
+            fixed("1. a\n2. b\n", "1. a\n2. b\n1. x\n2. y\n3. z"),
+            "1. a\n2. b\n3. x\n4. y\n5. z"
+        );
+        // and above it, the list keeps the start it had
+        assert_eq!(
+            fixed("1. a\n2. b", "6. x\n7. y\n1. a\n2. b"),
+            "1. x\n2. y\n3. a\n4. b"
+        );
+    }
+
+    #[test]
+    fn deleting_or_swapping_the_first_item_keeps_the_start() {
+        assert_eq!(fixed("1. a\n2. b\n3. c", "2. b\n3. c"), "1. b\n2. c");
+        assert_eq!(fixed("1. a\n2. b", "2. b\n1. a"), "1. b\n2. a");
+        assert_eq!(fixed("5. a\n6. b\n7. c", "5. a\n7. c"), "5. a\n6. c");
+    }
+
+    #[test]
+    fn only_the_edited_list_is_renumbered() {
+        // a list past a blank line or a paragraph is another list
+        let rest = "\n\n1. x\n3. y\n\ntext\n4. z";
+        assert_eq!(
+            fixed(
+                &format!("1. a\n2. b\n3. c{rest}"),
+                &format!("1. a\n3. c{rest}")
+            ),
+            format!("1. a\n2. c{rest}")
+        );
+        // and so is a nested one the edit left alone
+        assert_eq!(
+            fixed(
+                "1. a\n   7. n\n   9. m\n2. b\n3. c",
+                "1. a\n   7. n\n   9. m\n3. c"
+            ),
+            "1. a\n   7. n\n   9. m\n2. c"
+        );
+        // an edit beside a list is not an edit in it
+        assert_eq!(
+            fixed("1. a\n4. b\n\ntext\nmore", "1. a\n4. b\n\nmore"),
+            "1. a\n4. b\n\nmore"
+        );
+    }
+
+    #[test]
+    fn a_list_numbered_all_the_same_stays_that_way() {
+        assert_eq!(fixed("1. a\n1. b\n1. c", "1. a\n1. c"), "1. a\n1. c");
+        assert_eq!(fixed("1. a\n1. b", "1. a\n2. \n1. b"), "1. a\n1. \n1. b");
+        assert_eq!(
+            fixed("1. a\n1. b\n", "1. a\n1. b\n1. x\n2. y"),
+            "1. a\n1. b\n1. x\n1. y"
+        );
+        // one pasted whole is left as it was written
+        assert_eq!(fixed("text\n", "text\n1. a\n1. b"), "text\n1. a\n1. b");
+    }
+
+    #[test]
+    fn code_and_front_matter_are_not_lists() {
+        assert_eq!(
+            fixed("```\n1. a\n2. b\n```", "```\n2. b\n```"),
+            "```\n2. b\n```"
+        );
+        assert_eq!(
+            fixed("---\n1. a\n2. b\n---", "---\n2. b\n---"),
+            "---\n2. b\n---"
+        );
+    }
+
+    #[test]
+    fn nested_and_quoted_lists_count_on_their_own() {
+        assert_eq!(
+            fixed(
+                "1. a\n   1. x\n   2. y\n   3. z\n2. b",
+                "1. a\n   1. x\n   3. z\n2. b"
+            ),
+            "1. a\n   1. x\n   2. z\n2. b"
+        );
+        assert_eq!(
+            fixed("> 1. a\n> 2. b\n> 3. c", "> 1. a\n> 3. c"),
+            "> 1. a\n> 2. c"
+        );
+        // a bullet between two runs makes two lists of them
+        assert_eq!(
+            fixed("1. a\n2. b\n- c\n1. d", "1. a\n- c\n1. d"),
+            "1. a\n- c\n1. d"
+        );
+    }
+
+    #[test]
+    fn nesting_is_planned_from_the_item_above() {
+        let l = lines("1. a\n2. b\n  - x\n3. c");
+        assert_eq!(nest(&l, 0, 0, false, 2), Some(None));
+        assert_eq!(nest(&l, 0, 0, true, 2), Some(None));
+        let n = nest(&l, 1, 1, false, 4).unwrap().unwrap();
+        assert_eq!((n.from, n.to, n.add.as_str()), (1, 2, "    "));
+        // an item above that already has children sets the indent
+        let n = nest(&l, 3, 3, false, 4).unwrap().unwrap();
+        assert_eq!((n.from, n.to, n.add.as_str()), (3, 3, "  "));
+        let n = nest(&l, 2, 2, true, 4).unwrap().unwrap();
+        assert_eq!((n.remove, n.items.clone()), (2, vec![2]));
+        assert_eq!(nest(&lines("text"), 0, 0, false, 2), None);
+    }
+}
