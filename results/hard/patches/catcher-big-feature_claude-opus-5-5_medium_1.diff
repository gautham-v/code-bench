+    /// Run an edit that adds, removes or reorders lines, then put the numbers
+    /// of the list it landed in back in order. Part of the edit's own undo
+    /// step: `edit` records it, and the renumbering records nothing.
+    fn relist<R>(&mut self, edit: impl FnOnce(&mut Editor) -> R) -> R {
+        if self.relisting {
+            return edit(self);
+        }
+        let before = self.lines.clone();
+        self.relisting = true;
+        let out = edit(self);
+        self.relisting = false;
+        self.renumber(&before, None);
+        out
+    }
