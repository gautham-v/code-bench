+    /// Rewrite the markers [`crate::lists::renumber`] finds out of order
+    /// after an edit, keeping the cursor and the anchor on the text they
+    /// were on when a marker in front of them changes width.
+    fn renumber(&mut self, before: &[String], nested: Option<&[usize]>) {
+        for r in crate::lists::renumber(before, &self.lines, nested) {
+            let number = r.number.to_string();
+            self.lines[r.row].replace_range(r.at..r.at + r.digits, &number);
+            let end = r.at + r.digits;
+            let shift = |(row, col): Pos| {
+                if row != r.row || col <= r.at {
+                    (row, col)
+                } else if col >= end {
+                    (row, col - r.digits + number.len())
+                } else {
+                    (row, col.min(r.at + number.len()))
+                }
+            };
+            for pos in [Some(&mut self.cursor), self.anchor.as_mut()]
+                .into_iter()
+                .flatten()
+            {
+                *pos = shift(*pos);
+            }
+        }
+    }
