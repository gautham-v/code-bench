+    /// Run an edit and then put the numbers right in the numbered lists it
+    /// touched, so an item pasted, split off, deleted or moved leaves the
+    /// ones below it counting on. Part of the edit's own undo step. Unless
+    /// `always`, an edit that left the buffer with as many lines as it had
+    /// has not moved an item, and nothing is renumbered.
+    fn relist(&mut self, always: bool, edit: impl FnOnce(&mut Editor)) {
+        if self.relisting > 0 {
+            edit(self);
+            return;
+        }
+        let old = self.lines.clone();
+        self.relisting += 1;
+        edit(self);
+        self.relisting -= 1;
+        if !always && old.len() == self.lines.len() {
+            return;
+        }
+        for (row, end, grew) in crate::lists::renumber(&old, &mut self.lines) {
+            self.number_grew(row, end, grew);
+        }
+    }
