+            "1. a\n2. \n\n3. b"
+        );
+    }
+
+    #[test]
+    fn a_list_cut_in_two_keeps_the_numbers_of_its_lower_half() {
+        assert_eq!(
+            renumbered("1. ab\n2. c\n3. d", "1. a\nb\n2. c\n3. d"),
+            "1. a\nb\n2. c\n3. d"
+        );
+    }
+}
