+    fn list_rows(&self) -> Option<(usize, usize)> {
+        use crate::lists;
+        let (from, to) = self.selected_rows();
+        if !lists::is_item(&self.lines[from]) {
+            return None;
+        }
+        let me = lists::shape(&self.lines[from]);
