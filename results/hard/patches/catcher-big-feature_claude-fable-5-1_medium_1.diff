+    /// in which case it keeps its number.
+    fn number_moved_item(&mut self, row: usize, same: bool) {
+        use crate::lists;
+        let Some(mine) = lists::number(&self.lines[row]) else {
+            return;
+        };
+        let n = match lists::prev_sibling(&self.lines, row)
+            .and_then(|r| lists::number(&self.lines[r]))
+        {
+            Some(prev) if prev.punct == mine.punct => prev.n,
+            _ if same => return,
+            _ => 1,
+        };
+        if let Some((end, grew)) = lists::set_number(&mut self.lines, row, n) {
+            self.number_grew(row, end, grew);
+        }
+    }
