+//! Numbered lists as the editor sees them: which lines are the items of one
+//! list, what an edit did to it, and the numbers it should carry afterwards.
+//! Pure functions on the buffer's lines, so they can be tested without an
+//! editor.
+//!
+//! A list here is a run of sibling items: numbered lines at one indent, with
+//! the same `.` or `)`, and nothing between them but their own deeper lines.
+//! Blank lines only keep two items together when the numbers already run on
+//! (`1.`, blank, `2.`), which is what tells a loose list from two lists that
+//! happen to be a blank line apart.
+
+/// A line taken apart: how many `>` it sits behind, where its own
+/// indentation starts and ends, and how wide that indentation is.
+pub struct Shape {
+    pub quote: usize,
+    /// Bytes of the quote prefix, the `> ` markers and whatever precedes them.
+    pub prefix: usize,
+    /// Byte where the text starts, after the indentation.
+    pub text: usize,
+    /// The indentation in columns, a tab reaching the next multiple of four.
+    pub indent: usize,
+}
+
+pub fn shape(line: &str) -> Shape {
+    let bytes = line.as_bytes();
+    let ws = |mut i: usize| {
+        while matches!(bytes.get(i), Some(b' ') | Some(b'\t')) {
+            i += 1;
+        }
+        i
+    };
+    let (mut quote, mut prefix) = (0, 0);
+    loop {
+        let at = ws(prefix);
+        if bytes.get(at) != Some(&b'>') {
+            break;
+        }
+        quote += 1;
+        prefix = at + 1;
+        if bytes.get(prefix) == Some(&b' ') {
+            prefix += 1;
+        }
+    }
+    let text = ws(prefix);
+    let indent = line[prefix..text].chars().fold(0, |w, c| match c {
+        '\t' => w / 4 * 4 + 4,
+        _ => w + 1,
+    });
+    Shape {
+        quote,
+        prefix,
+        text,
+        indent,
+    }
+}
+
+fn is_blank(line: &str) -> bool {
+    shape(line).text == line.len()
+}
+
+/// The number of a numbered item: the bytes its digits take, their value and
+/// the `.` or `)` after them.
+pub struct Number {
+    pub start: usize,
+    pub end: usize,
+    pub n: u64,
+    pub punct: char,
+}
+
+pub fn number(line: &str) -> Option<Number> {
+    let start = shape(line).text;
+    let rest = &line[start..];
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 || digits > 9 {
+        return None;
+    }
+    let after = &rest[digits..];
+    let punct = after.chars().next().filter(|c| matches!(c, '.' | ')'))?;
+    after[1..].strip_prefix(' ')?;
+    Some(Number {
+        start,
+        end: start + digits,
+        n: rest[..digits].parse().ok()?,
+        punct,
+    })
+}
+
+/// Whether the line is a list item at all, bullet or numbered.
+pub fn is_item(line: &str) -> bool {
+    let rest = &line[shape(line).text..];
+    ["- ", "* ", "+ "].iter().any(|m| rest.starts_with(m)) || number(line).is_some()
+}
+
+/// What makes two numbered lines items of the same list.
+fn key(line: &str) -> Option<(usize, usize, char)> {
+    let s = shape(line);
+    number(line).map(|n| (s.quote, s.indent, n.punct))
+}
+
+fn num(lines: &[String], row: usize) -> u64 {
+    number(&lines[row]).map_or(0, |n| n.n)
+}
+
+/// Whether the numbers of `a` and the item after it, `b`, run on.
+fn runs_on(lines: &[String], a: usize, b: usize) -> bool {
+    num(lines, b) == num(lines, a) + 1
+}
+
+/// The rows of the list the numbered item at `row` is in, top to bottom.
+/// `joined` says whether two items with a blank line between them are still
+/// one list.
+fn group(lines: &[String], row: usize, joined: &dyn Fn(usize, usize) -> bool) -> Vec<usize> {
+    let Some((quote, indent, punct)) = key(&lines[row]) else {
+        return Vec::new();
+    };
+    // the next sibling walking one way from `from`, or `None` where the list
+    // ends: at a shallower line, or one at this indent that is not an item
+    let step = |from: usize, down: bool| -> Option<usize> {
+        let mut blank = false;
+        let mut r = from;
+        loop {
+            r = if down { r + 1 } else { r.checked_sub(1)? };
+            let line = lines.get(r)?;
+            let s = shape(line);
+            if s.quote != quote {
+                return None;
+            }
+            if s.text == line.len() {
+                blank = true;
+            } else if s.indent < indent {
+                return None;
+            } else if s.indent == indent {
+                if key(line) != Some((quote, indent, punct)) {
+                    return None;
+                }
+                let (a, b) = if down { (from, r) } else { (r, from) };
+                return (!blank || joined(a, b)).then_some(r);
+            }
+        }
+    };
+    let mut rows = vec![row];
+    while let Some(r) = step(rows[0], false) {
+        rows.insert(0, r);
+    }
+    while let Some(r) = step(rows[rows.len() - 1], true) {
+        rows.push(r);
+    }
+    rows
+}
+
+/// The list around `row` as it stands, with no edit to account for.
+pub fn list_at(lines: &[String], row: usize) -> Vec<usize> {
+    group(lines, row, &|a, b| runs_on(lines, a, b))
+}
+
+/// A list that numbers every item the same, `1.` all the way down, which is
+/// left to keep doing so.
+pub fn uniform(lines: &[String], rows: &[usize]) -> bool {
+    rows.len() > 1 && rows.iter().all(|&r| num(lines, r) == num(lines, rows[0]))
+}
+
+/// The last row of the item at `row`: its deeper lines go with it, the blank
+/// lines after them do not.
+pub fn subtree_end(lines: &[String], row: usize) -> usize {
+    let me = shape(&lines[row]);
+    let mut end = row;
+    for (r, line) in lines.iter().enumerate().skip(row + 1) {
+        let s = shape(line);
+        if s.quote != me.quote {
+            break;
+        }
+        if s.text == line.len() {
+            continue;
+        }
+        if s.indent <= me.indent {
+            break;
+        }
+        end = r;
+    }
+    end
+}
+
+/// The item above `row` at the same indent, the one a Tab nests it under.
+pub fn prev_sibling(lines: &[String], row: usize) -> Option<usize> {
+    let me = shape(&lines[row]);
+    for r in (0..row).rev() {
+        let s = shape(&lines[r]);
+        if s.quote != me.quote {
+            return None;
+        }
+        if s.text == lines[r].len() || s.indent > me.indent {
+            continue;
+        }
+        return (s.indent == me.indent && is_item(&lines[r])).then_some(r);
+    }
+    None
+}
+
+/// The item `row` is nested under.
+pub fn parent(lines: &[String], row: usize) -> Option<usize> {
+    let me = shape(&lines[row]);
+    for r in (0..row).rev() {
+        let s = shape(&lines[r]);
+        if s.quote != me.quote {
+            return None;
+        }
+        if s.text == lines[r].len() || s.indent >= me.indent {
+            continue;
+        }
+        return is_item(&lines[r]).then_some(r);
+    }
+    None
+}
+
+/// Write `n` as the number of the item at `row`. Returns the byte the old
+/// number ended at and how many bytes longer the new one is.
+pub fn set_number(lines: &mut [String], row: usize, n: u64) -> Option<(usize, isize)> {
+    let old = number(&lines[row])?;
+    if old.n == n {
+        return None;
+    }
+    let new = n.to_string();
+    let grew = new.len() as isize - (old.end - old.start) as isize;
+    lines[row].replace_range(old.start..old.end, &new);
+    Some((old.end, grew))
+}
+
+/// Put the numbers right in the lists an edit touched, `old` being the
+/// buffer before it and `lines` the buffer after. Only those lists change: a
+/// list counts on from the number it started at before the edit, a list
+/// that numbered every item the same is left alone, and so is one nowhere
+/// near the edit. Returns each number rewritten, as `(row, end, grew)`: the
+/// byte its digits used to end at and how many bytes it grew by.
+pub fn renumber(old: &[String], lines: &mut [String]) -> Vec<(usize, usize, isize)> {
+    // the edit: rows `s..=e` of the old buffer became `s..=e2` of the new
+    // one, either of which may be empty
+    let head = old
+        .iter()
+        .zip(lines.iter())
+        .take_while(|(a, b)| a == b)
+        .count();
+    let tail = old[head..]
+        .iter()
+        .rev()
+        .zip(lines[head..].iter().rev())
+        .take_while(|(a, b)| a == b)
+        .count();
+    let s = head as isize;
+    let e = (old.len() - tail) as isize - 1;
+    let e2 = (lines.len() - tail) as isize - 1;
+    let before = |r: usize| -> Option<usize> {
+        let r = r as isize;
+        if r < s {
+            Some(r as usize)
+        } else if r > e2 {
+            Some((r - e2 + e) as usize)
+        } else {
+            None
+        }
+    };
+
+    // a loose list keeps its blank lines through the edit: without this the
+    // item typed or pasted into one would cut it in two
+    let near = |r: isize| (r >= 0 && (r as usize) < old.len()).then_some(r as usize);
+    let loose = (s - 1..=e + 1).filter_map(near).any(|r| {
+        list_at(old, r)
+            .windows(2)
+            .any(|w| (w[0]..w[1]).any(|r| is_blank(&old[r])))
+    });
+
+    // the rows to look for lists on: the edit, and the first line with
+    // anything on it either side
+    let mut from = (s - 1).max(0) as usize;
+    while from > 0 && is_blank(&lines[from]) {
+        from -= 1;
+    }
+    let mut to = ((e2 + 1).max(0) as usize).min(lines.len().saturating_sub(1));
+    while to + 1 < lines.len() && is_blank(&lines[to]) {
+        to += 1;
+    }
+
+    let mut plans: Vec<(Vec<usize>, u64)> = Vec::new();
+    {
+        let lines: &[String] = lines;
+        let joined = |a: usize, b: usize| {
+            runs_on(lines, a, b) || (loose && a as isize <= e2 && b as isize >= s)
+        };
+        for row in from..=to.min(lines.len().saturating_sub(1)) {
+            let rows = group(lines, row, &joined);
+            if rows.is_empty() || plans.iter().any(|(seen, _)| seen[0] == rows[0]) {
+                continue;
+            }
+            // the list this one was before the edit: the one an untouched
+            // item of it came out of, or the one the edit began in
+            let was = rows
+                .iter()
+                .find_map(|&r| before(r))
+                .or_else(|| {
+                    let at = near(s)?;
+                    (key(&old[at]) == key(&lines[rows[0]])).then_some(at)
+                })
+                .map(|r| list_at(old, r));
+            let start = match was {
+                Some(was) if uniform(old, &was) => continue,
+                Some(was) => {
+                    // where that list's first item is now. An item of it
+                    // still standing above this one means the edit cut the
+                    // list in two, and the lower half keeps its own number
+                    let top = was[0] as isize;
+                    let top = if top < s {
+                        top
+                    } else if top <= e {
+                        s
+                    } else {
+                        top - e + e2
+                    };
+                    let cut = (top.max(0) as usize..rows[0])
+                        .any(|r| key(&lines[r]) == key(&lines[rows[0]]));
+                    if cut {
+                        num(lines, rows[0])
+                    } else {
+                        num(old, was[0])
+                    }
+                }
+                None if uniform(lines, &rows) => continue,
+                None => num(lines, rows[0]),
+            };
+            plans.push((rows, start));
+        }
+    }
+
+    let mut changed = Vec::new();
+    for (rows, start) in plans {
+        for (i, row) in rows.into_iter().enumerate() {
+            if let Some((end, grew)) = set_number(lines, row, start + i as u64) {
+                changed.push((row, end, grew));
+            }
+        }
+    }
+    changed
+}
