+// ----------------------------------------------------------- stop words --
+
+/// Is this an everyday word, whatever its casing in a doc? Such a word is
+/// never taken for a name: "IMPORTANT", "License" and "Code" stay prose.
+pub(super) fn is_common(word: &str) -> bool {
+    use std::sync::OnceLock;
+    static WORDS: OnceLock<HashSet<&'static str>> = OnceLock::new();
+    let words = WORDS.get_or_init(|| COMMON_WORDS.split_whitespace().collect());
+    let lower = word.to_lowercase();
+    if words.contains(lower.as_str()) {
+        return true;
+    }
+    // Plurals and -ing/-ed forms of the same words.
+    ["s", "es", "ing", "ed", "d"]
+        .iter()
+        .filter_map(|suffix| lower.strip_suffix(suffix))
+        .any(|stem| stem.len() > 2 && words.contains(stem))
+}
