+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,462 @@
+//! Finding the agent session behind the front terminal.
+//!
+//! The process table is read with libproc; nothing is spawned. The choice
+//! between several sessions ([`choose`]) and the test for "is this process an
+//! agent" ([`agent_for`]) are pure, so they are tested without a terminal.
+
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use super::{Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// Programs that run an agent as a script: the agent is their first argument.
+const INTERPRETERS: &[&str] = &["node", "bun", "deno", "sh", "bash", "zsh"];
+
+/// Where the agents' packages live on disk, for installs whose process name
+/// and script name say nothing (`node …/claude-code/cli.js`).
+const AGENT_PATH_MARKS: &[(&str, Agent)] = &[
+    ("/claude-code/", Agent::Claude),
+    ("/claude/versions/", Agent::Claude),
+    ("/@openai/codex/", Agent::Codex),
+];
+
+/// One agent process under the front terminal.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Candidate {
+    pub session: Session,
+    /// Generations below the terminal's process.
+    pub depth: usize,
+    /// When the tty last took input, then when it last showed output.
+    pub tty_used: Option<(SystemTime, SystemTime)>,
+}
+
+/// Which agent a process is, from its name and arguments.
+///
+/// The name alone decides for a native binary (`claude`, `codex`). An npm
+/// install runs as `node /…/bin/claude`, and the native Claude Code binary
+/// is a file named after its version, started with `argv[0] = "claude"`; both
+/// are recognised from the arguments.
+pub(super) fn agent_for(name: &str, exe: &str, argv: &[String]) -> Option<Agent> {
+    let named = |s: &str| {
+        AGENT_PROCESS_NAMES
+            .iter()
+            .find(|(n, _)| *n == s)
+            .map(|(_, a)| *a)
+    };
+    let marked = |path: &str| {
+        AGENT_PATH_MARKS
+            .iter()
+            .find(|(mark, _)| path.contains(mark))
+            .map(|(_, a)| *a)
+    };
+    let arg0 = argv.first().map(|a| base_name(a)).unwrap_or("");
+    if let Some(agent) = named(name).or_else(|| named(arg0)) {
+        return Some(agent);
+    }
+    if INTERPRETERS.contains(&name) || INTERPRETERS.contains(&arg0) {
+        // The script is the first argument that is not a flag.
+        let script = argv.iter().skip(1).find(|a| !a.starts_with('-'))?;
+        let stem = base_name(script);
+        let stem = stem
+            .strip_suffix(".js")
+            .or_else(|| stem.strip_suffix(".mjs"))
+            .or_else(|| stem.strip_suffix(".cjs"))
+            .unwrap_or(stem);
+        return named(stem).or_else(|| marked(script));
+    }
+    marked(exe)
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// The session a dictation is meant for: the one whose terminal was typed
+/// into (or focused) last, then the one that printed last; within one tty,
+/// the outermost agent.
+pub(super) fn choose(mut candidates: Vec<Candidate>) -> Option<Session> {
+    candidates.sort_by(|a, b| {
+        b.tty_used
+            .cmp(&a.tty_used)
+            .then(a.depth.cmp(&b.depth))
+            .then(a.session.pid.cmp(&b.session.pid))
+    });
+    candidates.into_iter().next().map(|c| c.session)
+}
+
+/// When the tty device was last read and last written.
+fn tty_used(tty: &Path) -> Option<(SystemTime, SystemTime)> {
+    let meta = std::fs::metadata(tty).ok()?;
+    Some((meta.accessed().ok()?, meta.modified().ok()?))
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    use std::collections::HashMap;
+
+    if !super::is_terminal(&front.bundle_id) || front.pid <= 0 {
+        return None;
+    }
+    let procs: Vec<sys::Proc> = sys::pids().into_iter().filter_map(sys::info).collect();
+    let mut children: HashMap<i32, Vec<&sys::Proc>> = HashMap::new();
+    for p in &procs {
+        children.entry(p.ppid).or_default().push(p);
+    }
+
+    // The terminal's own process, plus iTerm2's session servers: they hold
+    // its shells but are re-parented to launchd.
+    let mut queue: Vec<(i32, usize)> = vec![(front.pid, 0)];
+    if front.bundle_id == "com.googlecode.iterm2" {
+        queue.extend(
+            procs
+                .iter()
+                .filter(|p| p.name.starts_with("iTermServer"))
+                .map(|p| (p.pid, 0)),
+        );
+    }
+
+    let mut candidates = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    while let Some((pid, depth)) = queue.pop() {
+        if !seen.insert(pid) {
+            continue;
+        }
+        for p in children.get(&pid).map(Vec::as_slice).unwrap_or(&[]) {
+            if p.pid == pid {
+                continue;
+            }
+            queue.push((p.pid, depth + 1));
+            let Some(agent) = sys::agent(p) else { continue };
+            let Some(cwd) = sys::cwd(p.pid) else { continue };
+            let tty = p.tdev.and_then(sys::tty_path);
+            candidates.push(Candidate {
+                tty_used: tty.as_deref().and_then(tty_used),
+                depth: depth + 1,
+                session: Session {
+                    agent,
+                    pid: p.pid,
+                    cwd,
+                    tty,
+                },
+            });
+        }
+    }
+    choose(candidates)
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    let _ = (front, tty_used as fn(&Path) -> _);
+    None
+}
+
+/// The libproc and sysctl calls.
+#[cfg(target_os = "macos")]
+mod sys {
+    use std::ffi::{CStr, OsStr};
+    use std::mem;
+    use std::os::unix::ffi::OsStrExt;
+
+    use super::{agent_for, Agent, PathBuf};
+
+    pub struct Proc {
+        pub pid: i32,
+        pub ppid: i32,
+        pub name: String,
+        /// The controlling terminal's device, when there is one.
+        pub tdev: Option<u32>,
+    }
+
+    pub fn pids() -> Vec<i32> {
+        // SAFETY: a null buffer asks for the count only.
+        let count = unsafe { libc::proc_listallpids(std::ptr::null_mut(), 0) };
+        if count <= 0 {
+            return Vec::new();
+        }
+        // Room for processes started between the two calls.
+        let mut pids = vec![0 as libc::pid_t; count as usize + 64];
+        let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as libc::c_int;
+        // SAFETY: the buffer is `bytes` long and written as pid_t values.
+        let count = unsafe { libc::proc_listallpids(pids.as_mut_ptr().cast(), bytes) };
+        pids.truncate(count.max(0) as usize);
+        pids.retain(|pid| *pid > 0);
+        pids
+    }
+
+    pub fn info(pid: i32) -> Option<Proc> {
+        // SAFETY: proc_bsdinfo is plain data; zero is a valid value for it.
+        let mut info: libc::proc_bsdinfo = unsafe { mem::zeroed() };
+        let size = mem::size_of::<libc::proc_bsdinfo>() as libc::c_int;
+        // SAFETY: the buffer is a proc_bsdinfo of exactly `size` bytes.
+        let written = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                (&mut info as *mut libc::proc_bsdinfo).cast(),
+                size,
+            )
+        };
+        if written != size {
+            return None;
+        }
+        // pbi_name is the longer of the two; it is empty for some processes.
+        let name = match c_chars(&info.pbi_name) {
+            name if name.is_empty() => c_chars(&info.pbi_comm),
+            name => name,
+        };
+        Some(Proc {
+            pid,
+            ppid: info.pbi_ppid as i32,
+            name,
+            tdev: Some(info.e_tdev).filter(|dev| *dev != 0 && *dev != u32::MAX),
+        })
+    }
+
+    pub fn agent(p: &Proc) -> Option<Agent> {
+        if let Some(agent) = agent_for(&p.name, "", &[]) {
+            return Some(agent);
+        }
+        let (exe, argv) = args(p.pid)?;
+        agent_for(&p.name, &exe, &argv)
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        // SAFETY: proc_vnodepathinfo is plain data; zero is a valid value.
+        let mut info: libc::proc_vnodepathinfo = unsafe { mem::zeroed() };
+        let size = mem::size_of::<libc::proc_vnodepathinfo>() as libc::c_int;
+        // SAFETY: the buffer is a proc_vnodepathinfo of exactly `size` bytes.
+        let written = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                (&mut info as *mut libc::proc_vnodepathinfo).cast(),
+                size,
+            )
+        };
+        if written != size {
+            return None;
+        }
+        let path: Vec<u8> = info
+            .pvi_cdir
+            .vip_path
+            .iter()
+            .flatten()
+            .map(|c| *c as u8)
+            .take_while(|b| *b != 0)
+            .collect();
+        if path.is_empty() {
+            return None;
+        }
+        Some(PathBuf::from(OsStr::from_bytes(&path)))
+    }
+
+    pub fn tty_path(dev: u32) -> Option<PathBuf> {
+        // SAFETY: devname returns null or a NUL-terminated name in static
+        // storage, copied before anything else can call it.
+        let name = unsafe {
+            let name = libc::devname(dev as libc::dev_t, libc::S_IFCHR);
+            if name.is_null() {
+                return None;
+            }
+            CStr::from_ptr(name).to_string_lossy().into_owned()
+        };
+        // devname answers "??" for a device it does not know.
+        if name.is_empty() || name.contains('?') {
+            return None;
+        }
+        Some(PathBuf::from("/dev").join(name))
+    }
+
+    /// The executable path and arguments of a process of the same user
+    /// (KERN_PROCARGS2: argc, the path, padding, then the arguments).
+    fn args(pid: i32) -> Option<(String, Vec<String>)> {
+        let mut argmax: libc::c_int = 0;
+        let mut size: libc::size_t = mem::size_of::<libc::c_int>();
+        let mut mib = [libc::CTL_KERN, libc::KERN_ARGMAX];
+        // SAFETY: `argmax` is a c_int and `size` is its size.
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as libc::c_uint,
+                (&mut argmax as *mut libc::c_int).cast(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || argmax <= 0 {
+            return None;
+        }
+        let mut buf = vec![0u8; argmax as usize];
+        let mut size = buf.len() as libc::size_t;
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        // SAFETY: the kernel writes at most `size` bytes into `buf`.
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as libc::c_uint,
+                buf.as_mut_ptr().cast(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 || size < mem::size_of::<libc::c_int>() {
+            return None;
+        }
+        buf.truncate(size);
+        let (argc, rest) = buf.split_at(mem::size_of::<libc::c_int>());
+        let argc = libc::c_int::from_ne_bytes(argc.try_into().ok()?);
+        let exe_end = rest.iter().position(|b| *b == 0)?;
+        let exe = String::from_utf8_lossy(&rest[..exe_end]).into_owned();
+        let argv = rest[exe_end..]
+            .split(|b| *b == 0)
+            .skip_while(|s| s.is_empty())
+            .take(argc.max(0) as usize)
+            .map(|s| String::from_utf8_lossy(s).into_owned())
+            .collect();
+        Some((exe, argv))
+    }
+
+    fn c_chars(chars: &[libc::c_char]) -> String {
+        let bytes: Vec<u8> = chars
+            .iter()
+            .map(|c| *c as u8)
+            .take_while(|b| *b != 0)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(list: &[&str]) -> Vec<String> {
+        list.iter().map(|s| s.to_string()).collect()
+    }
+
+    #[test]
+    fn agents_by_name_and_arguments() {
+        assert_eq!(agent_for("claude", "", &[]), Some(Agent::Claude));
+        assert_eq!(agent_for("codex", "", &[]), Some(Agent::Codex));
+        // The native build: a binary named after its version.
+        assert_eq!(
+            agent_for(
+                "2.0.14",
+                "/Users/you/.local/share/claude/versions/2.0.14",
+                &args(&["claude", "--continue"])
+            ),
+            Some(Agent::Claude)
+        );
+        // npm installs run under node.
+        assert_eq!(
+            agent_for(
+                "node",
+                "/opt/homebrew/bin/node",
+                &args(&["node", "/opt/homebrew/bin/claude"])
+            ),
+            Some(Agent::Claude)
+        );
+        assert_eq!(
+            agent_for(
+                "node",
+                "/usr/local/bin/node",
+                &args(&[
+                    "node",
+                    "--no-warnings",
+                    "/usr/local/lib/node_modules/@openai/codex/bin/codex.js"
+                ])
+            ),
+            Some(Agent::Codex)
+        );
+    }
+
+    #[test]
+    fn other_processes_are_not_agents() {
+        assert_eq!(agent_for("zsh", "/bin/zsh", &args(&["-zsh"])), None);
+        assert_eq!(
+            agent_for("vim", "/usr/bin/vim", &args(&["vim", "claude"])),
+            None
+        );
+        assert_eq!(
+            agent_for("node", "/usr/bin/node", &args(&["node", "server.js"])),
+            None
+        );
+        assert_eq!(agent_for("claude-helper", "", &[]), None);
+    }
+
+    fn candidate(pid: i32, depth: usize, used: Option<(u64, u64)>) -> Candidate {
+        let at = |secs| SystemTime::UNIX_EPOCH + std::time::Duration::from_secs(secs);
+        Candidate {
+            session: Session {
+                agent: Agent::Claude,
+                pid,
+                cwd: PathBuf::from("/tmp"),
+                tty: None,
+            },
+            depth,
+            tty_used: used.map(|(read, written)| (at(read), at(written))),
+        }
+    }
+
+    #[test]
+    fn the_most_recently_used_tty_wins() {
+        assert_eq!(choose(Vec::new()), None);
+        // Input beats output: a background tab that is printing is not the
+        // one being talked to.
+        let picked = choose(vec![
+            candidate(10, 2, Some((100, 900))),
+            candidate(20, 2, Some((500, 500))),
+            candidate(30, 2, None),
+        ]);
+        assert_eq!(picked.map(|s| s.pid), Some(20));
+        // Same tty: the outer agent.
+        let picked = choose(vec![
+            candidate(11, 4, Some((7, 7))),
+            candidate(12, 2, Some((7, 7))),
+        ]);
+        assert_eq!(picked.map(|s| s.pid), Some(12));
+    }
+
+    #[test]
+    fn only_terminals_are_searched() {
+        let front = FrontApp {
+            bundle_id: "com.apple.Safari".into(),
+            name: "Safari".into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(detect(&front), None);
+    }
+
+    /// A process named `claude` under this one is found, with its directory.
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn finds_an_agent_under_the_front_process() {
+        let dir = tempfile::tempdir().unwrap();
+        let bin = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &bin).unwrap();
+        let work = dir.path().join("project");
+        std::fs::create_dir(&work).unwrap();
+        let mut child = std::process::Command::new(&bin)
+            .arg("30")
+            .current_dir(&work)
+            .spawn()
+            .unwrap();
+        let front = FrontApp {
+            bundle_id: "com.mitchellh.ghostty".into(),
+            name: "Ghostty".into(),
+            pid: std::process::id() as i32,
+        };
+        let found = detect(&front);
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let session = found.expect("the child is an agent");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(session.pid, child.id() as i32);
+        assert_eq!(session.cwd, work.canonicalize().unwrap());
+        assert_eq!(session.project(), "project");
+    }
+}
