+            run("take a look at status item dot rs", &v),
+            "take a look at @crates/squawk-app/src/status_item.rs"
+        );
+        assert_eq!(
+            run("Status item dot RS is broken.", &v),
+            "@crates/squawk-app/src/status_item.rs is broken."
+        );
