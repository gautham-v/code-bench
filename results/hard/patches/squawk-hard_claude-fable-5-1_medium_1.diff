new file mode 100644
index 0000000..2ef6bb5
--- /dev/null
+++ b/crates/squawk-core/src/context/vocab.rs
@@ -0,0 +1,845 @@
+//! Reading a repo: its files, and the words it writes its own way.
+//!
+//! Files come from git when the directory is in a repo (tracked files plus
+//! new ones that are not ignored), otherwise from a bounded walk. Words come
+//! from three places: the crate/package manifests, the prose of README.md /
+//! CLAUDE.md / CONTEXT.md / AGENTS.md, and the file names themselves.
+
+use std::collections::{BTreeSet, HashSet};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::mpsc;
+use std::time::{Duration, Instant, SystemTime};
+
+use regex::Regex;
+
+use super::RepoVocab;
+use crate::text;
+
+/// The docs read for vocabulary, matched without regard to case.
+const DOC_NAMES: &[&str] = &["readme.md", "claude.md", "context.md", "agents.md"];
+/// No doc is read past this; the terms that matter are near the top.
+const DOC_MAX_BYTES: u64 = 256 * 1024;
+
+/// Listing untracked files walks the working tree; on a huge repo it gets
+/// this long before the tracked files alone are used.
+const GIT_UNTRACKED_BUDGET: Duration = Duration::from_millis(150);
+const GIT_TRACKED_BUDGET: Duration = Duration::from_secs(2);
+/// Tracked files deleted from the working tree are dropped (one stat each)
+/// in repos up to this size.
+const STAT_MAX_FILES: usize = 20_000;
+
+/// The walk outside git stops at whichever of these comes first.
+const WALK_MAX_FILES: usize = 20_000;
+const WALK_MAX_DEPTH: usize = 8;
+const WALK_BUDGET: Duration = Duration::from_millis(150);
+/// Directories a walk never enters (hidden ones are skipped too).
+const WALK_SKIP_DIRS: &[&str] = &[
+    "node_modules",
+    "target",
+    "build",
+    "dist",
+    "out",
+    "vendor",
+    "venv",
+    "__pycache__",
+    "Pods",
+    "DerivedData",
+];
+
+/// At most this many manifests are opened for package names.
+const MAX_MANIFESTS: usize = 64;
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let mut files = list_files(cwd);
+    let docs = doc_files(cwd);
+    // The docs can be mentioned even when git ignores them (a local CLAUDE.md).
+    for (name, _) in &docs {
+        if !files.contains(name) {
+            files.push(name.clone());
+        }
+    }
+    files.sort();
+    files.dedup();
+
+    let mut words: BTreeSet<String> = BTreeSet::new();
+    words.extend(package_names(cwd, &files));
+    let mut terms = DocTerms::default();
+    for (i, (_, path)) in docs.iter().chain(&parent_docs(cwd)).enumerate() {
+        if let Some(body) = read_capped(path, DOC_MAX_BYTES) {
+            terms.read(&body, i == 0 && is_readme(path));
+        }
+    }
+    words.extend(terms.finish());
+    words.extend(
+        files
+            .iter()
+            .filter_map(|f| file_stem(f))
+            .filter(|s| s.chars().any(char::is_alphabetic))
+            .map(str::to_string),
+    );
+
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words: words.into_iter().collect(),
+    }
+}
+
+/// `status_item` for `src/status_item.rs`: the name up to its first dot.
+/// Dotfiles have none.
+pub(super) fn file_stem(path: &str) -> Option<&str> {
+    let name = path.rsplit('/').next().unwrap_or(path);
+    let stem = name.split('.').next().unwrap_or(name);
+    (!stem.is_empty()).then_some(stem)
+}
+
+// ---------------------------------------------------------------- files --
+
+fn list_files(cwd: &Path) -> Vec<String> {
+    if git_index(cwd).is_some() {
+        if let Some(files) = git_files(cwd) {
+            return files;
+        }
+    }
+    walk_files(cwd)
+}
+
+/// The index file of the repo `cwd` is in: `<repo>/.git/index`, or the one a
+/// worktree's or submodule's `.git` file points at.
+pub(super) fn git_index(cwd: &Path) -> Option<PathBuf> {
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        let Ok(meta) = std::fs::metadata(&dot_git) else {
+            continue;
+        };
+        if meta.is_dir() {
+            return Some(dot_git.join("index"));
+        }
+        let pointer = std::fs::read_to_string(&dot_git).ok()?;
+        let git_dir = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+        return Some(dir.join(git_dir.trim()).join("index"));
+    }
+    None
+}
+
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let git = git_program()?;
+    let listed = git_ls_files(
+        &git,
+        cwd,
+        &["--cached", "--others", "--exclude-standard"],
+        GIT_UNTRACKED_BUDGET,
+    )
+    .or_else(|| git_ls_files(&git, cwd, &["--cached"], GIT_TRACKED_BUDGET))?;
+    let mut files: Vec<String> = listed
+        .split('\0')
+        .filter(|f| !f.is_empty())
+        .map(str::to_string)
+        .collect();
+    if files.len() <= STAT_MAX_FILES {
+        files.retain(|f| std::fs::symlink_metadata(cwd.join(f)).is_ok());
+    }
+    Some(files)
+}
+
+/// `git ls-files -z <args>` in `cwd`, or `None` if git fails or takes longer
+/// than `budget` (it is killed).
+fn git_ls_files(git: &Path, cwd: &Path, args: &[&str], budget: Duration) -> Option<String> {
+    let mut child = Command::new(git)
+        .arg("-C")
+        .arg(cwd)
+        .args(["ls-files", "-z"])
+        .args(args)
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .ok()?;
+    let mut stdout = child.stdout.take()?;
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut out = Vec::new();
+        let read = stdout.read_to_end(&mut out).map(|_| out);
+        let _ = tx.send(read);
+    });
+    match rx.recv_timeout(budget) {
+        Ok(Ok(out)) => {
+            let status = child.wait().ok()?;
+            status
+                .success()
+                .then(|| String::from_utf8_lossy(&out).into_owned())
+        }
+        _ => {
+            let _ = child.kill();
+            let _ = child.wait();
+            None
+        }
+    }
+}
+
+/// The git to run. `/usr/bin/git` on a Mac without developer tools is a
+/// shim that opens an install dialog; it is never run in that case.
+fn git_program() -> Option<PathBuf> {
+    let path = std::env::var_os("PATH").unwrap_or_default();
+    let found = std::env::split_paths(&path)
+        .chain(["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"].map(PathBuf::from))
+        .map(|dir| dir.join("git"))
+        .find(|git| git.is_file())?;
+    if cfg!(target_os = "macos")
+        && found == Path::new("/usr/bin/git")
+        && !Path::new("/Library/Developer/CommandLineTools/usr/bin/git").exists()
+        && !Path::new("/var/db/xcode_select_link").exists()
+    {
+        return None;
+    }
+    Some(found)
+}
+
+fn walk_files(root: &Path) -> Vec<String> {
+    let deadline = Instant::now() + WALK_BUDGET;
+    let mut files = Vec::new();
+    // Breadth first, so a cut-off walk keeps the files nearest the root.
+    let mut queue = std::collections::VecDeque::from([(root.to_path_buf(), String::new(), 0)]);
+    while let Some((dir, prefix, depth)) = queue.pop_front() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        let mut entries: Vec<_> = entries.filter_map(|e| e.ok()).collect();
+        entries.sort_by_key(|e| e.file_name());
+        for entry in entries {
+            if files.len() >= WALK_MAX_FILES || Instant::now() > deadline {
+                return files;
+            }
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if kind.is_dir() {
+                let skip = name.starts_with('.') || WALK_SKIP_DIRS.contains(&name.as_str());
+                if !skip && depth < WALK_MAX_DEPTH {
+                    queue.push_back((entry.path(), format!("{prefix}{name}/"), depth + 1));
+                }
+            } else if kind.is_file() && name != ".DS_Store" {
+                files.push(format!("{prefix}{name}"));
+            }
+        }
+    }
+    files
+}
+
+// ----------------------------------------------------------------- docs --
+
+/// The docs in `dir` itself: (name as it is on disk, path).
+fn doc_files(dir: &Path) -> Vec<(String, PathBuf)> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut docs: Vec<(String, PathBuf)> = entries
+        .filter_map(|e| e.ok())
+        .filter(|e| e.file_type().is_ok_and(|t| !t.is_dir()))
+        .map(|e| (e.file_name().to_string_lossy().into_owned(), e.path()))
+        .filter(|(name, path)| DOC_NAMES.contains(&name.to_lowercase().as_str()) && path.is_file())
+        .collect();
+    // README first: its title is the project's name.
+    docs.sort_by_key(|(name, _)| (!name.to_lowercase().starts_with("readme"), name.clone()));
+    docs
+}
+
+/// When the session runs in a subdirectory, the repo root's docs still
+/// describe it.
+fn parent_docs(cwd: &Path) -> Vec<(String, PathBuf)> {
+    match cwd.ancestors().find(|dir| dir.join(".git").exists()) {
+        Some(top) if top != cwd => doc_files(top),
+        _ => Vec::new(),
+    }
+}
+
+fn is_readme(path: &Path) -> bool {
+    path.file_name()
+        .is_some_and(|n| n.to_string_lossy().to_lowercase().starts_with("readme"))
+}
+
+fn read_capped(path: &Path, max: u64) -> Option<String> {
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)
+        .ok()?
+        .take(max)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Shape {
+    /// `VocabCache`, `macOS`: casing that cannot be an accident.
+    Inner,
+    /// `NVIDIA`, `API`.
+    Acronym,
+    /// `Parakeet`: a capital, then lowercase.
+    Capital,
+}
+
+fn shape(word: &str) -> Option<Shape> {
+    if word.chars().count() < 2 || !word.chars().all(char::is_alphanumeric) {
+        return None;
+    }
+    let letters = word.chars().filter(|c| c.is_alphabetic()).count();
+    let upper = word.chars().filter(|c| c.is_uppercase()).count();
+    let lower = word.chars().filter(|c| c.is_lowercase()).count();
+    let first = word.chars().next()?;
+    if upper == 0 || letters < 2 {
+        None
+    } else if lower == 0 {
+        Some(Shape::Acronym)
+    } else if text::has_inner_case(word) {
+        Some(Shape::Inner)
+    } else if first.is_uppercase() {
+        Some(Shape::Capital)
+    } else {
+        None
+    }
+}
+
+/// Terms gathered from markdown prose.
+///
+/// A word counts when its casing says it is a name: inner capitals anywhere,
+/// an acronym, or a capital in the middle of a sentence — alone or in a run
+/// ("Claude Code"). A capital that only opens a sentence says nothing, and a
+/// word the docs also write in lowercase is not a name.
+#[derive(Default)]
+struct DocTerms {
+    terms: BTreeSet<String>,
+    /// Capitalised words and acronyms, kept only if never seen lowercase.
+    tentative: BTreeSet<String>,
+    lowercase: HashSet<String>,
+}
+
+struct Seen {
+    word: String,
+    shape: Shape,
+    opens_sentence: bool,
+}
+
+impl DocTerms {
+    fn read(&mut self, body: &str, title_is_name: bool) {
+        let link = Regex::new(r"!?\[([^\]]*)\]\([^)]*\)").expect("valid regex");
+        let code = Regex::new(r"`([^`]*)`").expect("valid regex");
+        let tag = Regex::new(r"<[^>]*>").expect("valid regex");
+        let mut in_fence = false;
+        let mut first_heading = title_is_name;
+        for line in body.lines() {
+            let line = line.trim();
+            if line.starts_with("```") || line.starts_with("~~~") {
+                in_fence = !in_fence;
+                continue;
+            }
+            if in_fence || line.is_empty() {
+                continue;
+            }
+            let heading = line.starts_with('#');
+            let line = line.trim_start_matches('#').trim();
+            if heading && std::mem::take(&mut first_heading) {
+                self.title(line);
+            }
+            let line = link.replace_all(line, "$1");
+            let line = tag.replace_all(&line, " ");
+            for span in code.captures_iter(&line) {
+                // An identifier with inner capitals is a term as written.
+                if shape(&span[1]) == Some(Shape::Inner) {
+                    self.terms.insert(span[1].to_string());
+                }
+            }
+            // A code span breaks a run of words like a comma would.
+            let line = code.replace_all(&line, " , ");
+            self.prose(&line, heading);
+        }
+    }
+
+    /// The README's first heading is the project's name, written however
+    /// the project writes it.
+    fn title(&mut self, heading: &str) {
+        let words: Vec<&str> = heading.split_whitespace().collect();
+        let plain = |w: &&str| w.chars().all(|c| c.is_alphanumeric() || "-_.".contains(c));
+        if (1..=3).contains(&words.len())
+            && words.iter().all(plain)
+            && !words.iter().all(|w| is_common(w))
+        {
+            self.terms.insert(words.join(" "));
+        }
+    }
+
+    fn prose(&mut self, line: &str, heading: bool) {
+        let mut run: Vec<Seen> = Vec::new();
+        let mut opens_sentence = true;
+        for raw in line.split_whitespace() {
+            // List markers and quotes open a sentence without being a word.
+            if matches!(raw, "-" | "*" | "+" | ">") {
+                continue;
+            }
+            // Punctuation on its own ("—", " , " left by a code span).
+            let Some(start) = raw.find(char::is_alphanumeric) else {
+                self.flush(&mut run, heading);
+                opens_sentence |= raw.contains(['.', '?', '!', ':']);
+                continue;
+            };
+            let end = raw
+                .char_indices()
+                .rev()
+                .find(|(_, c)| c.is_alphanumeric())
+                .map_or(raw.len(), |(i, c)| i + c.len_utf8());
+            let (led, word, trail) = (start > 0, &raw[start..end], &raw[end..]);
+            let (word, possessive) =
+                match word.strip_suffix("'s").or_else(|| word.strip_suffix("’s")) {
+                    Some(stem) => (stem, true),
+                    None => (word, false),
+                };
+            let trail_ends_sentence = trail.contains(['.', '?', '!', ':']);
+
+            let named = (!text::is_protected(raw)).then(|| shape(word)).flatten();
+            if led && !opens_sentence {
+                self.flush(&mut run, heading);
+            }
+            match named {
+                Some(shape) => run.push(Seen {
+                    word: word.to_string(),
+                    shape,
+                    opens_sentence: opens_sentence && run.is_empty(),
+                }),
+                None => {
+                    self.flush(&mut run, heading);
+                    for part in word.split(|c: char| !c.is_alphanumeric()) {
+                        if part.chars().any(char::is_lowercase)
+                            && !part.chars().any(char::is_uppercase)
+                        {
+                            self.lowercase.insert(part.to_string());
+                        }
+                    }
+                }
+            }
+            if possessive || !trail.is_empty() {
+                self.flush(&mut run, heading);
+            }
+            // "1." opens a list item; any other word ends the opening.
+            opens_sentence =
+                trail_ends_sentence || (opens_sentence && word.chars().all(|c| c.is_ascii_digit()));
+        }
+        self.flush(&mut run, heading);
+    }
+
+    fn flush(&mut self, run: &mut Vec<Seen>, heading: bool) {
+        let mut run = std::mem::take(run);
+        // A line of capitals is shouting, not three acronyms.
+        if run.len() >= 3 && run.iter().all(|s| s.shape == Shape::Acronym) {
+            return;
+        }
+        // A sentence's first capital means nothing on its own; it stays only
+        // as the start of a longer name ("Claude Code is…"). A heading's
+        // first word is kept: "Parakeet model" is how names appear there.
+        if let Some(first) = run.first() {
+            let uninformative = first.opens_sentence
+                && first.shape == Shape::Capital
+                && (is_common(&first.word) || (run.len() == 1 && !heading));
+            if uninformative {
+                run.remove(0);
+            }
+        }
+        if run.is_empty() || run.len() > 4 {
+            return;
+        }
+        if run.len() >= 2 {
+            let common = run.iter().filter(|s| is_common(&s.word)).count();
+            // Title Case makes every heading look like a name.
+            let is_name = if heading {
+                common == 0
+            } else {
+                common < run.len()
+            };
+            if is_name {
+                let words: Vec<&str> = run.iter().map(|s| s.word.as_str()).collect();
+                self.terms.insert(words.join(" "));
+            }
+        }
+        for seen in run {
+            match seen.shape {
+                Shape::Inner => {
+                    self.terms.insert(seen.word);
+                }
+                Shape::Acronym | Shape::Capital => {
+                    if !is_common(&seen.word) {
+                        self.tentative.insert(seen.word);
+                    }
+                }
+            }
+        }
+    }
+
+    fn finish(self) -> Vec<String> {
+        let DocTerms {
+            mut terms,
+            tentative,
+            lowercase,
+        } = self;
+        terms.extend(
+            tentative
+                .into_iter()
+                .filter(|w| !lowercase.contains(&w.to_lowercase())),
+        );
+        terms.into_iter().collect()
+    }
+}
+
+// ------------------------------------------------------------- packages --
+
+/// The names the repo's own crates and packages go by.
+fn package_names(root: &Path, files: &[String]) -> Vec<String> {
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| {
+            matches!(
+                f.rsplit('/').next().unwrap_or(f),
+                "Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod"
+            )
+        })
+        .collect();
+    // Nearest the root first: those are the ones that name the project.
+    manifests.sort_by_key(|f| f.matches('/').count());
+    let mut names = Vec::new();
+    for file in manifests.into_iter().take(MAX_MANIFESTS) {
+        let Some(body) = read_capped(&root.join(file), DOC_MAX_BYTES) else {
+            continue;
+        };
+        match file.rsplit('/').next().unwrap_or(file) {
+            "Cargo.toml" => {
+                let Ok(doc) = body.parse::<toml::Table>() else {
+                    continue;
+                };
+                names.extend(toml_str(&doc, &["package", "name"]));
+                names.extend(toml_str(&doc, &["lib", "name"]));
+                let bins = doc.get("bin").and_then(|b| b.as_array());
+                for bin in bins.into_iter().flatten() {
+                    names.extend(bin.get("name").and_then(|n| n.as_str()).map(str::to_string));
+                }
+            }
+            "pyproject.toml" => {
+                let Ok(doc) = body.parse::<toml::Table>() else {
+                    continue;
+                };
+                names.extend(toml_str(&doc, &["project", "name"]));
+                names.extend(toml_str(&doc, &["tool", "poetry", "name"]));
+            }
+            "package.json" => {
+                let Ok(doc) = serde_json::from_str::<serde_json::Value>(&body) else {
+                    continue;
+                };
+                if let Some(name) = doc.get("name").and_then(|n| n.as_str()) {
+                    // "@scope/name": the scope is not what people say.
+                    names.push(name.rsplit('/').next().unwrap_or(name).to_string());
+                }
+            }
+            _ => {
+                let module = body.lines().find_map(|l| l.trim().strip_prefix("module "));
+                if let Some(module) = module {
+                    names.push(module.trim().rsplit('/').next().unwrap_or("").to_string());
+                }
+            }
+        }
+    }
+    names.retain(|n| {
+        (2..=64).contains(&n.len())
+            && n.chars().any(char::is_alphabetic)
+            && n.chars()
+                .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '.'))
+    });
+    names
+}
+
+fn toml_str(doc: &toml::Table, path: &[&str]) -> Option<String> {
+    let (last, tables) = path.split_last()?;
+    let mut table = doc;
+    for key in tables {
+        table = table.get(*key)?.as_table()?;
+    }
+    table.get(*last)?.as_str().map(str::to_string)
+}
