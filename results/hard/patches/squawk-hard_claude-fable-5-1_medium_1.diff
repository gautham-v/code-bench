+            "see @old/context/mod.rs"
+        );
+    }
+
+    #[test]
+    fn unsure_means_untouched() {
+        let v = squawk();
+        for text in [
+            "the status item is broken",
+            "the audio is clipping",
+            "item dot rs",
+            "missing dot rs",
+            "status item, dot rs",
+            "connect the dot",
+            "open `status item dot rs`",
+            "see src/status_item.rs and @README.md",
+            "status item.rs",
+            "my file dot rs",
+        ] {
+            assert_eq!(run(text, &v), text, "{text}");
+        }
+        let spaced = vocab(&["my file.rs"], &[]);
+        assert_eq!(run("open my file dot rs", &spaced), "open my file dot rs");
+    }
+
+    #[test]
+    fn terms_get_the_repos_spelling() {
+        let v = squawk();
+        assert_eq!(
+            run("the vocab cache in squawk core", &v),
+            "the VocabCache in squawk-core"
+        );
+        assert_eq!(
+            run("Vocabcache, parakeet's model and nvidia on Mac OS.", &v),
+            "VocabCache, Parakeet's model and NVIDIA on macOS."
+        );
+        assert_eq!(run("ask claude code", &v), "ask Claude Code");
+        // Already right, or not a term at all.
+        assert_eq!(run("ask Claude Code", &v), "ask Claude Code");
+        assert_eq!(run("ask claude", &v), "ask claude");
+        // A file's name is not a term: these stay prose.
+        assert_eq!(run("Cargo build the readme", &v), "Cargo build the readme");
+        assert_eq!(
+            run("Main thing: system audio", &v),
+            "Main thing: system audio"
+        );
+        // Punctuation between the words: two words, not one term.
+        assert_eq!(run("vocab, cache", &v), "vocab, cache");
+        assert_eq!(run("see vocab_cache.rs", &v), "see vocab_cache.rs");
+    }
+
+    #[test]
+    fn two_terms_said_alike_are_left_alone() {
+        let v = vocab(&[], &["GitHub", "Github", "DataStore", "data_store"]);
+        assert_eq!(run("push to github", &v), "push to github");
+        assert_eq!(run("the data store", &v), "the data store");
+        // A file stem gives way to a real name.
+        let v = vocab(&["src/vocab_cache.rs"], &["VocabCache", "vocab_cache"]);
+        assert_eq!(run("the vocab cache", &v), "the VocabCache");
+    }
+
+    #[test]
+    fn untouched_text_is_returned_as_given() {
+        let v = squawk();
+        assert_eq!(run("two  spaces\tand a tab", &v), "two  spaces\tand a tab");
+        assert_eq!(run("", &v), "");
+        let empty = RepoVocab::default();
+        assert_eq!(run("status item dot rs", &empty), "status item dot rs");
+    }
+
+    #[test]
+    fn parts() {
+        let parts = |w| term_parts(w).unwrap().join(" ");
+        assert_eq!(parts("VocabCache"), "vocab cache");
+        assert_eq!(parts("squawk-core"), "squawk core");
+        assert_eq!(parts("SQLite"), "sq lite");
+        assert_eq!(parts("gpt5"), "gpt 5");
+        assert_eq!(parts("Claude Code"), "claude code");
+        assert_eq!(term_parts("C++"), None);
+        assert_eq!(
+            groupings(&["a".into(), "b".into(), "c".into()]),
+            ["abc", "a bc", "ab c", "a b c"]
+        );
+    }
+
+    #[test]
+    fn index_is_built_once_per_vocab() {
+        let v = Arc::new(squawk());
+        let a = index_for(&v);
+        let b = index_for(&v);
+        assert!(Arc::ptr_eq(&a, &b));
+        let other = Arc::new(squawk());
+        assert!(!Arc::ptr_eq(&a, &index_for(&other)));
+    }
+}
