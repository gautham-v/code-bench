+// ---------------------------------------------------------------- cache --
+
+/// What a cached vocab was built from; a change in any of it means rebuild.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Stamp {
+    /// `.git/index`: its modification time and size.
+    index: Option<(Option<SystemTime>, u64)>,
+    /// The directory itself: a file added to or removed from its top level.
+    root: Option<SystemTime>,
+}
+
+impl Stamp {
+    pub(super) fn of(cwd: &Path) -> Stamp {
+        let index = git_index(cwd).map(|index| match std::fs::metadata(index) {
+            Ok(meta) => (meta.modified().ok(), meta.len()),
+            Err(_) => (None, 0),
+        });
+        let root = std::fs::metadata(cwd).and_then(|m| m.modified()).ok();
+        Stamp { index, root }
+    }
+
+    /// How long a vocab with this stamp is trusted without a change. Git
+    /// says when tracked files change; untracked files, and everything
+    /// outside git, are only seen by looking again.
+    pub(super) fn ttl(&self) -> Duration {
+        if self.index.is_some() {
+            Duration::from_secs(30)
+        } else {
+            Duration::from_secs(5)
+        }
+    }
+}
