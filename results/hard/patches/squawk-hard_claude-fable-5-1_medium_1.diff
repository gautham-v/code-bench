@@ -0,0 +1,873 @@
+//! Rewriting a transcript with a repo's vocab: spoken file names become
+//! @mentions, and the repo's terms get the repo's spelling.
+//!
+//! A file is referred to by its whole name with its extension: "status item
+//! dot rs", or without the "dot" for extensions that are not also words
+//! ("cargo toml"). Words are compared with separators and case removed, so
+//! `status_item.rs`, `StatusItem.rs` and `status-item.rs` are all said the
+//! same way, and "hot key dot rs" finds `hotkey.rs`. When several files share
+//! the name, a folder said before it ("context slash mod dot rs") picks one;
+//! a name that still fits more than one file is left as spoken.
+//!
+//! A term is rewritten when it is heard whole: the word itself in any case,
+//! or its parts as separate words ("vocab cache" for `VocabCache`, "squawk
+//! core" for `squawk-core`). A term that is only a file's name is not
+//! rewritten from its parts: "the status item" stays prose, and is reached
+//! as a file by saying its extension.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex};
+
+use super::vocab::file_stem;
+use super::RepoVocab;
+use crate::text::{self, Chunk};
+
+/// Extensions that can be said without "dot": abbreviations nobody says
+/// after a file's name by accident. Words do need it ("go", "mod", "lock"),
+/// and so do language names ("the main java class" is not `Main.java`).
+const DOTLESS_EXTS: &[&str] = &[
+    "md", "toml", "json", "yaml", "yml", "rs", "py", "ts", "tsx", "js", "jsx", "txt", "html",
+    "css", "scss", "sh", "sql", "kt", "rb", "cpp", "hpp", "cs", "xml", "csv", "plist",
+];
+/// Whole names said without "dot" although their extension is a word.
+const DOTLESS_NAMES: &[&str] = &[
+    "cargo.lock",
+    "yarn.lock",
+    "gemfile.lock",
+    "poetry.lock",
+    "flake.lock",
+];
+/// How an extension can be heard after "dot".
+const EXT_ALIASES: &[(&str, &str)] = &[
+    ("markdown", "md"),
+    ("jason", "json"),
+    ("python", "py"),
+    ("pie", "py"),
+    ("text", "txt"),
+    ("javascript", "js"),
+    ("typescript", "ts"),
+    ("yammel", "yaml"),
+    ("shell", "sh"),
+    ("rust", "rs"),
+];
+/// Separators said aloud inside a name: "status underscore item".
+const SEPARATOR_WORDS: &[&str] = &["underscore", "dash", "hyphen"];
+const NUMBER_WORDS: &[&str] = &[
+    "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
+];
+
+/// A file or folder name is at most this many spoken words.
+const MAX_NAME_WORDS: usize = 6;
+/// An extension spelled out letter by letter: "t s x".
+const MAX_EXT_WORDS: usize = 3;
+/// A term's parts are tried in every grouping up to this many parts.
+const MAX_GROUPED_PARTS: usize = 5;
+const MAX_TERM_WORDS: usize = 8;
+
+/// A vocab arranged for lookup. Built once per vocab (see [`index_for`]).
+#[derive(Debug, Default)]
+pub(super) struct Index {
+    /// Spoken name (`statusitem.rs`) → the files called that.
+    names: HashMap<String, Vec<u32>>,
+    /// Every last extension in `names`.
+    exts: HashSet<String>,
+    /// Spoken form (`vocab cache`) → the term.
+    terms: HashMap<String, Term>,
+    /// The longest spoken form, in words.
+    max_term_words: usize,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Term {
+    Written {
+        written: String,
+        /// Only rewritten when heard as one word (a file's stem).
+        one_word_only: bool,
+    },
+    /// Two terms are said this way; neither is written.
+    Ambiguous,
+}
+
+/// The index for a vocab, built on first use and kept for the few vocabs
+/// most recently used, so `apply` never pays for it after a warm-up.
+pub(super) fn index_for(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+    const KEPT: usize = 4;
+    static RECENT: Mutex<Vec<(Arc<RepoVocab>, Arc<Index>)>> = Mutex::new(Vec::new());
+    let find = |recent: &Vec<(Arc<RepoVocab>, Arc<Index>)>| {
+        recent
+            .iter()
+            .find(|(v, _)| Arc::ptr_eq(v, vocab))
+            .map(|(_, index)| index.clone())
+    };
+    if let Some(index) = find(&RECENT.lock().unwrap_or_else(|e| e.into_inner())) {
+        return index;
+    }
+    let index = Arc::new(Index::new(vocab));
+    let mut recent = RECENT.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(index) = find(&recent) {
+        return index;
+    }
+    // Holding the vocab keeps its address from being reused by another.
+    recent.insert(0, (vocab.clone(), index.clone()));
+    recent.truncate(KEPT);
+    index
+}
+
+impl Index {
+    pub(super) fn new(vocab: &RepoVocab) -> Index {
+        let mut index = Index::default();
+        let mut stems: HashSet<&str> = HashSet::new();
+        for (i, file) in vocab.files.iter().enumerate() {
+            stems.extend(file_stem(file));
+            // A path with a space cannot be one @mention.
+            if file.is_empty() || file.contains(char::is_whitespace) {
+                continue;
+            }
+            let name = file.rsplit('/').next().unwrap_or(file);
+            if let Some(key) = name_key(name) {
+                if let Some((_, ext)) = key.rsplit_once('.') {
+                    index.exts.insert(ext.to_string());
+                }
+                index.names.entry(key).or_default().push(i as u32);
+            }
+        }
+
+        // The repo's names first; a file stem never displaces one.
+        let (stem_words, names): (Vec<&String>, Vec<&String>) =
+            vocab.words.iter().partition(|w| stems.contains(w.as_str()));
+        for word in names {
+            let Some(parts) = term_parts(word) else {
+                continue;
+            };
+            // A lowercase word has no spelling to restore.
+            if parts.len() == 1 && !word.chars().any(char::is_uppercase) {
+                continue;
+            }
+            for form in groupings(&parts) {
+                index.max_term_words = index.max_term_words.max(form.split(' ').count());
+                let term = Term::Written {
+                    written: word.clone(),
+                    one_word_only: false,
+                };
+                index
+                    .terms
+                    .entry(form)
+                    .and_modify(|t| {
+                        if *t != term {
+                            *t = Term::Ambiguous;
+                        }
+                    })
+                    .or_insert(term);
+            }
+        }
+        for word in stem_words {
+            let Some(parts) = term_parts(word).filter(|p| p.len() > 1) else {
+                continue;
+            };
+            for form in [parts.concat(), parts.join(" ")] {
+                index.terms.entry(form).or_insert(Term::Written {
+                    written: word.clone(),
+                    one_word_only: true,
+                });
+            }
+        }
+        index.max_term_words = index.max_term_words.clamp(1, MAX_TERM_WORDS);
+        index
+    }
+}
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab, index: &Index) -> String {
+    let mut chunks = text::chunks(text);
+    let mentioned = mention_files(&mut chunks, vocab, index);
+    let spelled = spell_terms(&mut chunks, index);
+    if mentioned || spelled {
+        text::join(&chunks)
+    } else {
+        text.to_string()
+    }
+}
+
+// ------------------------------------------------------------- mentions --
+
+/// Letters and digits only, lowercased: how a name is compared.
+fn squash(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// `status_item.rs` → `statusitem.rs`, `.gitignore` → `.gitignore`,
+/// `foo.test.ts` → `foo.test.ts`. `None` for a name with no extension.
+fn name_key(name: &str) -> Option<String> {
+    let segments: Vec<String> = name.split('.').map(squash).collect();
+    let dotfile = name.starts_with('.');
+    if segments.len() < 2 || segments.iter().skip(dotfile as usize).any(String::is_empty) {
+        return None;
+    }
+    Some(segments.join("."))
+}
+
+/// A chunk that can be part of a spoken name: an ordinary word.
+fn is_plain(chunk: &Chunk) -> bool {
+    !chunk.is_protected() && chunk.core.chars().any(char::is_alphanumeric)
+}
+
+/// A plain chunk that is exactly this word, with nothing attached after it.
+fn is_word(chunk: &Chunk, word: &str) -> bool {
+    is_plain(chunk) && chunk.trail.is_empty() && chunk.key() == word
+}
+
+/// The ways `chunks[start..end]` can be read as one name: as heard, and with
+/// spoken separators dropped and number words as digits.
+fn spoken(chunks: &[Chunk]) -> Vec<String> {
+    let raw: String = chunks.iter().map(|c| squash(&c.core)).collect();
+    let cooked: String = chunks
+        .iter()
+        .map(|c| {
+            let key = c.key();
+            if SEPARATOR_WORDS.contains(&key.as_str()) {
+                String::new()
+            } else if let Some(n) = NUMBER_WORDS.iter().position(|w| *w == key) {
+                n.to_string()
+            } else {
+                squash(&c.core)
+            }
+        })
+        .collect();
+    if cooked == raw || cooked.is_empty() {
+        vec![raw]
+    } else {
+        vec![raw, cooked]
+    }
+}
+
+/// How many chunks before `end` can be name words: each plain, nothing
+/// between them but spaces, and no "dot" or "slash" among them.
+fn name_words_before(chunks: &[Chunk], end: usize) -> usize {
+    let mut n = 0;
+    while n < MAX_NAME_WORDS && n < end {
+        let c = &chunks[end - 1 - n];
+        let attached = !c.trail.is_empty() || (n > 0 && !chunks[end - n].lead.is_empty());
+        if !is_plain(c) || attached || matches!(c.key().as_str(), "dot" | "slash") {
+            break;
+        }
+        n += 1;
+    }
+    n
+}
+
+/// What can follow the "dot" at `dot`: (end of the reference, the rest of the
+/// name key from that dot on). Longest first.
+fn after_dot(chunks: &[Chunk], dot: usize, depth: usize) -> Vec<(usize, String)> {
+    let mut out = Vec::new();
+    for n in 1..=MAX_EXT_WORDS {
+        let end = dot + 1 + n;
+        if end > chunks.len() {
+            break;
+        }
+        let words = &chunks[dot + 1..end];
+        let joined = words
+            .iter()
+            .enumerate()
+            .all(|(i, c)| is_plain(c) && c.lead.is_empty() && (i + 1 == n || c.trail.is_empty()));
+        if !joined {
+            break;
+        }
+        let mut segments = spoken(words);
+        if n == 1 {
+            let key = words[0].key();
+            segments.extend(
+                EXT_ALIASES
+                    .iter()
+                    .filter(|(heard, _)| *heard == key)
+                    .map(|(_, ext)| ext.to_string()),
+            );
+        }
+        for segment in segments {
+            // "app dot test dot ts": another dot, another segment.
+            let more = depth < 3 && words[n - 1].trail.is_empty();
+            if more && chunks.get(end).is_some_and(is_dot) {
+                for (far, rest) in after_dot(chunks, end, depth + 1) {
+                    out.push((far, format!(".{segment}{rest}")));
+                }
+            }
+            out.push((end, format!(".{segment}")));
+        }
+    }
+    out.sort_by_key(|form| std::cmp::Reverse(form.0));
+    out
+}
+
+fn is_dot(chunk: &Chunk) -> bool {
+    chunk.lead.is_empty() && is_word(chunk, "dot")
+}
+
+fn is_slash(chunk: &Chunk) -> bool {
+    chunk.lead.is_empty() && is_word(chunk, "slash")
+}
+
+/// A reference found in the chunks: `chunks[start..end]` names these files.
+struct Found<'a> {
+    start: usize,
+    end: usize,
+    files: &'a [u32],
+}
+
+/// "… status item dot rs": the name before the "dot" at `dot` and the
+/// extension after it. The longest name that is a file's wins.
+fn dotted<'a>(chunks: &[Chunk], dot: usize, index: &'a Index) -> Option<Found<'a>> {
+    let before = name_words_before(chunks, dot);
+    for (end, rest) in after_dot(chunks, dot, 0) {
+        for n in (1..=before).rev() {
+            for stem in spoken(&chunks[dot - n..dot]) {
+                if let Some(files) = index.names.get(&format!("{stem}{rest}")) {
+                    return Some(Found {
+                        start: dot - n,
+                        end,
+                        files,
+                    });
+                }
+            }
+        }
+        // "dot gitignore": a dotfile is its extension.
+        if let Some(files) = index.names.get(&rest) {
+            return Some(Found {
+                start: dot,
+                end,
+                files,
+            });
+        }
+    }
+    None
+}
+
+/// "… cargo toml": the chunk at `at` is an extension said without "dot".
+fn dotless<'a>(chunks: &[Chunk], at: usize, index: &'a Index) -> Option<Found<'a>> {
+    let ext = chunks[at].key();
+    if !is_plain(&chunks[at]) || !chunks[at].lead.is_empty() || !index.exts.contains(&ext) {
+        return None;
+    }
+    for n in (1..=name_words_before(chunks, at)).rev() {
+        for stem in spoken(&chunks[at - n..at]) {
+            let key = format!("{stem}.{ext}");
+            if !DOTLESS_EXTS.contains(&ext.as_str()) && !DOTLESS_NAMES.contains(&key.as_str()) {
+                continue;
+            }
+            if let Some(files) = index.names.get(&key) {
+                return Some(Found {
+                    start: at - n,
+                    end: at + 1,
+                    files,
+                });
+            }
+        }
+    }
+    None
+}
+
+/// Folders said before the name at `start`, checked against `path`'s own:
+/// "core slash src slash" fits `…/core/src/<name>`. Returns where the
+/// folders start and whether they spell the whole path, or `None` when a
+/// folder was said that this path does not have.
+fn folders_before(chunks: &[Chunk], start: usize, path: &str) -> Option<(usize, bool)> {
+    let mut dirs: Vec<&str> = path.split('/').collect();
+    dirs.pop();
+    let mut pos = start;
+    while pos > 0 && is_slash(&chunks[pos - 1]) && chunks[pos].lead.is_empty() {
+        let dir = squash(dirs.pop()?);
+        let slash = pos - 1;
+        let n = (1..=name_words_before(chunks, slash))
+            .find(|n| spoken(&chunks[slash - n..slash]).contains(&dir))?;
+        pos = slash - n;
+    }
+    Some((pos, dirs.is_empty()))
+}
+
+/// The one file a reference means, and where the reference starts once any
+/// folders said before it are counted in. `None` when it is not certain.
+fn resolve(chunks: &[Chunk], found: &Found, vocab: &RepoVocab) -> Option<(usize, u32)> {
+    let path = |i: u32| vocab.files[i as usize].as_str();
+    let said_folder = found.start > 0 && is_slash(&chunks[found.start - 1]);
+    if !said_folder {
+        return match found.files {
+            [only] => Some((found.start, *only)),
+            // The name alone is the path of the file at the top.
+            files => {
+                let mut top = files.iter().filter(|i| !path(**i).contains('/'));
+                match (top.next(), top.next()) {
+                    (Some(only), None) => Some((found.start, *only)),
+                    _ => None,
+                }
+            }
+        };
+    }
+    let fits: Vec<(usize, bool, u32)> = found
+        .files
+        .iter()
+        .filter_map(|i| {
+            let (start, whole) = folders_before(chunks, found.start, path(*i))?;
+            Some((start, whole, *i))
+        })
+        .collect();
+    // The file that accounts for the most folders said; among equals, the
+    // one whose whole path was said.
+    let longest = fits.iter().map(|(start, ..)| *start).min()?;
+    let best: Vec<_> = fits.iter().filter(|(s, ..)| *s == longest).collect();
+    match best.as_slice() {
+        [(start, _, file)] => Some((*start, *file)),
+        several => {
+            let mut whole = several.iter().filter(|(_, whole, _)| *whole);
+            match (whole.next(), whole.next()) {
+                (Some((start, _, file)), None) => Some((*start, *file)),
+                _ => None,
+            }
+        }
+    }
+}
+
+fn mention_files(chunks: &mut Vec<Chunk>, vocab: &RepoVocab, index: &Index) -> bool {
+    if index.names.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        let found = if is_dot(&chunks[i]) {
+            dotted(chunks, i, index)
+        } else if i > 0 && !is_dot(&chunks[i - 1]) {
+            dotless(chunks, i, index)
+        } else {
+            None
+        };
+        let Some((mut start, file)) = found
+            .as_ref()
+            .and_then(|found| resolve(chunks, found, vocab))
+        else {
+            i += 1;
+            continue;
+        };
+        let end = found.expect("resolved").end;
+        // "the claude md" is the file, not "the" file; "the claude md file"
+        // keeps its article.
+        let article = start > 0
+            && chunks[start].lead.is_empty()
+            && is_word(&chunks[start - 1], "the")
+            && !chunks
+                .get(end)
+                .is_some_and(|c| matches!(c.key().as_str(), "file" | "files"));
+        if article {
+            start -= 1;
+        }
+        let mut trail = chunks[end - 1].trail.clone();
+        // Ending the dictation: a period there would read as part of the path.
+        if end == chunks.len() && trail == "." {
+            trail.clear();
+        }
+        let mention = Chunk {
+            lead: chunks[start].lead.clone(),
+            core: format!("@{}", vocab.files[file as usize]),
+            trail,
+        };
+        chunks.splice(start..end, [mention]);
+        changed = true;
+        i = start + 1;
+    }
+    changed
+}
+
+// ---------------------------------------------------------------- terms --
+
+/// The parts a term is said in: `VocabCache` → vocab, cache; `squawk-core`
+/// → squawk, core; `gpt5` → gpt, 5; `Claude Code` → claude, code. `None`
+/// for a term with characters that are never said.
+fn term_parts(word: &str) -> Option<Vec<String>> {
+    let chars: Vec<char> = word.chars().collect();
+    let mut parts: Vec<String> = Vec::new();
+    let mut cur = String::new();
+    for (i, &c) in chars.iter().enumerate() {
+        if matches!(c, ' ' | '-' | '_' | '.') {
+            if !cur.is_empty() {
+                parts.push(std::mem::take(&mut cur));
+            }
+            continue;
+        }
+        if !c.is_alphanumeric() {
+            return None;
+        }
+        if let Some(&p) = i.checked_sub(1).and_then(|j| chars.get(j)) {
+            let next_lower = chars.get(i + 1).is_some_and(|n| n.is_lowercase());
+            // The camel-case rule the dictionary uses: `SQLite` → SQ, Lite.
+            let boundary = (p.is_lowercase() && c.is_uppercase())
+                || (p.is_uppercase() && c.is_uppercase() && next_lower)
+                || (p.is_alphanumeric() && p.is_ascii_digit() != c.is_ascii_digit());
+            if boundary && !cur.is_empty() {
+                parts.push(std::mem::take(&mut cur));
+            }
+        }
+        cur.extend(c.to_lowercase());
+    }
+    if !cur.is_empty() {
+        parts.push(cur);
+    }
+    (!parts.is_empty()).then_some(parts)
+}
+
+/// Every way of saying the parts as words: each gap is a space or nothing.
+/// Long terms get only the two extremes.
+fn groupings(parts: &[String]) -> Vec<String> {
+    if parts.len() > MAX_GROUPED_PARTS {
+        return vec![parts.concat(), parts.join(" ")];
+    }
+    let gaps = parts.len() - 1;
+    (0..1u32 << gaps)
+        .map(|mask| {
+            let mut form = parts[0].clone();
+            for (gap, part) in parts[1..].iter().enumerate() {
+                if mask & (1 << gap) != 0 {
+                    form.push(' ');
+                }
+                form.push_str(part);
+            }
+            form
+        })
+        .collect()
+}
+
+/// How a heard chunk is looked up: lowercased, hyphens and underscores as
+/// spaces. `None` if it holds anything else that is not a letter or digit.
+fn heard(core: &str) -> Option<String> {
+    let mut out = String::new();
+    for c in core.chars() {
+        if c.is_alphanumeric() {
+            out.extend(c.to_lowercase());
+        } else if matches!(c, '-' | '_') {
+            out.push(' ');
+        } else {
+            return None;
+        }
+    }
+    let out = out.split_whitespace().collect::<Vec<_>>().join(" ");
+    (!out.is_empty()).then_some(out)
+}
+
+fn spell_terms(chunks: &mut Vec<Chunk>, index: &Index) -> bool {
+    if index.terms.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    'next: while i < chunks.len() {
+        // How far a term starting here could run: unprotected words with
+        // nothing but spaces between them.
+        let mut reach = 0;
+        while reach < index.max_term_words && i + reach < chunks.len() {
+            let c = &chunks[i + reach];
+            if c.is_protected() || (reach > 0 && !c.lead.is_empty()) {
+                break;
+            }
+            reach += 1;
+            if !c.trail.is_empty() {
+                break;
+            }
+        }
+        for len in (1..=reach).rev() {
+            let last = &chunks[i + len - 1];
+            // "Parakeet's": the term, then the possessive.
+            let (last_core, possessive) = ["'s", "’s"]
+                .iter()
+                .find_map(|s| Some((last.core.strip_suffix(s)?, *s)))
+                .unwrap_or((&last.core, ""));
+            let cores = chunks[i..i + len - 1]
+                .iter()
+                .map(|c| c.core.as_str())
+                .chain([last_core]);
+            let Some(forms) = cores.map(heard).collect::<Option<Vec<_>>>() else {
+                continue;
+            };
+            let Some(Term::Written {
+                written,
+                one_word_only,
+            }) = index.terms.get(&forms.join(" "))
+            else {
+                continue;
+            };
+            if *one_word_only && len > 1 {
+                continue;
+            }
+            let core = format!("{written}{possessive}");
+            let as_heard = chunks[i..i + len]
+                .iter()
+                .map(|c| c.core.as_str())
+                .collect::<Vec<_>>()
+                .join(" ");
+            if core != as_heard {
+                let term = Chunk {
+                    lead: chunks[i].lead.clone(),
+                    core,
+                    trail: chunks[i + len - 1].trail.clone(),
+                };
+                chunks.splice(i..i + len, [term]);
+                changed = true;
+            } else {
+                // Already written the repo's way; its words are spoken for.
+                i += len - 1;
+            }
+            i += 1;
+            continue 'next;
+        }
+        i += 1;
+    }
+    changed
+}
+
