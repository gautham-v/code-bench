+    #[test]
+    fn names_come_from_casing() {
+        let words = terms(
+            "# squawk\n\n\
+             Local dictation for macOS. Built for talking to Claude Code in a terminal.\n\
+             Everything runs on your Mac with NVIDIA's Parakeet TDT 0.6B v3. No API keys.\n\
+             The `VocabCache` holds a `RepoVocab`; see `map_prose`.\n",
+        );
+        for term in [
+            "squawk",
+            "macOS",
+            "Claude Code",
+            "Claude",
+            "Mac",
+            "NVIDIA",
+            "Parakeet TDT",
+            "Parakeet",
+            "TDT",
+            "API",
+            "VocabCache",
+            "RepoVocab",
+        ] {
+            assert!(has(&words, term), "{term} in {words:?}");
+        }
+        for not in [
+            "Local",
+            "Built",
+            "Everything",
+            "No",
+            "The",
+            "Code",
