index 0000000..7064cf2
--- /dev/null
+++ b/src/lists.rs
@@ -0,0 +1,438 @@
+//! Numbered lists that keep their own count, and items that nest: the pure
+//! half of it, on the buffer's lines, so the editor only has to say which
+//! rows an edit touched.
+//!
+//! A list here is a run of sibling items: the same indent, the same kind of
+//! marker, with whatever is nested under each of them in between. Blank lines
+//! do not end one (markdown's loose lists); a paragraph after a blank, a
+//! heading, a fence or a shallower item does. Renumbering only ever rewrites
+//! the run it was pointed at, and a run that numbers every item the same —
+//! `1.` all the way down — is somebody's choice and is left alone.
+
+use std::collections::HashSet;
+
+/// A line split at its indent: the quote bars before it, where the indent
+/// starts and ends (bytes), how many columns it is, and what follows.
+struct Shape<'a> {
+    quotes: usize,
+    start: usize,
+    indent: usize,
+    width: usize,
+    rest: &'a str,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Marker {
+    Bullet,
+    Number { n: u64, digits: usize, delim: char },
+}
+
+impl Marker {
+    /// Columns the marker and its space take: where the item's text starts.
+    fn width(self) -> usize {
+        match self {
+            Marker::Bullet => 2,
+            Marker::Number { digits, .. } => digits + 2,
+        }
+    }
+
+    /// Whether two sibling items belong to one list.
+    fn same_kind(self, other: Marker) -> bool {
+        match (self, other) {
+            (Marker::Bullet, Marker::Bullet) => true,
+            (Marker::Number { delim: a, .. }, Marker::Number { delim: b, .. }) => a == b,
+            _ => false,
+        }
+    }
+
+    fn number(self) -> Option<u64> {
+        match self {
+            Marker::Number { n, .. } => Some(n),
+            Marker::Bullet => None,
+        }
+    }
+}
+
+fn shape(line: &str) -> Shape<'_> {
+    let b = line.as_bytes();
+    let (mut i, mut quotes) = (0, 0);
+    // `> ` bars, each allowed up to three spaces before it
+    loop {
+        let mut j = i;
+        while j < b.len() && j - i < 3 && b[j] == b' ' {
+            j += 1;
+        }
+        if b.get(j) != Some(&b'>') {
+            break;
+        }
+        i = j + 1;
+        quotes += 1;
+        if b.get(i) == Some(&b' ') {
+            i += 1;
+        }
+    }
+    let start = i;
+    let mut width = 0;
+    while let Some(c) = b.get(i) {
+        match c {
+            b' ' => width += 1,
+            b'\t' => width = (width / 4 + 1) * 4,
+            _ => break,
+        }
+        i += 1;
+    }
+    Shape {
+        quotes,
+        start,
+        indent: i,
+        width,
+        rest: &line[i..],
+    }
+}
+
+/// `- `, `* `, `+ `, `1. ` or `1) ` at the start of `rest`.
+fn marker(rest: &str) -> Option<Marker> {
+    if ["- ", "* ", "+ "].iter().any(|m| rest.starts_with(m)) {
+        return Some(Marker::Bullet);
+    }
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 || digits > 9 {
+        return None;
+    }
+    let after = &rest[digits..];
+    let delim = after.chars().next().filter(|c| matches!(c, '.' | ')'))?;
+    if !(after.len() == 1 || after[1..].starts_with(' ')) {
+        return None;
+    }
+    Some(Marker::Number {
+        n: rest[..digits].parse().ok()?,
+        digits,
+        delim,
+    })
+}
+
+fn item(line: &str) -> Option<(Shape<'_>, Marker)> {
+    let s = shape(line);
+    let m = marker(s.rest)?;
+    Some((s, m))
+}
+
+/// A line that ends a list even with no blank line before it.
+fn breaks_list(rest: &str) -> bool {
+    rest.starts_with('#')
+        || rest.starts_with("```")
+        || rest.starts_with("~~~")
+        || rest.starts_with('|')
+        || matches!(rest.trim_end(), "---" | "***" | "___")
+}
+
+/// For every line, whether it is inside a fenced code block (fences included).
+fn fenced(lines: &[String]) -> Vec<bool> {
+    let mut open = false;
+    lines
+        .iter()
+        .map(|l| {
+            let rest = shape(l).rest;
+            let fence = rest.starts_with("```") || rest.starts_with("~~~");
+            let inside = open || fence;
+            if fence {
+                open = !open;
+            }
+            inside
+        })
+        .collect()
+}
+
+/// Whether `row` is a list item outside any code fence.
+pub fn is_item(lines: &[String], row: usize) -> bool {
+    lines.get(row).is_some_and(|l| item(l).is_some()) && !fenced(lines)[row]
+}
+
+/// The items of the list `row` is in, ascending, and the item they are all
+/// nested under. With `any_kind` a sibling counts whatever its marker.
+fn siblings(lines: &[String], row: usize, any_kind: bool) -> Option<(Vec<usize>, Option<usize>)> {
+    let (me, mine) = item(&lines[row])?;
+    let mut rows = vec![row];
+    let mut parent = None;
+    // lines at or left of the item's indent, seen since the last item going
+    // up: under an item they are its lazy continuation, under a blank they
+    // are a paragraph of their own and the list ended above them
+    let mut para = false;
+    for i in (0..row).rev() {
+        let s = shape(&lines[i]);
+        if s.quotes != me.quotes {
+            break;
+        }
+        if s.rest.is_empty() {
+            if para {
+                break;
+            }
+            continue;
+        }
+        match marker(s.rest) {
+            Some(_) if s.width > me.width => para = false,
+            Some(m) if s.width == me.width => {
+                if !(any_kind || m.same_kind(mine)) {
+                    break;
+                }
+                rows.push(i);
+                para = false;
+            }
+            Some(_) => {
+                parent = Some(i);
+                break;
+            }
+            None if s.width > me.width => para = false,
+            None => {
+                if breaks_list(s.rest) {
+                    break;
+                }
+                para = true;
+            }
+        }
+    }
+    rows.reverse();
+    let mut blank = false;
+    for (i, line) in lines.iter().enumerate().skip(row + 1) {
+        let s = shape(line);
+        if s.quotes != me.quotes {
+            break;
+        }
+        if s.rest.is_empty() {
+            blank = true;
+            continue;
+        }
+        match marker(s.rest) {
+            Some(_) if s.width > me.width => {}
+            Some(m) if s.width == me.width => {
+                if !(any_kind || m.same_kind(mine)) {
+                    break;
+                }
+                rows.push(i);
+            }
+            Some(_) => break,
+            None if s.width > me.width => {}
+            None => {
+                if blank || breaks_list(s.rest) {
+                    break;
+                }
+            }
+        }
+        blank = false;
+    }
+    Some((rows, parent))
+}
+
+fn number_at(lines: &[String], row: usize) -> Option<u64> {
+    item(&lines[row]).and_then(|(_, m)| m.number())
+}
+
+fn set_number(lines: &mut [String], row: usize, n: u64) {
+    let Some((s, Marker::Number { n: old, digits, .. })) = item(&lines[row]) else {
+        return;
+    };
+    if old != n {
+        let at = s.indent;
+        lines[row].replace_range(at..at + digits, &n.to_string());
+    }
+}
+
+/// Every item numbered the same, and more than one of them.
+fn uniform(nums: &[u64]) -> bool {
+    nums.len() >= 2 && nums.iter().all(|n| *n == nums[0])
+}
+
+fn count_from(lines: &mut [String], run: &[usize], start: u64) {
+    for (k, &r) in run.iter().enumerate() {
+        set_number(lines, r, start + k as u64);
+    }
+}
+
+/// What the numbered list under the cursor looked like before an edit: where
+/// it sat, what it counted from, and whether it numbered every item alike.
+pub struct Hint {
+    quotes: usize,
+    width: usize,
+    pub start: u64,
+    pub uniform: bool,
+}
+
+/// The [`Hint`] for the numbered list one of `rows` is an item of, the first
+/// of them that is.
+pub fn hint(lines: &[String], rows: &[usize]) -> Option<Hint> {
+    rows.iter().find_map(|&row| {
+        let (s, m) = item(lines.get(row)?)?;
+        m.number()?;
+        let (run, _) = siblings(lines, row, false)?;
+        let nums: Vec<u64> = run.iter().filter_map(|&r| number_at(lines, r)).collect();
+        Some(Hint {
+            quotes: s.quotes,
+            width: s.width,
+            start: *nums.first()?,
+            uniform: uniform(&nums),
+        })
+    })
+}
+
+/// Give the item on `row` this number, whatever its list makes of it.
+pub fn renumber_item(lines: &mut [String], row: usize, n: u64) {
+    set_number(lines, row, n);
+}
+
+/// Put the numbered lists with an item on rows `from..=to` back in sequence
+/// after an edit there. A list counts on from its first item — or, when the
+/// edit replaced that first item, from where the list counted before
+/// (`before`). Lists numbered all alike are left as they are.
+pub fn renumber(lines: &mut [String], from: usize, to: usize, before: Option<&Hint>) {
+    if lines.is_empty() {
+        return;
+    }
+    let to = to.min(lines.len() - 1);
+    let fenced = fenced(lines);
+    let mut done = HashSet::new();
+    for row in from..=to {
+        if fenced[row] || done.contains(&row) {
+            continue;
+        }
+        let Some((s, Marker::Number { .. })) = item(&lines[row]) else {
+            continue;
+        };
+        let level = before.filter(|h| h.width == s.width && h.quotes == s.quotes);
+        let Some((run, _)) = siblings(lines, row, false) else {
+            continue;
+        };
+        done.extend(run.iter().copied());
+        let nums: Vec<u64> = run.iter().filter_map(|&r| number_at(lines, r)).collect();
+        match level {
+            Some(h) if h.uniform => continue,
+            None if uniform(&nums) => continue,
+            _ => {}
+        }
+        let start = match level {
+            Some(h) if (from..=to).contains(&run[0]) => h.start,
+            _ => nums[0],
+        };
+        count_from(lines, &run, start);
+    }
+}
+
+/// The last row of what is nested under the item on `row`.
+fn subtree_end(lines: &[String], row: usize) -> usize {
+    let me = shape(&lines[row]);
+    let mut end = row;
+    for (i, line) in lines.iter().enumerate().skip(row + 1) {
+        let s = shape(line);
+        if s.rest.is_empty() {
+            continue;
+        }
+        if s.quotes != me.quotes || s.width <= me.width {
+            break;
+        }
+        end = i;
+    }
+    end
+}
+
+/// Nest the item on `row` under the item above it, or with `out` bring it
+/// back out to its parent's level. Everything nested under it moves with it,
+/// and the numbers of the list it joined and the list it left follow.
+/// Returns the last row that moved, or `None` when there is nowhere to go:
+/// the first item of a list has nothing to nest under, a top-level one
+/// nothing to come out of.
+pub fn shift(lines: &mut [String], row: usize, out: bool, tab_width: usize) -> Option<usize> {
+    let (me, mine) = item(&lines[row])?;
+    let (me_width, me_quotes) = (me.width, me.quotes);
+    let old = lines[row][me.start..me.indent].to_string();
+    let indent_of = |r: usize| {
+        let s = shape(&lines[r]);
+        lines[r][s.start..s.indent].to_string()
+    };
+    let (sibs, parent) = siblings(lines, row, true)?;
+    let prev = sibs.iter().copied().filter(|&r| r < row).next_back();
+    let new = if out {
+        match parent {
+            Some(p) => indent_of(p),
+            None if me_width > 0 => String::new(),
+            None => return None,
+        }
+    } else {
+        let above = prev?;
+        // join what is already nested under the item above, if anything is
+        let child = (above + 1..row).find(|&r| {
+            item(&lines[r]).is_some_and(|(s, _)| s.quotes == me_quotes && s.width > me_width)
+        });
+        match child {
+            Some(c) => indent_of(c),
+            None => {
+                let base = indent_of(above);
+                if base.contains('\t') || old.contains('\t') {
+                    base + "\t"
+                } else {
+                    // far enough to sit under the text of the item above,
+                    // which is what makes it nested rather than a sibling
+                    let text = item(&lines[above]).map_or(2, |(_, m)| m.width());
+                    let by = if tab_width > text + 3 { text } else { tab_width.max(text) };
+                    base + &" ".repeat(by)
+                }
+            }
+        }
+    };
+    // a list numbered all alike keeps its numbers wherever its items go
+    let alike = mine.number().is_some()
+        && siblings(lines, row, false).is_some_and(|(run, _)| {
+            let nums: Vec<u64> = run.iter().filter_map(|&r| number_at(lines, r)).collect();
+            uniform(&nums)
+        });
+
+    let end = subtree_end(lines, row);
+    for line in &mut lines[row..=end] {
+        let s = shape(line);
+        if s.rest.is_empty() {
+            continue;
+        }
+        let cur = &line[s.start..s.indent];
+        let indent = match cur.strip_prefix(old.as_str()) {
+            Some(deeper) => format!("{new}{deeper}"),
+            None => format!("{new}{}", " ".repeat(s.width.saturating_sub(me_width))),
+        };
+        line.replace_range(s.start..s.indent, &indent);
+    }
+    if alike {
+        return Some(end);
+    }
+
+    // the list it joined
+    if mine.number().is_some() {
+        if let Some((run, _)) = siblings(lines, row, false) {
+            let others: Vec<u64> = run
+                .iter()
+                .filter(|&&r| r != row)
+                .filter_map(|&r| number_at(lines, r))
+                .collect();
+            if uniform(&others) {
+                set_number(lines, row, others[0]);
+            } else {
+                let start = if run[0] == row { 1 } else { number_at(lines, run[0]).unwrap_or(1) };
+                count_from(lines, &run, start);
+            }
+        }
+    }
+    // the list it left: the items after it close the gap when it nested, and
+    // are its own children, counted from one, when it came out
+    let (left, restart) = if out {
+        let next = (end + 1..lines.len()).find(|&r| !shape(&lines[r]).rest.is_empty());
+        (next.filter(|&r| shape(&lines[r]).width == me_width), true)
+    } else {
+        (prev, false)
+    };
+    if let Some((run, _)) = left
+        .filter(|&r| number_at(lines, r).is_some())
+        .and_then(|r| siblings(lines, r, false))
+    {
+        let nums: Vec<u64> = run.iter().filter_map(|&r| number_at(lines, r)).collect();
+        if !uniform(&nums) {
+            count_from(lines, &run, if restart { 1 } else { nums[0] });
+        }
+    }
+    Some(end)
+}
