+    fn rewrite_lists<R>(&mut self, f: impl FnOnce(&mut Vec<String>) -> R) -> R {
+        let old = |p: Pos| self.lines.get(p.0).cloned().unwrap_or_default();
+        let (at_cursor, at_anchor) = (old(self.cursor), self.anchor.map(old));
+        let out = f(&mut self.lines);
