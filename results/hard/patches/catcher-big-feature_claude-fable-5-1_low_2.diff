+            let new = &lines[row];
+            let (was, now) = (old.chars().count(), new.chars().count());
+            let same = old
+                .chars()
+                .rev()
+                .zip(new.chars().rev())
+                .take_while(|(a, b)| a == b)
+                .count();
+            if was - col.min(was) <= same {
