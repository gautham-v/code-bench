@@ -0,0 +1,773 @@
+//! Numbered lists as the editor keeps them: which lines are items, which
+//! list each one belongs to, and what the numbers should read once an edit
+//! has added, removed, moved or nested some. Pure functions on lines, like
+//! `commands`, so the buffer only has to say what it did.
+//!
+//! A list is the items that share an indent under one parent. Lines indented
+//! past an item are nested under it; a blank line does not end a list whose
+//! numbers carry on across it (`1.`, blank, `2.`), and does end one whose
+//! numbers start over, since that is somebody's second list. Only a list the
+//! edit changed is renumbered, from the number it started at — and a list
+//! that numbers every item the same (`1.` `1.` `1.`) keeps doing so.
+
+use std::ops::Range;
+
+/// What marks an item: the bullet itself, or the `.` / `)` after a number.
+/// Two kinds at one indent are two lists, as CommonMark has it.
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Bullet(char),
+    Ordered(char),
+}
+
+/// The quote a line sits in: the columns before its first `>`, and how many
+/// `>` deep. `(0, 0)` outside a quote.
+type Quote = (usize, usize);
+
+/// A line taken apart as far as a list cares.
+struct Parts<'a> {
+    quote: Quote,
+    /// Bytes `lead..mark` are the indentation: after the quote's `> `, if any.
+    lead: usize,
+    mark: usize,
+    /// The indentation in columns, a tab running to the next multiple of 4.
+    indent: usize,
+    /// The line from `mark` on.
+    rest: &'a str,
+}
+
+struct Item {
+    quote: Quote,
+    lead: usize,
+    mark: usize,
+    indent: usize,
+    /// The column the item's text starts at.
+    content: usize,
+    kind: Kind,
+    /// An ordered item's number, and the bytes its digits take.
+    number: u64,
+    digits: Range<usize>,
+    list: usize,
+}
+
+/// The lists of a whole buffer.
+struct Scan {
+    items: Vec<Option<Item>>,
+    /// The item a row hangs off: an item's parent, or the item a line of text
+    /// (or of an indented fence) carries on.
+    owner: Vec<Option<usize>>,
+    /// Each list's item rows, top to bottom.
+    lists: Vec<Vec<usize>>,
+}
+
+/// A list still open while the scan walks down the buffer.
+struct Open {
+    id: usize,
+    quote: Quote,
+    indent: usize,
+    kind: Kind,
+    /// Of its last item so far: the row, the content column, the number.
+    last: usize,
+    content: usize,
+    number: u64,
+    /// The list its last unmoved item was in before the edit.
+    prior: Option<usize>,
+}
+
+/// Where a line of the buffer came from: its row before the edit, and
+/// whether the edit is what put it where it now is.
+#[derive(Clone, Copy)]
+pub struct Origin {
+    pub row: usize,
+    pub moved: bool,
+}
+
+fn width(indent: &str) -> usize {
+    indent.chars().fold(0, |w, c| match c {
+        '\t' => w / 4 * 4 + 4,
+        _ => w + 1,
+    })
+}
+
+fn parts(line: &str) -> Parts<'_> {
+    let ws = |s: &str| s.len() - s.trim_start_matches([' ', '\t']).len();
+    let mut quote = (0, 0);
+    let mut lead = 0;
+    let first = ws(line);
+    if line[first..].starts_with('>') {
+        quote.0 = width(&line[..first]);
+        lead = first;
+        while line[lead..].starts_with('>') {
+            quote.1 += 1;
+            lead += 1;
+            if line[lead..].starts_with(' ') {
+                lead += 1;
+            }
+        }
+    }
+    let mark = lead + ws(&line[lead..]);
+    Parts {
+        quote,
+        lead,
+        mark,
+        indent: width(&line[lead..mark]),
+        rest: &line[mark..],
+    }
+}
+
+/// The marker `rest` opens with: its kind, its number, how many digits that
+/// is, and the marker's width up to the text.
+fn marker(rest: &str) -> Option<(Kind, u64, usize, usize)> {
+    let mut chars = rest.chars();
+    let first = chars.next()?;
+    if matches!(first, '-' | '*' | '+') {
+        return (chars.next() == Some(' ')).then_some((Kind::Bullet(first), 0, 0, 2));
+    }
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 || digits > 9 {
+        return None;
+    }
+    let mut after = rest[digits..].chars();
+    let punct = after.next().filter(|c| matches!(c, '.' | ')'))?;
+    if after.next() != Some(' ') {
+        return None;
+    }
+    let number = rest[..digits].parse().ok()?;
+    Some((Kind::Ordered(punct), number, digits, digits + 2))
+}
+
+/// A line that cannot carry a paragraph on: a heading or a rule.
+fn breaks(rest: &str) -> bool {
+    let hashes = rest.chars().take_while(|c| *c == '#').count();
+    let heading =
+        (1..=6).contains(&hashes) && (rest.len() == hashes || rest[hashes..].starts_with(' '));
+    heading || crate::md::is_rule(rest)
+}
+
+/// Walk the buffer and sort its items into lists. `prior` says, for the rows
+/// an edit left alone, which list each was in before it: that is what tells a
+/// list with a gap just cut into it from two lists that were never one.
+fn scan(lines: &[String], prior: &[Option<usize>]) -> Scan {
+    let mut s = Scan {
+        items: lines.iter().map(|_| None).collect(),
+        owner: vec![None; lines.len()],
+        lists: Vec::new(),
+    };
+    let front = crate::notes::front_matter_end(lines.iter().map(String::as_str));
+    let mut open: Vec<Open> = Vec::new();
+    // a blank line since the last one with text; and whether that last line
+    // was a paragraph's, which the next can carry on from any indent
+    let mut blank = false;
+    let mut para = false;
+    // inside a fence: the item its opening line hangs off
+    let mut fence: Option<Option<usize>> = None;
+    for (row, line) in lines.iter().enumerate() {
+        if front.is_some_and(|end| row <= end) {
+            continue;
+        }
+        if let Some(owner) = fence {
+            s.owner[row] = owner;
+            if crate::md::is_fence(line) {
+                fence = None;
+            }
+            continue;
+        }
+        let p = parts(line);
+        // the lists of a quote this line is not in are over
+        while open
+            .last()
+            .is_some_and(|o| o.quote.1 > 0 && o.quote != p.quote)
+        {
+            open.pop();
+        }
+        if p.rest.trim().is_empty() {
+            blank = true;
+            continue;
+        }
+        // a quote starting here is text to the lists outside it
+        if p.quote.1 > 0 && open.last().is_some_and(|o| o.quote != p.quote) {
+            while open.last().is_some_and(|o| o.content > p.quote.0) {
+                open.pop();
+            }
+        }
+        // this line's own lists sit above any it is quoted inside of
+        let floor = open.iter().take_while(|o| o.quote != p.quote).count();
+        let is_fence = crate::md::is_fence(line);
+        let found = if is_fence { None } else { marker(p.rest) };
+        let Some((kind, number, digits, len)) = found.filter(|_| !crate::md::is_rule(p.rest))
+        else {
+            // text: under the item whose content it is indented to, or — with
+            // no blank line before it — the paragraph above carried on
+            if blank || !para || is_fence || breaks(p.rest) {
+                while open.len() > floor && open[open.len() - 1].content > p.indent {
+                    open.pop();
+                }
+            }
+            s.owner[row] = open.last().map(|o| o.last);
+            if is_fence {
+                fence = Some(s.owner[row]);
+            }
+            para = !is_fence && !breaks(p.rest);
+            blank = false;
+            continue;
+        };
+        while open.len() > floor && open[open.len() - 1].indent > p.indent {
+            open.pop();
+        }
+        let was = prior.get(row).copied().flatten();
+        let sibling = open.len() > floor && open[open.len() - 1].indent == p.indent;
+        let joins = sibling && {
+            let o = &open[open.len() - 1];
+            o.kind == kind
+                && match (kind, blank, o.prior, was) {
+                    (Kind::Bullet(_), ..) | (_, false, ..) => true,
+                    (_, _, Some(a), Some(b)) => a == b,
+                    _ => number == o.number + 1 || number == o.number,
+                }
+        };
+        if sibling && !joins {
+            open.pop();
+        }
+        if !joins {
+            s.lists.push(Vec::new());
+            open.push(Open {
+                id: s.lists.len() - 1,
+                quote: p.quote,
+                indent: p.indent,
+                kind,
+                last: row,
+                content: 0,
+                number,
+                prior: None,
+            });
+        }
+        let at = open.len() - 1;
+        s.owner[row] = at.checked_sub(1).map(|up| open[up].last);
+        let o = &mut open[at];
+        o.last = row;
+        o.content = p.indent + len;
+        o.number = number;
+        o.prior = was.or(o.prior);
+        s.lists[o.id].push(row);
+        s.items[row] = Some(Item {
+            quote: p.quote,
+            lead: p.lead,
+            mark: p.mark,
+            indent: p.indent,
+            content: p.indent + len,
+            kind,
+            number,
+            digits: p.mark..p.mark + digits,
+            list: o.id,
+        });
+        blank = false;
+        para = true;
+    }
+    s
+}
+
+impl Scan {
+    fn list_of(&self, row: usize) -> Option<usize> {
+        self.items.get(row)?.as_ref().map(|i| i.list)
+    }
+
+    fn number(&self, row: usize) -> u64 {
+        self.items[row].as_ref().map_or(0, |i| i.number)
+    }
+
+    fn ordered(&self, list: usize) -> bool {
+        self.lists[list]
+            .first()
+            .and_then(|r| self.items[*r].as_ref())
+            .is_some_and(|i| matches!(i.kind, Kind::Ordered(_)))
+    }
+
+    /// The number a list starts at, and whether it gives every item that
+    /// same number: two or more of them, since one item says nothing.
+    fn style(&self, list: usize) -> (u64, bool) {
+        let rows = &self.lists[list];
+        let start = self.number(rows[0]);
+        let same = rows.len() > 1 && rows.iter().all(|r| self.number(*r) == start);
+        (start, same)
+    }
+
+    /// Whether `row` hangs, however far down, off the item on `top`.
+    fn under(&self, row: usize, top: usize) -> bool {
+        let mut at = self.owner[row];
+        while let Some(up) = at {
+            if up == top {
+                return true;
+            }
+            at = self.owner[up];
+        }
+        false
+    }
+
+    /// One past the last row nested under the item on `row`. Blank lines
+    /// inside it count; the ones after it do not.
+    fn subtree_end(&self, lines: &[String], row: usize) -> usize {
+        let mut end = row + 1;
+        for (next, line) in lines.iter().enumerate().skip(row + 1) {
+            if self.under(next, row) {
+                end = next + 1;
+            } else if !line.trim().is_empty() {
+                break;
+            }
+        }
+        end
+    }
+
+    /// The item `row` would nest under: the one before it at its own level,
+    /// with nothing but that item's own lines between the two.
+    fn item_above(&self, lines: &[String], row: usize) -> Option<usize> {
+        let near = (0..row).rev().find(|r| !lines[*r].trim().is_empty())?;
+        let mut at = match self.items[near] {
+            Some(_) => Some(near),
+            None => self.owner[near],
+        };
+        while let Some(up) = at {
+            if self.owner[up] == self.owner[row] {
+                return Some(up);
+            }
+            at = self.owner[up];
+        }
+        None
+    }
+}
+
+/// The rows an edit did not touch: the lines the two buffers open with and
+/// the lines they end with, matched to where each was before.
+pub fn kept_rows(before: &[String], after: &[String]) -> Vec<Option<Origin>> {
+    let most = before.len().min(after.len());
+    let head = (0..most).take_while(|i| before[*i] == after[*i]).count();
+    let tail = (0..most - head)
+        .take_while(|i| before[before.len() - 1 - i] == after[after.len() - 1 - i])
+        .count();
+    (0..after.len())
+        .map(|row| {
+            let row = if row < head {
+                row
+            } else if row >= after.len() - tail {
+                row + before.len() - after.len()
+            } else {
+                return None;
+            };
+            Some(Origin { row, moved: false })
+        })
+        .collect()
+}
+
+/// The lines of `after` whose numbers an edit left wrong, rewritten. A list
+/// is touched only when it is not, item for item, a list `before` had; it is
+/// then counted from the number it started at before the edit, or given the
+/// one number its every item had. A list of nothing but moved items starts at
+/// `fresh` when that is set (an item nested under another starts a list of
+/// its own), and one of nothing but new lines — a paste into the open — is
+/// left as it came.
+pub fn renumber(
+    before: &[String],
+    after: &[String],
+    origins: &[Option<Origin>],
+    fresh: Option<u64>,
+) -> Vec<(usize, String)> {
+    let pre = scan(before, &[]);
+    let prior = priors(&pre, origins);
+    let post = scan(after, &prior);
+    let from = |row: usize, moved: bool| {
+        let o = origins.get(row).copied().flatten()?;
+        let list = pre.list_of(o.row).filter(|l| pre.ordered(*l))?;
+        (o.moved == moved).then_some((o.row, list))
+    };
+    let mut out = Vec::new();
+    for (id, rows) in post.lists.iter().enumerate() {
+        if !post.ordered(id) {
+            continue;
+        }
+        let stayed: Vec<usize> = rows
+            .iter()
+            .filter_map(|r| Some(from(*r, false)?.0))
+            .collect();
+        if stayed.len() == rows.len()
+            && pre
+                .list_of(stayed[0])
+                .is_some_and(|l| pre.lists[l] == stayed)
+        {
+            continue;
+        }
+        let (start, same) = if let Some((_, list)) = rows.iter().find_map(|r| from(*r, false)) {
+            pre.style(list)
+        } else if let Some((_, list)) = rows.iter().find_map(|r| from(*r, true)) {
+            let (start, same) = pre.style(list);
+            (if same { start } else { fresh.unwrap_or(start) }, same)
+        } else {
+            continue;
+        };
+        for (i, row) in rows.iter().enumerate() {
+            let want = if same { start } else { start + i as u64 };
+            let Some(item) = &post.items[*row] else {
+                continue;
+            };
+            if item.number != want {
+                let mut line = after[*row].clone();
+                line.replace_range(item.digits.clone(), &want.to_string());
+                out.push((*row, line));
+            }
+        }
+    }
+    out
+}
+
+/// For each row now, the list its line was in before the edit, if the edit
+/// left that line where it was.
+fn priors(pre: &Scan, origins: &[Option<Origin>]) -> Vec<Option<usize>> {
+    origins
+        .iter()
+        .map(|o| o.filter(|o| !o.moved).and_then(|o| pre.list_of(o.row)))
+        .collect()
+}
+
+/// Tab and Shift+Tab on rows `from..=to`: each item among them goes one
+/// level in, under the item above it, or one level out, beside its parent.
+/// What is nested under an item goes with it, and the numbers of every list
+/// that gained or lost an item follow. `None` when no row is a list item;
+/// otherwise the lines that changed, which is none when there was nowhere
+/// to go.
+pub fn shift(
+    lines: &[String],
+    from: usize,
+    to: usize,
+    out: bool,
+    tab_width: usize,
+) -> Option<Vec<(usize, String)>> {
+    let pre = scan(lines, &[]);
+    if !(from..=to).any(|r| pre.list_of(r).is_some()) {
+        return None;
+    }
+    // a note that nests with tabs goes on doing so
+    let tabs = pre
+        .items
+        .iter()
+        .zip(lines)
+        .any(|(i, l)| i.as_ref().is_some_and(|i| l[i.lead..i.mark].contains('\t')));
+    let mut work = lines.to_vec();
+    let mut origins: Vec<Option<Origin>> = (0..lines.len())
+        .map(|row| Some(Origin { row, moved: false }))
+        .collect();
+    let mut row = from;
+    while row <= to {
+        // scanned afresh: the item before this one may just have moved
+        let s = scan(&work, &priors(&pre, &origins));
+        let Some(item) = &s.items[row] else {
+            row += 1;
+            continue;
+        };
+        let end = s.subtree_end(&work, row);
+        let indent = if out {
+            outdent(&s, &work, row, tab_width)
+        } else {
+            nest(&s, &work, row, tab_width, tabs)
+        };
+        if let Some(indent) = indent {
+            let old = work[row][item.lead..item.mark].to_string();
+            for (r, line) in work.iter_mut().enumerate().take(end).skip(row) {
+                if let Some(moved) = reindent(line, item, &old, &indent, r == row) {
+                    *line = moved;
+                }
+            }
+            origins[row] = Some(Origin { row, moved: true });
+            // what is under it went with it
+            row = end;
+        } else {
+            row += 1;
+        }
+    }
+    for (r, line) in renumber(lines, &work, &origins, Some(1)) {
+        work[r] = line;
+    }
+    Some(
+        work.into_iter()
+            .enumerate()
+            .filter(|(r, line)| lines[*r] != *line)
+            .collect(),
+    )
+}
+
+/// The indentation that puts the item on `row` under the item above it: that
+/// item's other children's if it has any, else `tab_width` further in than
+/// the item itself — but never short of its text, where a marker would still
+/// read as its sibling, nor so far past it as to read as code.
+fn nest(s: &Scan, lines: &[String], row: usize, tab_width: usize, tabs: bool) -> Option<String> {
+    let item = s.items[row].as_ref()?;
+    let above = s.item_above(lines, row)?;
+    let parent = s.items[above].as_ref()?;
+    if parent.quote != item.quote {
+        return None;
+    }
+    let child = (above + 1..row).rev().find_map(|r| {
+        let c = s.items[r].as_ref()?;
+        (s.owner[r] == Some(above) && c.quote == item.quote).then(|| &lines[r][c.lead..c.mark])
+    });
+    let indent = match child {
+        Some(indent) => indent.to_string(),
+        None if tabs => format!("{}\t", &lines[above][parent.lead..parent.mark]),
+        None => " ".repeat((parent.indent + tab_width).clamp(parent.content, parent.content + 3)),
+    };
+    (width(&indent) > item.indent).then_some(indent)
+}
+
+/// The indentation that puts the item on `row` beside its parent, or one
+/// step back when it is indented under nothing.
+fn outdent(s: &Scan, lines: &[String], row: usize, tab_width: usize) -> Option<String> {
+    let item = s.items[row].as_ref()?;
+    let parent = s.owner[row]
+        .and_then(|up| Some((up, s.items[up].as_ref()?)))
+        .filter(|(_, p)| p.quote == item.quote);
+    if let Some((up, p)) = parent {
+        return Some(lines[up][p.lead..p.mark].to_string());
+    }
+    let old = &lines[row][item.lead..item.mark];
+    if old.is_empty() {
+        None
+    } else if let Some(rest) = old.strip_prefix('\t') {
+        Some(rest.to_string())
+    } else {
+        Some(" ".repeat(item.indent.saturating_sub(tab_width)))
+    }
+}
+
+/// `line`, a row of the item's subtree, moved as far as the item itself is
+/// moving: from `old` indentation to `new`. `None` for a line that stays —
+/// a blank one, or text no further in than the item, which carries its
+/// paragraph on from wherever it stands.
+fn reindent(line: &str, item: &Item, old: &str, new: &str, own: bool) -> Option<String> {
+    let p = parts(line);
+    // a quote inside the item moves by the space before its `>`
+    let (lead, mark, cols) = if p.quote == item.quote {
+        (p.lead, p.mark, p.indent)
+    } else if item.quote.1 == 0 {
+        let first = line.len() - line.trim_start_matches([' ', '\t']).len();
+        (0, first, p.quote.0)
+    } else {
+        return None;
+    };
+    if !own && (line.trim().is_empty() || cols <= item.indent) {
+        return None;
+    }
+    let indent = match line[lead..mark].strip_prefix(old) {
+        Some(deeper) => format!("{new}{deeper}"),
+        None => " ".repeat((cols + width(new)).saturating_sub(item.indent)),
+    };
+    Some(format!("{}{indent}{}", &line[..lead], &line[mark..]))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lines(text: &str) -> Vec<String> {
+        text.lines().map(String::from).collect()
+    }
+
+    /// `after` with the numbers an ordinary edit from `before` left wrong
+    /// put right.
+    fn fixed(before: &str, after: &str) -> String {
+        let (before, mut after) = (lines(before), lines(after));
+        let origins = kept_rows(&before, &after);
+        for (row, line) in renumber(&before, &after, &origins, None) {
+            after[row] = line;
+        }
+        after.join("\n")
+    }
+
+    fn shifted(text: &str, from: usize, to: usize, out: bool) -> Option<String> {
+        let mut all = lines(text);
+        for (row, line) in shift(&all, from, to, out, 2)? {
+            all[row] = line;
+        }
+        Some(all.join("\n"))
+    }
+
+    #[test]
+    fn a_list_that_gained_or_lost_an_item_counts_on_from_its_start() {
+        assert_eq!(
+            fixed("1. a\n2. b", "1. a\n2. b\n1. x\n2. y"),
+            "1. a\n2. b\n3. x\n4. y"
+        );
+        assert_eq!(fixed("1. a\n2. b\n3. c", "1. a\n3. c"), "1. a\n2. c");
+        // the start is the list's own, whichever item now comes first
+        assert_eq!(fixed("5. a\n6. b\n7. c", "6. b\n7. c"), "5. b\n6. c");
+        assert_eq!(
+            fixed("1. a\n2. b", "1. x\n2. y\n1. a\n2. b"),
+            "1. x\n2. y\n3. a\n4. b"
+        );
+        // a wider number keeps its punctuation
+        assert_eq!(
+            fixed("9) a\n10) b", "9) a\n10) \n10) b"),
+            "9) a\n10) \n11) b"
+        );
+    }
+
+    #[test]
+    fn only_the_list_that_changed_is_renumbered() {
+        // a list further down, wrong numbers and all, is not this edit's
+        let rest = "\n\ntext\n\n4. x\n9. y";
+        assert_eq!(
+            fixed(
+                &format!("1. a\n2. b{rest}"),
+                &format!("1. a\n2. \n2. b{rest}")
+            ),
+            format!("1. a\n2. \n3. b{rest}")
+        );
+        // nor is one under a blank line that starts its count over
+        assert_eq!(
+            fixed("1. a\n2. b\n\n1. x\n2. y", "1. a\n2. \n2. b\n\n1. x\n2. y"),
+            "1. a\n2. \n3. b\n\n1. x\n2. y"
+        );
+        // a nested list and the one around it keep to themselves
+        assert_eq!(
+            fixed(
+                "1. a\n   1. x\n   2. y\n2. b",
+                "1. a\n   1. x\n   2. \n   2. y\n2. b"
+            ),
+            "1. a\n   1. x\n   2. \n   3. y\n2. b"
+        );
+        assert_eq!(
+            fixed(
+                "1. a\n   3. x\n   7. y\n2. b",
+                "1. a\n   3. x\n   7. y\n2. \n2. b"
+            ),
+            "1. a\n   3. x\n   7. y\n2. \n3. b"
+        );
+        // and a list pasted where there was none is left as it was copied
+        assert_eq!(
+            fixed("text\n", "text\n6. a\n7. b\n1. c"),
+            "text\n6. a\n7. b\n1. c"
+        );
+    }
+
+    #[test]
+    fn a_loose_list_is_one_list_across_its_blank_lines() {
+        assert_eq!(
+            fixed("1. a\n\n2. b\n\n3. c", "1. a\n\n3. c"),
+            "1. a\n\n2. c"
+        );
+        assert_eq!(
+            fixed("1. a\n\n   more\n\n2. b", "1. a\n2. \n\n   more\n\n2. b"),
+            "1. a\n2. \n\n   more\n\n3. b"
+        );
+        // text that carries an item's paragraph on does not end the list
+        assert_eq!(
+            fixed("1. a\nmore\n2. b\n3. c", "1. a\nmore\n3. c"),
+            "1. a\nmore\n2. c"
+        );
+        // a heading does
+        assert_eq!(
+            fixed("1. a\n# h\n4. b\n5. c", "1. a\n1. \n# h\n4. b\n5. c"),
+            "1. a\n2. \n# h\n4. b\n5. c"
+        );
+    }
+
+    #[test]
+    fn a_list_numbered_all_alike_stays_that_way() {
+        assert_eq!(
+            fixed("1. a\n1. b\n1. c", "1. a\n2. \n1. b\n1. c"),
+            "1. a\n1. \n1. b\n1. c"
+        );
+        assert_eq!(fixed("1. a\n1. b\n1. c", "1. a\n1. c"), "1. a\n1. c");
+        assert_eq!(
+            fixed("1. a\n1. b", "1. a\n1. b\n1. x\n2. y"),
+            "1. a\n1. b\n1. x\n1. y"
+        );
+        // one item is not a pattern
+        assert_eq!(fixed("1. a", "1. a\n1. b"), "1. a\n2. b");
+    }
+
+    #[test]
+    fn code_front_matter_and_quotes_are_told_apart() {
+        let fenced = "\n```\n3. x\n4. y\n```";
+        assert_eq!(
+            fixed(&format!("1. a\n2. b{fenced}"), &format!("2. b{fenced}")),
+            format!("1. b{fenced}")
+        );
+        let front = "---\ntags:\n---\n";
+        assert_eq!(
+            fixed(&format!("{front}1. a\n2. b"), &format!("{front}2. b")),
+            format!("{front}1. b")
+        );
+        assert_eq!(
+            fixed("> 1. a\n> 2. b\n> 3. c", "> 1. a\n> 3. c"),
+            "> 1. a\n> 2. c"
+        );
+        assert_eq!(
+            fixed("> 1. a\n\n3. c\n4. d", "> 1. a\n> 2. \n\n3. c\n4. d"),
+            "> 1. a\n> 2. \n\n3. c\n4. d"
+        );
+    }
+
+    #[test]
+    fn tab_nests_an_item_under_the_one_above_with_all_it_carries() {
+        assert_eq!(
+            shifted("1. a\n2. b\n3. c", 1, 1, false).unwrap(),
+            "1. a\n   1. b\n2. c"
+        );
+        // its own nested lines go along, and it joins the children already there
+        assert_eq!(
+            shifted(
+                "1. a\n   1. x\n2. b\n   - y\n\n     more\n3. c",
+                2,
+                2,
+                false
+            )
+            .unwrap(),
+            "1. a\n   1. x\n   2. b\n      - y\n\n        more\n2. c"
+        );
+        // under a bullet two columns are enough
+        assert_eq!(shifted("- a\n- b", 1, 1, false).unwrap(), "- a\n  - b");
+        // a note that nests with tabs keeps to tabs
+        assert_eq!(
+            shifted("1. a\n\t1. x\n2. b\n3. c", 3, 3, false).unwrap(),
+            "1. a\n\t1. x\n2. b\n\t1. c"
+        );
+        // several at once land in one list
+        assert_eq!(
+            shifted("1. a\n2. b\n3. c\n4. d", 1, 2, false).unwrap(),
+            "1. a\n   1. b\n   2. c\n2. d"
+        );
+        // the first item has nothing to go under, and plain text is not a list
+        assert_eq!(shifted("1. a\n2. b", 0, 0, false).unwrap(), "1. a\n2. b");
+        assert_eq!(
+            shifted("text\n\n1. a", 2, 2, false).unwrap(),
+            "text\n\n1. a"
+        );
+        assert!(shifted("text", 0, 0, false).is_none());
+    }
+
+    #[test]
+    fn shift_tab_brings_an_item_back_out_beside_its_parent() {
+        assert_eq!(
+            shifted("1. a\n   1. b\n2. c", 1, 1, true).unwrap(),
+            "1. a\n2. b\n3. c"
+        );
+        // the items after it in the old list are now its own
+        assert_eq!(
+            shifted(
+                "1. a\n   1. x\n   2. y\n      - deep\n   3. z\n2. b",
+                2,
+                2,
+                true
+            )
+            .unwrap(),
+            "1. a\n   1. x\n2. y\n   - deep\n   1. z\n3. b"
+        );
+        assert_eq!(shifted("1. a\n2. b", 1, 1, true).unwrap(), "1. a\n2. b");
+        // lists numbered alike come through either way untouched
+        assert_eq!(
+            shifted("1. a\n1. b\n1. c", 1, 1, false).unwrap(),
+            "1. a\n   1. b\n1. c"
+        );
+        assert_eq!(
+            shifted("1. a\n   1. b\n1. c\n1. d", 1, 1, true).unwrap(),
+            "1. a\n1. b\n1. c\n1. d"
+        );
+    }
+}
