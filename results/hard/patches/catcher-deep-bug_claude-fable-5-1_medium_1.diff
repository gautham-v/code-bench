+/// Fold an already-rendered page the way the editor folds its buffer: every
+/// row drawn from a line `visible` hides is dropped, and each heading in
+/// `folded` gets the editor's marker in front.
+///
+/// A row the renderer invented has no source line to ask about, so it goes
+/// the way of the rows around it: the blank line between a folded heading and
+/// its first paragraph leaves with the paragraph, and the one above the next
+/// heading stays, so the page keeps the spacing it had.
+pub fn fold_page(r: &mut Rendered, visible: &crate::fold::Visible, folded: &[usize]) {
+    if visible.is_plain() {
+        return;
+    }
+    let state: Vec<Option<bool>> = r
+        .lines
+        .iter()
+        .map(|l| l.src_line.map(|s| visible.is_hidden(s)))
+        .collect();
+    let mut keep = vec![true; state.len()];
+    let mut before = None;
+    for i in 0..state.len() {
+        match state[i] {
+            Some(hidden) => {
+                keep[i] = !hidden;
+                before = Some(hidden);
+            }
+            None => {
+                let after = state[i + 1..].iter().find_map(|s| *s);
+                keep[i] = match (before, after) {
+                    (_, Some(true)) => false,
+                    // out of a fold: only the gap right above what follows
+                    (Some(true), Some(false)) => {
+                        state[i + 1].is_some() && r.lines[i].cells.is_empty()
+                    }
+                    (Some(true), None) => false,
+                    _ => true,
+                };
+            }
+        }
+    }
+    let mut keep = keep.into_iter();
+    r.lines.retain(|_| keep.next().unwrap_or(true));
+    let mut marked = None;
+    for line in &mut r.lines {
+        let Some(src) = line.src_line.filter(|s| folded.contains(s)) else {
+            continue;
+        };
+        // a heading is one line of source but may be several rows of page
+        if marked != Some(src) {
+            marked = Some(src);
+            let mut cells = str_cells(theme::FOLDED, theme::fold());
+            cells.append(&mut line.cells);
+            line.cells = cells;
+        }
+    }
