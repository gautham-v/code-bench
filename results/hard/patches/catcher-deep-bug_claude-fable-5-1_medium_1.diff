+/// The line of `lines` a search hit meant: `line` itself while it still reads
+/// as `text` did, else the nearest line that does, else `line` as it was.
+/// Compared trimmed, as the hit was shown.
+fn line_reading(lines: &[String], text: &str, line: usize) -> usize {
+    let want = text.trim();
+    let reads = |i: &usize| lines.get(*i).is_some_and(|l| l.trim() == want);
+    if reads(&line) {
+        return line;
+    }
+    (0..lines.len())
+        .filter(reads)
+        .min_by_key(|&i| i.abs_diff(line))
+        .unwrap_or(line)
+}
