+/// Past this many cells the line-up of two buffers is not worth its table,
+/// and only the lines the two share at their ends are matched.
+const MAX_ALIGN_CELLS: usize = 4_000_000;
+
+/// For every line of `old`, the line of `new` it survived as, or `None` for
+/// one the rewrite removed or changed. The shared head and tail are matched
+/// outright and the middle by longest common subsequence, so lines keep their
+/// order and a repeated line is matched to the copy in the same place.
+fn line_map(old: &[String], new: &[String]) -> Vec<Option<usize>> {
+    let mut map = vec![None; old.len()];
+    let mut head = 0;
+    while head < old.len() && head < new.len() && old[head] == new[head] {
+        map[head] = Some(head);
+        head += 1;
+    }
+    let mut tail = 0;
+    while tail < old.len() - head
+        && tail < new.len() - head
+        && old[old.len() - 1 - tail] == new[new.len() - 1 - tail]
+    {
+        map[old.len() - 1 - tail] = Some(new.len() - 1 - tail);
+        tail += 1;
+    }
+    let a = &old[head..old.len() - tail];
+    let b = &new[head..new.len() - tail];
+    if a.is_empty() || b.is_empty() || a.len().saturating_mul(b.len()) > MAX_ALIGN_CELLS {
+        return map;
+    }
+    // lcs[i][j]: the longest common subsequence of a[i..] and b[j..]
+    let w = b.len() + 1;
+    let mut lcs = vec![0u32; (a.len() + 1) * w];
+    for i in (0..a.len()).rev() {
+        for j in (0..b.len()).rev() {
+            lcs[i * w + j] = if a[i] == b[j] {
+                lcs[(i + 1) * w + j + 1] + 1
+            } else {
+                lcs[(i + 1) * w + j].max(lcs[i * w + j + 1])
+            };
+        }
+    }
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() && j < b.len() {
+        if a[i] == b[j] {
+            map[head + i] = Some(head + j);
+            i += 1;
+            j += 1;
+        } else if lcs[(i + 1) * w + j] >= lcs[i * w + j + 1] {
+            i += 1;
+        } else {
+            j += 1;
+        }
+    }
+    map
+}
