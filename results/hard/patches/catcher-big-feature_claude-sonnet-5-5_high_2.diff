+        let mut e = at("1. a\n2. b\n3. c", 2, 0);
+        assert!(e.move_selected_lines(false));
+        assert_eq!(e.text(), "1. a\n2. c\n3. b");
+        assert!(e.move_selected_lines(false));
+        assert_eq!(e.text(), "1. c\n2. a\n3. b");
+        assert!(e.undo());
+        assert_eq!(e.text(), "1. a\n2. c\n3. b");
+    }
+
+    #[test]
+    fn lists_numbered_alike_and_other_lists_are_left_alone() {
+        let mut e = at("1. a\n1. b\n1. c", 0, 4);
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n1. \n1. b\n1. c");
+        let mut e = at("1. a\n1. b\n1. c", 1, 0);
+        e.anchor = Some((2, 0));
+        e.delete_selection();
+        assert_eq!(e.text(), "1. a\n1. c");
+        let text = "1. a\n3. b\n\ntext\n\n5. x\n9. y\n\n- 4. z";
+        let mut e = at(text, 0, 4);
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n2. \n3. b\n\ntext\n\n5. x\n9. y\n\n- 4. z");
+    }
+
+    #[test]
+    fn numbers_follow_only_their_own_level() {
+        let mut e = at("1. a\n   1. x\n   2. y\n2. b\n3. c", 3, 0);
+        e.anchor = Some((4, 0));
+        e.delete_selection();
+        assert_eq!(e.text(), "1. a\n   1. x\n   2. y\n2. c");
+        let mut e = at("1. a\n   1. x\n   2. y\n2. b", 1, 7);
+        e.insert_newline_continuing_list();
+        assert_eq!(e.text(), "1. a\n   1. x\n   2. \n   3. y\n2. b");
+    }
+
+    #[test]
+    fn tab_nests_an_item_under_the_one_above_with_its_children() {
+        let mut e = at("1. a\n2. b\n   - x\n3. c", 1, 3);
+        assert!(tab(&mut e, false));
+        assert_eq!(e.text(), "1. a\n   1. b\n      - x\n2. c");
+        assert_eq!(e.cursor, (1, 6));
+        assert!(tab(&mut e, true));
+        assert_eq!(e.text(), "1. a\n2. b\n   - x\n3. c");
+        assert_eq!(e.cursor, (1, 3));
+        // joins an existing child list
+        let mut e = at("1. a\n   1. x\n2. b\n3. c", 2, 0);
+        tab(&mut e, false);
+        assert_eq!(e.text(), "1. a\n   1. x\n   2. b\n2. c");
+        // the first item cannot nest; a non-list line still gets spaces
+        let mut e = at("1. a\n2. b", 0, 0);
+        assert!(!tab(&mut e, false));
+        assert_eq!(e.text(), "1. a\n2. b");
+        let mut e = at("plain", 0, 0);
+        tab(&mut e, false);
+        assert_eq!(e.text(), "  plain");
+    }
+
+    #[test]
+    fn shift_tab_hands_the_following_siblings_a_fresh_count() {
+        let mut e = at("1. a\n   1. b\n   2. c\n   3. d\n2. e", 2, 5);
+        assert!(tab(&mut e, true));
+        assert_eq!(e.text(), "1. a\n   1. b\n2. c\n   1. d\n3. e");
+        assert!(!tab(&mut e, true) || e.text().starts_with("1. a"));
+    }
+
+    #[test]
+    fn tab_on_a_selection_nests_every_selected_item() {
+        let mut e = at("1. a\n2. b\n3. c\n4. d", 1, 0);
+        e.anchor = Some((1, 0));
+        e.cursor = (2, 4);
+        assert!(tab(&mut e, false));
+        assert_eq!(e.text(), "1. a\n   1. b\n   2. c\n2. d");
+    }
