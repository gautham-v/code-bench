+/// An ordered list marker at the start of a line: `3. ` or `3) `, indent first.
+struct Ordered {
+    /// Bytes of leading whitespace.
+    ws: usize,
+    /// Digits in the number.
+    digits: usize,
+    num: u64,
+    delim: char,
+}
+
+fn ordered_item(line: &str) -> Option<Ordered> {
+    let ws = line.len() - line.trim_start_matches([' ', '\t']).len();
+    let rest = &line[ws..];
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    if digits == 0 || digits > 9 {
+        return None;
+    }
+    let after = &rest[digits..];
+    let delim = after.chars().next().filter(|c| matches!(c, '.' | ')'))?;
+    after[1..].strip_prefix(' ')?;
+    Some(Ordered {
+        ws,
+        digits,
+        num: rest[..digits].parse().ok()?,
+        delim,
+    })
+}
+
+/// Bytes from the start of `line` to the text of its list item, if it is one.
+fn item_marker_len(line: &str) -> Option<usize> {
+    if let Some(o) = ordered_item(line) {
+        return Some(o.ws + o.digits + 2);
+    }
+    let ws = line.len() - line.trim_start_matches([' ', '\t']).len();
+    let rest = &line[ws..];
+    (rest.starts_with(['-', '*', '+']) && rest[1..].starts_with(' ')).then_some(ws + 2)
+}
+
+fn is_blank(line: &str) -> bool {
+    line.trim().is_empty()
+}
+
+/// Display columns of leading whitespace; a tab counts four.
+fn indent_width(line: &str) -> usize {
+    line.chars()
+        .take_while(|c| matches!(c, ' ' | '\t'))
+        .map(|c| if c == '\t' { 4 } else { 1 })
+        .sum()
+}
+
+/// The next (or previous) item of the list the ordered item at `from` is in:
+/// same indent, same delimiter. Deeper lines and blank lines in between belong
+/// to the item; anything else at its indent, or shallower, ends the list.
+fn sibling(lines: &[String], from: usize, down: bool) -> Option<usize> {
+    let me = ordered_item(&lines[from])?;
+    let w = indent_width(&lines[from]);
+    let mut k = from;
+    loop {
+        k = if down { k + 1 } else { k.checked_sub(1)? };
+        let line = lines.get(k)?;
+        if is_blank(line) {
+            continue;
+        }
+        let lw = indent_width(line);
+        if lw > w {
+            continue;
+        }
+        if lw < w {
+            return None;
+        }
+        return ordered_item(line)
+            .filter(|o| o.delim == me.delim)
+            .map(|_| k);
+    }
+}
+
+/// The rows of the list the ordered item at `row` belongs to, top to bottom.
+fn list_items(lines: &[String], row: usize) -> Vec<usize> {
+    if lines.get(row).and_then(|l| ordered_item(l)).is_none() {
+        return Vec::new();
+    }
+    let mut first = row;
+    while let Some(up) = sibling(lines, first, false) {
+        first = up;
+    }
+    let mut items = vec![first];
+    while let Some(next) = sibling(lines, *items.last().unwrap(), true) {
+        items.push(next);
+    }
+    items
+}
+
+/// Whether a list numbers every item alike (`1.` `1.` `1.`), on purpose. The
+/// rows in `fresh` are the ones just inserted or moved in: their numbers say
+/// nothing about how the list was meant to be numbered.
+fn numbered_alike(lines: &[String], items: &[usize], fresh: &[usize]) -> bool {
+    let nums: Vec<u64> = items
+        .iter()
+        .filter(|r| !fresh.contains(r))
+        .filter_map(|&r| ordered_item(&lines[r]).map(|o| o.num))
+        .collect();
+    nums.len() >= 2 && nums.iter().all(|n| *n == nums[0])
+}
+
+/// Number the list the item at `row` is in one, two, three… from `start` (its
+/// own first number when `None`). A list that numbers every item alike is
+/// left as it is. Returns `(row, change in marker length, char column where the
+/// number ended)` for each line rewritten.
+fn renumber_list(
+    lines: &mut [String],
+    row: usize,
+    start: Option<u64>,
+    fresh: &[usize],
+) -> Vec<(usize, isize, usize)> {
+    let items = list_items(lines, row);
+    if items.is_empty() || numbered_alike(lines, &items, fresh) {
+        return Vec::new();
+    }
+    let first = ordered_item(&lines[items[0]]).map_or(1, |o| o.num);
+    let start = start.unwrap_or(first);
+    let mut changes = Vec::new();
+    for (k, &r) in items.iter().enumerate() {
+        let Some(o) = ordered_item(&lines[r]) else {
+            continue;
+        };
+        let want = start + k as u64;
+        if want == o.num {
+            continue;
+        }
+        let from = o.ws;
+        let to = o.ws + o.digits;
+        let end_col = lines[r][..to].chars().count();
+        let new = want.to_string();
+        let delta = new.len() as isize - o.digits as isize;
+        lines[r].replace_range(from..to, &new);
+        changes.push((r, delta, end_col));
+    }
+    changes
+}
+
+/// The ordered markers on `lines`, as (indent, number, delimiter).
+fn ordered_markers(lines: &[String]) -> Vec<(usize, u64, char)> {
+    lines
+        .iter()
+        .filter_map(|l| ordered_item(l).map(|o| (indent_width(l), o.num, o.delim)))
+        .collect()
+}
+
+/// The last row of the item at `row`: itself and every deeper line under it.
+fn subtree_end(lines: &[String], row: usize) -> usize {
+    let w = indent_width(&lines[row]);
+    let mut end = row;
+    for (k, line) in lines.iter().enumerate().skip(row + 1) {
+        if is_blank(line) {
+            continue;
+        }
+        if indent_width(line) <= w {
+            break;
+        }
+        end = k;
+    }
+    end
+}
+
+/// Take `cols` columns of leading whitespace off `line`.
+fn dedent(line: &str, cols: usize) -> (String, usize) {
+    let mut left = cols;
+    let mut removed = 0;
+    let mut chars = line.chars().peekable();
+    while left > 0 {
+        let step = match chars.peek() {
+            Some(' ') => 1,
+            Some('\t') => 4,
+            _ => break,
+        };
+        chars.next();
+        removed += 1;
+        left = left.saturating_sub(step);
+    }
+    (chars.collect(), removed)
+}
