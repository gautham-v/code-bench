+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn write(dir: &Path, rel: &str, body: &str) {
+        let p = dir.join(rel);
+        std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+        std::fs::write(p, body).unwrap();
+    }
+
+    #[test]
+    fn walks_outside_git_and_skips_junk() {
+        let d = tempfile::tempdir().unwrap();
+        write(d.path(), "src/audio.rs", "");
+        write(d.path(), "README.md", "# x\n");
+        write(d.path(), "target/debug/junk.rs", "");
+        write(d.path(), "node_modules/x/index.js", "");
+        write(d.path(), ".hidden/secret.rs", "");
+        let v = build(d.path());
+        assert_eq!(v.root, d.path());
+        assert_eq!(v.files, vec!["README.md", "src/audio.rs"]);
+    }
+
+    #[test]
+    fn git_files_are_relative_to_the_session_dir() {
+        let d = tempfile::tempdir().unwrap();
+        let git = |args: &[&str]| {
+            Command::new("git")
+                .current_dir(d.path())
+                .args(args)
+                .output()
+                .map(|o| o.status.success())
+                .unwrap_or(false)
+        };
+        if !git(&["init", "-q"]) {
+            return; // no git here
+        }
+        write(d.path(), "pkg/src/lib.rs", "");
+        write(d.path(), "pkg/notes.txt", "");
+        write(d.path(), "top.rs", "");
+        write(d.path(), ".gitignore", "ignored.rs\n");
+        write(d.path(), "pkg/ignored.rs", "");
+        git(&["add", "-A"]);
+        let v = build(&d.path().join("pkg"));
+        assert_eq!(v.files, vec!["notes.txt", "src/lib.rs"]);
+    }
+
+    #[test]
+    fn words_come_from_names_and_docs() {
+        let d = tempfile::tempdir().unwrap();
+        write(d.path(), "Cargo.toml", "[package]\nname = \"squawk-core\"\n");
+        write(d.path(), "src/VocabCache.swift", "");
+        write(d.path(), "src/audio.rs", "");
+        write(d.path(), "src/Cargo.rs", "");
+        write(
+            d.path(),
+            "README.md",
+            "# squawk\n\nStores history in SQLite. Runs on your Mac with NVIDIA's Parakeet TDT \
+             model. Talk to Claude Code. Everything is local; a mac is a computer.\n\n```\nNOTE Foo\n```\n",
+        );
+        write(d.path(), "CLAUDE.md", "IMPORTANT: NEVER skip tests. Use macOS.\n");
+        let files = list_files(d.path());
+        let words = collect_words(d.path(), &files);
+        for w in [
+            "squawk-core",
+            "VocabCache",
+            "audio",
+            "SQLite",
+            "NVIDIA",
+            "Parakeet TDT",
+            "Claude Code",
+            "macOS",
+        ] {
+            assert!(words.iter().any(|x| x == w), "{w} missing from {words:?}");
+        }
+        for w in ["Cargo", "Mac", "NOTE", "IMPORTANT", "NEVER", "Everything", "Foo"] {
+            assert!(!words.iter().any(|x| x == w), "{w} should not be in {words:?}");
+        }
+    }
+
+    #[test]
+    fn cache_rebuilds_when_the_index_changes_and_not_before() {
+        let d = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(d.path().join(".git")).unwrap();
+        write(d.path(), "a.rs", "");
+        let mut cache = Cache::default();
+        let first = cache.get(d.path());
+        let again = cache.get(d.path());
+        assert!(Arc::ptr_eq(&first, &again));
+        write(d.path(), ".git/index", "changed");
+        write(d.path(), "b.rs", "");
+        let third = cache.get(d.path());
+        assert!(!Arc::ptr_eq(&first, &third));
+        assert!(third.files.contains(&"b.rs".to_string()));
+    }
+}
