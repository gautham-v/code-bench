@@ -0,0 +1,450 @@
+//! Rewriting a transcript with what the repo knows: spoken file names become
+//! `@mentions`, and repo jargon gets the spelling the repo uses.
+//!
+//! Both are conservative. A file reference is rewritten only when exactly one
+//! file in the repo fits everything that was said; otherwise the words stay.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, Weak};
+
+use crate::text::{self, Chunk};
+
+use super::{Context, RepoVocab};
+
+/// Spoken extensions that are ordinary words: "the go mod file" is not
+/// `go.mod`. These are only accepted after an explicit "dot".
+const WORDY_EXTENSIONS: &[&str] = &[
+    "go", "lock", "log", "text", "swift", "bin", "test", "spec", "map", "dev", "so", "in", "out",
+    "env", "as", "mod", "doc", "docs", "app", "sum", "old", "new", "tmp", "run", "make", "build",
+    "lib", "main", "cmd", "key", "list", "data", "src", "bak", "min", "ini",
+];
+
+/// Spoken in place of a character inside a name: "status underscore item".
+const NAME_FILLERS: &[&str] = &["underscore", "dash", "hyphen"];
+
+/// Most words a spoken name part or folder may take.
+const MAX_SPAN: usize = 6;
+
+// ---------------------------------------------------------------- index
+
+/// What `apply` looks things up in, built once per [`RepoVocab`].
+#[derive(Debug, Default)]
+pub(super) struct Index {
+    /// Normalised last name part (`rs`, `toml`, `gitignore`) → files.
+    by_last: HashMap<String, Vec<u32>>,
+    /// Spoken form (`git hub`, `githubs`) → written form; `None` when two
+    /// words claim the same spoken form.
+    jargon: HashMap<String, Option<String>>,
+    /// Most words in a jargon entry.
+    max_words: usize,
+}
+
+type Slot = (Weak<RepoVocab>, Arc<Index>);
+
+static INDEXES: Mutex<Vec<Slot>> = Mutex::new(Vec::new());
+
+/// The index for `vocab`, built on first use and remembered while the vocab
+/// is alive.
+pub(super) fn index_for(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+    let weak = Arc::downgrade(vocab);
+    {
+        let slots = INDEXES.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some((_, idx)) = slots.iter().find(|(w, _)| Weak::ptr_eq(w, &weak)) {
+            return idx.clone();
+        }
+    }
+    let idx = Arc::new(Index::build(vocab));
+    let mut slots = INDEXES.lock().unwrap_or_else(|e| e.into_inner());
+    slots.retain(|(w, _)| w.strong_count() > 0);
+    if let Some((_, existing)) = slots.iter().find(|(w, _)| Weak::ptr_eq(w, &weak)) {
+        return existing.clone();
+    }
+    if slots.len() >= 8 {
+        slots.remove(0);
+    }
+    slots.push((weak, idx.clone()));
+    idx
+}
+
+/// Build the index ahead of the first `apply`.
+pub(super) fn warm(vocab: &Arc<RepoVocab>) {
+    let _ = index_for(vocab);
+}
+
+impl Index {
+    fn build(vocab: &RepoVocab) -> Index {
+        let mut idx = Index::default();
+        for (i, file) in vocab.files.iter().enumerate() {
+            if let Some(name) = NameParts::of(base_name(file)) {
+                idx.by_last
+                    .entry(name.groups.last().cloned().unwrap_or_default())
+                    .or_default()
+                    .push(i as u32);
+            }
+        }
+        for word in &vocab.words {
+            idx.add_jargon(word);
+        }
+        idx
+    }
+
+    fn add_jargon(&mut self, word: &str) {
+        let word = word.trim();
+        if !word
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, ' ' | '-' | '_'))
+        {
+            return;
+        }
+        let parts = word_parts(word);
+        let joined: String = parts.concat();
+        if joined.chars().count() < 2 {
+            return;
+        }
+        // A plain lowercase single word has nothing to fix: writing it down
+        // the way it already is would only lowercase a capital that belongs.
+        let single_plain = parts.len() == 1 && word == word.to_lowercase();
+        if single_plain {
+            return;
+        }
+        self.max_words = self.max_words.max(parts.len());
+        for key in [parts.join(" "), joined] {
+            match self.jargon.get(&key) {
+                Some(Some(w)) if w != word => {
+                    self.jargon.insert(key, None);
+                }
+                Some(_) => {}
+                None => {
+                    self.jargon.insert(key, Some(word.to_string()));
+                }
+            }
+        }
+    }
+}
+
+fn base_name(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// A file name as spoken: `status_item.rs` → groups `statusitem`, `rs`;
+/// `.gitignore` → leading dot, group `gitignore`.
+struct NameParts {
+    leading_dot: bool,
+    groups: Vec<String>,
+}
+
+impl NameParts {
+    fn of(name: &str) -> Option<NameParts> {
+        let leading_dot = name.starts_with('.');
+        let body = name.strip_prefix('.').unwrap_or(name);
+        let groups: Vec<String> = body.split('.').map(norm).collect();
+        if groups.iter().any(String::is_empty) {
+            return None;
+        }
+        // `Makefile`, `LICENSE`: nothing to say after a dot, no mention.
+        if groups.len() < 2 && !leading_dot {
+            return None;
+        }
+        Some(NameParts {
+            leading_dot,
+            groups,
+        })
+    }
+}
+
+/// Lowercase, letters and digits only.
+fn norm(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// Lowercase parts of a repo word: `VocabCache` → vocab, cache;
+/// `squawk-core` → squawk, core; `gpt5` → gpt, 5; `SQLite` → sq, lite.
+fn word_parts(word: &str) -> Vec<String> {
+    let mut parts = Vec::new();
+    for piece in word.split(|c: char| c.is_whitespace() || c == '-' || c == '_') {
+        let chars: Vec<char> = piece.chars().collect();
+        let mut cur = String::new();
+        for (i, &c) in chars.iter().enumerate() {
+            let prev = i.checked_sub(1).map(|j| chars[j]);
+            let next = chars.get(i + 1).copied();
+            let boundary = match prev {
+                None => false,
+                Some(p) => {
+                    (p.is_lowercase() && c.is_uppercase())
+                        || (p.is_alphabetic() != c.is_alphabetic() && !cur.is_empty())
+                        || (p.is_uppercase()
+                            && c.is_uppercase()
+                            && next.is_some_and(char::is_lowercase))
+                }
+            };
+            if boundary {
+                parts.push(std::mem::take(&mut cur));
+            }
+            cur.extend(c.to_lowercase());
+        }
+        if !cur.is_empty() {
+            parts.push(cur);
+        }
+    }
+    parts
+}
+
+// ---------------------------------------------------------------- apply
+
+pub(super) fn apply(text: &str, context: &Context) -> String {
+    let vocab = &context.vocab;
+    if vocab.files.is_empty() && vocab.words.is_empty() {
+        return text.to_string();
+    }
+    let index = index_for(vocab);
+    let mut toks = text::chunks(text);
+    let mut changed = mention_files(&mut toks, vocab, &index);
+    changed |= fix_jargon(&mut toks, &index);
+    if changed {
+        text::join(&toks)
+    } else {
+        text.to_string()
+    }
+}
+
+/// A plain spoken word: not an @mention, path or file name already.
+fn is_spoken(t: &Chunk) -> bool {
+    !t.is_protected()
+        && !t.core.is_empty()
+        && t.core
+            .chars()
+            .all(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '\'' | '’'))
+}
+
+/// The bare word `kw` with nothing attached.
+fn is_kw(t: &Chunk, kw: &str) -> bool {
+    t.lead.is_empty() && t.trail.is_empty() && t.core.eq_ignore_ascii_case(kw)
+}
+
+/// What a spoken token contributes to a name: its letters and digits, or
+/// nothing for "underscore"/"dash".
+fn piece(t: &Chunk) -> Option<String> {
+    if !is_spoken(t) {
+        return None;
+    }
+    if NAME_FILLERS.iter().any(|f| t.core.eq_ignore_ascii_case(f)) {
+        return Some(String::new());
+    }
+    Some(norm(&t.core))
+}
+
+/// The `k` tokens ending just before `end` that spell `target` together.
+fn spell_back(toks: &[Chunk], end: usize, target: &str) -> Option<usize> {
+    for k in 1..=MAX_SPAN.min(end) {
+        let span = &toks[end - k..end];
+        let pieces: Option<Vec<String>> = span.iter().map(piece).collect();
+        let Some(pieces) = pieces else { break };
+        if pieces.first().is_some_and(String::is_empty)
+            || pieces.last().is_some_and(String::is_empty)
+        {
+            continue;
+        }
+        if pieces.concat() == target {
+            return Some(end - k);
+        }
+    }
+    None
+}
+
+/// Where in `toks` a mention of `file` that ends at token `e` begins, if
+/// everything said fits it.
+fn match_file(toks: &[Chunk], e: usize, file: &str, dot_said: bool) -> Option<usize> {
+    let (dir, name) = match file.rsplit_once('/') {
+        Some((d, n)) => (d, n),
+        None => ("", file),
+    };
+    let parts = NameParts::of(name)?;
+    let last = parts.groups.len() - 1;
+    if *parts.groups.last()? != norm(&toks[e].core) {
+        return None;
+    }
+    let mut pos = e;
+    for g in (1..=last).rev() {
+        if dot_said {
+            if pos == 0 || !is_kw(&toks[pos - 1], "dot") {
+                return None;
+            }
+            pos -= 1;
+        } else if !(g == last && last == 1 && !parts.leading_dot) {
+            // Only "name ext" with a single extension may drop the "dot".
+            return None;
+        }
+        pos = spell_back(toks, pos, &parts.groups[g - 1])?;
+    }
+    if parts.leading_dot {
+        if pos == 0 || !is_kw(&toks[pos - 1], "dot") {
+            return None;
+        }
+        pos -= 1;
+    }
+
+    // Folders said aloud, innermost first: "context slash mod dot rs".
+    let dirs: Vec<&str> = dir.split('/').filter(|d| !d.is_empty()).collect();
+    let mut d = dirs.len();
+    while d > 0 && pos > 0 && is_kw(&toks[pos - 1], "slash") {
+        d -= 1;
+        let target = norm(dirs[d]);
+        if target.is_empty() {
+            return None;
+        }
+        let mut start = spell_back(toks, pos - 1, &target)?;
+        if dirs[d].starts_with('.') && start > 0 && is_kw(&toks[start - 1], "dot") {
+            start -= 1;
+        }
+        pos = start;
+    }
+    // A "slash" nothing here answers to: not this file.
+    if pos > 0 && is_kw(&toks[pos - 1], "slash") {
+        return None;
+    }
+
+    // One breath: no punctuation inside the span.
+    for j in pos..e {
+        if !toks[j].trail.is_empty() || !toks[j + 1].lead.is_empty() {
+            return None;
+        }
+    }
+    Some(pos)
+}
+
+fn mention_files(toks: &mut Vec<Chunk>, vocab: &RepoVocab, index: &Index) -> bool {
+    if index.by_last.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut e = 1;
+    while e < toks.len() {
+        let t = &toks[e];
+        if !is_spoken(t)
+            || !t.lead.is_empty()
+            || !t.core.chars().all(char::is_alphanumeric)
+        {
+            e += 1;
+            continue;
+        }
+        let key = norm(&t.core);
+        let Some(candidates) = index.by_last.get(&key) else {
+            e += 1;
+            continue;
+        };
+        let dot_said = is_kw(&toks[e - 1], "dot");
+        if !dot_said && (key.chars().count() < 2 || WORDY_EXTENSIONS.contains(&key.as_str())) {
+            e += 1;
+            continue;
+        }
+
+        // The fits that say the most win; two of those is no answer.
+        let mut best: Option<usize> = None;
+        let mut winners: Vec<&str> = Vec::new();
+        for &i in candidates {
+            let file = vocab.files[i as usize].as_str();
+            let Some(start) = match_file(toks, e, file, dot_said) else {
+                continue;
+            };
+            match best {
+                Some(b) if start > b => {}
+                Some(b) if start == b => winners.push(file),
+                _ => {
+                    best = Some(start);
+                    winners.clear();
+                    winners.push(file);
+                }
+            }
+        }
+        let (Some(start), [file]) = (best, winners.as_slice()) else {
+            e += 1;
+            continue;
+        };
+        if file.chars().any(char::is_whitespace) {
+            e += 1;
+            continue;
+        }
+        let mention = Chunk {
+            lead: toks[start].lead.clone(),
+            core: format!("@{file}"),
+            trail: toks[e].trail.clone(),
+        };
+        toks.splice(start..=e, [mention]);
+        changed = true;
+        e = start + 1;
+    }
+    changed
+}
+
+fn split_possessive(core: &str) -> (&str, &str) {
+    for suffix in ["'s", "’s"] {
+        if let Some(body) = core.strip_suffix(suffix) {
+            if !body.is_empty() {
+                return (body, suffix);
+            }
+        }
+    }
+    (core, "")
+}
+
+fn fix_jargon(toks: &mut Vec<Chunk>, index: &Index) -> bool {
+    if index.jargon.is_empty() {
+        return false;
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < toks.len() {
+        let mut replaced = false;
+        for n in (1..=index.max_words.clamp(1, MAX_SPAN).min(toks.len() - i)).rev() {
+            let span = &toks[i..i + n];
+            if !span.iter().all(is_spoken) {
+                continue;
+            }
+            if (0..n - 1).any(|j| !span[j].trail.is_empty() || !span[j + 1].lead.is_empty()) {
+                continue;
+            }
+            let (last_body, poss) = split_possessive(&span[n - 1].core);
+            let mut parts: Vec<String> = Vec::new();
+            for (j, t) in span.iter().enumerate() {
+                let body = if j == n - 1 { last_body } else { t.core.as_str() };
+                parts.extend(
+                    body.split(['-', '_'])
+                        .filter(|p| !p.is_empty())
+                        .map(str::to_lowercase),
+                );
+            }
+            let spaced = parts.join(" ");
+            let joined = parts.concat();
+            let written = [&spaced, &joined]
+                .into_iter()
+                .find_map(|k| index.jargon.get(k))
+                .and_then(|w| w.as_ref());
+            let Some(written) = written else { continue };
+            let core = format!("{written}{poss}");
+            let old: Vec<&str> = span.iter().map(|t| t.core.as_str()).collect();
+            if old.join(" ") == core {
+                // Already spelled right; leave it and its neighbours.
+                replaced = true;
+                i += n;
+                break;
+            }
+            let new = Chunk {
+                lead: span[0].lead.clone(),
+                core,
+                trail: span[n - 1].trail.clone(),
+            };
+            toks.splice(i..i + n, [new]);
+            changed = true;
+            replaced = true;
+            i += 1;
+            break;
+        }
+        if !replaced {
+            i += 1;
+        }
+    }
+    changed
+}
