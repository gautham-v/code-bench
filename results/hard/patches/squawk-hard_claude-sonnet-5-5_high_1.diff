--- /dev/null
+++ b/crates/squawk-core/src/context/vocab.rs
@@ -0,0 +1,584 @@
+//! What a repo offers for fixing a transcript: its files and its jargon.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::Arc;
+use std::time::{Duration, Instant, SystemTime};
+
+use super::RepoVocab;
+
+/// Most files kept from one repo; a monorepo past this is not scanned further.
+const MAX_FILES: usize = 200_000;
+/// Bounds for the walk used outside git.
+const WALK_MAX_FILES: usize = 20_000;
+const WALK_MAX_DEPTH: usize = 8;
+/// Docs are read for jargon only up to this size.
+const MAX_DOC_BYTES: u64 = 256 * 1024;
+const MAX_WORDS: usize = 5_000;
+const MAX_MANIFESTS: usize = 64;
+
+/// Outside git there is no index to watch, so vocab is rebuilt after this.
+const NON_GIT_TTL: Duration = Duration::from_secs(10);
+/// In git, untracked files do not move the index; look again now and then.
+const GIT_TTL: Duration = Duration::from_secs(30);
+
+/// Directories never walked outside git.
+const SKIP_DIRS: &[&str] = &[
+    "node_modules",
+    "target",
+    "build",
+    "dist",
+    "out",
+    "venv",
+    "__pycache__",
+    "Pods",
+    "DerivedData",
+    "vendor",
+];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let files = list_files(cwd);
+    let words = collect_words(cwd, &files);
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words,
+    }
+}
+
+// ---------------------------------------------------------------- files
+
+fn list_files(cwd: &Path) -> Vec<String> {
+    if !cwd.is_dir() {
+        return Vec::new();
+    }
+    let mut files = if git_index_path(cwd).is_some() {
+        git_files(cwd).unwrap_or_else(|| walk_files(cwd))
+    } else {
+        walk_files(cwd)
+    };
+    files.sort();
+    files.dedup();
+    files.truncate(MAX_FILES);
+    files
+}
+
+/// `git ls-files` from `cwd`: tracked files plus untracked ones that are not
+/// ignored, relative to `cwd`.
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        .args([
+            "-c",
+            "core.quotepath=off",
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+        ])
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    Some(
+        out.stdout
+            .split(|&b| b == 0)
+            .filter(|p| !p.is_empty())
+            .map(|p| String::from_utf8_lossy(p).into_owned())
+            .take(MAX_FILES)
+            .collect(),
+    )
+}
+
+fn walk_files(root: &Path) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut stack = vec![(root.to_path_buf(), 0usize)];
+    while let Some((dir, depth)) = stack.pop() {
+        let Ok(read) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        let mut entries: Vec<_> = read.flatten().collect();
+        entries.sort_by_key(|e| e.file_name());
+        for entry in entries {
+            if out.len() >= WALK_MAX_FILES {
+                return out;
+            }
+            let name = entry.file_name().to_string_lossy().into_owned();
+            let Ok(kind) = entry.file_type() else { continue };
+            if kind.is_dir() {
+                if depth + 1 < WALK_MAX_DEPTH
+                    && !name.starts_with('.')
+                    && !SKIP_DIRS.contains(&name.as_str())
+                {
+                    stack.push((entry.path(), depth + 1));
+                }
+            } else if kind.is_file() || kind.is_symlink() {
+                if let Ok(rel) = entry.path().strip_prefix(root) {
+                    out.push(rel.to_string_lossy().into_owned());
+                }
+            }
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------- words
+
+fn collect_words(root: &Path, files: &[String]) -> Vec<String> {
+    let mut words = Words::default();
+
+    for file in files {
+        let base = file.rsplit('/').next().unwrap_or(file);
+        if let Some(stem) = file_stem(base) {
+            if stem_is_jargon(stem) {
+                words.add(stem);
+            }
+        }
+    }
+
+    // Manifests, shallowest first.
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| {
+            matches!(
+                f.rsplit('/').next().unwrap_or(f),
+                "Cargo.toml" | "package.json" | "pyproject.toml" | "go.mod"
+            )
+        })
+        .collect();
+    manifests.sort_by_key(|f| (f.matches('/').count(), f.as_str()));
+    for manifest in manifests.into_iter().take(MAX_MANIFESTS) {
+        if let Some(text) = read_small(&root.join(manifest)) {
+            if let Some(name) = package_name(manifest.rsplit('/').next().unwrap_or(manifest), &text)
+            {
+                words.add(&name);
+            }
+        }
+    }
+
+    for doc in ["README.md", "CLAUDE.md", "CONTEXT.md"] {
+        // Root docs only, whatever their case on disk.
+        let Some(found) = files.iter().find(|f| f.eq_ignore_ascii_case(doc)) else {
+            continue;
+        };
+        if let Some(text) = read_small(&root.join(found)) {
+            for term in doc_terms(&text) {
+                words.add(&term);
+            }
+        }
+    }
+
+    words.list
+}
+
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    seen: HashSet<String>,
+}
+
+impl Words {
+    fn add(&mut self, word: &str) {
+        let word = word.trim();
+        if word.is_empty() || self.list.len() >= MAX_WORDS {
+            return;
+        }
+        if self.seen.insert(word.to_string()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+fn read_small(path: &Path) -> Option<String> {
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > MAX_DOC_BYTES {
+        return None;
+    }
+    std::fs::read_to_string(path).ok()
+}
+
+/// `status_item.rs` → `status_item`, `.gitignore` → `gitignore`,
+/// `Makefile` → `Makefile`.
+fn file_stem(base: &str) -> Option<&str> {
+    let trimmed = base.strip_prefix('.').unwrap_or(base);
+    let stem = trimmed.rsplit_once('.').map_or(trimmed, |(s, _)| s);
+    (!stem.is_empty()).then_some(stem)
+}
+
+/// Worth keeping from a file name: a plain lowercase word (no-op to
+/// write, but part of the vocabulary) or one whose inner capitals matter
+/// (`VocabCache`). Names that are only capitalised or all capitals (`Cargo`,
+/// `README`, `CLAUDE`) are file-naming convention, not spelling.
+fn stem_is_jargon(stem: &str) -> bool {
+    if stem.chars().count() < 3 || !stem.chars().all(|c| c.is_alphanumeric() || c == '_') {
+        return false;
+    }
+    if !stem.chars().any(char::is_alphabetic) {
+        return false;
+    }
+    let plain_lower = !stem.chars().any(char::is_uppercase);
+    let camel = crate::text::has_inner_case(stem) && stem.chars().any(char::is_lowercase);
+    (plain_lower && !stem.contains('_')) || camel
+}
+
+fn package_name(manifest: &str, text: &str) -> Option<String> {
+    let name = match manifest {
+        "Cargo.toml" => toml_name(text, &["package"]),
+        "pyproject.toml" => toml_name(text, &["project", "tool.poetry"]),
+        "package.json" => {
+            let v: serde_json::Value = serde_json::from_str(text).ok()?;
+            let n = v.get("name")?.as_str()?;
+            Some(n.rsplit('/').next().unwrap_or(n).to_string())
+        }
+        "go.mod" => text
+            .lines()
+            .find_map(|l| l.trim().strip_prefix("module "))
+            .map(|m| m.trim().trim_matches('"').rsplit('/').next().unwrap_or("").to_string()),
+        _ => None,
+    }?;
+    (name.chars().count() >= 2 && name.chars().any(char::is_alphabetic)).then_some(name)
+}
+
+/// `name = "x"` inside one of the given tables.
+fn toml_name(text: &str, tables: &[&str]) -> Option<String> {
+    let mut in_table = false;
+    for line in text.lines() {
+        let line = line.trim();
+        if let Some(header) = line.strip_prefix('[') {
+            let header = header.trim_end_matches(']').trim();
+            in_table = tables.contains(&header);
+        } else if in_table {
+            if let Some((key, value)) = line.split_once('=') {
+                if key.trim() == "name" {
+                    let v = value.trim().trim_matches(['"', '\'']);
+                    if !v.is_empty() {
+                        return Some(v.to_string());
+                    }
+                }
+            }
+        }
+    }
+    None
+}
+
+/// All-caps words that are emphasis or plain English, not jargon.
+const SHOUTING: &[&str] = &[
+    "ALL", "ALWAYS", "AN", "AND", "ANY", "ARE", "AS", "AT", "BE", "BUT", "BY", "CAN", "CRITICAL",
+    "DO", "DONT", "FIXME", "FOR", "HAS", "HE", "HOW", "IF", "IMPORTANT", "IN", "IS", "IT", "ME",
+    "MUST", "MY", "NEVER", "NO", "NOT", "NOTE", "OF", "OK", "ON", "ONLY", "OR", "REQUIRED", "SHALL",
+    "SHOULD", "SO", "THE", "TO", "TODO", "UP", "US", "WARNING", "WE", "WHAT", "WHEN", "WHY", "WILL",
+    "WITH", "YES", "YOU", "YOUR",
+];
+
+/// Jargon in a README / CLAUDE.md / CONTEXT.md, in the casing the doc uses:
+/// words with inner capitals or digits (`SQLite`, `macOS`, `H100`), acronyms
+/// (`TDT`), and capitalised terms met in the middle of a sentence
+/// (`Parakeet`, `Claude Code`) unless the doc also writes them in lowercase.
+fn doc_terms(text: &str) -> Vec<String> {
+    let mut terms: Vec<String> = Vec::new();
+    let mut capitalised: Vec<String> = Vec::new();
+    let mut lowercase: HashSet<String> = HashSet::new();
+    let mut in_fence = false;
+
+    for line in text.lines() {
+        let trimmed = line.trim_start();
+        if trimmed.starts_with("```") || trimmed.starts_with("~~~") {
+            in_fence = !in_fence;
+            continue;
+        }
+        if in_fence {
+            continue;
+        }
+        let heading = trimmed.starts_with('#');
+        let body = strip_markup(trimmed.trim_start_matches('#'));
+
+        let mut sentence_start = true;
+        let mut run: Vec<String> = Vec::new();
+        let flush_run = |run: &mut Vec<String>, capitalised: &mut Vec<String>| {
+            if !run.is_empty() {
+                capitalised.push(run.join(" "));
+                run.clear();
+            }
+        };
+        for raw in body.split_whitespace() {
+            let word = raw.trim_matches(|c: char| !c.is_alphanumeric());
+            let word = word
+                .strip_suffix("'s")
+                .or_else(|| word.strip_suffix("’s"))
+                .unwrap_or(word);
+            let ends_run = raw.ends_with(|c: char| !c.is_alphanumeric());
+            let ends_sentence = raw.ends_with(['.', '!', '?', ':', ';']);
+            let plain = !word.is_empty() && word.chars().all(char::is_alphanumeric);
+            if !plain {
+                flush_run(&mut run, &mut capitalised);
+                sentence_start = sentence_start || ends_sentence || word.is_empty();
+                continue;
+            }
+
+            if is_distinctive(word) {
+                terms.push(word.to_string());
+                // An acronym can close a phrase: "Parakeet TDT".
+                if run.is_empty() {
+                    flush_run(&mut run, &mut capitalised);
+                } else {
+                    run.push(word.to_string());
+                }
+            } else if word.chars().next().is_some_and(char::is_lowercase) {
+                lowercase.insert(word.to_string());
+                flush_run(&mut run, &mut capitalised);
+            } else if !heading && !sentence_start && is_capitalised(word) {
+                run.push(word.to_string());
+            } else {
+                flush_run(&mut run, &mut capitalised);
+            }
+            if ends_run {
+                flush_run(&mut run, &mut capitalised);
+            }
+            sentence_start = ends_sentence;
+        }
+        flush_run(&mut run, &mut capitalised);
+    }
+
+    for term in capitalised {
+        let single = !term.contains(' ');
+        if single && lowercase.contains(&term.to_lowercase()) {
+            continue;
+        }
+        terms.push(term);
+    }
+    terms
+}
+
+/// Remove markdown that is not prose: inline code, link targets, bare URLs,
+/// emphasis markers and table bars.
+fn strip_markup(line: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut in_code = false;
+    let mut in_target = false;
+    let mut prev = ' ';
+    for c in line.chars() {
+        let after_bracket = prev == ']';
+        prev = c;
+        match c {
+            '`' => {
+                in_code = !in_code;
+                out.push(' ');
+            }
+            _ if in_code => {}
+            ']' => out.push(' '),
+            '(' if after_bracket => in_target = true,
+            ')' if in_target => in_target = false,
+            _ if in_target => {}
+            '*' | '_' | '|' | '[' | '>' => out.push(' '),
+            _ => out.push(c),
+        }
+    }
+    out.split_whitespace()
+        .filter(|w| !w.contains("://") && !w.starts_with('@'))
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn is_capitalised(word: &str) -> bool {
+    let mut chars = word.chars();
+    chars.next().is_some_and(char::is_uppercase)
+        && word.chars().count() >= 3
+        && chars.all(|c| c.is_lowercase())
+}
+
+/// Spelled in a way ordinary prose never is: inner capitals, an acronym, or
+/// letters mixed with digits.
+fn is_distinctive(word: &str) -> bool {
+    let letters = word.chars().filter(|c| c.is_alphabetic()).count();
+    if letters == 0 || !word.chars().next().is_some_and(char::is_alphabetic) {
+        return false;
+    }
+    let has_digit = word.chars().any(|c| c.is_ascii_digit());
+    if word.chars().count() < 2 {
+        return false;
+    }
+    let all_caps = word.chars().filter(|c| c.is_alphabetic()).all(char::is_uppercase);
+    if all_caps {
+        return letters >= 2 && letters <= 8 && !SHOUTING.contains(&word.to_ascii_uppercase().as_str());
+    }
+    if has_digit {
+        return true;
+    }
+    crate::text::has_inner_case(word) && word.chars().any(char::is_lowercase)
+}
+
+// ---------------------------------------------------------------- cache
+
+/// What the vocab was built from, to tell when it has gone stale.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Stamp {
+    index: Option<(PathBuf, SystemTime, u64)>,
+    built: Instant,
+}
+
+impl Stamp {
+    fn take(cwd: &Path) -> Stamp {
+        Stamp {
+            index: git_index_path(cwd).and_then(|p| {
+                let meta = std::fs::metadata(&p).ok()?;
+                Some((p, meta.modified().ok()?, meta.len()))
+            }),
+            built: Instant::now(),
+        }
+    }
+
+    fn is_stale(&self, now: &Stamp) -> bool {
+        let ttl = if now.index.is_some() { GIT_TTL } else { NON_GIT_TTL };
+        self.index != now.index || now.built.duration_since(self.built) > ttl
+    }
+}
+
+/// The `index` file of the repo containing `cwd`: found by walking up to a
+/// `.git` directory, or a `.git` file (worktrees, submodules) naming one.
+fn git_index_path(cwd: &Path) -> Option<PathBuf> {
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        if dot_git.is_dir() {
+            return Some(dot_git.join("index"));
+        }
+        if dot_git.is_file() {
+            let text = std::fs::read_to_string(&dot_git).ok()?;
+            let target = text.trim().strip_prefix("gitdir:")?.trim();
+            let target = Path::new(target);
+            let git_dir = if target.is_absolute() {
+                target.to_path_buf()
+            } else {
+                dir.join(target)
+            };
+            return Some(git_dir.join("index"));
+        }
+    }
+    None
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Cache {
+    entries: HashMap<PathBuf, (Arc<RepoVocab>, Stamp)>,
+}
+
+impl Cache {
+    pub fn get(&mut self, cwd: &Path) -> Arc<RepoVocab> {
+        let now = Stamp::take(cwd);
+        if let Some((vocab, stamp)) = self.entries.get(cwd) {
+            if !stamp.is_stale(&now) {
+                return vocab.clone();
+            }
+        }
+        let vocab = Arc::new(build(cwd));
+        self.entries
+            .insert(cwd.to_path_buf(), (vocab.clone(), Stamp::take(cwd)));
+        vocab
+    }
+}
