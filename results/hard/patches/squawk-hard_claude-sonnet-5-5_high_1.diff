@@ -0,0 +1,440 @@
+//! Finding the agent session behind the front terminal.
+//!
+//! The process table is read through libproc (macOS only; elsewhere nothing
+//! is found). The choice among candidates is a pure function over
+//! [`ProcEntry`] so it can be tested without a terminal.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use super::{Agent, Session, AGENT_PROCESS_NAMES};
+
+/// What squawk needs to know about one process.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ProcEntry {
+    pub pid: i32,
+    pub ppid: i32,
+    /// Set when the process is a coding agent.
+    pub agent: Option<Agent>,
+    pub cwd: Option<PathBuf>,
+    pub tty: Option<PathBuf>,
+    /// Start time, seconds since the epoch: the tie-breaker.
+    pub started: u64,
+}
+
+/// Is a process with these names (comm, executable path, argv) an agent?
+///
+/// A native `claude` binary shows up under its own name, but also as a
+/// version-numbered file under `.../claude/versions/`, and the npm build is
+/// `node .../@anthropic-ai/claude-code/cli.js`. Anything that merely
+/// *contains* "claude" (`claude-helper`, an editor plugin) is not a session.
+pub(crate) fn agent_for(names: &[&str]) -> Option<Agent> {
+    for name in names {
+        let name = name.trim();
+        let base = name.rsplit('/').next().unwrap_or(name);
+        let base = base.to_ascii_lowercase();
+        for (agent_name, agent) in AGENT_PROCESS_NAMES {
+            if base == *agent_name {
+                return Some(*agent);
+            }
+            if name.contains('/') {
+                let lower = name.to_ascii_lowercase();
+                let dir_marker = format!("/{agent_name}/versions/");
+                let pkg_marker = match agent {
+                    Agent::Claude => "/@anthropic-ai/claude-code/",
+                    Agent::Codex => "/@openai/codex/",
+                };
+                if lower.contains(&dir_marker) || lower.contains(pkg_marker) {
+                    return Some(*agent);
+                }
+            }
+        }
+    }
+    None
+}
+
+/// The agent session under `front_pid`, from a snapshot of the process
+/// table. `tty_activity` says when a tty device was last used.
+pub(crate) fn select(
+    front_pid: i32,
+    procs: &[ProcEntry],
+    tty_activity: impl Fn(&Path) -> Option<SystemTime>,
+) -> Option<Session> {
+    let by_pid: HashMap<i32, &ProcEntry> = procs.iter().map(|p| (p.pid, p)).collect();
+    let mut children: HashMap<i32, Vec<i32>> = HashMap::new();
+    for p in procs {
+        if p.pid != p.ppid {
+            children.entry(p.ppid).or_default().push(p.pid);
+        }
+    }
+
+    // Everything under the terminal.
+    let mut seen: HashSet<i32> = HashSet::new();
+    let mut stack = vec![front_pid];
+    let mut descendants: Vec<&ProcEntry> = Vec::new();
+    while let Some(pid) = stack.pop() {
+        for &child in children.get(&pid).into_iter().flatten() {
+            if seen.insert(child) {
+                if let Some(p) = by_pid.get(&child) {
+                    descendants.push(p);
+                }
+                stack.push(child);
+            }
+        }
+    }
+
+    let agents: Vec<&ProcEntry> = descendants
+        .iter()
+        .copied()
+        .filter(|p| p.agent.is_some() && p.cwd.is_some())
+        .collect();
+    let agent_pids: HashSet<i32> = agents.iter().map(|p| p.pid).collect();
+
+    // An agent's own helpers are not sessions: keep the outermost.
+    let has_agent_ancestor = |p: &ProcEntry| {
+        let mut cur = p.ppid;
+        let mut hops = 0;
+        while let Some(parent) = by_pid.get(&cur) {
+            if agent_pids.contains(&parent.pid) {
+                return true;
+            }
+            if parent.pid == front_pid || parent.ppid == parent.pid || hops > 64 {
+                break;
+            }
+            cur = parent.ppid;
+            hops += 1;
+        }
+        false
+    };
+
+    agents
+        .into_iter()
+        .filter(|p| !has_agent_ancestor(p))
+        .max_by_key(|p| {
+            let used = p
+                .tty
+                .as_deref()
+                .and_then(&tty_activity)
+                .unwrap_or(SystemTime::UNIX_EPOCH);
+            (used, p.started, p.pid)
+        })
+        .map(|p| Session {
+            agent: p.agent.expect("filtered"),
+            pid: p.pid,
+            cwd: p.cwd.clone().expect("filtered"),
+            tty: p.tty.clone(),
+        })
+}
+
+/// The more recent of a tty device's access and modification times.
+pub(crate) fn tty_activity(tty: &Path) -> Option<SystemTime> {
+    let meta = std::fs::metadata(tty).ok()?;
+    match (meta.accessed().ok(), meta.modified().ok()) {
+        (Some(a), Some(m)) => Some(a.max(m)),
+        (a, m) => a.or(m),
+    }
+}
+
+#[cfg(target_os = "macos")]
+pub(crate) fn snapshot() -> Vec<ProcEntry> {
+    macos::snapshot()
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(crate) fn snapshot() -> Vec<ProcEntry> {
+    Vec::new()
+}
+
+#[cfg(target_os = "macos")]
+mod macos {
+    use super::*;
+    use std::ffi::CStr;
+    use std::mem;
+    use std::os::raw::{c_char, c_int, c_void};
+
+    pub fn snapshot() -> Vec<ProcEntry> {
+        let mut pids = all_pids();
+        pids.sort_unstable();
+        let mut out = Vec::with_capacity(pids.len());
+        for pid in pids {
+            if pid <= 0 {
+                continue;
+            }
+            let Some(info) = bsd_info(pid) else { continue };
+            out.push(entry(pid, &info));
+        }
+        out
+    }
+
+    fn all_pids() -> Vec<i32> {
+        // SAFETY: a null buffer asks for the size; the second call fills a
+        // buffer of exactly the size we pass.
+        unsafe {
+            let bytes = libc::proc_listallpids(std::ptr::null_mut(), 0);
+            if bytes <= 0 {
+                return Vec::new();
+            }
+            // The table can grow between the calls.
+            let cap = bytes as usize / mem::size_of::<i32>() + 64;
+            let mut buf = vec![0i32; cap];
+            let got = libc::proc_listallpids(
+                buf.as_mut_ptr() as *mut c_void,
+                (cap * mem::size_of::<i32>()) as c_int,
+            );
+            if got <= 0 {
+                return Vec::new();
+            }
+            buf.truncate(got as usize / mem::size_of::<i32>());
+            buf
+        }
+    }
+
+    fn bsd_info(pid: i32) -> Option<libc::proc_bsdinfo> {
+        // SAFETY: proc_bsdinfo is plain data; the kernel fills at most the
+        // size we give it and returns how much it wrote.
+        unsafe {
+            let mut info: libc::proc_bsdinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_bsdinfo>() as c_int;
+            let got = libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            );
+            (got == size).then_some(info)
+        }
+    }
+
+    fn c_array(raw: &[c_char]) -> String {
+        let bytes: Vec<u8> = raw
+            .iter()
+            .take_while(|&&c| c != 0)
+            .map(|&c| c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    fn entry(pid: i32, info: &libc::proc_bsdinfo) -> ProcEntry {
+        let comm = c_array(&info.pbi_comm);
+        let name = c_array(&info.pbi_name);
+        let mut agent = agent_for(&[&comm, &name]);
+        // Only look further (a syscall or two) at the processes that could
+        // plausibly be an agent: a version-numbered binary or `node`.
+        if agent.is_none() && plausible_runtime(&comm, &name) {
+            let path = exe_path(pid);
+            let args = proc_args(pid);
+            let mut names: Vec<&str> = Vec::new();
+            if let Some(p) = path.as_deref() {
+                names.push(p);
+            }
+            if let Some((exec, argv)) = args.as_ref() {
+                names.push(exec);
+                names.extend(argv.iter().take(3).map(String::as_str));
+            }
+            agent = agent_for(&names);
+        }
+        let (cwd, tty) = if agent.is_some() {
+            (cwd_of(pid), tty_of(info.e_tdev))
+        } else {
+            (None, None)
+        };
+        ProcEntry {
+            pid,
+            ppid: info.pbi_ppid as i32,
+            agent,
+            cwd,
+            tty,
+            started: info.pbi_start_tvsec,
+        }
+    }
+
+    /// `node`, `bun`, or a name that is a version number (`2.1.50`): the
+    /// shapes an agent's process takes when it is not literally `claude`.
+    fn plausible_runtime(comm: &str, name: &str) -> bool {
+        let lower = comm.to_ascii_lowercase();
+        let version_like = |s: &str| {
+            s.chars().next().is_some_and(|c| c.is_ascii_digit())
+                && s.chars().all(|c| c.is_ascii_digit() || c == '.')
+        };
+        matches!(lower.as_str(), "node" | "bun" | "deno") || version_like(comm) || version_like(name)
+    }
+
+    fn exe_path(pid: i32) -> Option<String> {
+        let mut buf = vec![0u8; 4096];
+        // SAFETY: buffer and its length match.
+        let n = unsafe { libc::proc_pidpath(pid, buf.as_mut_ptr() as *mut c_void, buf.len() as u32) };
+        (n > 0).then(|| String::from_utf8_lossy(&buf[..n as usize]).into_owned())
+    }
+
+    /// `(executable path, argv)` from KERN_PROCARGS2.
+    fn proc_args(pid: i32) -> Option<(String, Vec<String>)> {
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+        let mut size: usize = 0;
+        // SAFETY: sizing call, then a read into a buffer of that size.
+        let buf = unsafe {
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                std::ptr::null_mut(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+                || size < 8
+            {
+                return None;
+            }
+            let mut buf = vec![0u8; size];
+            if libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                buf.as_mut_ptr() as *mut c_void,
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            ) != 0
+            {
+                return None;
+            }
+            buf.truncate(size);
+            buf
+        };
+        let argc = i32::from_ne_bytes(buf[..4].try_into().ok()?).max(0) as usize;
+        let mut rest = &buf[4..];
+        let end = rest.iter().position(|&b| b == 0)?;
+        let exec = String::from_utf8_lossy(&rest[..end]).into_owned();
+        rest = &rest[end..];
+        let skip = rest.iter().position(|&b| b != 0).unwrap_or(rest.len());
+        rest = &rest[skip..];
+        let argv = rest
+            .split(|&b| b == 0)
+            .take(argc)
+            .map(|s| String::from_utf8_lossy(s).into_owned())
+            .collect();
+        Some((exec, argv))
+    }
+
+    fn cwd_of(pid: i32) -> Option<PathBuf> {
+        // SAFETY: plain data, size-checked by the kernel.
+        unsafe {
+            let mut info: libc::proc_vnodepathinfo = mem::zeroed();
+            let size = mem::size_of::<libc::proc_vnodepathinfo>() as c_int;
+            let got = libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            );
+            if got != size {
+                return None;
+            }
+            let ptr = info.pvi_cdir.vip_path.as_ptr() as *const c_char;
+            let path = CStr::from_ptr(ptr).to_string_lossy().into_owned();
+            (!path.is_empty()).then(|| PathBuf::from(path))
+        }
+    }
+
+    fn tty_of(dev: u32) -> Option<PathBuf> {
+        if dev == u32::MAX || dev == 0 {
+            return None;
+        }
+        // SAFETY: devname returns a pointer to a static buffer or null.
+        unsafe {
+            let ptr = libc::devname(dev as libc::dev_t, libc::S_IFCHR);
+            if ptr.is_null() {
+                return None;
+            }
+            let name = CStr::from_ptr(ptr).to_string_lossy().into_owned();
+            (!name.is_empty() && name != "??").then(|| PathBuf::from("/dev").join(name))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    fn proc(pid: i32, ppid: i32, agent: Option<Agent>, tty: Option<&str>) -> ProcEntry {
+        ProcEntry {
+            pid,
+            ppid,
+            agent,
+            cwd: agent.map(|_| PathBuf::from(format!("/work/{pid}"))),
+            tty: tty.map(PathBuf::from),
+            started: pid as u64,
+        }
+    }
+
+    #[test]
+    fn names_that_are_agents() {
+        assert_eq!(agent_for(&["claude"]), Some(Agent::Claude));
+        assert_eq!(agent_for(&["Codex"]), Some(Agent::Codex));
+        assert_eq!(
+            agent_for(&["2.1.50", "/Users/me/.local/share/claude/versions/2.1.50"]),
+            Some(Agent::Claude)
+        );
+        assert_eq!(
+            agent_for(&["node", "/usr/lib/node_modules/@anthropic-ai/claude-code/cli.js"]),
+            Some(Agent::Claude)
+        );
+        assert_eq!(agent_for(&["/opt/homebrew/bin/codex"]), Some(Agent::Codex));
+        assert_eq!(agent_for(&["claude-helper"]), None);
+        assert_eq!(agent_for(&["zsh", "node"]), None);
+    }
+
+    #[test]
+    fn finds_agent_under_terminal_only() {
+        let procs = vec![
+            proc(10, 1, None, None),                       // the terminal
+            proc(11, 10, None, Some("/dev/ttys001")),      // login
+            proc(12, 11, None, Some("/dev/ttys001")),      // zsh
+            proc(13, 12, Some(Agent::Claude), Some("/dev/ttys001")),
+            proc(20, 1, None, None),                       // another app
+            proc(21, 20, Some(Agent::Codex), Some("/dev/ttys002")),
+        ];
+        let s = select(10, &procs, |_| None).unwrap();
+        assert_eq!((s.pid, s.agent), (13, Agent::Claude));
+        assert_eq!(s.cwd, PathBuf::from("/work/13"));
+        assert!(select(99, &procs, |_| None).is_none());
+        assert!(select(20, &procs[..4], |_| None).is_none());
+    }
+
+    #[test]
+    fn most_recent_tty_wins_and_helpers_do_not_count() {
+        let procs = vec![
+            proc(10, 1, None, None),
+            proc(11, 10, Some(Agent::Claude), Some("/dev/ttys001")),
+            proc(12, 10, Some(Agent::Claude), Some("/dev/ttys002")),
+            proc(13, 11, Some(Agent::Claude), Some("/dev/ttys001")), // helper of 11
+        ];
+        let now = SystemTime::UNIX_EPOCH + Duration::from_secs(1000);
+        let used = |p: &Path| {
+            Some(if p.ends_with("ttys001") {
+                now
+            } else {
+                now - Duration::from_secs(60)
+            })
+        };
+        assert_eq!(select(10, &procs, used).unwrap().pid, 11);
+        let used = |p: &Path| {
+            Some(if p.ends_with("ttys002") {
+                now
+            } else {
+                now - Duration::from_secs(60)
+            })
+        };
+        assert_eq!(select(10, &procs, used).unwrap().pid, 12);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn snapshot_sees_this_process() {
+        let me = std::process::id() as i32;
+        let procs = snapshot();
+        assert!(procs.iter().any(|p| p.pid == me));
+    }
+}
