+/// Fold an already-rendered page the way the editor is folded: every row that
+/// came from a line `visible` hides is dropped, and each heading in `folded`
+/// gets the editor's `▸ ` in front. The blank rows the renderer put between
+/// the blocks of a hidden section go with it, so a folded heading sits as
+/// close to the next one as a heading with nothing under it would.
+///
+/// Done on the rendered rows rather than on the markdown: cutting the source
+/// would shift every line number a click maps back to, and a row dropped here
+/// leaves the ones that stay knowing exactly where they came from.
+pub fn fold_page(r: &mut Rendered, visible: &crate::fold::Visible, folded: &[usize]) {
+    if visible.is_plain() {
+        return;
+    }
+    let mut out: Vec<PLine> = Vec::with_capacity(r.lines.len());
+    // the last row with a source line was a hidden one
+    let mut dropping = false;
+    let mut marked = None;
+    for mut line in std::mem::take(&mut r.lines) {
+        match line.src_line {
+            Some(l) if visible.is_hidden(l) => dropping = true,
+            Some(l) => {
+                dropping = false;
+                if folded.contains(&l) && marked != Some(l) && !line.cells.is_empty() {
+                    marked = Some(l);
+                    let style = theme::fold();
+                    line.cells.splice(0..0, str_cells(theme::FOLDED, style));
+                }
+                out.push(line);
+            }
+            None if dropping => {}
+            None => out.push(line),
+        }
+    }
+    // a fold that runs to the end of the note leaves no blank row behind it
+    if dropping {
+        while out.last().is_some_and(|l| l.cells.is_empty()) {
+            out.pop();
+        }
+    }
+    r.lines = out;
+}
