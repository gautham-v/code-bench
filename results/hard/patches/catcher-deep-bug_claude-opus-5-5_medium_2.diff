+/// The line a search hit should open on. `line` is where the hit was when
+/// the note was read and `shown` what it said there; a note that has changed
+/// since — saved from another program, or reloaded on the way in — may have
+/// moved it, and then the nearest line that still says the same is the one.
+fn hit_line(lines: &[String], line: usize, shown: Option<&str>) -> usize {
+    let last = lines.len().saturating_sub(1);
+    let Some(shown) = shown else {
+        return line.min(last);
+    };
+    if lines.get(line).is_some_and(|l| l == shown) {
+        return line;
+    }
+    (0..lines.len())
+        .filter(|&r| lines[r] == shown)
+        .min_by_key(|&r| r.abs_diff(line))
+        .unwrap_or(line.min(last))
+}
