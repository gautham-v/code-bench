+    /// The note at `old` now lives at `new` — renamed, or moved to another
+    /// folder. Its folds go with it: they belong to the note, and the path
+    /// was only ever how to find them.
+    pub fn rename(&mut self, old: &Path, new: &Path) {
+        if old == new {
+            return;
+        }
+        match self.by_note.remove(old) {
+            Some(m) => {
+                self.by_note.insert(new.to_path_buf(), m);
+            }
+            // whatever a note that used to live at `new` had folded is not
+            // this note's to inherit
+            None => {
+                self.by_note.remove(new);
+            }
+        }
+    }
+
+    /// Drop every fold of `path`: the note is gone, and a note made at the
+    /// same path later is a different note.
+    pub fn forget(&mut self, path: &Path) {
+        self.by_note.remove(path);
+    }
+
+    /// Bring the folds of `path` across a rewrite of the whole buffer — the
+    /// file changed on disk and `new` replaced `old`. Unlike [`Folds::settle`]
+    /// this knows what the buffer was, so a fold above the first changed line
+    /// stays put and one below the last changed line moves by exactly as much
+    /// as the note grew, whatever other headings read the same. Only a fold
+    /// inside the rewritten stretch has to be looked for by its text, and is
+    /// dropped when that is gone or could be more than one line.
+    pub fn rebase(&mut self, path: &Path, old: &[String], new: &[String], blocks: &[Block]) {
+        let Some(m) = self.by_note.get_mut(path) else {
+            return;
+        };
+        let head = old.iter().zip(new).take_while(|(a, b)| a == b).count();
+        let tail = old[head..]
+            .iter()
+            .rev()
+            .zip(new[head..].iter().rev())
+            .take_while(|(a, b)| a == b)
+            .count();
+        let was = std::mem::take(m);
+        for (row, text) in was {
+            let at = if row < head {
+                Some(row)
+            } else if row + tail >= old.len() {
+                Some(row + new.len() - old.len())
+            } else {
+                let mut hits = (head..new.len() - tail).filter(|&r| new[r] == text);
+                hits.next().filter(|_| hits.next().is_none())
+            };
+            let at = at
+                .filter(|&r| new.get(r) == Some(&text))
+                .filter(|&r| hidden_span(new, blocks, r).is_some());
+            if let Some(at) = at {
+                m.insert(at, text);
+            }
+        }
+        if m.is_empty() {
+            self.by_note.remove(path);
+        }
+    }
