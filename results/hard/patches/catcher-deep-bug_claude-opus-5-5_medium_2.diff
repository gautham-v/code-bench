+/// The same count on a row of the reading view, which is cells rather than
+/// spans. The cells come from nowhere in the note, like the rest of what the
+/// renderer adds.
+fn fold_note_cells(cells: &mut Vec<PCell>, label: &str, width: usize) {
+    let used = crate::render::cells_width(cells);
+    let need = crate::md::str_width(label) + 2;
+    if used + need > width {
+        return;
+    }
+    let pad = " ".repeat(width - used - need + 2);
+    for (text, style) in [(pad.as_str(), theme::PLAIN), (label, dim())] {
+        cells.extend(text.chars().map(|ch| PCell {
+            ch,
+            style,
+            link: None,
+            src: None,
+        }));
+    }
+}
