diff --git a/src/render.rs b/src/render.rs
index 5399ad4..8f8f380 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -135,6 +135,47 @@ pub fn render_page_at(
     r.finish()
 }
 
+/// Fold the page the way the editor does: lines whose source line `hidden`
+/// says is folded away are dropped, and a heading `folded` names gets the `▸ `
+/// marker. A blank line the renderer put between blocks has no source line of
+/// its own; it belongs to the block after it, so it goes when that block does.
+pub fn fold_page(r: &mut Rendered, hidden: impl Fn(usize) -> bool, folded: impl Fn(usize) -> bool) {
+    let mut next: Option<usize> = None;
+    let mut keep = vec![true; r.lines.len()];
+    for (i, line) in r.lines.iter().enumerate().rev() {
+        match line.src_line {
+            Some(l) => {
+                next = Some(l);
+                keep[i] = !hidden(l);
+            }
+            None if line.cells.is_empty() && line.image.is_none() => {
+                keep[i] = !next.is_some_and(&hidden);
+            }
+            None => {}
+        }
+    }
+    let mut keep = keep.into_iter();
+    r.lines.retain(|_| keep.next().unwrap_or(true));
+    let mut prev: Option<usize> = None;
+    for line in &mut r.lines {
+        let at = line.src_line;
+        if at != prev {
+            if at.is_some_and(&folded) {
+                let marker = theme::FOLDED.chars().map(|ch| PCell {
+                    ch,
+                    style: theme::fold(),
+                    link: None,
+                    src: None,
+                });
+                line.cells.splice(0..0, marker);
+            }
+        }
+        if at.is_some() {
+            prev = at;
+        }
+    }
+}
+
 /// Add the linked-mentions footer to an already-rendered page: a rule, a count,
 /// and one row per note that links here.
 ///
@@ -2320,4 +2361,16 @@ mod tests {
         let row = r.lines.iter().find(|l| l.text().contains("meta")).unwrap();
         assert!(!row.text().contains("about"));
     }
+ 
+    #[test]
+    fn a_folded_page_drops_the_section_and_marks_the_heading() {
+        let md = "# A\n\ntext\n\n## B\n\nmore\n";
+        let mut r = render_page_at(md, 0, usize::MAX, TableStyle::default());
+        fold_page(&mut r, |l| (1..=3).contains(&l), |l| l == 0);
+        let page: Vec<String> = r.lines.iter().map(|l| l.text()).collect();
+        assert!(!page.iter().any(|t| t.contains("text")));
+        assert!(page.iter().any(|t| t.contains("more")));
+        assert!(page[0].starts_with(theme::FOLDED));
+        assert_eq!(page.iter().filter(|t| t.is_empty()).count(), 2);
+    }
 }
