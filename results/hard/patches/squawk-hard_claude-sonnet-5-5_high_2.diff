index 0000000..bb2c475
--- /dev/null
+++ b/crates/squawk-core/src/context/jargon.rs
@@ -0,0 +1,239 @@
+//! Repo jargon in the spelling the repo uses.
+//!
+//! Each word in [`RepoVocab::words`] is matched whole-word and
+//! case-insensitively against the transcript and written as the repo writes
+//! it. A word with inner capitals or digits (`VocabCache`, `gpt5`) also
+//! matches when the model split it ("vocab cache", "GPT 5"). A multi-word term
+//! (`Claude Code`) matches its words in a row. Nothing inside an @mention, a
+//! path or a file name is touched, and matching works on words, not regexes,
+//! so it costs one pass over the text however large the vocab is.
+
+use std::collections::HashMap;
+
+use super::RepoVocab;
+use crate::text::{self, Chunk};
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab) -> String {
+    if vocab.words.is_empty() {
+        return text.to_string();
+    }
+    let index = Index::new(&vocab.words);
+    let chunks = text::chunks(text);
+    let keys: Vec<Option<String>> = chunks
+        .iter()
+        .map(|c| (!c.is_protected() && !c.core.is_empty()).then(|| c.core.to_lowercase()))
+        .collect();
+
+    let mut out: Vec<Chunk> = Vec::with_capacity(chunks.len());
+    let mut changed = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        if let Some((len, written)) = index.longest_at(&chunks, &keys, i) {
+            let mut c = chunks[i].clone();
+            if c.core != written || len > 1 {
+                changed = true;
+            }
+            c.core = written.to_string();
+            c.trail = chunks[i + len - 1].trail.clone();
+            out.push(c);
+            i += len;
+        } else {
+            out.push(chunks[i].clone());
+            i += 1;
+        }
+    }
+    if changed {
+        text::join(&out)
+    } else {
+        text.to_string()
+    }
+}
+
+struct Index<'a> {
+    /// First spoken word → (spoken words, written form), longest first.
+    by_first: HashMap<String, Vec<(Vec<String>, &'a str)>>,
+}
+
+impl<'a> Index<'a> {
+    fn new(words: &'a [String]) -> Index<'a> {
+        let mut by_first: HashMap<String, Vec<(Vec<String>, &'a str)>> = HashMap::new();
+        let mut taken: std::collections::HashSet<Vec<String>> = Default::default();
+        for word in words {
+            let written = word.trim();
+            if written.is_empty() || written.starts_with('#') || written.contains("->") {
+                continue;
+            }
+            let plain: Vec<String> = written.split_whitespace().map(str::to_lowercase).collect();
+            let mut spoken = vec![plain];
+            if !written.contains(char::is_whitespace) {
+                let parts = split_camel(written);
+                if parts.len() > 1 {
+                    spoken.push(parts.iter().map(|p| p.to_lowercase()).collect());
+                }
+            }
+            for key in spoken {
+                // The first word to claim a spoken form keeps it.
+                if taken.insert(key.clone()) {
+                    by_first
+                        .entry(key[0].clone())
+                        .or_default()
+                        .push((key, written));
+                }
+            }
+        }
+        for list in by_first.values_mut() {
+            list.sort_by_key(|(key, _)| std::cmp::Reverse(key.len()));
+        }
+        Index { by_first }
+    }
+
+    /// The longest term spoken starting at chunk `i`: how many chunks it
+    /// covers and how it is written.
+    fn longest_at(
+        &self,
+        chunks: &[Chunk],
+        keys: &[Option<String>],
+        i: usize,
+    ) -> Option<(usize, &'a str)> {
+        let first = keys[i].as_ref()?;
+        'terms: for (key, written) in self.by_first.get(first)? {
+            if i + key.len() > chunks.len() {
+                continue;
+            }
+            for (n, word) in key.iter().enumerate() {
+                let at = i + n;
+                // Words of one term are an unbroken run of speech.
+                let glued =
+                    n == 0 || (chunks[at].lead.is_empty() && chunks[at - 1].trail.is_empty());
+                if !glued || keys[at].as_deref() != Some(word.as_str()) {
+                    continue 'terms;
+                }
+            }
+            return Some((key.len(), written));
+        }
+        None
+    }
+}
+
+/// `VocabCache` → `Vocab`, `Cache`; `gpt5` → `gpt`, `5`; `SQLite` → `SQ`,
+/// `Lite`; `status_item` stays whole (separators are not split on: only the
+/// repo's own form is matched for those).
+fn split_camel(word: &str) -> Vec<String> {
+    #[derive(PartialEq, Clone, Copy)]
+    enum K {
+        Upper,
+        Lower,
+        Digit,
+        Other,
+    }
+    if word.contains(['_', '-']) {
+        return vec![word.to_string()];
+    }
+    let kind = |c: char| {
+        if c.is_uppercase() {
+            K::Upper
+        } else if c.is_lowercase() {
+            K::Lower
+        } else if c.is_ascii_digit() {
+            K::Digit
+        } else {
+            K::Other
+        }
+    };
+    let chars: Vec<char> = word.chars().collect();
+    let mut parts: Vec<String> = Vec::new();
+    let mut cur = String::new();
+    for (i, &c) in chars.iter().enumerate() {
+        let k = kind(c);
+        if i > 0 {
+            let pk = kind(chars[i - 1]);
+            let next_lower = chars.get(i + 1).is_some_and(|n| n.is_lowercase());
+            let boundary = match (pk, k) {
+                (K::Lower, K::Upper) => true,
+                (K::Upper, K::Upper) => next_lower,
+                (a, b) if (a == K::Digit) != (b == K::Digit) => true,
+                _ => false,
+            };
+            if boundary && !cur.is_empty() {
+                parts.push(std::mem::take(&mut cur));
+            }
+        }
+        cur.push(c);
+    }
+    if !cur.is_empty() {
+        parts.push(cur);
+    }
+    parts
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn run(words: &[&str], text: &str) -> String {
+        let vocab = RepoVocab {
+            root: PathBuf::from("/repo"),
+            files: Vec::new(),
+            words: words.iter().map(|w| w.to_string()).collect(),
+        };
+        apply(text, &vocab)
+    }
+
+    #[test]
+    fn fixes_case_whole_words_only() {
+        assert_eq!(
+            run(
+                &["SwiftUI", "squawk"],
+                "the swiftui view in Squawk, not squawks"
+            ),
+            "the SwiftUI view in squawk, not squawks"
+        );
+    }
+
+    #[test]
+    fn rejoins_split_camel_case() {
+        assert_eq!(
+            run(&["VocabCache", "gpt5"], "the vocab cache and GPT 5."),
+            "the VocabCache and gpt5."
+        );
+    }
+
+    #[test]
+    fn phrases_match_in_a_row_only() {
+        assert_eq!(
+            run(&["Claude Code"], "ask claude code, not claude, code"),
+            "ask Claude Code, not claude, code"
+        );
+    }
+
+    #[test]
+    fn keeps_punctuation_around_a_match() {
+        assert_eq!(run(&["TOML"], "(toml), is it?"), "(TOML), is it?");
+        assert_eq!(
+            run(&["Claude Code"], "use claude code."),
+            "use Claude Code."
+        );
+    }
+
+    #[test]
+    fn leaves_mentions_and_paths_alone() {
+        assert_eq!(
+            run(&["audio"], "Audio in @src/Audio.rs and src/audio/x.rs"),
+            "audio in @src/Audio.rs and src/audio/x.rs"
+        );
+    }
+
+    #[test]
+    fn hyphenated_names_match_as_written() {
+        assert_eq!(
+            run(&["squawk-core"], "build Squawk-Core"),
+            "build squawk-core"
+        );
+    }
+
+    #[test]
+    fn untouched_text_is_returned_verbatim() {
+        assert_eq!(run(&["TOML"], "a  b   c"), "a  b   c");
+    }
+}
