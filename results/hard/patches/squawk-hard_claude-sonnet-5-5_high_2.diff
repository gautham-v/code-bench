new file mode 100644
index 0000000..f1c0def
--- /dev/null
+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,303 @@
+//! Finding the agent session behind the front terminal.
+//!
+//! The process table is read through libproc (no subprocesses). Everything
+//! after the read is plain data, so the choice of session is unit-testable.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use super::{is_terminal, Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// One process, as far as session detection cares.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Proc {
+    pub pid: i32,
+    pub ppid: i32,
+    /// Every name the process goes by: comm, long name, executable basename.
+    pub names: Vec<String>,
+    /// Controlling terminal device number, 0 if none.
+    pub tdev: u32,
+}
+
+/// An agent process under the terminal, before its cwd and tty are read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Candidate {
+    pub agent: Agent,
+    pub pid: i32,
+    pub tdev: u32,
+}
+
+pub fn detect(front: &FrontApp) -> Option<Session> {
+    if !is_terminal(&front.bundle_id) {
+        return None;
+    }
+    let procs = sys::list_procs();
+    let mut sessions: Vec<(Session, Option<SystemTime>)> = candidates(&procs, front.pid)
+        .into_iter()
+        .filter_map(|c| {
+            let cwd = sys::cwd(c.pid)?;
+            let tty = sys::tty_path(c.tdev);
+            let used = tty.as_deref().and_then(tty_last_used);
+            Some((
+                Session {
+                    agent: c.agent,
+                    pid: c.pid,
+                    cwd,
+                    tty,
+                },
+                used,
+            ))
+        })
+        .collect();
+    // Most recently used tty wins; a session with no readable tty loses to
+    // one with; the highest pid (newest) breaks remaining ties.
+    sessions.sort_by_key(|(s, used)| (*used, s.pid));
+    sessions.pop().map(|(s, _)| s)
+}
+
+/// Agent processes that descend from `front_pid`.
+pub(super) fn candidates(procs: &[Proc], front_pid: i32) -> Vec<Candidate> {
+    let parent: HashMap<i32, i32> = procs.iter().map(|p| (p.pid, p.ppid)).collect();
+    procs
+        .iter()
+        .filter_map(|p| {
+            let agent = agent_of(p)?;
+            descends_from(&parent, p.pid, front_pid).then_some(Candidate {
+                agent,
+                pid: p.pid,
+                tdev: p.tdev,
+            })
+        })
+        .collect()
+}
+
+fn agent_of(p: &Proc) -> Option<Agent> {
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(name, _)| p.names.iter().any(|n| n.eq_ignore_ascii_case(name)))
+        .map(|(_, agent)| *agent)
+}
+
+fn descends_from(parent: &HashMap<i32, i32>, pid: i32, ancestor: i32) -> bool {
+    let mut cur = pid;
+    // Bounded, so a loop in a stale table cannot spin.
+    for _ in 0..64 {
+        match parent.get(&cur) {
+            Some(&p) if p == ancestor => return true,
+            Some(&p) if p > 1 && p != cur => cur = p,
+            _ => return false,
+        }
+    }
+    false
+}
+
+fn tty_last_used(tty: &Path) -> Option<SystemTime> {
+    let m = std::fs::metadata(tty).ok()?;
+    match (m.accessed().ok(), m.modified().ok()) {
+        (Some(a), Some(b)) => Some(a.max(b)),
+        (a, b) => a.or(b),
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    use super::*;
+    use std::ffi::CStr;
+    use std::os::raw::{c_char, c_void};
+    use std::os::unix::fs::MetadataExt;
+
+    /// `PROC_ALL_PIDS` from <sys/proc_info.h>; libc does not export it.
+    const PROC_ALL_PIDS: u32 = 1;
+
+    fn cstr(buf: &[c_char]) -> String {
+        let bytes: Vec<u8> = buf
+            .iter()
+            .take_while(|&&c| c != 0)
+            .map(|&c| c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+
+    pub fn list_procs() -> Vec<Proc> {
+        let mut pids: Vec<i32> = Vec::new();
+        for _ in 0..4 {
+            let bytes = unsafe { libc::proc_listpids(PROC_ALL_PIDS, 0, std::ptr::null_mut(), 0) };
+            if bytes <= 0 {
+                return Vec::new();
+            }
+            // Room for processes that start between the two calls.
+            pids = vec![0i32; bytes as usize / 4 + 64];
+            let got = unsafe {
+                libc::proc_listpids(
+                    PROC_ALL_PIDS,
+                    0,
+                    pids.as_mut_ptr() as *mut c_void,
+                    (pids.len() * 4) as libc::c_int,
+                )
+            };
+            if got > 0 {
+                pids.truncate(got as usize / 4);
+                break;
+            }
+        }
+        pids.into_iter()
+            .filter(|&p| p > 0)
+            .filter_map(read_proc)
+            .collect()
+    }
+
+    fn read_proc(pid: i32) -> Option<Proc> {
+        let mut info: libc::proc_bsdinfo = unsafe { std::mem::zeroed() };
+        let size = std::mem::size_of::<libc::proc_bsdinfo>() as libc::c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            )
+        };
+        if got != size {
+            return None;
+        }
+        let mut names = vec![cstr(&info.pbi_comm), cstr(&info.pbi_name)];
+        // A versioned binary is still `claude` by its path.
+        let mut path = [0u8; 1024];
+        let n =
+            unsafe { libc::proc_pidpath(pid, path.as_mut_ptr() as *mut c_void, path.len() as u32) };
+        if n > 0 {
+            let p = String::from_utf8_lossy(&path[..n as usize]).into_owned();
+            if let Some(base) = Path::new(&p).file_name() {
+                names.push(base.to_string_lossy().into_owned());
+            }
+        }
+        names.retain(|n| !n.is_empty());
+        Some(Proc {
+            pid,
+            ppid: info.pbi_ppid as i32,
+            names,
+            tdev: info.e_tdev,
+        })
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        let mut info: libc::proc_vnodepathinfo = unsafe { std::mem::zeroed() };
+        let size = std::mem::size_of::<libc::proc_vnodepathinfo>() as libc::c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                &mut info as *mut _ as *mut c_void,
+                size,
+            )
+        };
+        if got != size {
+            return None;
+        }
+        let path = unsafe { CStr::from_ptr(info.pvi_cdir.vip_path.as_ptr() as *const c_char) };
+        let path = PathBuf::from(path.to_string_lossy().into_owned());
+        (path.is_absolute()).then_some(path)
+    }
+
+    /// The `/dev/ttysNNN` whose device number is `tdev`.
+    pub fn tty_path(tdev: u32) -> Option<PathBuf> {
+        if tdev == 0 || tdev == u32::MAX {
+            return None;
+        }
+        std::fs::read_dir("/dev")
+            .ok()?
+            .flatten()
+            .filter(|e| e.file_name().to_string_lossy().starts_with("ttys"))
+            .find(|e| e.metadata().is_ok_and(|m| m.rdev() == tdev as u64))
+            .map(|e| e.path())
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+mod sys {
+    use super::*;
+
+    pub fn list_procs() -> Vec<Proc> {
+        Vec::new()
+    }
+    pub fn cwd(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+    pub fn tty_path(_tdev: u32) -> Option<PathBuf> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn p(pid: i32, ppid: i32, name: &str) -> Proc {
+        Proc {
+            pid,
+            ppid,
+            names: vec![name.to_string()],
+            tdev: 0,
+        }
+    }
+
+    #[test]
+    fn finds_agents_under_the_terminal_only() {
+        let procs = [
+            p(10, 1, "Ghostty"),
+            p(11, 10, "zsh"),
+            p(12, 11, "claude"),
+            p(20, 1, "Other"),
+            p(21, 20, "zsh"),
+            p(22, 21, "codex"),
+            p(30, 12, "node"),
+        ];
+        let c = candidates(&procs, 10);
+        assert_eq!(c.len(), 1);
+        assert_eq!((c[0].pid, c[0].agent), (12, Agent::Claude));
+        let c = candidates(&procs, 20);
+        assert_eq!((c[0].pid, c[0].agent), (22, Agent::Codex));
+    }
+
+    #[test]
+    fn matches_any_of_a_process_names() {
+        let mut agent = p(12, 11, "2.1.4");
+        agent.names.push("claude".into());
+        let procs = [p(11, 10, "zsh"), agent];
+        assert_eq!(candidates(&procs, 10).len(), 1);
+    }
+
+    #[test]
+    fn parent_loops_terminate() {
+        let procs = [p(5, 6, "claude"), p(6, 5, "zsh")];
+        assert!(candidates(&procs, 99).is_empty());
+    }
+
+    #[test]
+    fn non_terminals_have_no_session() {
+        let front = FrontApp {
+            bundle_id: "com.apple.Safari".into(),
+            name: "Safari".into(),
+            pid: 1,
+        };
+        assert_eq!(detect(&front), None);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn libproc_reads_this_process() {
+        let me = std::process::id() as i32;
+        let procs = sys::list_procs();
+        let mine = procs.iter().find(|p| p.pid == me).expect("own pid listed");
+        assert_eq!(mine.ppid, unsafe { libc::getppid() });
+        assert!(!mine.names.is_empty());
+        let cwd = sys::cwd(me).expect("own cwd");
+        assert_eq!(
+            cwd.canonicalize().unwrap(),
+            std::env::current_dir().unwrap().canonicalize().unwrap()
+        );
+    }
+}
