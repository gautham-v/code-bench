index 0000000..a96614c
--- /dev/null
+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,510 @@
+//! Spoken file references to `@mentions`.
+//!
+//! "look at status item dot rs" → "look at @src/status_item.rs";
+//! "context slash mod dot rs" → "@src/context/mod.rs"; "the claude md" →
+//! "the @CLAUDE.md". A reference is only rewritten when it names exactly one
+//! tracked file. Zero matches, several matches, a folder that does not fit:
+//! the words stay as they were said.
+//!
+//! A reference is anchored on its extension, either after the word "dot"
+//! ("rs", or spelled out "r s") or, without "dot", a well-known extension
+//! word that is unlikely to be ordinary speech ("md", "toml", "json"...).
+//! Left of the anchor are the file's name words, and before those any number
+//! of `folder slash` pairs.
+
+use std::collections::HashSet;
+
+use super::RepoVocab;
+use crate::text::{self, Chunk};
+
+/// Extensions that may be said without "dot" ("cargo toml"). Ordinary words
+/// that happen to be extensions (`mod`, `lock`, `log`, `in`, `so`) are left out:
+/// "run go mod tidy" must not become "run @go.mod tidy".
+const BARE_EXTS: &[&str] = &[
+    "md", "toml", "json", "yaml", "yml", "rs", "py", "ts", "tsx", "js", "jsx", "swift", "html",
+    "css", "scss", "sh", "txt", "csv", "xml", "sql", "rb", "kt", "cpp", "hpp", "plist",
+];
+
+/// Most words a file's name or a folder's name is spoken in.
+const MAX_NAME_WORDS: usize = 4;
+const MAX_FOLDER_WORDS: usize = 3;
+const MAX_EXT_LETTERS: usize = 4;
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab) -> String {
+    if vocab.files.is_empty() {
+        return text.to_string();
+    }
+    let chunks = text::chunks(text);
+    let toks: Vec<Option<String>> = chunks.iter().map(token).collect();
+    if !toks
+        .iter()
+        .flatten()
+        .any(|t| t == "dot" || BARE_EXTS.contains(&t.as_str()))
+    {
+        return text.to_string();
+    }
+
+    let r = Resolver {
+        chunks: &chunks,
+        toks: &toks,
+        vocab,
+    };
+    let mut out: Vec<Chunk> = Vec::new();
+    let mut floor = 0; // first chunk not yet consumed or emitted
+    let mut i = 0;
+    let mut changed = false;
+    while i < chunks.len() {
+        if let Some(m) = r.mention_at(i, floor) {
+            // Chunks before the mention that were not consumed stay as they are.
+            out.extend(chunks[floor..m.start].iter().cloned());
+            out.push(Chunk {
+                lead: chunks[m.start].lead.clone(),
+                core: format!("@{}", m.path),
+                trail: chunks[m.end].trail.clone(),
+            });
+            floor = m.end + 1;
+            i = floor;
+            changed = true;
+        } else {
+            i += 1;
+        }
+    }
+    if !changed {
+        return text.to_string();
+    }
+    out.extend(chunks[floor..].iter().cloned());
+    text::join(&out)
+}
+
+/// The lowercase word a chunk contributes to a file reference, if it can
+/// contribute one: plain letters and digits, not already a path or mention.
+fn token(c: &Chunk) -> Option<String> {
+    if c.is_protected() || c.core.is_empty() {
+        return None;
+    }
+    c.core
+        .chars()
+        .all(|ch| ch.is_alphanumeric() || ch == '_' || ch == '-')
+        .then(|| c.core.to_lowercase())
+}
+
+/// Lowercase letters and digits only: "Status_Item", "status item" and
+/// "statusitem" are the same name.
+fn norm(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+struct Mention<'a> {
+    /// First and last chunk consumed.
+    start: usize,
+    end: usize,
+    path: &'a str,
+}
+
+struct Resolver<'a> {
+    chunks: &'a [Chunk],
+    toks: &'a [Option<String>],
+    vocab: &'a RepoVocab,
+}
+
+/// A tracked file with the parts a spoken reference is compared with.
+#[derive(Clone)]
+struct Cand<'a> {
+    path: &'a str,
+    /// Normalised name without the extension.
+    stem: String,
+    dirs: Vec<&'a str>,
+}
+
+impl<'a> Resolver<'a> {
+    /// Are chunks `a..=b` one unbroken run of speech: no punctuation between
+    /// them, every one a plain word?
+    fn run(&self, a: usize, b: usize) -> bool {
+        (a..=b).all(|i| {
+            self.toks[i].is_some()
+                && (i == a || self.chunks[i].lead.is_empty())
+                && (i == b || self.chunks[i].trail.is_empty())
+        })
+    }
+
+    fn tok(&self, i: usize) -> &str {
+        self.toks[i].as_deref().unwrap_or("")
+    }
+
+    /// A reference whose extension anchor is at chunk `i`, if there is one
+    /// and it resolves to a single file.
+    fn mention_at(&self, i: usize, floor: usize) -> Option<Mention<'a>> {
+        let t = self.toks[i].as_deref()?;
+        if t == "dot" {
+            // "<name> dot <ext>": the name is left of the dot.
+            if let Some(m) = self.dotted(i, floor) {
+                return m;
+            }
+            // ".gitignore": "dot <name>", no extension.
+            return self.dotfile(i, floor).flatten();
+        }
+        if BARE_EXTS.contains(&t) && i > floor {
+            return self.resolve(t, i, i, floor).flatten();
+        }
+        None
+    }
+
+    /// `Some(result)` once the text after "dot" read as a known extension
+    /// (the result is `None` for "known extension, but no unique file").
+    fn dotted(&self, dot: usize, floor: usize) -> Option<Option<Mention<'a>>> {
+        if dot <= floor || dot + 1 >= self.chunks.len() {
+            return None;
+        }
+        // Longest extension first: "t s x" before "t".
+        let first = self.toks[dot + 1].as_deref()?;
+        let spelled = first.chars().count() == 1;
+        let max = if spelled { MAX_EXT_LETTERS } else { 1 };
+        for n in (1..=max).rev() {
+            let last = dot + n;
+            if last >= self.chunks.len() || !self.run(dot, last) {
+                continue;
+            }
+            let ext: String = (dot + 1..=last).map(|k| self.tok(k)).collect();
+            if spelled && (dot + 1..=last).any(|k| self.tok(k).chars().count() != 1) {
+                continue;
+            }
+            if !self.has_ext(&ext) {
+                continue;
+            }
+            return Some(self.resolve(&ext, dot, last, floor).flatten());
+        }
+        None
+    }
+
+    fn dotfile(&self, dot: usize, floor: usize) -> Option<Option<Mention<'a>>> {
+        // The name words follow the dot; the "ext" is the whole name.
+        for n in (1..=MAX_NAME_WORDS).rev() {
+            let last = dot + n;
+            if last >= self.chunks.len() || !self.run(dot, last) {
+                continue;
+            }
+            let name = self.name_of(dot + 1, last + 1)?;
+            let cands: Vec<Cand> = self
+                .vocab
+                .files
+                .iter()
+                .filter_map(|f| {
+                    let (dirs, base) = split_path(f);
+                    let rest = base.strip_prefix('.')?;
+                    (!rest.contains('.') && norm(rest) == name).then(|| Cand {
+                        path: f,
+                        stem: name.clone(),
+                        dirs,
+                    })
+                })
+                .collect();
+            if cands.is_empty() {
+                continue;
+            }
+            return Some(self.pick(cands, dot, last, floor));
+        }
+        None
+    }
+
+    fn has_ext(&self, ext: &str) -> bool {
+        self.vocab
+            .files
+            .iter()
+            .any(|f| ext_of(f).is_some_and(|e| e.eq_ignore_ascii_case(ext)))
+    }
+
+    /// Resolve the name words left of `anchor` (the "dot", or the bare
+    /// extension word itself) against files with extension `ext`.
+    /// `end` is the last chunk of the reference.
+    fn resolve(
+        &self,
+        ext: &str,
+        anchor: usize,
+        end: usize,
+        floor: usize,
+    ) -> Option<Option<Mention<'a>>> {
+        let with_ext: Vec<Cand> = self
+            .vocab
+            .files
+            .iter()
+            .filter(|f| ext_of(f).is_some_and(|e| e.eq_ignore_ascii_case(ext)))
+            .map(|f| {
+                let (dirs, base) = split_path(f);
+                let stem = base.rsplit_once('.').map_or(base, |(s, _)| s);
+                Cand {
+                    path: f,
+                    stem: norm(stem),
+                    dirs,
+                }
+            })
+            .collect();
+        if with_ext.is_empty() {
+            return None;
+        }
+        // Longest name first: "status item" before "item".
+        for k in (1..=MAX_NAME_WORDS).rev() {
+            if anchor < floor + k || !self.run(anchor - k, anchor) {
+                continue;
+            }
+            let Some(name) = self.name_of(anchor - k, anchor) else {
+                continue;
+            };
+            let cands: Vec<Cand> = with_ext
+                .iter()
+                .filter(|c| c.stem == name)
+                .cloned()
+                .collect();
+            if cands.is_empty() {
+                continue;
+            }
+            return Some(self.pick(cands, anchor - k, end, floor));
+        }
+        None
+    }
+
+    /// The normalised name spoken in chunks `a..b`; "dot", "underscore" and
+    /// "dash" inside it are punctuation, not letters. `None` for a name
+    /// made of nothing or that starts or ends on "slash"/"dot".
+    fn name_of(&self, a: usize, b: usize) -> Option<String> {
+        let words: Vec<&str> = (a..b).map(|i| self.tok(i)).collect();
+        let edge = |w: &&str| matches!(*w, "slash" | "dot");
+        if words.contains(&"slash")
+            || words.first().is_some_and(edge)
+            || words.last().is_some_and(edge)
+        {
+            return None;
+        }
+        let name: String = words
+            .iter()
+            .filter(|w| {
+                words.len() == 1 || !matches!(**w, "dot" | "underscore" | "dash" | "hyphen")
+            })
+            .map(|w| norm(w))
+            .collect();
+        (!name.is_empty()).then_some(name)
+    }
+
+    /// Of the files that fit the name, those that also fit the spoken folders;
+    /// a mention only if exactly one is left. `name_start` is the first name
+    /// word; folder words (if any) sit before it.
+    fn pick(
+        &self,
+        cands: Vec<Cand<'a>>,
+        name_start: usize,
+        end: usize,
+        floor: usize,
+    ) -> Option<Mention<'a>> {
+        let mut fits: Vec<(usize, &'a str)> = Vec::new();
+        let mut seen: HashSet<&str> = HashSet::new();
+        for c in &cands {
+            if let Some(start) = self.folders_fit(&c.dirs, name_start, floor) {
+                if seen.insert(c.path) {
+                    fits.push((start, c.path));
+                }
+            }
+        }
+        match fits.as_slice() {
+            [(start, path)] if !path.contains(char::is_whitespace) => Some(Mention {
+                start: *start,
+                end,
+                path,
+            }),
+            _ => None,
+        }
+    }
+
+    /// Does the speech before `name_start` agree with the file's folders?
+    /// Returns the first chunk the reference covers, or `None` if a spoken
+    /// folder does not fit. No spoken folder always fits.
+    fn folders_fit(&self, dirs: &[&str], name_start: usize, floor: usize) -> Option<usize> {
+        let mut start = name_start;
+        let mut level = dirs.len();
+        // `start` is where the reference begins; a "slash" before it means
+        // another folder was spoken.
+        while start > floor && self.tok_opt(start - 1) == Some("slash") {
+            let slash = start - 1;
+            // The slash is glued to what follows it...
+            if !self.run(slash, start) {
+                return None;
+            }
+            level = level.checked_sub(1)?;
+            let want = norm(dirs[level]);
+            let mut matched = None;
+            for j in 1..=MAX_FOLDER_WORDS {
+                if slash < floor + j || !self.run(slash - j, slash) {
+                    continue;
+                }
+                let words: Vec<&str> = (slash - j..slash).map(|k| self.tok(k)).collect();
+                if words.iter().any(|w| matches!(*w, "slash" | "dot")) {
+                    continue;
+                }
+                let joined: String = words.iter().map(|w| norm(w)).collect();
+                if joined == want {
+                    matched = Some(slash - j);
+                    break;
+                }
+            }
+            start = matched?;
+        }
+        Some(start)
+    }
+
+    fn tok_opt(&self, i: usize) -> Option<&str> {
+        self.toks.get(i).and_then(|t| t.as_deref())
+    }
+}
+
+fn split_path(path: &str) -> (Vec<&str>, &str) {
+    let mut parts: Vec<&str> = path.split('/').collect();
+    let base = parts.pop().unwrap_or(path);
+    (parts, base)
+}
+
+fn ext_of(path: &str) -> Option<&str> {
+    let base = path.rsplit('/').next()?;
+    let (stem, ext) = base.rsplit_once('.')?;
+    (!stem.is_empty()).then_some(ext)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn vocab(files: &[&str]) -> RepoVocab {
+        RepoVocab {
+            root: PathBuf::from("/repo"),
+            files: files.iter().map(|f| f.to_string()).collect(),
+            words: Vec::new(),
+        }
+    }
+
+    fn files() -> RepoVocab {
+        vocab(&[
+            "CLAUDE.md",
+            "Cargo.toml",
+            "README.md",
+            ".gitignore",
+            "crates/core/Cargo.toml",
+            "crates/app/Cargo.toml",
+            "crates/app/src/status_item.rs",
+            "crates/app/src/main.rs",
+            "crates/core/src/main.rs",
+            "crates/core/src/context/mod.rs",
+            "crates/core/src/store/mod.rs",
+            "crates/core/src/audio.rs",
+            "docs/my notes.md",
+            "web/Foo.test.ts",
+            "go.mod",
+        ])
+    }
+
+    fn run(text: &str) -> String {
+        apply(text, &files())
+    }
+
+    #[test]
+    fn dot_form() {
+        assert_eq!(
+            run("take a look at status item dot rs"),
+            "take a look at @crates/app/src/status_item.rs"
+        );
+        assert_eq!(
+            run("open audio dot rs, then stop."),
+            "open @crates/core/src/audio.rs, then stop."
+        );
+        assert_eq!(run("see audio dot rs."), "see @crates/core/src/audio.rs.");
+    }
+
+    #[test]
+    fn bare_extension_form() {
+        assert_eq!(run("update the claude md"), "update the @CLAUDE.md");
+        assert_eq!(run("what does readme md say"), "what does @README.md say");
+    }
+
+    #[test]
+    fn spelled_out_extension_and_underscores() {
+        assert_eq!(
+            run("fix status underscore item dot r s now"),
+            "fix @crates/app/src/status_item.rs now"
+        );
+    }
+
+    #[test]
+    fn folders_disambiguate() {
+        assert_eq!(
+            run("look at context slash mod dot rs"),
+            "look at @crates/core/src/context/mod.rs"
+        );
+        assert_eq!(
+            run("store slash mod dot rs is fine"),
+            "@crates/core/src/store/mod.rs is fine"
+        );
+        assert_eq!(run("app slash cargo toml"), "@crates/app/Cargo.toml");
+    }
+
+    #[test]
+    fn ambiguous_stays_as_spoken() {
+        assert_eq!(run("open main dot rs"), "open main dot rs");
+        assert_eq!(run("open mod dot rs"), "open mod dot rs");
+        assert_eq!(run("edit the cargo toml"), "edit the cargo toml");
+    }
+
+    #[test]
+    fn unknown_or_partial_folder_stays() {
+        assert_eq!(
+            run("open nope slash audio dot rs"),
+            "open nope slash audio dot rs"
+        );
+        assert_eq!(run("open missing dot rs"), "open missing dot rs");
+        assert_eq!(run("open audio dot py"), "open audio dot py");
+    }
+
+    #[test]
+    fn ordinary_words_are_not_extensions() {
+        assert_eq!(run("run go mod tidy"), "run go mod tidy");
+        assert_eq!(
+            run("the dot product of two vectors"),
+            "the dot product of two vectors"
+        );
+    }
+
+    #[test]
+    fn dotfiles_and_multi_dot_names() {
+        assert_eq!(run("add it to dot gitignore"), "add it to @.gitignore");
+        assert_eq!(run("run foo dot test dot ts"), "run @web/Foo.test.ts");
+    }
+
+    #[test]
+    fn spaces_in_a_path_are_never_mentioned() {
+        assert_eq!(run("read my notes dot md"), "read my notes dot md");
+    }
+
+    #[test]
+    fn punctuation_breaks_a_reference() {
+        assert_eq!(run("status, item dot rs"), "status, item dot rs");
+        assert_eq!(run("audio. Dot rs"), "audio. Dot rs");
+    }
+
+    #[test]
+    fn existing_mentions_and_paths_are_left_alone() {
+        let text = "look at @src/audio.rs and src/audio.rs and main.rs";
+        assert_eq!(run(text), text);
+    }
+
+    #[test]
+    fn two_references_in_one_sentence() {
+        assert_eq!(
+            run("compare audio dot rs with the claude md"),
+            "compare @crates/core/src/audio.rs with the @CLAUDE.md"
+        );
+    }
+
+    #[test]
+    fn no_files_no_change() {
+        assert_eq!(apply("audio dot rs", &vocab(&[])), "audio dot rs");
+    }
+}
