@@ -0,0 +1,600 @@
+//! What a repo offers for fixing a transcript: its files and its jargon.
+//!
+//! Files come from `git ls-files` (a bounded walk outside git); jargon from
+//! the project's own names (directory, crate/package names, file stems) and
+//! the prose docs the agent itself reads (README.md, CLAUDE.md, CONTEXT.md,
+//! AGENTS.md). Only terms whose casing carries meaning are kept: forcing
+//! "license" to "LICENSE" because a file is called that would be worse than
+//! leaving the model's spelling alone.
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::Arc;
+use std::time::{Duration, Instant, SystemTime};
+
+use regex::Regex;
+
+use super::RepoVocab;
+use crate::text;
+
+/// Outside git there is no index to watch; rebuild after this long.
+const WALK_TTL: Duration = Duration::from_secs(2);
+const MAX_WALK_FILES: usize = 20_000;
+const MAX_WALK_DEPTH: usize = 10;
+const MAX_WORDS: usize = 2_000;
+const MAX_DOC_BYTES: u64 = 256 * 1024;
+const MAX_MANIFESTS: usize = 64;
+const DOC_FILES: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+const SKIP_DIRS: &[&str] = &[
+    ".git",
+    "node_modules",
+    "target",
+    "dist",
+    "build",
+    "out",
+    "vendor",
+    "venv",
+    ".venv",
+    "__pycache__",
+    ".next",
+    ".cache",
+    "Pods",
+    "DerivedData",
+];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let files = list_files(cwd);
+    let words = collect_words(cwd, &files);
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words,
+    }
+}
+
+// ---- files ---------------------------------------------------------------
+
+fn list_files(cwd: &Path) -> Vec<String> {
+    if git_dir(cwd).is_some() {
+        if let Some(files) = git_ls_files(cwd).filter(|f| !f.is_empty()) {
+            return files;
+        }
+    }
+    walk(cwd)
+}
+
+fn git_ls_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        .args(["-c", "core.quotepath=off", "ls-files", "-z"])
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let mut files: Vec<String> = out
+        .stdout
+        .split(|&b| b == 0)
+        .filter(|p| !p.is_empty())
+        .map(|p| String::from_utf8_lossy(p).into_owned())
+        // Deleted from the work tree, or a submodule: not mentionable.
+        .filter(|p| cwd.join(p).is_file())
+        .collect();
+    files.sort();
+    files.dedup();
+    Some(files)
+}
+
+fn walk(root: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    let mut stack = vec![(root.to_path_buf(), 0usize)];
+    while let Some((dir, depth)) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let name = entry.file_name().to_string_lossy().into_owned();
+            let path = entry.path();
+            if kind.is_dir() {
+                if depth < MAX_WALK_DEPTH && !SKIP_DIRS.contains(&name.as_str()) {
+                    stack.push((path, depth + 1));
+                }
+            } else if kind.is_file() || (kind.is_symlink() && path.is_file()) {
+                if let Ok(rel) = path.strip_prefix(root) {
+                    files.push(rel.to_string_lossy().replace('\\', "/"));
+                }
+            }
+        }
+        if files.len() >= MAX_WALK_FILES {
+            break;
+        }
+    }
+    files.sort();
+    files.truncate(MAX_WALK_FILES);
+    files
+}
+
+// ---- cache stamps --------------------------------------------------------
+
+/// The `.git` directory of the repo containing `cwd` (following a worktree's
+/// `.git` file).
+pub(super) fn git_dir(cwd: &Path) -> Option<PathBuf> {
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        if dot_git.is_dir() {
+            return Some(dot_git);
+        }
+        if dot_git.is_file() {
+            let text = std::fs::read_to_string(&dot_git).ok()?;
+            let target = Path::new(text.trim().strip_prefix("gitdir:")?.trim());
+            return Some(if target.is_absolute() {
+                target.to_path_buf()
+            } else {
+                dir.join(target)
+            });
+        }
+    }
+    None
+}
+
+/// What a cached vocab was built against.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Stamp {
+    /// A git repo: the mtime of `.git/index` (`None` before the first add).
+    Index(Option<SystemTime>),
+    /// Not git: when it was built.
+    Built(Instant),
+}
+
+impl Stamp {
+    pub fn now(cwd: &Path) -> Stamp {
+        match git_dir(cwd) {
+            Some(dir) => Stamp::Index(
+                std::fs::metadata(dir.join("index"))
+                    .and_then(|m| m.modified())
+                    .ok(),
+            ),
+            None => Stamp::Built(Instant::now()),
+        }
+    }
+
+    /// Is something built under `self` still good now?
+    pub fn is_fresh(&self, cwd: &Path) -> bool {
+        match (self, Stamp::now(cwd)) {
+            (Stamp::Index(a), Stamp::Index(b)) => *a == b,
+            (Stamp::Built(at), Stamp::Built(_)) => at.elapsed() < WALK_TTL,
+            _ => false,
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct Entry {
+    pub vocab: Arc<RepoVocab>,
+    pub stamp: Stamp,
+}
+
+// ---- words ---------------------------------------------------------------
+
+fn collect_words(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut words = WordSet::default();
+
+    // The project's own names.
+    if let Some(name) = cwd.file_name().map(|n| n.to_string_lossy().into_owned()) {
+        if name.len() >= 3 && is_identifier(&name) {
+            words.add(&name);
+        }
+    }
+    let mut manifests = 0;
+    for file in files {
+        let base = file.rsplit('/').next().unwrap_or(file);
+        if !matches!(
+            base,
+            "Cargo.toml" | "pyproject.toml" | "package.json" | "go.mod"
+        ) {
+            continue;
+        }
+        manifests += 1;
+        if manifests > MAX_MANIFESTS {
+            break;
+        }
+        if let Some(name) = package_name(base, &cwd.join(file)).filter(|n| is_identifier(n)) {
+            words.add(&name);
+        }
+    }
+
+    // Docs before file names: their casing wins.
+    for doc in DOC_FILES {
+        let path = cwd.join(doc);
+        if !std::fs::metadata(&path).is_ok_and(|m| m.is_file() && m.len() <= MAX_DOC_BYTES) {
+            continue;
+        }
+        if let Ok(text) = std::fs::read_to_string(&path) {
+            for term in doc_terms(&text) {
+                words.add(&term);
+            }
+        }
+    }
+
+    // File and directory names with structure to them.
+    let mut seen: HashSet<&str> = HashSet::new();
+    for file in files {
+        let mut parts = file.split('/').peekable();
+        while let Some(part) = parts.next() {
+            if !seen.insert(part) {
+                continue;
+            }
+            let stem = if parts.peek().is_none() {
+                part.rsplit_once('.').map_or(part, |(s, _)| s)
+            } else {
+                part
+            };
+            if is_distinctive(stem) && !is_shouting(stem) {
+                words.add(stem);
+            }
+        }
+    }
+    words.list
+}
+
+#[derive(Default)]
+struct WordSet {
+    seen: HashSet<String>,
+    list: Vec<String>,
+}
+
+impl WordSet {
+    /// The first spelling of a word (case-insensitively) wins.
+    fn add(&mut self, word: &str) {
+        if self.list.len() < MAX_WORDS && self.seen.insert(word.to_lowercase()) {
+            self.list.push(word.to_string());
+        }
+    }
+}
+
+fn package_name(manifest: &str, path: &Path) -> Option<String> {
+    let text = std::fs::read_to_string(path).ok()?;
+    match manifest {
+        "package.json" => {
+            let re = Regex::new(r#""name"\s*:\s*"([^"]+)""#).ok()?;
+            let name = re.captures(&text)?[1].to_string();
+            Some(name.rsplit('/').next().unwrap_or(&name).to_string())
+        }
+        "go.mod" => {
+            let module = text
+                .lines()
+                .find_map(|l| l.trim().strip_prefix("module "))?
+                .trim();
+            Some(module.rsplit('/').next().unwrap_or(module).to_string())
+        }
+        _ => {
+            // Cargo.toml [package], pyproject.toml [project] / [tool.poetry].
+            let mut in_section = false;
+            for line in text.lines() {
+                let line = line.trim();
+                if line.starts_with('[') {
+                    in_section = matches!(line, "[package]" | "[project]" | "[tool.poetry]");
+                } else if in_section {
+                    if let Some(rest) = line.strip_prefix("name") {
+                        let value = rest.trim_start().strip_prefix('=')?.trim();
+                        return Some(value.trim_matches(['"', '\'']).to_string());
+                    }
+                }
+            }
+            None
+        }
+    }
+}
+
+/// `[A-Za-z0-9_-]+` starting with a letter.
+fn is_identifier(s: &str) -> bool {
+    s.chars().next().is_some_and(|c| c.is_ascii_alphabetic())
+        && s.chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-')
+}
+
+/// A name whose spelling is information: a separator inside, inner capitals,
+/// or letters mixed with digits. Plain words are not: the model already
+/// spells them right.
+fn is_distinctive(s: &str) -> bool {
+    if s.len() < 3 || !is_identifier(s) {
+        return false;
+    }
+    let inner_sep = s.trim_matches(['_', '-']).contains(['_', '-']);
+    let inner_case = text::has_inner_case(s) && s.chars().any(char::is_lowercase);
+    let mixed_digits = s.chars().any(|c| c.is_ascii_digit());
+    inner_sep || inner_case || mixed_digits
+}
+
+/// `README`, `CLAUDE`, `MAX_LEN`: a file or constant name, not a term to force
+/// into prose.
+fn is_shouting(s: &str) -> bool {
+    s.chars().any(char::is_alphabetic) && !s.chars().any(char::is_lowercase)
+}
+
+fn is_acronym(w: &str) -> bool {
+    (2..=6).contains(&w.chars().count()) && w.chars().all(|c| c.is_ascii_uppercase())
+}
+
+/// Capitals used for emphasis, not acronyms.
+const EMPHASIS: &[&str] = &[
+    "note",
+    "todo",
+    "fixme",
+    "important",
+    "never",
+    "always",
+    "must",
+    "should",
+    "warning",
+    "caution",
+    "tip",
+    "do",
+    "not",
+    "yes",
+    "no",
+    "ok",
+    "only",
+    "all",
+    "any",
+    "and",
+    "or",
+    "the",
+    "if",
+    "when",
+    "use",
+    "run",
+    "see",
+    "we",
+    "you",
+    "it",
+    "is",
+    "in",
+    "on",
+    "off",
+    "to",
+    "for",
+    "of",
+];
+
+/// Capitalised words that are not names even in the middle of a sentence.
+const COMMON_CAPS: &[&str] = &[
+    "the", "and", "for", "with", "this", "that", "see", "note", "also", "but", "not", "you", "yes",
+    "can", "may", "then", "when", "what", "who", "how", "why", "all", "any", "none",
+];
+
+struct Tok {
+    word: String,
+    starts_sentence: bool,
+    /// A name cannot run from the previous token into this one.
+    breaks_before: bool,
+    /// Headings and tables are Title Case: they name nothing.
+    may_name: bool,
+}
+
+impl Tok {
+    fn is_cap_word(&self) -> bool {
+        let mut chars = self.word.chars();
+        chars.next().is_some_and(char::is_uppercase)
+            && self.word.chars().count() >= 3
+            && chars.all(char::is_lowercase)
+    }
+}
+
+/// Terms from one markdown document, in the casing the document uses.
+fn doc_terms(doc: &str) -> Vec<String> {
+    let code_span = Regex::new(r"`([^`\n]+)`").unwrap();
+    let link_target = Regex::new(r"\]\([^)\s]*\)").unwrap();
+    let url = Regex::new(r"https?://\S+").unwrap();
+
+    let mut out: Vec<String> = Vec::new();
+    let mut tokens: Vec<Tok> = Vec::new();
+    let mut in_fence = false;
+    let mut block_start = true;
+    let mut prev_punct = false;
+    let mut prev_sentence_end = false;
+
+    for line in doc.lines() {
+        let trimmed = line.trim();
+        if trimmed.starts_with("```") || trimmed.starts_with("~~~") {
+            in_fence = !in_fence;
+            block_start = true;
+            continue;
+        }
+        if in_fence {
+            continue;
+        }
+        if trimmed.is_empty() {
+            block_start = true;
+            continue;
+        }
+        let heading = trimmed.starts_with('#');
+        let table = trimmed.starts_with('|');
+        let list = trimmed.starts_with(['-', '*', '+', '>'])
+            || trimmed
+                .split_once(". ")
+                .is_some_and(|(n, _)| !n.is_empty() && n.chars().all(|c| c.is_ascii_digit()));
+        if heading || table || list {
+            block_start = true;
+        }
+
+        // Inline code: identifiers with structure, then out of the prose.
+        for cap in code_span.captures_iter(trimmed) {
+            for piece in
+                cap[1].split(|c: char| !(c.is_ascii_alphanumeric() || c == '_' || c == '-'))
+            {
+                if is_distinctive(piece) && !is_shouting(piece) {
+                    out.push(piece.to_string());
+                }
+            }
+        }
+        let prose = code_span.replace_all(trimmed, " ` ");
+        let prose = link_target.replace_all(&prose, "]");
+        let prose = url.replace_all(&prose, " ` ");
+
+        for raw in prose.split_whitespace() {
+            let word = raw.trim_matches(|c: char| !c.is_alphanumeric());
+            if word.is_empty() {
+                // A list marker, a dash, a removed code span or URL.
+                prev_punct = true;
+                continue;
+            }
+            let starts_sentence = block_start || prev_sentence_end;
+            tokens.push(Tok {
+                word: word.to_string(),
+                starts_sentence,
+                breaks_before: starts_sentence || prev_punct,
+                may_name: !(heading || table),
+            });
+            block_start = false;
+            let tail = raw.trim_end_matches(['"', '\'', ')', ']', '”', '’', '*', '_']);
+            prev_sentence_end = tail.ends_with(['.', '!', '?', ':']);
+            prev_punct = raw.ends_with(|c: char| !c.is_alphanumeric());
+        }
+        if heading || table {
+            block_start = true;
+        }
+    }
+
+    let lower_seen: HashSet<&str> = tokens
+        .iter()
+        .map(|t| t.word.as_str())
+        .filter(|w| !w.chars().any(char::is_uppercase))
+        .collect();
+
+    // Distinctive spellings and acronyms.
+    for t in &tokens {
+        let w = t.word.as_str();
+        let lower = w.to_lowercase();
+        let structured = is_distinctive(w) && !w.contains('-') && !is_shouting(w);
+        let acronym = is_acronym(w)
+            && !EMPHASIS.contains(&lower.as_str())
+            && !lower_seen.contains(lower.as_str());
+        if structured || acronym {
+            out.push(w.to_string());
+        }
+    }
+
+    // Names: capitalised words in the middle of a sentence. Alone, only when
+    // the doc never writes the word lowercase; in a run of two or more, only
+    // when it never writes the run lowercase ("Claude Code", not "Code").
+    let mut i = 0;
+    while i < tokens.len() {
+        let t = &tokens[i];
+        if !t.may_name || !t.is_cap_word() || t.starts_sentence {
+            i += 1;
+            continue;
+        }
+        let mut j = i + 1;
+        while j < tokens.len()
+            && !tokens[j].breaks_before
+            && tokens[j].may_name
+            && tokens[j].is_cap_word()
+        {
+            j += 1;
+        }
+        let run: Vec<&str> = tokens[i..j].iter().map(|t| t.word.as_str()).collect();
+        let joined = run.join(" ");
+        let lower = joined.to_lowercase();
+        if run.len() == 1 {
+            if !COMMON_CAPS.contains(&lower.as_str()) && !lower_seen.contains(lower.as_str()) {
+                out.push(joined);
+            }
+        } else if !doc.contains(&lower) {
+            out.push(joined);
+        }
+        i = j;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn doc_terms_keep_meaningful_spellings_only() {
+        let doc = "# Squawk Tool\n\n\
+            Local dictation for macOS. Hold fn and talk. Built for talking to Claude Code in a\n\
+            terminal, with a SwiftUI popover and the TOML config. It runs on NVIDIA's Parakeet model.\n\
+            IMPORTANT: never write code without tests. See `VocabCache` and `squawk-core`.\n\n\
+            ```\nIgnoredBlock here\n```\n";
+        let terms = doc_terms(doc);
+        for want in [
+            "macOS",
+            "Claude Code",
+            "SwiftUI",
+            "TOML",
+            "Parakeet",
+            "VocabCache",
+            "squawk-core",
+        ] {
+            assert!(terms.iter().any(|t| t == want), "{want} in {terms:?}");
+        }
+        for not in [
+            "Code",
+            "Local",
+            "Hold",
+            "IMPORTANT",
+            "Tool",
+            "Squawk",
+            "IgnoredBlock",
+            "See",
+        ] {
+            assert!(!terms.iter().any(|t| t == not), "{not} in {terms:?}");
+        }
+    }
+
+    #[test]
+    fn a_word_the_doc_also_writes_lowercase_is_not_forced() {
+        let terms = doc_terms("Use the Config file. The config is read once.\n");
+        assert!(!terms.iter().any(|t| t.eq_ignore_ascii_case("config")));
+    }
+
+    #[test]
+    fn distinctiveness() {
+        for w in ["status_item", "squawk-core", "VocabCache", "gpt5", "macOS"] {
+            assert!(is_distinctive(w), "{w}");
+        }
+        for w in ["audio", "Audio", "mod", "README", "a-", "_x"] {
+            assert!(!is_distinctive(w) || is_shouting(w), "{w}");
+        }
+    }
+
+    #[test]
+    fn walk_outside_git_skips_build_dirs() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        std::fs::create_dir_all(root.join("src")).unwrap();
+        std::fs::create_dir_all(root.join("node_modules/x")).unwrap();
+        std::fs::write(root.join("src/a.rs"), "").unwrap();
+        std::fs::write(root.join("node_modules/x/b.js"), "").unwrap();
+        assert_eq!(build(root).files, ["src/a.rs"]);
+    }
+
+    #[test]
+    fn manifests_and_stems_become_words() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        std::fs::create_dir_all(root.join("crates/core/src")).unwrap();
+        std::fs::write(
+            root.join("crates/core/Cargo.toml"),
+            "[package]\nname = \"squawk-core\"\n",
+        )
+        .unwrap();
+        std::fs::write(root.join("crates/core/src/status_item.rs"), "").unwrap();
+        std::fs::write(root.join("crates/core/src/audio.rs"), "").unwrap();
+        let vocab = build(root);
+        assert!(vocab.words.contains(&"squawk-core".to_string()));
+        assert!(vocab.words.contains(&"status_item".to_string()));
+        assert!(!vocab.words.contains(&"audio".to_string()));
+    }
+}
