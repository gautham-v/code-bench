+            "open @src/context/mod.rs"
+        );
+        assert_eq!(apply("open mod dot rs", &ctx), "open mod dot rs");
+        assert_eq!(
+            apply("open tests slash mod dot rs", &ctx),
+            "open tests slash mod dot rs"
+        );
+    }
+
+    #[test]
+    fn jargon_is_written_the_repo_way() {
+        let ctx = repo();
+        assert_eq!(
+            apply("ask claude code why parakeet is slow in squawk core", &ctx),
+            "ask Claude Code why Parakeet is slow in squawk-core"
+        );
+        // A file's name said in passing is prose, not a reference.
+        assert_eq!(
+            apply("the status item plays audio", &ctx),
+            "the status item plays audio"
+        );
+    }
+
+    #[test]
+    fn mentions_are_made_before_jargon_and_then_left_alone() {
+        let ctx = context(&["src/parakeet.rs"], &["Parakeet"]);
+        assert_eq!(
+            apply("parakeet lives in parakeet dot rs", &ctx),
+            "Parakeet lives in @src/parakeet.rs"
+        );
+        assert_eq!(
+            apply("see @src/parakeet.rs and parakeet.rs", &ctx),
+            "see @src/parakeet.rs and parakeet.rs"
+        );
+    }
+
+    #[test]
+    fn untouched_text_comes_back_as_it_was() {
+        let ctx = repo();
+        let text = "nothing  here\tnames a file,  or a term";
+        assert_eq!(apply(text, &ctx), text);
+        assert_eq!(apply("", &ctx), "");
+        let empty = context(&[], &[]);
+        assert_eq!(apply("status item dot rs", &empty), "status item dot rs");
+    }
+
+    #[test]
+    fn the_pipeline_runs_it_between_cleanup_and_the_dictionary() {
+        use crate::cleanup::CleanupOptions;
+        use crate::dictionary::Dictionary;
+        use crate::pipeline::finish;
+
+        let ctx = repo();
+        let opts = CleanupOptions::default();
+        let none = Dictionary::default();
+        assert_eq!(
+            finish(
+                "Um, take a look at status item dot rs.",
+                &none,
+                Some(&ctx),
+                &opts
+            ),
+            "Take a look at @src/status_item.rs"
+        );
+        assert_eq!(
+            finish(
+                "is parakeet used in audio dot rs?",
+                &none,
+                Some(&ctx),
+                &opts
+            ),
+            "Is Parakeet used in @src/audio.rs?"
+        );
+        // Without a session the same words are only cleaned up.
+        assert_eq!(
+            finish("take a look at status item dot rs", &none, None, &opts),
+            "Take a look at status item dot rs."
+        );
+        // The user's dictionary has the last word, but not inside a mention.
+        let dict = Dictionary::parse("parakeet -> the model\naudio -> sound\n");
+        assert_eq!(
+            finish(
+                "parakeet reads audio dot rs for audio",
+                &dict,
+                Some(&ctx),
+                &opts
+            ),
+            "The model reads @src/audio.rs for sound."
+        );
+    }
+
+    fn git(root: &Path, args: &[&str]) {
+        let status = std::process::Command::new("git")
+            .args(args)
+            .current_dir(root)
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .unwrap();
+        assert!(status.success(), "git {args:?}");
+    }
+
+    #[test]
+    fn cache_rebuilds_when_the_index_changes() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        git(root, &["init", "-q"]);
+        std::fs::write(root.join("audio.rs"), "").unwrap();
+        git(root, &["add", "."]);
+
+        let mut cache = VocabCache::new();
+        let first = cache.get(root);
+        assert_eq!(first.root, root);
+        assert_eq!(first.files, ["audio.rs"]);
+        assert!(Arc::ptr_eq(&first, &cache.get(root)));
+
+        std::fs::write(root.join("video.rs"), "").unwrap();
+        assert!(Arc::ptr_eq(&first, &cache.get(root)), "not tracked yet");
+        git(root, &["add", "."]);
+        let second = cache.get(root);
+        assert_eq!(second.files, ["audio.rs", "video.rs"]);
+        assert!(Arc::ptr_eq(&second, &cache.get(root)));
+    }
+
+    #[test]
+    fn cache_outside_git_notices_new_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        std::fs::write(root.join("notes.md"), "").unwrap();
+
+        let mut cache = VocabCache::new();
+        let first = cache.get(root);
+        assert_eq!(first.files, ["notes.md"]);
+        assert!(Arc::ptr_eq(&first, &cache.get(root)));
+
+        std::fs::write(root.join("todo.md"), "").unwrap();
+        assert_eq!(cache.get(root).files, ["notes.md", "todo.md"]);
+    }
+
+    #[test]
+    fn cache_keeps_each_directory_apart() {
+        let a = tempfile::tempdir().unwrap();
+        let b = tempfile::tempdir().unwrap();
+        std::fs::write(a.path().join("a.md"), "").unwrap();
+        std::fs::write(b.path().join("b.md"), "").unwrap();
+        let mut cache = VocabCache::new();
+        assert_eq!(cache.get(a.path()).files, ["a.md"]);
+        assert_eq!(cache.get(b.path()).files, ["b.md"]);
+        assert_eq!(cache.get(a.path()).files, ["a.md"]);
+    }
 }
