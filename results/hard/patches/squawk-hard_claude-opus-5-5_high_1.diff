index 0000000..7cd8f39
--- /dev/null
+++ b/crates/squawk-core/src/context/index.rs
@@ -0,0 +1,191 @@
+//! What [`apply`](super::apply) looks things up in.
+//!
+//! A [`RepoVocab`] is two plain lists, and scanning them on every dictation
+//! would cost milliseconds in a large repo. The lookup tables are derived
+//! once per vocab instead, and kept for as long as that vocab is alive:
+//! [`VocabCache::get`](super::VocabCache::get) builds them while the user is
+//! still talking, so `apply` only ever reads.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex, PoisonError, Weak};
+
+use super::jargon::{self, Rule};
+use super::vocab::stem;
+use super::{fold, mentions, RepoVocab};
+
+/// Indexes kept at once. The app has one or two vocabs alive; this only
+/// bounds a process that keeps making new ones.
+const MAX_KEPT: usize = 64;
+
+static KEPT: Mutex<Vec<(Weak<RepoVocab>, Arc<Index>)>> = Mutex::new(Vec::new());
+
+#[derive(Debug, Default)]
+pub(super) struct Index {
+    /// Folded file name (`statusitem.rs`) → the files (as indexes into
+    /// `RepoVocab::files`) that carry it.
+    names: HashMap<String, Vec<u32>>,
+    /// Folded word (`squawkcore`) → how the repo writes it.
+    spellings: HashMap<String, Spelling>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Spelling {
+    /// One spelling (an index into `RepoVocab::words`), and when hearing it
+    /// means it. `None`: never; the word is only a file's name, or has no
+    /// casing of its own.
+    One(u32, Option<Rule>),
+    /// The repo writes it more than one way.
+    Several,
+}
+
+impl Index {
+    /// The index for `vocab`, built the first time it is asked for.
+    pub fn of(vocab: &Arc<RepoVocab>) -> Arc<Index> {
+        let find = |kept: &Vec<(Weak<RepoVocab>, Arc<Index>)>| {
+            kept.iter()
+                .find(|(v, _)| std::ptr::eq(v.as_ptr(), Arc::as_ptr(vocab)))
+                .map(|(_, index)| index.clone())
+        };
+        {
+            let mut kept = KEPT.lock().unwrap_or_else(PoisonError::into_inner);
+            // A vocab that is gone takes its index with it. A live `Weak`
+            // also keeps the address from being reused, so a pointer match
+            // is the same vocab, and an `Arc`'s contents do not change.
+            kept.retain(|(v, _)| v.strong_count() > 0);
+            if let Some(index) = find(&kept) {
+                return index;
+            }
+        }
+        // Built outside the lock: another vocab's dictation need not wait.
+        let index = Arc::new(Index::build(vocab));
+        let mut kept = KEPT.lock().unwrap_or_else(PoisonError::into_inner);
+        if let Some(index) = find(&kept) {
+            return index;
+        }
+        if kept.len() >= MAX_KEPT {
+            kept.remove(0);
+        }
+        kept.push((Arc::downgrade(vocab), index.clone()));
+        index
+    }
+
+    fn build(vocab: &RepoVocab) -> Index {
+        let mut names: HashMap<String, Vec<u32>> = HashMap::new();
+        let mut stems: HashSet<&str> = HashSet::new();
+        for (i, file) in vocab.files.iter().enumerate() {
+            if let Some(stem) = stem(file) {
+                stems.insert(stem);
+            }
+            let name = file.rsplit('/').next().unwrap_or(file);
+            // A spoken name always has a dot in it, and a path with a space
+            // cannot be written as a bare @mention.
+            if name.contains('.') && !file.contains(char::is_whitespace) {
+                names
+                    .entry(mentions::name_key(name))
+                    .or_default()
+                    .push(i as u32);
+            }
+        }
+
+        let mut spellings: HashMap<String, Spelling> = HashMap::new();
+        for (i, word) in vocab.words.iter().enumerate() {
+            let key = fold(word);
+            if key.is_empty() {
+                continue;
+            }
+            let rule = jargon::rule_for(word, &key, stems.contains(word.as_str()));
+            spellings
+                .entry(key)
+                .and_modify(|known| {
+                    if !matches!(known, Spelling::One(j, _) if vocab.words[*j as usize] == *word) {
+                        *known = Spelling::Several;
+                    }
+                })
+                .or_insert(Spelling::One(i as u32, rule));
+        }
+        Index { names, spellings }
+    }
+
+    /// The files whose name folds to `key`.
+    pub fn files_named(&self, key: &str) -> &[u32] {
+        self.names.get(key).map_or(&[], Vec::as_slice)
+    }
+
+    pub fn spelling(&self, key: &str) -> Option<Spelling> {
+        self.spellings.get(key).copied()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn vocab(files: &[&str], words: &[&str]) -> Arc<RepoVocab> {
+        Arc::new(RepoVocab {
+            root: "/repo".into(),
+            files: files.iter().map(|f| f.to_string()).collect(),
+            words: words.iter().map(|w| w.to_string()).collect(),
+        })
+    }
+
+    #[test]
+    fn one_index_per_vocab_for_as_long_as_it_lives() {
+        let a = vocab(&["src/audio.rs"], &[]);
+        let b = vocab(&["src/video.rs"], &[]);
+        let index = Index::of(&a);
+        assert!(Arc::ptr_eq(&index, &Index::of(&a)));
+        assert!(Arc::ptr_eq(&index, &Index::of(&a.clone())));
+        assert_eq!(index.files_named("audio.rs"), [0]);
+        assert!(Index::of(&b).files_named("audio.rs").is_empty());
+
+        drop(a);
+        // Whatever is at that address next is a different vocab.
+        let c = vocab(&["lib/audio.rs", "src/audio.rs"], &[]);
+        assert_eq!(Index::of(&c).files_named("audio.rs"), [0, 1]);
+    }
+
+    #[test]
+    fn file_names_fold() {
+        let v = vocab(
+            &[
+                "src/status_item.rs",
+                "web/StatusItem.rs",
+                "docs/my notes.md",
+                "Makefile",
+            ],
+            &[],
+        );
+        let index = Index::of(&v);
+        assert_eq!(index.files_named("statusitem.rs"), [0, 1]);
+        assert!(index.files_named("mynotes.md").is_empty());
+        assert!(index.files_named("makefile").is_empty());
+    }
+
+    #[test]
+    fn spellings() {
+        let v = vocab(
+            &["src/status_item.rs", "README.md"],
+            &[
+                "Parakeet",
+                "GitHub",
+                "Github",
+                "status_item",
+                "README",
+                "audio",
+            ],
+        );
+        let index = Index::of(&v);
+        assert_eq!(
+            index.spelling("parakeet"),
+            Some(Spelling::One(0, Some(Rule::Word)))
+        );
+        assert_eq!(index.spelling("github"), Some(Spelling::Several));
+        assert_eq!(index.spelling("statusitem"), Some(Spelling::One(3, None)));
+        assert_eq!(
+            index.spelling("readme"),
+            Some(Spelling::One(4, Some(Rule::Word)))
+        );
+        assert_eq!(index.spelling("audio"), Some(Spelling::One(5, None)));
+        assert_eq!(index.spelling("tokio"), None);
+    }
+}
diff --git a/crates/squawk-core/src/context/jargon.rs b/crates/squawk-core/src/context/jargon.rs
new file mode 100644
index 0000000..7d111ec
--- /dev/null
+++ b/crates/squawk-core/src/context/jargon.rs
@@ -0,0 +1,328 @@
+//! Repo jargon, written the way the repo writes it.
+//!
+//! A vocab word is matched by what it sounds like: its letters and digits,
+//! whatever the case and however the model split or joined them. "squawk
+//! core" is `squawk-core`, "vocab cache" is `VocabCache`, "nvidia" is
+//! `NVIDIA`. What is matched is rewritten only when the repo's spelling is
+//! clearly meant:
+//! - a plain word (`Parakeet`) must be heard as one word, and only its
+//!   capitals are the repo's to give;
+//! - a compound that reads as a phrase (`launch_at_login`) is not joined up;
+//! - a word that is only a file's name is left to @mentions: `CLAUDE.md` and
+//!   `status_item.rs` do not make "ask Claude" or "the status item" theirs;
+//! - a word the repo spells two ways is left as heard.
+
+use super::fold;
+use super::index::{Index, Spelling};
+use crate::dictionary::split_jargon;
+use crate::text::Chunk;
+
+/// Most spoken words one term is matched against.
+const MAX_SPAN: usize = 6;
+
+/// A compound with one of these in it is a phrase with underscores
+/// (`launch_at_login`, `isOpen`), and saying the phrase is not naming it.
+const LINKING_WORDS: &[&str] = &[
+    "a", "an", "and", "as", "at", "be", "by", "do", "for", "from", "in", "is", "it", "me", "my",
+    "no", "not", "of", "on", "or", "out", "the", "to", "up", "with",
+];
+
+/// File names that are words in their own right: "the readme" is the file,
+/// and `README` is how to write it.
+const NAMED_FILES: &[&str] = &[
+    "readme",
+    "changelog",
+    "codeowners",
+    "makefile",
+    "dockerfile",
+    "gemfile",
+    "procfile",
+    "rakefile",
+    "justfile",
+    "jenkinsfile",
+    "vagrantfile",
+    "brewfile",
+    "podfile",
+];
+
+/// A chunk as it is matched: folded, with a possessive set aside.
+struct Piece<'a> {
+    key: String,
+    /// `'s`, re-attached after the rewrite.
+    possessive: &'a str,
+}
+
+/// When hearing words that sound like a term means the term.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Rule {
+    /// However it was split: `squawk-core`, `VocabCache`, `Claude Code`.
+    Always,
+    /// Only when heard as one word, or spelled out letter by letter:
+    /// `Parakeet`, `API`. "To get her" is not `Together`.
+    Word,
+    /// Only when already joined up: `launch_at_login`.
+    Joined,
+}
+
+/// The rule for a vocab word (`key` is the word folded), or `None` if it is
+/// never rewritten. `is_stem`: some file's name is exactly this word.
+pub(super) fn rule_for(word: &str, key: &str, is_stem: bool) -> Option<Rule> {
+    if is_stem && !NAMED_FILES.contains(&key) {
+        return None;
+    }
+    if word.contains(char::is_whitespace) {
+        return Some(Rule::Always);
+    }
+    let parts = parts(word);
+    if parts.len() < 2 {
+        // A plain word: only its capitals are the repo's to give.
+        return word.chars().any(char::is_uppercase).then_some(Rule::Word);
+    }
+    let phrase = parts
+        .iter()
+        .any(|p| LINKING_WORDS.contains(&p.to_lowercase().as_str()));
+    Some(if phrase { Rule::Joined } else { Rule::Always })
+}
+
+/// Rewrite the jargon in `chunks`. Returns whether anything changed.
+pub(super) fn apply(chunks: &mut Vec<Chunk>, words: &[String], index: &Index) -> bool {
+    let pieces: Vec<Option<Piece>> = chunks.iter().map(piece).collect();
+    let mut out: Vec<Chunk> = Vec::with_capacity(chunks.len());
+    let mut changed = false;
+    let mut i = 0;
+    while i < chunks.len() {
+        // Longest first: "claude code mode" before "claude code".
+        let keys = span_keys(chunks, &pieces, i);
+        let hit = (1..=keys.len()).rev().find_map(|len| {
+            // Spelled two ways, there is no telling which is meant.
+            let Spelling::One(word, Some(rule)) = index.spelling(&keys[len - 1])? else {
+                return None;
+            };
+            let meant = match rule {
+                Rule::Always => true,
+                Rule::Joined => len == 1,
+                Rule::Word => {
+                    len == 1
+                        || pieces[i..i + len]
+                            .iter()
+                            .flatten()
+                            .all(|p| p.key.chars().count() == 1)
+                }
+            };
+            meant.then_some((len, words[word as usize].as_str()))
+        });
+        let Some((len, word)) = hit else {
+            out.push(chunks[i].clone());
+            i += 1;
+            continue;
+        };
+        let last = i + len - 1;
+        let possessive = pieces[last].as_ref().map_or("", |p| p.possessive);
+        let rewritten = Chunk {
+            lead: chunks[i].lead.clone(),
+            core: format!("{word}{possessive}"),
+            trail: chunks[last].trail.clone(),
+        };
+        changed |= len > 1 || rewritten != chunks[i];
+        out.push(rewritten);
+        i += len;
+    }
+    if changed {
+        *chunks = out;
+    }
+    changed
+}
+
+fn piece(chunk: &Chunk) -> Option<Piece<'_>> {
+    let wordy = |c: char| c.is_alphanumeric() || matches!(c, '-' | '_' | '\'' | '’');
+    if chunk.is_protected() || !chunk.core.chars().all(wordy) {
+        return None;
+    }
+    let (base, possessive) = ["'s", "’s", "'S", "’S"]
+        .iter()
+        .find_map(|s| {
+            Some((
+                chunk.core.strip_suffix(s)?,
+                &chunk.core[chunk.core.len() - s.len()..],
+            ))
+        })
+        .unwrap_or((chunk.core.as_str(), ""));
+    let key = fold(base);
+    (!key.is_empty()).then_some(Piece { key, possessive })
+}
+
+/// The folded text of each run of words starting at `start`, shortest first.
+/// A run stops at punctuation, at a protected chunk and after a possessive.
+fn span_keys(chunks: &[Chunk], pieces: &[Option<Piece>], start: usize) -> Vec<String> {
+    let mut keys: Vec<String> = Vec::new();
+    for i in start..chunks.len().min(start + MAX_SPAN) {
+        let Some(piece) = &pieces[i] else { break };
+        if i > start {
+            let before = &chunks[i - 1];
+            let apart = !before.trail.is_empty()
+                || !chunks[i].lead.is_empty()
+                || pieces[i - 1]
+                    .as_ref()
+                    .is_some_and(|p| !p.possessive.is_empty());
+            if apart {
+                break;
+            }
+        }
+        let mut key = keys.last().cloned().unwrap_or_default();
+        key.push_str(&piece.key);
+        keys.push(key);
+    }
+    keys
+}
+
+/// `status_item` → status, item; `VocabCache` → Vocab, Cache; `gpt5` → gpt, 5.
+fn parts(word: &str) -> Vec<String> {
+    word.split(|c: char| !c.is_alphanumeric())
+        .filter(|s| !s.is_empty())
+        .flat_map(split_jargon)
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use super::*;
+    use crate::context::RepoVocab;
+    use crate::text;
+
+    const WORDS: &[&str] = &[
+        "Claude Code",
+        "Parakeet",
+        "NVIDIA",
+        "API",
+        "VocabCache",
+        "macOS",
+        "squawk-core",
+        "paste_restore_ms",
+        "claude_code_mode",
+        "launch_at_login",
+        "isOpen",
+        "GitHub",
+        "Github",
+        "gpui",
+        "README",
+        "CLAUDE",
+        "status_item",
+        "Button",
+        "audio",
+    ];
+    const FILES: &[&str] = &[
+        "README.md",
+        "CLAUDE.md",
+        "src/status_item.rs",
+        "src/audio.rs",
+        "web/Button.tsx",
+    ];
+
+    fn j(text: &str) -> String {
+        let vocab = Arc::new(RepoVocab {
+            root: "/repo".into(),
+            files: FILES.iter().map(|f| f.to_string()).collect(),
+            words: WORDS.iter().map(|w| w.to_string()).collect(),
+        });
+        let mut chunks = text::chunks(text);
+        let changed = apply(&mut chunks, &vocab.words, &Index::of(&vocab));
+        let out = text::join(&chunks);
+        assert_eq!(changed, out != text, "changed flag for {text:?}");
+        out
+    }
+
+    fn same(text: &str) {
+        assert_eq!(j(text), text);
+    }
+
+    #[test]
+    fn casing() {
+        assert_eq!(j("ask parakeet about nvidia"), "ask Parakeet about NVIDIA");
+        assert_eq!(j("on MacOS, the Api."), "on macOS, the API.");
+        assert_eq!(j("claude code is open"), "Claude Code is open");
+        same("ask Parakeet about NVIDIA");
+    }
+
+    #[test]
+    fn compounds_heard_as_separate_words() {
+        assert_eq!(j("bump squawk core today"), "bump squawk-core today");
+        assert_eq!(j("the vocab cache is stale"), "the VocabCache is stale");
+        assert_eq!(
+            j("set paste restore ms to 500"),
+            "set paste_restore_ms to 500"
+        );
+        assert_eq!(
+            j("Squawk-Core and vocabcache"),
+            "squawk-core and VocabCache"
+        );
+        assert_eq!(j("on mac OS"), "on macOS");
+    }
+
+    #[test]
+    fn the_longest_term_wins() {
+        assert_eq!(j("turn off claude code mode"), "turn off claude_code_mode");
+    }
+
+    #[test]
+    fn spelled_out_acronyms() {
+        assert_eq!(j("the a p i is down"), "the API is down");
+        // A plain word is not assembled from pieces.
+        same("para keet");
+    }
+
+    #[test]
+    fn phrases_are_not_joined_up() {
+        same("make it launch at login");
+        same("check that it is open");
+        // Already joined, it is the name.
+        assert_eq!(
+            j("the launch-at-login module"),
+            "the launch_at_login module"
+        );
+    }
+
+    #[test]
+    fn a_file_name_is_not_jargon() {
+        same("ask claude to fix the status item");
+        same("the button and the Audio");
+        // Except the files everyone calls by name.
+        assert_eq!(j("update the readme"), "update the README");
+    }
+
+    #[test]
+    fn two_spellings_are_left_alone() {
+        same("push to github");
+        same("push to git hub");
+    }
+
+    #[test]
+    fn lower_case_words_are_not_enforced() {
+        same("the GPUI docs");
+    }
+
+    #[test]
+    fn possessives_and_punctuation() {
+        assert_eq!(j("(parakeet's output)"), "(Parakeet's output)");
+        assert_eq!(
+            j("squawk core's tests, please."),
+            "squawk-core's tests, please."
+        );
+        // A comma between the words: two things, not one name.
+        same("squawk, core");
+        same("claude's code");
+    }
+
+    #[test]
+    fn protected_chunks_are_left_alone() {
+        same("see @src/parakeet.rs and parakeet.rs and `parakeet`");
+        assert_eq!(j("squawk @x/core.rs core"), "squawk @x/core.rs core");
+    }
+
+    #[test]
+    fn nothing_to_do() {
+        same("");
+        same("fix the resampler so it handles 48 kHz input");
+    }
+}
