new file mode 100644
index 0000000..37995ab
--- /dev/null
+++ b/crates/squawk-core/src/context/terms.rs
@@ -0,0 +1,442 @@
+//! The jargon a repo's markdown carries: the terms it writes in a way plain
+//! English would not.
+//!
+//! A word counts when its casing is a choice, not grammar:
+//! - inner capitals or all capitals anywhere, headings included (`GitHub`,
+//!   `NVIDIA`);
+//! - a capital in the middle of a sentence (`Parakeet`), or a run of them
+//!   (`Claude Code`, and `Claude` on its own, but not `Code`);
+//! - an identifier in a code span (`VocabCache`, `paste_restore_ms`).
+//!
+//! The first word of a sentence, title-cased headings, shouted lines
+//! (`DO NOT PUSH`) and words the same docs also write in lower case say
+//! nothing about casing and are skipped.
+
+use std::collections::HashSet;
+use std::sync::OnceLock;
+
+use regex::Regex;
+
+use crate::text;
+
+/// Longest capitalised run kept as one term.
+const MAX_PHRASE_WORDS: usize = 4;
+
+/// Words that get a capital from grammar, habit or emphasis, never as a
+/// name: the small words, and the verbs that open a sentence in docs ("Use
+/// Tokio", "Requires Xcode").
+#[rustfmt::skip]
+const NOT_TERMS: &[&str] = &[
+    "a", "about", "above", "add", "adds", "after", "again", "all", "also", "always", "an", "and",
+    "any", "are", "as", "ask", "at", "avoid", "based", "be", "because", "been", "before", "below",
+    "between", "both", "build", "builds", "built", "but", "by", "call", "can", "caution", "check",
+    "choose", "click", "configure", "could", "create", "critical", "default", "delete", "deploy",
+    "deprecated", "did", "disable", "do", "does", "done", "down", "during", "each", "either",
+    "else", "enable", "etc", "ever", "every", "everything", "exactly", "example", "examples",
+    "export", "false", "first", "fix", "fixme", "follow", "for", "from", "he", "here", "hold",
+    "how", "if", "import", "important", "in", "include", "includes", "install", "into", "is", "it",
+    "its", "just", "keep", "last", "least", "less", "make", "many", "may", "me", "might", "more",
+    "most", "must", "my", "neither", "never", "new", "next", "no", "none", "not", "note", "notes",
+    "nothing", "now", "null", "of", "off", "ok", "okay", "old", "on", "one", "only", "open",
+    "optional", "or", "other", "our", "out", "over", "own", "per", "please", "powered", "prefer",
+    "press", "put", "read", "remove", "require", "required", "requires", "run", "runs", "same",
+    "see", "select", "set", "shall", "she", "should", "since", "so", "some", "start", "stop",
+    "such", "support", "supports", "test", "than", "that", "the", "their", "then", "there",
+    "these", "they", "this", "those", "three", "through", "tip", "to", "todo", "too", "true",
+    "try", "two", "type", "under", "up", "update", "use", "uses", "using", "very", "via",
+    "warning", "was", "we", "were", "what", "when", "where", "which", "while", "who", "why",
+    "will", "with", "within", "without", "work", "works", "would", "write", "written", "yes",
+    "you", "your",
+];
+
+#[derive(Debug, Default)]
+pub(super) struct Terms {
+    /// Candidate terms, in the order first seen.
+    found: Vec<String>,
+    /// Whether a candidate is a single word (and so answers to `lower`).
+    single: Vec<bool>,
+    /// Every word the docs write entirely in lower case.
+    lower: HashSet<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Shape {
+    /// `Parakeet`: one capital, at the front.
+    Capitalised,
+    /// `NVIDIA`: all capitals.
+    Upper,
+    /// `GitHub`, `macOS`: capitals inside.
+    Mixed,
+}
+
+#[derive(Debug, Clone)]
+struct Word {
+    text: String,
+    shape: Shape,
+}
+
+/// A run of capitalised words with nothing between them.
+#[derive(Default)]
+struct Run {
+    words: Vec<Word>,
+    /// The first of them is the first word of its sentence.
+    opens_sentence: bool,
+}
+
+impl Terms {
+    /// Collect from one markdown document.
+    pub fn read(&mut self, markdown: &str) {
+        let mut fenced = false;
+        for line in markdown.lines() {
+            let line = line.trim();
+            if line.starts_with("```") || line.starts_with("~~~") {
+                fenced = !fenced;
+                continue;
+            }
+            if fenced || line.is_empty() {
+                continue;
+            }
+            let heading = line.starts_with('#');
+            // A table row is labels, not sentences.
+            let labels = heading || line.starts_with('|');
+            let prose = self.take_code_spans(line);
+            let prose = link_re().replace_all(&prose, "$1");
+            self.read_line(&prose, labels);
+        }
+    }
+
+    /// The terms, with the ones the docs also write in lower case dropped.
+    pub fn finish(self) -> Vec<String> {
+        let Terms {
+            found,
+            single,
+            lower,
+        } = self;
+        found
+            .into_iter()
+            .zip(single)
+            .filter(|(term, single)| !single || !lower.contains(&term.to_lowercase()))
+            .map(|(term, _)| term)
+            .collect()
+    }
+
+    /// Record the identifiers in `code spans` and blank the spans out.
+    fn take_code_spans(&mut self, line: &str) -> String {
+        let re = code_re();
+        for span in re.captures_iter(line) {
+            let code = &span[1];
+            // A lone lower-case word in backticks is a command or a key,
+            // spelled the way it is said.
+            if is_identifier(code)
+                && (code.contains(['_', '-']) || code.chars().any(char::is_uppercase))
+            {
+                self.push(code.to_string(), false);
+            }
+        }
+        // A bare `|` keeps the words either side of the span apart.
+        re.replace_all(line, " | ").into_owned()
+    }
+
+    fn read_line(&mut self, line: &str, labels: bool) {
+        let mut run = Run::default();
+        // A sentence-opening run, until the sentence is seen to go on: a
+        // line that is capitals from end to end is a title.
+        let mut opener: Option<Vec<Word>> = None;
+        let mut sentence_start = true;
+        for raw in line.split_whitespace() {
+            let start = raw.find(char::is_alphanumeric).unwrap_or(raw.len());
+            let end = raw
+                .char_indices()
+                .rev()
+                .find(|(_, c)| c.is_alphanumeric())
+                .map(|(i, c)| i + c.len_utf8())
+                .unwrap_or(start);
+            let (lead, core, trail) = (&raw[..start], &raw[start..end], &raw[end..]);
+            if core.is_empty() {
+                // A list marker, a dash, or what a blanked code span left:
+                // its place, and maybe the full stop that followed it.
+                opener = self.close(&mut run, labels).or(opener);
+                sentence_start |= raw.contains(['.', '!', '?', ':']);
+                continue;
+            }
+            let (core, possessive) = match core.strip_suffix("'s").or(core.strip_suffix("’s")) {
+                Some(base) => (base, true),
+                None => (core, false),
+            };
+            if !lead.is_empty() {
+                opener = self.close(&mut run, labels).or(opener);
+            }
+            let shape = shape_of(core);
+            if shape.is_none() {
+                opener = self.close(&mut run, labels).or(opener);
+            }
+            // This word follows whatever run came before it.
+            if let Some(words) = opener.take() {
+                if !sentence_start {
+                    self.keep_opener(&words);
+                }
+            }
+            match shape {
+                Some(shape) => {
+                    if run.words.is_empty() {
+                        run.opens_sentence = sentence_start;
+                    }
+                    run.words.push(Word {
+                        text: core.to_string(),
+                        shape,
+                    });
+                }
+                None if is_plain_lower(core) => {
+                    self.lower.insert(core.to_string());
+                }
+                // snake_case written straight into the prose.
+                None if is_identifier(core) && core.contains('_') => {
+                    self.push(core.to_string(), false);
+                }
+                None => {}
+            }
+            if possessive || !trail.is_empty() {
+                opener = self.close(&mut run, labels).or(opener);
+            }
+            sentence_start = trail.contains(['.', '!', '?', ':']);
+        }
+        self.close(&mut run, labels);
+    }
+
+    /// A run of capitalised words has ended: keep what it tells us. A run
+    /// that opens a sentence is handed back, to be kept only if the
+    /// sentence goes on after it.
+    fn close(&mut self, run: &mut Run, labels: bool) -> Option<Vec<Word>> {
+        let Run {
+            words,
+            opens_sentence,
+        } = std::mem::take(run);
+        // Two or more words in capitals are shouting, not acronyms.
+        if words.is_empty() || (words.len() > 1 && words.iter().all(|w| w.shape == Shape::Upper)) {
+            return None;
+        }
+        for w in &words {
+            if w.shape != Shape::Capitalised && !is_stop(&w.text) {
+                self.push(w.text.clone(), true);
+            }
+        }
+        // Past here the evidence is a capital where grammar asks for none,
+        // which a heading cannot give.
+        if labels {
+            return None;
+        }
+        if opens_sentence {
+            return (words.len() > 1).then_some(words);
+        }
+        self.keep_name(&words);
+        None
+    }
+
+    /// Capitalised words from the middle of a sentence.
+    fn keep_name(&mut self, words: &[Word]) {
+        match words {
+            [w] => {
+                if w.shape == Shape::Capitalised && !is_stop(&w.text) {
+                    self.push(w.text.clone(), true);
+                }
+            }
+            many if many.len() <= MAX_PHRASE_WORDS && !many.iter().all(|w| is_stop(&w.text)) => {
+                let phrase: Vec<&str> = many.iter().map(|w| w.text.as_str()).collect();
+                self.push(phrase.join(" "), false);
+                // The first word of a name is the name ("Claude" in "Claude
+                // Code"); the rest are ordinary words that it capitalises.
+                let first = &many[0];
+                if first.shape == Shape::Capitalised && !is_stop(&first.text) {
+                    self.push(first.text.clone(), true);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A run that opened a sentence which then went on. Its first word has
+    /// its capital from grammar, so what it says depends on that word.
+    fn keep_opener(&mut self, words: &[Word]) {
+        let first = &words[0];
+        if first.shape != Shape::Capitalised {
+            // "NVIDIA Parakeet runs…": no grammar in that capital.
+            self.keep_name(words);
+        } else if is_stop(&first.text) {
+            // "Use Tokio for…": the name starts after it.
+            self.keep_name(&words[1..]);
+        } else if words.len() <= MAX_PHRASE_WORDS {
+            // "Claude Code runs…" or "Leverage Tokio for…": a name, or a
+            // verb and a name. Kept whole, which is right for the first
+            // and harmless for the second; no word of it is kept alone.
+            let phrase: Vec<&str> = words.iter().map(|w| w.text.as_str()).collect();
+            self.push(phrase.join(" "), false);
+        }
+    }
+
+    fn push(&mut self, term: String, single: bool) {
+        if !self.found.contains(&term) {
+            self.found.push(term);
+            self.single.push(single);
+        }
+    }
+}
+
+fn is_stop(word: &str) -> bool {
+    NOT_TERMS.contains(&word.to_lowercase().as_str())
+}
+
+/// How a word is capitalised, or `None` for a word that is not (or is not a
+/// plain word at all: a path, a number, a hyphenated compound).
+fn shape_of(word: &str) -> Option<Shape> {
+    let mut chars = word.chars();
+    let first = chars.next()?;
+    if word.chars().count() < 2
+        || !word.chars().all(char::is_alphanumeric)
+        || !word.chars().any(char::is_alphabetic)
+    {
+        return None;
+    }
+    if text::has_inner_case(word) {
+        let all_upper = word.chars().all(|c| !c.is_lowercase());
+        return Some(if all_upper {
+            Shape::Upper
+        } else {
+            Shape::Mixed
+        });
+    }
+    first.is_uppercase().then_some(Shape::Capitalised)
+}
+
+fn is_plain_lower(word: &str) -> bool {
+    word.chars()
+        .all(|c| c.is_lowercase() || c == '\'' || c == '’')
+}
+
+/// `VocabCache`, `status_item`, `squawk-core`: one name, nothing else.
+fn is_identifier(code: &str) -> bool {
+    code.len() >= 2
+        && code.len() <= 64
+        && code.chars().next().is_some_and(char::is_alphabetic)
+        && code.chars().last().is_some_and(char::is_alphanumeric)
+        && code
+            .chars()
+            .all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+}
+
+fn code_re() -> &'static Regex {
+    static RE: OnceLock<Regex> = OnceLock::new();
+    RE.get_or_init(|| Regex::new("`+([^`]+)`+").expect("valid regex"))
+}
+
+/// `[text](target)` and `![alt](target)`, keeping the text.
+fn link_re() -> &'static Regex {
+    static RE: OnceLock<Regex> = OnceLock::new();
+    RE.get_or_init(|| Regex::new(r"!?\[([^\]]*)\]\([^)]*\)").expect("valid regex"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn terms(markdown: &str) -> Vec<String> {
+        let mut t = Terms::default();
+        t.read(markdown);
+        t.finish()
+    }
+
+    #[test]
+    fn capitals_mid_sentence_are_terms() {
+        assert_eq!(
+            terms("Built for talking to Claude Code in a terminal, with Parakeet."),
+            ["Claude Code", "Claude", "Parakeet"]
+        );
+    }
+
+    #[test]
+    fn a_sentence_start_says_nothing() {
+        assert!(terms("Everything runs here. Work in progress. See the design.").is_empty());
+        assert!(terms("- Use small commits\n- Local only").is_empty());
+    }
+
+    #[test]
+    fn acronyms_and_inner_capitals_count_anywhere() {
+        assert_eq!(
+            terms("# The GitHub API\n\nNVIDIA's Parakeet TDT 0.6B on macOS."),
+            [
+                "GitHub",
+                "API",
+                "NVIDIA",
+                "TDT",
+                "Parakeet TDT",
+                "Parakeet",
+                "macOS"
+            ]
+        );
+    }
+
+    #[test]
+    fn a_verb_that_opens_a_sentence_is_not_part_of_the_name() {
+        assert_eq!(
+            terms("Uses Parakeet and Tokio. Prefer Zod Schemas over types."),
+            ["Parakeet", "Tokio", "Zod Schemas", "Zod"]
+        );
+        assert_eq!(
+            terms("See `docs`. Use React Query here."),
+            ["React Query", "React"]
+        );
+    }
+
+    #[test]
+    fn a_name_that_opens_a_sentence_is_kept_whole() {
+        // "Code" and "Voice" alone would capitalise ordinary words.
+        assert_eq!(
+            terms("Claude Code runs the tests. Acme Voice is a tool."),
+            ["Claude Code", "Acme Voice"]
+        );
+        assert_eq!(
+            terms("NVIDIA Parakeet runs locally."),
+            ["NVIDIA", "NVIDIA Parakeet"]
+        );
+    }
+
+    #[test]
+    fn titles_are_not_terms() {
+        assert!(terms("## Getting Started\n\n## When To Ask Before Acting").is_empty());
+        assert!(terms("**Getting Started**\n\nQuick Start: read on. Release Notes.").is_empty());
+    }
+
+    #[test]
+    fn emphasis_is_not_jargon() {
+        assert!(terms("IMPORTANT: you MUST NOT push. NEVER force push to MAIN BRANCH.").is_empty());
+    }
+
+    #[test]
+    fn words_also_written_in_lower_case_are_dropped() {
+        assert_eq!(
+            terms("We call it the Engine. The engine owns audio. It uses Tokio."),
+            ["Tokio"]
+        );
+    }
+
+    #[test]
+    fn identifiers_in_code_spans() {
+        assert_eq!(
+            terms("Set `paste_restore_ms`, call `VocabCache::get` or `VocabCache`, run `cargo test`, see `main`."),
+            ["paste_restore_ms", "VocabCache"]
+        );
+    }
+
+    #[test]
+    fn code_blocks_links_and_paths_are_skipped() {
+        let md = "```sh\ncargo build --release Foo\n```\nRead [the spec](docs/Spec.md) or src/Main.rs at https://Example.com.";
+        assert!(terms(md).is_empty());
+    }
+
+    #[test]
+    fn punctuation_breaks_a_run() {
+        assert_eq!(
+            terms("It supports Ghostty, Kitty and Warp (not Hyper)."),
+            ["Ghostty", "Kitty", "Warp", "Hyper"]
+        );
+    }
+}
diff --git a/crates/squawk-core/src/context/vocab.rs b/crates/squawk-core/src/context/vocab.rs
new file mode 100644
index 0000000..5a4c042
--- /dev/null
+++ b/crates/squawk-core/src/context/vocab.rs
@@ -0,0 +1,511 @@
+//! Scanning a repo: its files, and the words it has its own spelling for.
+
+use std::collections::{HashSet, VecDeque};
+use std::fs;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::SystemTime;
+
+use super::terms::Terms;
+use super::{fold, RepoVocab};
+
+/// Docs read for jargon, in the session cwd and at the top of the repo.
+/// AGENTS.md is to codex what CLAUDE.md is to claude.
+const DOC_NAMES: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+/// A doc longer than this is not read for jargon.
+const MAX_DOC_BYTES: u64 = 512 * 1024;
+
+/// Manifests that name a package.
+const MANIFEST_NAMES: &[&str] = &["Cargo.toml", "package.json", "pyproject.toml", "go.mod"];
+/// A monorepo has hundreds; the shallowest ones name the things people say.
+const MAX_MANIFESTS: usize = 40;
+const MAX_MANIFEST_BYTES: u64 = 1024 * 1024;
+
+/// Limits on the walk outside git.
+const MAX_WALK_FILES: usize = 5000;
+const MAX_WALK_DIRS: usize = 2000;
+const MAX_WALK_DEPTH: usize = 6;
+/// Build output and dependencies: big, and never what a dictation is about.
+const SKIP_DIRS: &[&str] = &[
+    "node_modules",
+    "target",
+    "build",
+    "dist",
+    "__pycache__",
+    "venv",
+];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let repo = find_repo(cwd);
+    let files = match &repo {
+        Some(_) => git_files(cwd).filter(|f| !f.is_empty()),
+        None => None,
+    }
+    // Not a repo, or one with nothing tracked under here yet.
+    .unwrap_or_else(|| walk(cwd));
+    let files = with_local_docs(cwd, files);
+
+    let mut terms = Terms::default();
+    for doc in doc_paths(cwd, repo.as_ref()) {
+        if let Some(text) = read_capped(&doc, MAX_DOC_BYTES) {
+            terms.read(&text);
+        }
+    }
+
+    // The docs' spelling wins over a manifest's, and both over a file name.
+    let mut words = Words::default();
+    words.add(terms.finish());
+    words.add(package_names(cwd, &files));
+    words.add(files.iter().filter_map(|f| stem(f)).map(str::to_string));
+
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words: words.list,
+    }
+}
+
+/// Words by rank: a later group cannot respell what an earlier one settled.
+#[derive(Default)]
+struct Words {
+    list: Vec<String>,
+    exact: HashSet<String>,
+    settled: HashSet<String>,
+}
+
+impl Words {
+    fn add(&mut self, group: impl IntoIterator<Item = String>) {
+        let mut keys = Vec::new();
+        for word in group {
+            let key = fold(&word);
+            if key.is_empty() || self.settled.contains(&key) {
+                continue;
+            }
+            if self.exact.insert(word.clone()) {
+                self.list.push(word);
+            }
+            keys.push(key);
+        }
+        self.settled.extend(keys);
+    }
+}
+
+/// `src/status_item.rs` → `status_item`. Dotfiles and names that are not
+/// words have no stem.
+pub(super) fn stem(file: &str) -> Option<&str> {
+    let name = file.rsplit('/').next()?;
+    let stem = name.split('.').next()?;
+    let wordy = (2..=48).contains(&stem.len())
+        && stem.chars().any(char::is_alphabetic)
+        && stem
+            .chars()
+            .all(|c| c.is_alphanumeric() || c == '_' || c == '-');
+    wordy.then_some(stem)
+}
+
+/// A git work tree and the index that changes when its tracked files do.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Repo {
+    top: PathBuf,
+    index: PathBuf,
+}
+
+/// The repo `cwd` is in, found by looking for `.git` on the way up. A `.git`
+/// file (a linked worktree, a submodule) points at the real git dir.
+pub(super) fn find_repo(cwd: &Path) -> Option<Repo> {
+    let cwd = fs::canonicalize(cwd).ok()?;
+    for dir in cwd.ancestors() {
+        let dot_git = dir.join(".git");
+        let Ok(meta) = fs::metadata(&dot_git) else {
+            continue;
+        };
+        let git_dir = if meta.is_dir() {
+            dot_git
+        } else {
+            let pointer = fs::read_to_string(&dot_git).ok()?;
+            let target = pointer.lines().find_map(|l| l.strip_prefix("gitdir:"))?;
+            dir.join(target.trim())
+        };
+        return Some(Repo {
+            top: dir.to_path_buf(),
+            index: git_dir.join("index"),
+        });
+    }
+    None
+}
+
+/// Tracked files under `cwd`, relative to it. `None` if git cannot say.
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .args(["ls-files", "-z"])
+        .current_dir(cwd)
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    Some(
+        out.stdout
+            .split(|b| *b == 0)
+            .filter(|path| !path.is_empty())
+            .filter_map(|path| std::str::from_utf8(path).ok())
+            .map(str::to_string)
+            .collect(),
+    )
+}
+
+/// Files under `cwd` outside git: breadth first, so that when a limit cuts
+/// the walk short it is the deep files that are missing.
+fn walk(cwd: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    let mut dirs = 0;
+    let mut queue = VecDeque::from([(cwd.to_path_buf(), String::new(), 0)]);
+    while let Some((dir, prefix, depth)) = queue.pop_front() {
+        let Ok(entries) = fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let Ok(name) = entry.file_name().into_string() else {
+                continue;
+            };
+            if kind.is_file() {
+                files.push(format!("{prefix}{name}"));
+                if files.len() >= MAX_WALK_FILES {
+                    files.sort();
+                    return files;
+                }
+            } else if kind.is_dir()
+                && depth < MAX_WALK_DEPTH
+                && dirs < MAX_WALK_DIRS
+                && !name.starts_with('.')
+                && !SKIP_DIRS.contains(&name.as_str())
+            {
+                dirs += 1;
+                queue.push_back((entry.path(), format!("{prefix}{name}/"), depth + 1));
+            }
+        }
+    }
+    files.sort();
+    files
+}
+
+/// CLAUDE.md and its kin are often kept out of git, and are still the files
+/// a dictation is most likely to name: list the ones that are there.
+fn with_local_docs(cwd: &Path, mut files: Vec<String>) -> Vec<String> {
+    for name in DOC_NAMES {
+        if !files.iter().any(|f| f == name) && cwd.join(name).is_file() {
+            let at = files.partition_point(|f| f.as_str() < *name);
+            files.insert(at, name.to_string());
+        }
+    }
+    files
+}
+
+fn doc_paths(cwd: &Path, repo: Option<&Repo>) -> Vec<PathBuf> {
+    let mut dirs = vec![cwd.to_path_buf()];
+    if let Some(repo) = repo {
+        if fs::canonicalize(cwd).ok().as_deref() != Some(repo.top.as_path()) {
+            dirs.push(repo.top.clone());
+        }
+    }
+    dirs.iter()
+        .flat_map(|dir| DOC_NAMES.iter().map(move |name| dir.join(name)))
+        .collect()
+}
+
+fn read_capped(path: &Path, max: u64) -> Option<String> {
+    let meta = fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > max {
+        return None;
+    }
+    fs::read_to_string(path).ok()
+}
+
+/// The names the repo's own packages go by.
+fn package_names(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut manifests: Vec<&String> = files
+        .iter()
+        .filter(|f| MANIFEST_NAMES.contains(&f.rsplit('/').next().unwrap_or(f)))
+        .collect();
+    manifests.sort_by_key(|f| f.matches('/').count());
+    manifests
+        .into_iter()
+        .take(MAX_MANIFESTS)
+        .filter_map(|file| {
+            let text = read_capped(&cwd.join(file), MAX_MANIFEST_BYTES)?;
+            let name = match file.rsplit('/').next().unwrap_or(file) {
+                "Cargo.toml" => toml_name(&text, &["package"]),
+                "pyproject.toml" => {
+                    toml_name(&text, &["project"]).or_else(|| toml_name(&text, &["tool", "poetry"]))
+                }
+                "package.json" => serde_json::from_str::<serde_json::Value>(&text)
+                    .ok()
+                    .and_then(|v| Some(v.get("name")?.as_str()?.to_string())),
+                _ => text
+                    .lines()
+                    .find_map(|l| l.strip_prefix("module "))
+                    .map(|m| m.trim().to_string()),
+            }?;
+            // `@scope/name` and `github.com/owner/name` are said as `name`.
+            let name = name.rsplit('/').next()?.to_string();
+            let wordy = name.chars().next().is_some_and(char::is_alphanumeric)
+                && name.len() <= 64
+                && !name.contains(char::is_whitespace);
+            wordy.then_some(name)
+        })
+        .collect()
+}
+
+/// `name` in the table at `path` of a TOML manifest.
+fn toml_name(text: &str, path: &[&str]) -> Option<String> {
+    let mut value = &text.parse::<toml::Table>().ok()?;
+    for key in path {
+        value = value.get(*key)?.as_table()?;
+    }
+    Some(value.get("name")?.as_str()?.to_string())
+}
+
+/// What a cached vocab was built from. When any of it differs, rebuild.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Stamp {
+    /// `.git/index`: rewritten whenever the set of tracked files changes.
+    index: Option<FileStamp>,
+    /// The docs and, outside git, the directory itself.
+    rest: Vec<Option<FileStamp>>,
+}
+
+/// mtime, size, inode: git replaces the index by rename, so the inode
+/// catches a rewrite the clock was too coarse to see.
+type FileStamp = (SystemTime, u64, u64);
+
+impl Stamp {
+    pub fn of(cwd: &Path) -> Stamp {
+        let repo = find_repo(cwd);
+        let index = repo.as_ref().and_then(|r| file_stamp(&r.index));
+        let mut rest: Vec<_> = doc_paths(cwd, repo.as_ref())
+            .iter()
+            .map(|doc| file_stamp(doc))
+            .collect();
+        if index.is_none() {
+            rest.push(file_stamp(cwd));
+        }
+        Stamp { index, rest }
+    }
+
+    /// Whether git vouches for the file list. Without it, the list is only
+    /// good for a while.
+    pub fn tracked(&self) -> bool {
+        self.index.is_some()
+    }
+}
+
+fn file_stamp(path: &Path) -> Option<FileStamp> {
+    let meta = fs::metadata(path).ok()?;
+    Some((meta.modified().ok()?, meta.len(), meta.ino()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn write(root: &Path, file: &str, body: &str) {
+        let path = root.join(file);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, body).unwrap();
+    }
+
+    pub(crate) fn git(root: &Path, args: &[&str]) {
+        let status = Command::new("git")
+            .args(args)
+            .current_dir(root)
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .unwrap();
+        assert!(status.success(), "git {args:?}");
+    }
+
+    fn has(vocab: &RepoVocab, word: &str) -> bool {
+        vocab.words.iter().any(|w| w == word)
+    }
+
+    #[test]
+    fn stems() {
+        assert_eq!(stem("src/status_item.rs"), Some("status_item"));
+        assert_eq!(stem("web/app.test.tsx"), Some("app"));
+        assert_eq!(stem("README.md"), Some("README"));
+        assert_eq!(stem("Makefile"), Some("Makefile"));
+        assert_eq!(stem(".gitignore"), None);
+        assert_eq!(stem("a.rs"), None);
+        assert_eq!(stem("2024.csv"), None);
+    }
+
+    #[test]
+    fn lists_tracked_files_only() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        git(root, &["init", "-q"]);
+        write(root, "src/audio.rs", "");
+        write(root, "src/status_item.rs", "");
+        write(root, "Cargo.toml", "[package]\nname = \"squawk-core\"\n");
+        write(root, "target/debug/build.rs", "");
+        write(root, ".gitignore", "/target\n");
+        git(root, &["add", "."]);
+        write(root, "scratch.rs", "");
+
+        let vocab = build(root);
+        assert_eq!(vocab.root, root);
+        assert_eq!(
+            vocab.files,
+            [
+                ".gitignore",
+                "Cargo.toml",
+                "src/audio.rs",
+                "src/status_item.rs"
+            ]
+        );
+        assert!(has(&vocab, "squawk-core"));
+        assert!(has(&vocab, "status_item"));
+        assert!(has(&vocab, "audio"));
+
+        // CLAUDE.md is usually kept out of git, and is still there to mention.
+        write(root, "CLAUDE.md", "");
+        write(root, ".gitignore", "/target\nCLAUDE.md\n");
+        assert_eq!(
+            build(root).files,
+            [
+                ".gitignore",
+                "CLAUDE.md",
+                "Cargo.toml",
+                "src/audio.rs",
+                "src/status_item.rs"
+            ]
+        );
+    }
+
+    #[test]
+    fn a_subdirectory_lists_its_own_files_and_reads_the_repo_docs() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        git(root, &["init", "-q"]);
+        write(root, "README.md", "Speech runs on Parakeet.\n");
+        write(root, "crates/core/src/lib.rs", "");
+        write(root, "crates/app/src/main.rs", "");
+        git(root, &["add", "."]);
+
+        let vocab = build(&root.join("crates/core"));
+        assert_eq!(vocab.files, ["src/lib.rs"]);
+        assert!(has(&vocab, "Parakeet"));
+    }
+
+    #[test]
+    fn walks_outside_git_but_not_into_dependencies() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        write(root, "main.py", "");
+        write(root, "pkg/util.py", "");
+        write(root, "node_modules/left-pad/index.js", "");
+        write(root, ".cache/blob.bin", "");
+        write(root, ".env", "");
+        write(root, "a/b/c/d/e/f/g/too_deep.py", "");
+
+        let vocab = build(root);
+        assert_eq!(vocab.files, [".env", "main.py", "pkg/util.py"]);
+    }
+
+    #[test]
+    fn a_repo_with_nothing_tracked_is_walked() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        git(root, &["init", "-q"]);
+        write(root, "notes.md", "");
+        assert_eq!(build(root).files, ["notes.md"]);
+    }
+
+    #[test]
+    fn words_come_from_docs_then_manifests_then_file_names() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        write(
+            root,
+            "README.md",
+            "# tool\n\nWraps the Parakeet model for Claude Code.\n",
+        );
+        write(root, "CLAUDE.md", "Config lives in `AppConfig`.\n");
+        write(root, "package.json", r#"{"name": "@acme/voice-kit"}"#);
+        write(
+            root,
+            "py/pyproject.toml",
+            "[project]\nname = \"voice_tools\"\n",
+        );
+        write(
+            root,
+            "go/go.mod",
+            "module github.com/acme/voxd\n\ngo 1.22\n",
+        );
+        write(root, "src/parakeet.ts", "");
+        write(root, "src/StatusItem.swift", "");
+        write(root, "src/Button.tsx", "");
+
+        let vocab = build(root);
+        for word in [
+            "Parakeet",
+            "Claude Code",
+            "AppConfig",
+            "voice-kit",
+            "voice_tools",
+            "voxd",
+            "StatusItem",
+            "README",
+        ] {
+            assert!(has(&vocab, word), "{word} in {:?}", vocab.words);
+        }
+        // The README settled how parakeet is written; the file name does
+        // not get a say.
+        assert!(!has(&vocab, "parakeet"));
+    }
+
+    #[test]
+    fn finds_the_index_of_a_repo_and_of_a_linked_worktree() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        assert_eq!(find_repo(&root), None);
+        git(&root, &["init", "-q"]);
+        write(&root, "src/lib.rs", "");
+        let repo = find_repo(&root.join("src")).unwrap();
+        assert_eq!(repo.top, root);
+        assert_eq!(repo.index, root.join(".git/index"));
+
+        let linked = dir.path().join("linked");
+        write(&linked, ".git", "gitdir: ../.git/worktrees/linked\n");
+        let repo = find_repo(&linked).unwrap();
+        assert!(repo.index.ends_with(".git/worktrees/linked/index"));
+    }
+
+    #[test]
+    fn stamp_follows_the_index_and_the_docs() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path();
+        git(root, &["init", "-q"]);
+        write(root, "a.rs", "");
+        git(root, &["add", "."]);
+        let first = Stamp::of(root);
+        assert!(first.tracked());
+        assert_eq!(first, Stamp::of(root));
+
+        write(root, "b.rs", "");
+        assert_eq!(first, Stamp::of(root), "untracked files change nothing");
+        git(root, &["add", "."]);
+        let second = Stamp::of(root);
+        assert_ne!(first, second);
+
+        write(root, "CLAUDE.md", "Uses Tokio.\n");
+        assert_ne!(second, Stamp::of(root));
+    }
+}
