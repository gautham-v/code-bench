new file mode 100644
index 0000000..d24970e
--- /dev/null
+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,634 @@
+//! Spoken file names to @mentions.
+//!
+//! A reference is a file name said aloud: "status item dot rs", "app dot test
+//! dot tsx", "dot gitignore", or, for the config and doc files people name
+//! without the dot, "cargo toml" and "the claude md". The words are folded
+//! (case and `_`/`-` dropped) and compared with every file's name folded the
+//! same way, taking the longest run of words that names a file.
+//!
+//! A mention is written only when exactly one file answers. If the name is
+//! shared, a folder said before it ("context slash mod dot rs") picks one;
+//! if that still leaves a choice, or the folder matches nothing, the words
+//! stay as spoken.
+
+use super::fold;
+use super::index::Index;
+use crate::text::Chunk;
+
+/// Most words a file's stem is spoken as: "launch at login dot rs".
+const MAX_STEM_WORDS: usize = 5;
+/// Most words one folder name is spoken as.
+const MAX_DIR_WORDS: usize = 4;
+/// Most dots in a file name: "app dot test dot tsx".
+const MAX_DOTS: usize = 3;
+/// Most letters in an extension that is spelled out: "dot t s x".
+const MAX_SPELLED: usize = 4;
+
+/// Extensions people say without "dot" ("package json"). Source extensions
+/// are left out: "three js" and "tailwind css" are libraries, not files.
+const BARE_EXTENSIONS: &[&str] = &["md", "toml", "json", "yaml", "yml", "lock", "txt"];
+
+/// Punctuation read aloud inside a name; it folds away like the real thing.
+const SPOKEN_SEPARATORS: &[&str] = &["underscore", "dash", "hyphen"];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Word,
+    Dot,
+    Slash,
+    /// Protected, punctuation, or otherwise not part of a name.
+    Other,
+}
+
+struct Token {
+    kind: Kind,
+    /// A word, folded.
+    key: String,
+}
+
+/// A run of chunks that may name a file, and the folded names it could be.
+struct Candidate {
+    start: usize,
+    end: usize,
+    keys: Vec<String>,
+}
+
+/// Replace the file references in `chunks`. Returns whether any were.
+pub(super) fn apply(chunks: &mut Vec<Chunk>, files: &[String], index: &Index) -> bool {
+    let scan = Scan::new(chunks);
+
+    // (start, end, file): chunks[start..end] become one mention.
+    let mut mentions: Vec<(usize, usize, usize)> = Vec::new();
+    let mut settled = 0;
+    for (at, candidates) in scan.anchors() {
+        if at < settled {
+            continue;
+        }
+        // Longest first: "status item dot rs" is status_item.rs, not item.rs.
+        let named = candidates
+            .iter()
+            .filter(|c| c.start >= settled)
+            .find_map(|c| {
+                let mut hits: Vec<usize> = c
+                    .keys
+                    .iter()
+                    .flat_map(|key| index.files_named(key))
+                    .map(|file| *file as usize)
+                    .collect();
+                hits.sort_unstable();
+                hits.dedup();
+                (!hits.is_empty()).then_some((c, hits))
+            });
+        let Some((candidate, hits)) = named else {
+            continue;
+        };
+        // Whatever happens next, these words are spoken for: a name that is
+        // ambiguous as a whole must not be resolved by a piece of it.
+        settled = candidate.end;
+        if let Some((start, file)) = scan.choose(candidate, &hits, files) {
+            if mentions.last().is_none_or(|(_, end, _)| *end <= start) {
+                mentions.push((start, candidate.end, file));
+            }
+        }
+    }
+    if mentions.is_empty() {
+        return false;
+    }
+
+    let last = chunks.len();
+    for (start, end, file) in mentions.into_iter().rev() {
+        let mut trail = std::mem::take(&mut chunks[end - 1].trail);
+        // The period that ends the dictation would read as part of the path
+        // (`cleanup::finalize` leaves it off for the same reason).
+        if end == last && trail == "." {
+            trail.clear();
+        }
+        let mention = Chunk {
+            lead: std::mem::take(&mut chunks[start].lead),
+            core: format!("@{}", files[file]),
+            trail,
+        };
+        chunks.splice(start..end, [mention]);
+    }
+    true
+}
+
+/// A file or folder name folded for comparison: dots kept, case and
+/// separators dropped. `status_item.rs` → `statusitem.rs`.
+pub(super) fn name_key(name: &str) -> String {
+    name.chars()
+        .filter(|c| c.is_alphanumeric() || *c == '.')
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// Other extensions a spoken one may stand for.
+fn extension_variants(ext: &str) -> &'static [&'static str] {
+    match ext {
+        "yaml" => &["yml"],
+        "yml" => &["yaml"],
+        "jason" => &["json"],
+        _ => &[],
+    }
+}
+
+struct Scan<'a> {
+    chunks: &'a [Chunk],
+    tokens: Vec<Token>,
+}
+
+impl<'a> Scan<'a> {
+    fn new(chunks: &'a [Chunk]) -> Scan<'a> {
+        let tokens = chunks.iter().map(token).collect();
+        Scan { chunks, tokens }
+    }
+
+    fn kind(&self, i: usize) -> Kind {
+        self.tokens.get(i).map_or(Kind::Other, |t| t.kind)
+    }
+
+    /// No punctuation between chunk `i` and the next: they can be one name.
+    fn joined(&self, i: usize) -> bool {
+        i + 1 < self.chunks.len()
+            && self.chunks[i].trail.is_empty()
+            && self.chunks[i + 1].lead.is_empty()
+    }
+
+    /// Is token `i` of this kind and joined to the token before it?
+    fn follows(&self, i: usize, kind: Kind) -> bool {
+        i > 0 && self.kind(i) == kind && self.joined(i - 1)
+    }
+
+    /// Every place a file name may be, in order, each with its candidate
+    /// spans from longest to shortest.
+    fn anchors(&self) -> Vec<(usize, Vec<Candidate>)> {
+        let mut anchors = Vec::new();
+        for at in 0..self.tokens.len() {
+            let mut candidates = match self.kind(at) {
+                // The first dot of a name; later dots belong to its span.
+                Kind::Dot if !self.continues_a_name(at) => self.dotted(at),
+                Kind::Word if BARE_EXTENSIONS.contains(&self.tokens[at].key.as_str()) => {
+                    self.bare(at)
+                }
+                _ => Vec::new(),
+            };
+            if candidates.is_empty() {
+                continue;
+            }
+            candidates.sort_by_key(|c| (std::cmp::Reverse(c.end - c.start), c.start));
+            anchors.push((at, candidates));
+        }
+        anchors
+    }
+
+    /// Is the dot at `at` a later dot of a name (the second in "app dot
+    /// test dot tsx")? That is: one word, or a few spelled letters, between
+    /// it and the dot before.
+    fn continues_a_name(&self, at: usize) -> bool {
+        let mut first = at;
+        while first > 0
+            && at - first <= MAX_SPELLED
+            && self.joined(first - 1)
+            && self.kind(first - 1) == Kind::Word
+        {
+            first -= 1;
+        }
+        let words = at - first;
+        let spelled = (first..at).all(|i| self.tokens[i].key.chars().count() == 1);
+        (words == 1 || (words > 1 && words <= MAX_SPELLED && spelled)) && self.after_dot(first)
+    }
+
+    /// Is token `i` joined to a "dot" before it: the tail of a dotted name?
+    fn after_dot(&self, i: usize) -> bool {
+        i > 0 && self.joined(i - 1) && self.kind(i - 1) == Kind::Dot
+    }
+
+    /// Names with a spoken dot, the first of them at `dot`.
+    fn dotted(&self, dot: usize) -> Vec<Candidate> {
+        let mut first = dot;
+        while first > 0
+            && dot - first < MAX_STEM_WORDS
+            && self.joined(first - 1)
+            && self.kind(first - 1) == Kind::Word
+        {
+            first -= 1;
+        }
+        let ends = self.name_ends(dot);
+        let mut out = Vec::new();
+        for start in first..=dot {
+            if self.after_dot(start) {
+                continue;
+            }
+            for &end in &ends {
+                let key: String = (start..end)
+                    .map(|i| match self.kind(i) {
+                        Kind::Dot => ".",
+                        _ => self.tokens[i].key.as_str(),
+                    })
+                    .collect();
+                out.push(Candidate {
+                    start,
+                    end,
+                    keys: with_variants(key),
+                });
+            }
+        }
+        out
+    }
+
+    /// Where a name whose first dot is at `dot` may end: after each
+    /// extension, which is one word or a few spelled letters ("dot r s").
+    fn name_ends(&self, dot: usize) -> Vec<usize> {
+        let mut ends = Vec::new();
+        let mut dots = vec![dot];
+        for _ in 0..MAX_DOTS {
+            let mut next = Vec::new();
+            for &d in &dots {
+                let word = d + 1;
+                if !self.follows(word, Kind::Word) || self.tokens[word].key.is_empty() {
+                    continue;
+                }
+                let mut stops = vec![word + 1];
+                let letter = |i: usize| self.tokens[i].key.chars().count() == 1;
+                if letter(word) {
+                    let mut i = word + 1;
+                    while i - word < MAX_SPELLED && self.follows(i, Kind::Word) && letter(i) {
+                        i += 1;
+                        stops.push(i);
+                    }
+                }
+                for end in stops {
+                    // Another "dot <word>" after it: the name goes on.
+                    if self.follows(end, Kind::Dot) {
+                        next.push(end);
+                        if self.follows(end + 1, Kind::Word) {
+                            continue;
+                        }
+                    }
+                    ends.push(end);
+                }
+            }
+            dots = next;
+        }
+        ends
+    }
+
+    /// Names said without the dot, their extension at `ext`: "cargo toml".
+    fn bare(&self, ext: usize) -> Vec<Candidate> {
+        if !self.follows(ext, Kind::Word)
+            || self.kind(ext - 1) != Kind::Word
+            // "json dot rs": this word is a stem, not an extension.
+            || self.follows(ext + 1, Kind::Dot)
+        {
+            return Vec::new();
+        }
+        let mut first = ext - 1;
+        while first > 0
+            && ext - first < MAX_STEM_WORDS
+            && self.joined(first - 1)
+            && self.kind(first - 1) == Kind::Word
+        {
+            first -= 1;
+        }
+        (first..ext)
+            .filter(|&start| !self.after_dot(start))
+            .filter_map(|start| {
+                let stem: String = (start..ext).map(|i| self.tokens[i].key.as_str()).collect();
+                (!stem.is_empty()).then(|| Candidate {
+                    start,
+                    end: ext + 1,
+                    keys: with_variants(format!("{stem}.{}", self.tokens[ext].key)),
+                })
+            })
+            .collect()
+    }
+
+    /// The one file a candidate means, and where its reference starts, or
+    /// `None` when there is a choice left.
+    fn choose(
+        &self,
+        candidate: &Candidate,
+        hits: &[usize],
+        files: &[String],
+    ) -> Option<(usize, usize)> {
+        let Some(slash) = self.folder_slash(candidate.start) else {
+            return match hits {
+                [only] => Some((candidate.start, *only)),
+                _ => None,
+            };
+        };
+        // A folder was said. First as the file's own folder; failing that,
+        // as any folder above it ("squawk core slash lib dot rs").
+        for direct in [true, false] {
+            let mut matching = hits.iter().filter_map(|&file| {
+                let dirs: Vec<String> = files[file].split('/').map(name_key).collect();
+                let start = self.match_dirs(&dirs[..dirs.len() - 1], slash, direct)?;
+                Some((start, file))
+            });
+            match (matching.next(), matching.next()) {
+                (Some(one), None) => return Some(one),
+                (Some(_), Some(_)) => return None,
+                _ => {}
+            }
+        }
+        None
+    }
+
+    /// The "slash" before the name starting at `start`, if a folder name is
+    /// said before it.
+    fn folder_slash(&self, start: usize) -> Option<usize> {
+        let slash = start.checked_sub(1)?;
+        let named = self.kind(slash) == Kind::Slash
+            && self.joined(slash)
+            && slash > 0
+            && self.joined(slash - 1)
+            && matches!(self.kind(slash - 1), Kind::Word | Kind::Dot);
+        named.then_some(slash)
+    }
+
+    /// Match the folders said before `slash` against a file's folders
+    /// (outermost first), innermost first. Returns where the spoken path
+    /// starts. Every folder said must match: "foo slash audio dot rs" is not
+    /// a file in `src`.
+    fn match_dirs(&self, dirs: &[String], mut slash: usize, direct: bool) -> Option<usize> {
+        let mut dirs = dirs;
+        loop {
+            let (dir, start) = self.dir_before(dirs, slash, direct)?;
+            dirs = &dirs[..dir];
+            match self.folder_slash(start) {
+                Some(outer) => slash = outer,
+                None => return Some(start),
+            }
+        }
+    }
+
+    /// The folder (searching inwards-out) spelled by the words ending at
+    /// `end`, and where those words start.
+    fn dir_before(&self, dirs: &[String], end: usize, direct: bool) -> Option<(usize, usize)> {
+        for (i, dir) in dirs.iter().enumerate().rev() {
+            let mut said = String::new();
+            for start in (end.saturating_sub(MAX_DIR_WORDS)..end).rev() {
+                if !self.joined(start) {
+                    break;
+                }
+                let piece = match self.kind(start) {
+                    Kind::Word => self.tokens[start].key.as_str(),
+                    Kind::Dot => ".",
+                    _ => break,
+                };
+                said.insert_str(0, piece);
+                if said == *dir || (dir == "src" && said == "source") {
+                    return Some((i, start));
+                }
+            }
+            if direct {
+                break;
+            }
+        }
+        None
+    }
+}
+
+fn token(chunk: &Chunk) -> Token {
+    let other = Token {
+        kind: Kind::Other,
+        key: String::new(),
+    };
+    let wordy = |c: char| c.is_alphanumeric() || matches!(c, '-' | '_' | '\'' | '’');
+    if chunk.is_protected() || chunk.core.is_empty() || !chunk.core.chars().all(wordy) {
+        return other;
+    }
+    let lower = chunk.core.to_lowercase();
+    let (kind, key) = match lower.as_str() {
+        "dot" => (Kind::Dot, String::new()),
+        "slash" => (Kind::Slash, String::new()),
+        w if SPOKEN_SEPARATORS.contains(&w) => (Kind::Word, String::new()),
+        w => (Kind::Word, fold(w)),
+    };
+    Token { kind, key }
+}
+
+fn with_variants(key: String) -> Vec<String> {
+    let mut keys = Vec::new();
+    if let Some((stem, ext)) = key.rsplit_once('.') {
+        for other in extension_variants(ext) {
+            keys.push(format!("{stem}.{other}"));
+        }
+    }
+    keys.insert(0, key);
+    keys
+}
