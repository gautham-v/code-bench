new file mode 100644
index 0000000..607fc6e
--- /dev/null
+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,504 @@
+//! Finding the agent session behind the front terminal.
+//!
+//! One snapshot of the process table, then a walk down from the terminal's
+//! pid. The first `claude`/`codex` on each branch is a session; nothing below
+//! it is looked at (an agent's own tool processes, or a second agent it
+//! started, are not what the user is talking to).
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use super::{is_terminal, Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// Runtimes that run an agent as a script: `node /usr/local/bin/codex`.
+const SCRIPT_RUNTIMES: &[&str] = &["node", "bun", "deno"];
+
+/// One row of the process table.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Proc {
+    pid: i32,
+    ppid: i32,
+    /// The kernel's name for it (`p_comm`): the executable's file name.
+    name: String,
+}
+
+/// What ranks one session against another.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+struct Details {
+    /// Controlling terminal device, when it has one.
+    tty_dev: Option<u32>,
+    /// Start time (seconds, microseconds).
+    started: (u64, u64),
+}
+
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    // pid 1 and below: everything descends from launchd.
+    if !is_terminal(&front.bundle_id) || front.pid <= 1 {
+        return None;
+    }
+    let procs = sys::processes();
+    let mut args = sys::Args::new();
+    let found = agents_under(&procs, front.pid, |p| {
+        agent_named(&p.name).or_else(|| agent_in_args(&args.read(p.pid)))
+    });
+
+    found
+        .into_iter()
+        .filter_map(|(proc, agent)| {
+            let cwd = sys::cwd(proc.pid)?;
+            let details = sys::details(proc.pid).unwrap_or_default();
+            let tty = details.tty_dev.and_then(sys::tty_path);
+            let used = tty.as_deref().map(tty_times).unwrap_or_default();
+            let session = Session {
+                agent,
+                pid: proc.pid,
+                cwd,
+                tty,
+            };
+            Some(((used, details.started, proc.pid), session))
+        })
+        .max_by_key(|(rank, _)| *rank)
+        .map(|(_, session)| session)
+}
+
+/// When the terminal was last typed into, then last written to. Input comes
+/// first: an agent busy in a background tab writes constantly, but only the
+/// tab the user is in gets keystrokes.
+fn tty_times(tty: &Path) -> (Option<SystemTime>, Option<SystemTime>) {
+    match std::fs::metadata(tty) {
+        Ok(meta) => (meta.accessed().ok(), meta.modified().ok()),
+        Err(_) => (None, None),
+    }
+}
+
+/// The outermost agent processes among `root`'s descendants.
+fn agents_under(
+    procs: &[Proc],
+    root: i32,
+    mut agent_of: impl FnMut(&Proc) -> Option<Agent>,
+) -> Vec<(&Proc, Agent)> {
+    let mut children: HashMap<i32, Vec<&Proc>> = HashMap::new();
+    for p in procs {
+        children.entry(p.ppid).or_default().push(p);
+    }
+    let mut found = Vec::new();
+    let mut seen: HashSet<i32> = HashSet::from([root]);
+    let mut queue = vec![root];
+    while let Some(pid) = queue.pop() {
+        for &child in children.get(&pid).map(Vec::as_slice).unwrap_or_default() {
+            if !seen.insert(child.pid) {
+                continue;
+            }
+            match agent_of(child) {
+                Some(agent) => found.push((child, agent)),
+                None => queue.push(child.pid),
+            }
+        }
+    }
+    found
+}
+
+/// `claude`, `/usr/local/bin/claude`, `-claude`: the agent a name stands for.
+fn agent_named(name: &str) -> Option<Agent> {
+    let base = name.rsplit('/').next().unwrap_or(name);
+    let base = base.strip_prefix('-').unwrap_or(base);
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(n, _)| *n == base)
+        .map(|(_, agent)| *agent)
+}
+
+/// The agent in a command line, for when the kernel's name is not it: a
+/// native install runs a versioned binary (`.../versions/2.1.0`) with
+/// `claude` as argv[0], and an npm install is `node .../bin/codex`.
+fn agent_in_args(args: &[String]) -> Option<Agent> {
+    let first = args.first()?;
+    if let Some(agent) = agent_named(first) {
+        return Some(agent);
+    }
+    let runtime = first.rsplit('/').next().unwrap_or(first);
+    if !SCRIPT_RUNTIMES.contains(&runtime) {
+        return None;
+    }
+    let script = args.get(1)?;
+    let script = script.rsplit('/').next().unwrap_or(script);
+    let script = [".js", ".mjs", ".cjs"]
+        .iter()
+        .find_map(|ext| script.strip_suffix(ext))
+        .unwrap_or(script);
+    agent_named(script)
+}
+
+#[cfg(target_os = "macos")]
+mod sys {
+    //! libproc and sysctl. Everything here reads; nothing is spawned.
+
+    use std::ffi::{c_char, c_int, c_void, OsStr};
+    use std::mem;
+    use std::os::unix::ffi::OsStrExt;
+    use std::ptr;
+
+    use super::{Details, PathBuf, Proc};
+
+    extern "C" {
+        fn devname_r(
+            dev: libc::dev_t,
+            mode: libc::mode_t,
+            buf: *mut c_char,
+            len: c_int,
+        ) -> *mut c_char;
+    }
+
+    pub fn processes() -> Vec<Proc> {
+        // SAFETY: a null buffer asks only for the count.
+        let count = unsafe { libc::proc_listallpids(ptr::null_mut(), 0) };
+        if count <= 0 {
+            return Vec::new();
+        }
+        // Room for processes started between the two calls.
+        let mut pids = vec![0 as libc::pid_t; count as usize + 64];
+        let bytes = (pids.len() * mem::size_of::<libc::pid_t>()) as c_int;
+        // SAFETY: `pids` is `bytes` long.
+        let n = unsafe { libc::proc_listallpids(pids.as_mut_ptr().cast::<c_void>(), bytes) };
+        if n <= 0 {
+            return Vec::new();
+        }
+        pids.truncate(n as usize);
+        pids.into_iter()
+            .filter(|p| *p > 0)
+            .filter_map(info)
+            .collect()
+    }
+
+    /// The short form, because the full one is refused for other users'
+    /// processes, and a terminal's shells hang off a root-owned `login`:
+    /// without it the tree stops one step below the terminal.
+    fn info(pid: libc::pid_t) -> Option<Proc> {
+        // SAFETY: proc_bsdshortinfo is plain data; the kernel fills at most
+        // `size` bytes of it.
+        let mut bsd: libc::proc_bsdshortinfo = unsafe { mem::zeroed() };
+        let size = mem::size_of::<libc::proc_bsdshortinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDT_SHORTBSDINFO,
+                0,
+                (&mut bsd as *mut libc::proc_bsdshortinfo).cast::<c_void>(),
+                size,
+            )
+        };
+        (got == size).then(|| Proc {
+            pid,
+            ppid: bsd.pbsi_ppid as i32,
+            name: c_chars(&bsd.pbsi_comm),
+        })
+    }
+
+    pub fn details(pid: i32) -> Option<Details> {
+        // SAFETY: as in `info`.
+        let mut bsd: libc::proc_bsdinfo = unsafe { mem::zeroed() };
+        let size = mem::size_of::<libc::proc_bsdinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDTBSDINFO,
+                0,
+                (&mut bsd as *mut libc::proc_bsdinfo).cast::<c_void>(),
+                size,
+            )
+        };
+        (got == size).then(|| Details {
+            // NODEV when there is no controlling terminal.
+            tty_dev: Some(bsd.e_tdev).filter(|d| *d != 0 && *d != u32::MAX),
+            started: (bsd.pbi_start_tvsec, bsd.pbi_start_tvusec),
+        })
+    }
+
+    pub fn cwd(pid: i32) -> Option<PathBuf> {
+        // SAFETY: as in `info`.
+        let mut vpi: libc::proc_vnodepathinfo = unsafe { mem::zeroed() };
+        let size = mem::size_of::<libc::proc_vnodepathinfo>() as c_int;
+        let got = unsafe {
+            libc::proc_pidinfo(
+                pid,
+                libc::PROC_PIDVNODEPATHINFO,
+                0,
+                (&mut vpi as *mut libc::proc_vnodepathinfo).cast::<c_void>(),
+                size,
+            )
+        };
+        if got != size {
+            return None;
+        }
+        // libc spells `char[MAXPATHLEN]` as 32 rows of 32.
+        let path = vpi.pvi_cdir.vip_path.as_flattened();
+        let bytes: Vec<u8> = path
+            .iter()
+            .take_while(|c| **c != 0)
+            .map(|c| *c as u8)
+            .collect();
+        (!bytes.is_empty()).then(|| PathBuf::from(OsStr::from_bytes(&bytes)))
+    }
+
+    pub fn tty_path(dev: u32) -> Option<PathBuf> {
+        let mut buf = [0 as c_char; 128];
+        // SAFETY: `buf` is as long as the length passed.
+        let name = unsafe {
+            devname_r(
+                dev as libc::dev_t,
+                libc::S_IFCHR,
+                buf.as_mut_ptr(),
+                buf.len() as c_int,
+            )
+        };
+        if name.is_null() {
+            return None;
+        }
+        let name = c_chars(&buf);
+        (!name.is_empty()).then(|| PathBuf::from(format!("/dev/{name}")))
+    }
+
+    /// Reads the first arguments of a process; one buffer for a whole walk.
+    pub struct Args {
+        buf: Vec<u8>,
+    }
+
+    impl Args {
+        pub fn new() -> Args {
+            Args { buf: Vec::new() }
+        }
+
+        /// argv[0] and argv[1], or nothing if the process cannot be read.
+        pub fn read(&mut self, pid: i32) -> Vec<String> {
+            if self.buf.is_empty() {
+                self.buf = vec![0; arg_max()];
+            }
+            let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid];
+            let mut len = self.buf.len();
+            // SAFETY: the kernel writes at most `len` bytes into `buf`.
+            let rc = unsafe {
+                libc::sysctl(
+                    mib.as_mut_ptr(),
+                    mib.len() as libc::c_uint,
+                    self.buf.as_mut_ptr().cast::<c_void>(),
+                    &mut len,
+                    ptr::null_mut(),
+                    0,
+                )
+            };
+            if rc != 0 || len < mem::size_of::<c_int>() {
+                return Vec::new();
+            }
+            // argc, the executable path, NUL padding, then argv.
+            let (argc, rest) = self.buf[..len].split_at(mem::size_of::<c_int>());
+            let argc = c_int::from_ne_bytes(argc.try_into().expect("split at int size"));
+            let exec_end = rest.iter().position(|b| *b == 0).unwrap_or(rest.len());
+            let rest = &rest[exec_end..];
+            let argv_start = rest.iter().position(|b| *b != 0).unwrap_or(rest.len());
+            rest[argv_start..]
+                .split(|b| *b == 0)
+                .take(argc.clamp(0, 2) as usize)
+                .map(|arg| String::from_utf8_lossy(arg).into_owned())
+                .collect()
+        }
+    }
+
+    fn arg_max() -> usize {
+        let mut mib = [libc::CTL_KERN, libc::KERN_ARGMAX];
+        let mut max: c_int = 0;
+        let mut len = mem::size_of::<c_int>();
+        // SAFETY: `max` is `len` bytes.
+        let rc = unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                mib.len() as libc::c_uint,
+                (&mut max as *mut c_int).cast::<c_void>(),
+                &mut len,
+                ptr::null_mut(),
+                0,
+            )
+        };
+        if rc == 0 && max > 0 {
+            max as usize
+        } else {
+            1 << 20
+        }
+    }
+
+    fn c_chars(chars: &[c_char]) -> String {
+        let bytes: Vec<u8> = chars
+            .iter()
+            .take_while(|c| **c != 0)
+            .map(|c| *c as u8)
+            .collect();
+        String::from_utf8_lossy(&bytes).into_owned()
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+mod sys {
+    //! squawk is a macOS app; elsewhere there is no process table to read
+    //! and detection finds nothing.
+
+    use super::{Details, PathBuf, Proc};
+
+    pub fn processes() -> Vec<Proc> {
+        Vec::new()
+    }
+
+    pub fn details(_pid: i32) -> Option<Details> {
+        None
+    }
+
+    pub fn cwd(_pid: i32) -> Option<PathBuf> {
+        None
+    }
+
+    pub fn tty_path(_dev: u32) -> Option<PathBuf> {
+        None
+    }
+
+    pub struct Args;
+
+    impl Args {
+        pub fn new() -> Args {
+            Args
+        }
+
+        pub fn read(&mut self, _pid: i32) -> Vec<String> {
+            Vec::new()
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn proc(pid: i32, ppid: i32, name: &str) -> Proc {
+        Proc {
+            pid,
+            ppid,
+            name: name.to_string(),
+        }
+    }
+
+    fn pids(found: &[(&Proc, Agent)]) -> Vec<(i32, Agent)> {
+        let mut out: Vec<_> = found.iter().map(|(p, a)| (p.pid, *a)).collect();
+        out.sort_by_key(|(pid, _)| *pid);
+        out
+    }
+
+    #[test]
+    fn finds_agents_below_the_terminal_only() {
+        let procs = [
+            proc(100, 1, "ghostty"),
+            proc(101, 100, "login"),
+            proc(102, 101, "zsh"),
+            proc(103, 102, "claude"),
+            proc(110, 100, "zsh"),
+            proc(111, 110, "codex"),
+            // Another terminal's session.
+            proc(200, 1, "Terminal"),
+            proc(201, 200, "claude"),
+        ];
+        let found = agents_under(&procs, 100, |p| agent_named(&p.name));
+        assert_eq!(pids(&found), [(103, Agent::Claude), (111, Agent::Codex)]);
+        assert!(agents_under(&procs, 102, |p| agent_named(&p.name)).len() == 1);
+        assert!(agents_under(&procs, 999, |p| agent_named(&p.name)).is_empty());
+    }
+
+    #[test]
+    fn does_not_look_inside_an_agent() {
+        let procs = [
+            proc(100, 1, "ghostty"),
+            proc(102, 100, "zsh"),
+            proc(103, 102, "claude"),
+            proc(104, 103, "zsh"),
+            proc(105, 104, "codex"),
+        ];
+        let found = agents_under(&procs, 100, |p| agent_named(&p.name));
+        assert_eq!(pids(&found), [(103, Agent::Claude)]);
+    }
+
+    #[test]
+    fn a_parent_loop_ends() {
+        let procs = [proc(5, 6, "zsh"), proc(6, 5, "zsh")];
+        assert!(agents_under(&procs, 5, |p| agent_named(&p.name)).is_empty());
+    }
+
+    #[test]
+    fn names() {
+        assert_eq!(agent_named("claude"), Some(Agent::Claude));
+        assert_eq!(agent_named("/opt/homebrew/bin/codex"), Some(Agent::Codex));
+        assert_eq!(agent_named("claude-helper"), None);
+        assert_eq!(agent_named("zsh"), None);
+    }
+
+    #[test]
+    fn command_lines() {
+        let args = |a: &[&str]| a.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(agent_in_args(&args(&["claude"])), Some(Agent::Claude));
+        assert_eq!(
+            agent_in_args(&args(&["node", "/usr/local/bin/codex"])),
+            Some(Agent::Codex)
+        );
+        assert_eq!(
+            agent_in_args(&args(&["/usr/bin/node", "/x/bin/codex.js", "exec"])),
+            Some(Agent::Codex)
+        );
+        // An editor opening a file called claude is not a session.
+        assert_eq!(agent_in_args(&args(&["vim", "claude"])), None);
+        assert_eq!(agent_in_args(&args(&["node", "server.js"])), None);
+        assert_eq!(agent_in_args(&[]), None);
+    }
+
+    #[test]
+    fn only_terminals_are_searched() {
+        let front = FrontApp {
+            bundle_id: "com.apple.Safari".into(),
+            name: "Safari".into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(detect(&front), None);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn finds_a_real_process_and_its_directory() {
+        let dir = tempfile::tempdir().unwrap();
+        let bin = dir.path().join("claude");
+        std::fs::copy("/bin/sleep", &bin).unwrap();
+        let work = dir.path().join("project");
+        std::fs::create_dir(&work).unwrap();
+        let mut child = std::process::Command::new(&bin)
+            .arg("30")
+            .current_dir(&work)
+            .spawn()
+            .unwrap();
+        let front = FrontApp {
+            bundle_id: "com.mitchellh.ghostty".into(),
+            name: "Ghostty".into(),
+            pid: std::process::id() as i32,
+        };
+        // The child shows up under its new name once it has exec'd.
+        let mut session = None;
+        for _ in 0..100 {
+            session = detect(&front).filter(|s| s.pid == child.id() as i32);
+            if session.is_some() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let session = session.expect("the fake claude under this process");
+        assert_eq!(session.agent, Agent::Claude);
+        assert_eq!(
+            session.cwd.canonicalize().unwrap(),
+            work.canonicalize().unwrap()
+        );
+        assert_eq!(session.project(), "project");
+    }
+}
