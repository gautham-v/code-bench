index 0000000..d8ace2f
--- /dev/null
+++ b/crates/squawk-core/src/context/detect.rs
@@ -0,0 +1,194 @@
+//! Find the agent session behind a terminal, with libproc (macOS). No
+//! subprocesses.
+
+use std::path::PathBuf;
+
+use super::{Agent, FrontApp, Session, AGENT_PROCESS_NAMES};
+
+/// The agent a process name stands for.
+pub(super) fn agent_for(name: &str) -> Option<Agent> {
+    AGENT_PROCESS_NAMES
+        .iter()
+        .find(|(n, _)| n.eq_ignore_ascii_case(name))
+        .map(|(_, a)| *a)
+}
+
+/// Among `(session, last tty activity)` pairs, the most recently used; ties
+/// go to the earlier entry.
+pub(super) fn most_recent(found: Vec<(Session, std::time::SystemTime)>) -> Option<Session> {
+    let mut best: Option<(Session, std::time::SystemTime)> = None;
+    for (s, t) in found {
+        if best.as_ref().map_or(true, |(_, bt)| t > *bt) {
+            best = Some((s, t));
+        }
+    }
+    best.map(|(s, _)| s)
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn detect(front: &FrontApp) -> Option<Session> {
+    use std::collections::HashMap;
+    use std::time::SystemTime;
+
+    let pids = list_pids();
+    let mut parent: HashMap<i32, i32> = HashMap::new();
+    for &pid in &pids {
+        if let Some(info) = bsd_info(pid) {
+            parent.insert(pid, info.pbi_ppid as i32);
+        }
+    }
+    let mut found = Vec::new();
+    for &pid in &pids {
+        if pid == front.pid || !descends_from(pid, front.pid, &parent) {
+            continue;
+        }
+        let Some(name) = proc_name(pid) else { continue };
+        let Some(agent) = agent_for(&name) else {
+            continue;
+        };
+        let Some(cwd) = cwd_of(pid) else { continue };
+        let tty = bsd_info(pid).and_then(|i| tty_path(i.e_tdev));
+        let when = tty
+            .as_ref()
+            .and_then(|t| std::fs::metadata(t).ok())
+            .map(|m| {
+                let a = m.accessed().unwrap_or(SystemTime::UNIX_EPOCH);
+                let w = m.modified().unwrap_or(SystemTime::UNIX_EPOCH);
+                a.max(w)
+            })
+            .unwrap_or(SystemTime::UNIX_EPOCH);
+        found.push((
+            Session {
+                agent,
+                pid,
+                cwd,
+                tty,
+            },
+            when,
+        ));
+    }
+    most_recent(found)
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn detect(_front: &FrontApp) -> Option<Session> {
+    None
+}
+
+#[cfg(target_os = "macos")]
+fn descends_from(mut pid: i32, ancestor: i32, parent: &std::collections::HashMap<i32, i32>) -> bool {
+    for _ in 0..64 {
+        match parent.get(&pid) {
+            Some(&p) if p == ancestor => return true,
+            Some(&p) if p > 1 && p != pid => pid = p,
+            _ => return false,
+        }
+    }
+    false
+}
+
+#[cfg(target_os = "macos")]
+fn list_pids() -> Vec<i32> {
+    unsafe {
+        let n = libc::proc_listpids(1, 0, std::ptr::null_mut(), 0); // PROC_ALL_PIDS
+        if n <= 0 {
+            return Vec::new();
+        }
+        let mut buf = vec![0i32; n as usize / 4 + 64];
+        let got = libc::proc_listpids(
+            1,
+            0,
+            buf.as_mut_ptr() as *mut libc::c_void,
+            (buf.len() * 4) as libc::c_int,
+        );
+        if got <= 0 {
+            return Vec::new();
+        }
+        buf.truncate(got as usize / 4);
+        buf.retain(|&p| p > 0);
+        buf
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn bsd_info(pid: i32) -> Option<libc::proc_bsdinfo> {
+    unsafe {
+        let mut info: libc::proc_bsdinfo = std::mem::zeroed();
+        let size = std::mem::size_of::<libc::proc_bsdinfo>() as libc::c_int;
+        let got = libc::proc_pidinfo(
+            pid,
+            libc::PROC_PIDTBSDINFO,
+            0,
+            &mut info as *mut _ as *mut libc::c_void,
+            size,
+        );
+        (got == size).then_some(info)
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn proc_name(pid: i32) -> Option<String> {
+    let mut buf = [0u8; 256];
+    let n = unsafe { libc::proc_name(pid, buf.as_mut_ptr() as *mut libc::c_void, 256) };
+    if n <= 0 {
+        return None;
+    }
+    let name = String::from_utf8_lossy(&buf[..n as usize]).into_owned();
+    // `claude` is often a node/bun script or a versioned binary: fall back
+    // to the executable's file name.
+    if agent_for(&name).is_some() {
+        return Some(name);
+    }
+    let mut path = [0u8; 4096];
+    let n = unsafe { libc::proc_pidpath(pid, path.as_mut_ptr() as *mut libc::c_void, 4096) };
+    if n > 0 {
+        let p = String::from_utf8_lossy(&path[..n as usize]).into_owned();
+        if let Some(base) = p.rsplit('/').next() {
+            if agent_for(base).is_some() {
+                return Some(base.to_string());
+            }
+        }
+    }
+    Some(name)
+}
+
+#[cfg(target_os = "macos")]
+fn cwd_of(pid: i32) -> Option<PathBuf> {
+    unsafe {
+        let mut info: libc::proc_vnodepathinfo = std::mem::zeroed();
+        let size = std::mem::size_of::<libc::proc_vnodepathinfo>() as libc::c_int;
+        let got = libc::proc_pidinfo(
+            pid,
+            libc::PROC_PIDVNODEPATHINFO,
+            0,
+            &mut info as *mut _ as *mut libc::c_void,
+            size,
+        );
+        if got != size {
+            return None;
+        }
+        let p = info.pvi_cdir.vip_path.as_ptr() as *const libc::c_char;
+        let s = std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned();
+        (!s.is_empty()).then(|| PathBuf::from(s))
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn tty_path(dev: u32) -> Option<PathBuf> {
+    use std::os::unix::fs::MetadataExt;
+    if dev == 0 || dev == u32::MAX {
+        return None;
+    }
+    for entry in std::fs::read_dir("/dev").ok()?.flatten() {
+        let name = entry.file_name();
+        if !name.to_string_lossy().starts_with("ttys") {
+            continue;
+        }
+        if let Ok(m) = std::fs::metadata(entry.path()) {
+            if m.rdev() as u32 == dev {
+                return Some(entry.path());
+            }
+        }
+    }
+    None
+}
