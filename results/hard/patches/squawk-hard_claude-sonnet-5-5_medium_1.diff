+        assert_eq!(apply("see the claude md, then", &c), "see the @CLAUDE.md, then");
+        assert_eq!(apply("edit cargo toml.", &c), "edit @Cargo.toml.");
+        assert_eq!(
+            apply("open context slash mod dot rs now", &c),
+            "open @src/context/mod.rs now"
+        );
+        assert_eq!(apply("open src slash store slash mod dot r s", &c), "open @src/store/mod.rs");
+    }
+
+    #[test]
+    fn leaves_unsure_alone() {
+        let c = ctx(&["src/context/mod.rs", "src/store/mod.rs", "a.rs"], &[]);
+        for t in [
+            "look at mod dot rs",
+            "look at nothing dot rs",
+            "look at foo slash mod dot rs",
+            "go to the store",
+            "mention @src/a.rs again",
+        ] {
+            assert_eq!(apply(t, &c), t);
+        }
+    }
+
+    #[test]
+    fn jargon_spelling() {
+        let c = ctx(&[], &["SQLite", "squawk-core", "VocabCache", "audio", "NOTE"]);
+        assert_eq!(
+            apply("sqlite and squawk core with vocab cache note audio", &c),
+            "SQLite and squawk-core with VocabCache note audio"
+        );
+    }
+
+    #[test]
+    fn build_scans_repo() {
+        let d = tempfile::tempdir().unwrap();
+        std::fs::create_dir(d.path().join("src")).unwrap();
+        std::fs::write(d.path().join("src/audio.rs"), "").unwrap();
+        std::fs::write(d.path().join("README.md"), "# Squawk\n\nUses SQLite for the Squawk store.\n").unwrap();
+        let v = RepoVocab::build(d.path());
+        assert!(v.files.contains(&"src/audio.rs".to_string()));
+        assert!(v.words.contains(&"SQLite".to_string()));
+        assert!(v.words.contains(&"Squawk".to_string()));
+        let mut cache = VocabCache::new();
+        let a = cache.get(d.path());
+        // No git here: the TTL cache hands back the same vocab.
+        assert!(Arc::ptr_eq(&a, &cache.get(d.path())));
+    }
 }
