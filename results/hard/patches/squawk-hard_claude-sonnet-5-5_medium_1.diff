+++ b/crates/squawk-core/src/context/mentions.rs
@@ -0,0 +1,319 @@
+//! Spoken file names to @mentions, and repo jargon to its own spelling.
+
+use std::collections::HashMap;
+
+use crate::text::{self, Chunk};
+
+use super::RepoVocab;
+
+/// Extensions that may be said without "dot" ("cargo toml", "the claude md").
+const BARE_EXTENSIONS: &[&str] = &[
+    "md", "toml", "json", "rs", "py", "js", "ts", "tsx", "jsx", "yaml", "yml", "txt", "sh", "html",
+    "css", "lock", "mod", "sum", "cfg", "ini", "sql", "swift", "kt", "java", "rb", "go", "mjs",
+    "cjs", "scss", "csv", "xml", "plist", "lua", "cpp", "hpp", "proto",
+];
+
+/// Words that are never a repo term when they merely happen to be shouted in
+/// a README.
+const SHOUTED_WORDS: &[&str] = &[
+    "NOTE", "TODO", "WARNING", "IMPORTANT", "TIP", "FIXME", "NEVER", "ALWAYS", "MUST", "NOT",
+    "AND", "THE", "FOR", "YES", "OFF", "ALL", "NEW", "OLD", "WIP", "DONE",
+];
+
+const MAX_WORDS_PER_PART: usize = 8;
+
+struct Tok {
+    c: Chunk,
+    slash: bool,
+}
+
+impl Tok {
+    fn plain(&self) -> bool {
+        !self.slash && !self.c.core.is_empty() && !self.c.is_protected()
+    }
+
+    fn word(&self) -> String {
+        self.c.core.to_lowercase()
+    }
+}
+
+fn norm(s: &str) -> String {
+    s.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+fn is_separator_word(w: &str) -> bool {
+    matches!(w, "underscore" | "dash" | "hyphen" | "dot")
+}
+
+pub(super) fn apply(text: &str, vocab: &RepoVocab) -> String {
+    let mut toks: Vec<Tok> = text
+        .split_whitespace()
+        .map(|raw| Tok {
+            c: Chunk::parse(raw),
+            slash: raw == "/",
+        })
+        .collect();
+    let mut changed = false;
+    if !vocab.files.is_empty() {
+        changed |= mentions(&mut toks, vocab);
+    }
+    if !vocab.words.is_empty() {
+        changed |= jargon(&mut toks, vocab);
+    }
+    if !changed {
+        return text.to_string();
+    }
+    let chunks: Vec<Chunk> = toks.into_iter().map(|t| t.c).collect();
+    text::join(&chunks)
+}
+
+// ---- @mentions -------------------------------------------------------
+
+/// Normalised words `toks[a..b]` would spell, if they can be one name:
+/// plain words, no punctuation between them.
+fn piece(toks: &[Tok], a: usize, b: usize) -> Option<String> {
+    if a >= b || b > toks.len() {
+        return None;
+    }
+    let mut out = String::new();
+    for (i, t) in toks[a..b].iter().enumerate() {
+        if !t.plain() || (i > 0 && !t.c.lead.is_empty()) || (a + i + 1 < b && !t.c.trail.is_empty())
+        {
+            return None;
+        }
+        let w = t.word();
+        if is_separator_word(&w) {
+            continue;
+        }
+        out.push_str(&norm(&w));
+    }
+    Some(out)
+}
+
+fn is_slash_word(t: &Tok) -> bool {
+    t.slash || (t.plain() && t.word() == "slash" && t.c.trail.is_empty())
+}
+
+/// Walk back from `p` (exclusive end of the stem words) over the stem and any
+/// spoken folders; the start index of the whole reference.
+fn match_back(toks: &[Tok], p: usize, stem: &str, dirs: &[String]) -> Option<usize> {
+    let mut pos = p;
+    if !stem.is_empty() {
+        let k = (1..=MAX_WORDS_PER_PART.min(pos))
+            .find(|&k| piece(toks, pos - k, pos).is_some_and(|s| s == stem))?;
+        pos -= k;
+    }
+    let mut di = 0;
+    while pos > 0 && is_slash_word(&toks[pos - 1]) {
+        if !toks[pos].c.lead.is_empty() || di >= dirs.len() {
+            return None;
+        }
+        let end = pos - 1;
+        let j = (1..=MAX_WORDS_PER_PART.min(end))
+            .find(|&j| piece(toks, end - j, end).is_some_and(|s| s == dirs[di]))?;
+        pos = end - j;
+        di += 1;
+    }
+    Some(pos)
+}
+
+/// The one file `ext`-ended file the words ending at `e` name, with where
+/// the reference starts. `None` when nothing matches or it is ambiguous.
+fn resolve<'a>(
+    toks: &[Tok],
+    vocab: &'a RepoVocab,
+    p: usize,
+    ext: &str,
+    dotted: bool,
+) -> Option<(usize, &'a String)> {
+    let mut best: Option<(usize, &'a String)> = None;
+    let mut ties = false;
+    for f in &vocab.files {
+        if f.chars().any(char::is_whitespace) {
+            continue;
+        }
+        let (dir, name) = f.rsplit_once('/').unwrap_or(("", f));
+        let Some((stem, fext)) = name.rsplit_once('.') else {
+            continue;
+        };
+        if !fext.eq_ignore_ascii_case(ext) || (stem.is_empty() && !dotted) {
+            continue;
+        }
+        let dirs: Vec<String> = dir.rsplit('/').filter(|d| !d.is_empty()).map(norm).collect();
+        let Some(start) = match_back(toks, p, &norm(stem), &dirs) else {
+            continue;
+        };
+        match best {
+            Some((s, b)) if start == s && b != f => ties = true,
+            Some((s, _)) if start > s => {}
+            Some((s, b)) if start == s && b == f => {}
+            _ => {
+                best = Some((start, f));
+                ties = false;
+            }
+        }
+    }
+    if ties {
+        None
+    } else {
+        best
+    }
+}
+
+fn mentions(toks: &mut Vec<Tok>, vocab: &RepoVocab) -> bool {
+    let mut changed = false;
+    let mut e = 0;
+    while e < toks.len() {
+        if let Some((start, path)) = find_at(toks, vocab, e) {
+            let lead = toks[start].c.lead.clone();
+            let trail = toks[e].c.trail.clone();
+            let mention = Tok {
+                c: Chunk {
+                    lead,
+                    core: format!("@{path}"),
+                    trail,
+                },
+                slash: false,
+            };
+            toks.splice(start..=e, [mention]);
+            changed = true;
+            e = start + 1;
+        } else {
+            e += 1;
+        }
+    }
+    changed
+}
+
+fn find_at(toks: &[Tok], vocab: &RepoVocab, e: usize) -> Option<(usize, String)> {
+    let last = &toks[e];
+    if !last.plain() {
+        return None;
+    }
+    let valid = |start: usize| {
+        toks[start + 1..=e].iter().all(|t| t.c.lead.is_empty())
+            && toks[start..e].iter().all(|t| t.c.trail.is_empty())
+    };
+    // "... dot r s" / "... dot rs"
+    for m in 1..=4usize {
+        if e < m {
+            break;
+        }
+        let dot = &toks[e - m];
+        if !dot.plain() || dot.word() != "dot" {
+            continue;
+        }
+        let ext_toks = &toks[e - m + 1..=e];
+        if !ext_toks.iter().all(|t| {
+            t.plain() && t.c.core.chars().all(|c| c.is_ascii_alphanumeric()) && (m == 1 || t.c.core.len() == 1)
+        }) {
+            continue;
+        }
+        let ext: String = ext_toks.iter().map(|t| t.word()).collect();
+        if let Some((start, path)) = resolve(toks, vocab, e - m, &ext, true) {
+            if valid(start) {
+                return Some((start, path.clone()));
+            }
+        }
+    }
+    // "cargo toml"
+    let w = last.word();
+    if e >= 1
+        && last.c.core.chars().all(|c| c.is_ascii_alphanumeric())
+        && BARE_EXTENSIONS.contains(&w.as_str())
+    {
+        if let Some((start, path)) = resolve(toks, vocab, e, &w, false) {
+            if valid(start) {
+                return Some((start, path.clone()));
+            }
+        }
+    }
+    None
+}
+
+// ---- jargon ------------------------------------------------------------
+
+fn interesting(canon: &str) -> bool {
+    if SHOUTED_WORDS.contains(&canon) {
+        return false;
+    }
+    let letters = canon.chars().filter(|c| c.is_alphabetic()).count();
+    let shouted = letters > 0 && !canon.chars().any(char::is_lowercase);
+    if shouted && letters < 3 && !canon.chars().any(|c| c.is_ascii_digit()) {
+        return false;
+    }
+    // A plain lowercase word is already how everyone writes it.
+    canon.chars().any(|c| !c.is_lowercase() && c.is_alphabetic())
+        || canon.contains(['-', '_'])
+        || canon.chars().any(|c| c.is_ascii_digit())
+}
+
+/// Can several spoken words stand for this term ("vocab cache")?
+fn joinable(canon: &str) -> bool {
+    canon.contains('-') || (canon.chars().count() > 2 && text::has_inner_case(canon))
+}
+
+fn jargon(toks: &mut Vec<Tok>, vocab: &RepoVocab) -> bool {
+    // Normalised spelling -> its one canonical form (none if the repo
+    // writes it more than one way).
+    let mut canon: HashMap<String, Option<&str>> = HashMap::new();
+    for w in &vocab.words {
+        if w.chars().any(char::is_whitespace) || !interesting(w) {
+            continue;
+        }
+        canon
+            .entry(norm(w))
+            .and_modify(|c| {
+                if *c != Some(w.as_str()) {
+                    *c = None
+                }
+            })
+            .or_insert(Some(w.as_str()));
+    }
+    let mut changed = false;
+    let mut i = 0;
+    while i < toks.len() {
+        if !toks[i].plain() {
+            i += 1;
+            continue;
+        }
+        let mut done = false;
+        // Longest run of words first.
+        for n in (1..=4usize.min(toks.len() - i)).rev() {
+            let Some(key) = piece(toks, i, i + n) else {
+                continue;
+            };
+            let Some(Some(c)) = canon.get(&key).copied() else {
+                continue;
+            };
+            if n > 1 && !joinable(c) {
+                continue;
+            }
+            if n == 1 && toks[i].c.core == c {
+                done = true;
+                break;
+            }
+            let (lead, trail) = (toks[i].c.lead.clone(), toks[i + n - 1].c.trail.clone());
+            toks.splice(
+                i..i + n,
+                [Tok {
+                    c: Chunk {
+                        lead,
+                        core: c.to_string(),
+                        trail,
+                    },
+                    slash: false,
+                }],
+            );
+            changed = true;
+            done = true;
+            break;
+        }
+        let _ = done;
+        i += 1;
+    }
+    changed
+}
