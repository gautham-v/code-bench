--- /dev/null
+++ b/crates/squawk-core/src/context/vocab.rs
@@ -0,0 +1,290 @@
+//! Scan a repo for the files and jargon dictation should line up with.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::Arc;
+use std::time::{Duration, Instant, SystemTime};
+
+use super::RepoVocab;
+
+const MAX_FILES: usize = 50_000;
+const MAX_DEPTH: usize = 8;
+const NO_GIT_TTL: Duration = Duration::from_secs(20);
+const DOCS: &[&str] = &["README.md", "CLAUDE.md", "CONTEXT.md", "AGENTS.md"];
+
+pub(super) fn build(cwd: &Path) -> RepoVocab {
+    let files = list_files(cwd);
+    let words = collect_words(cwd, &files);
+    RepoVocab {
+        root: cwd.to_path_buf(),
+        files,
+        words,
+    }
+}
+
+fn list_files(cwd: &Path) -> Vec<String> {
+    if let Some(mut files) = git_files(cwd) {
+        files.sort();
+        files.dedup();
+        files.truncate(MAX_FILES);
+        return files;
+    }
+    let mut out = Vec::new();
+    walk(cwd, "", 0, &mut out);
+    out.sort();
+    out
+}
+
+fn git_files(cwd: &Path) -> Option<Vec<String>> {
+    let out = Command::new("git")
+        .args(["ls-files", "-z", "--cached", "--others", "--exclude-standard"])
+        .current_dir(cwd)
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&out.stdout);
+    Some(
+        text.split('\0')
+            .filter(|s| !s.is_empty())
+            // Deleted-but-tracked files still show up; only keep real ones.
+            .filter(|s| cwd.join(s).is_file())
+            .map(str::to_string)
+            .collect(),
+    )
+}
+
+fn walk(dir: &Path, prefix: &str, depth: usize, out: &mut Vec<String>) {
+    if depth > MAX_DEPTH || out.len() >= MAX_FILES {
+        return;
+    }
+    let Ok(rd) = std::fs::read_dir(dir) else {
+        return;
+    };
+    let mut entries: Vec<_> = rd.flatten().collect();
+    entries.sort_by_key(|e| e.file_name());
+    for e in entries {
+        let name = e.file_name().to_string_lossy().into_owned();
+        if name.starts_with('.') && name != ".gitignore" {
+            continue;
+        }
+        let Ok(ft) = e.file_type() else { continue };
+        let rel = if prefix.is_empty() {
+            name.clone()
+        } else {
+            format!("{prefix}/{name}")
+        };
+        if ft.is_dir() {
+            if matches!(
+                name.as_str(),
+                "node_modules" | "target" | "build" | "dist" | "venv" | "__pycache__"
+            ) {
+                continue;
+            }
+            walk(&e.path(), &rel, depth + 1, out);
+        } else if ft.is_file() {
+            out.push(rel);
+        }
+        if out.len() >= MAX_FILES {
+            return;
+        }
+    }
+}
+
+fn collect_words(cwd: &Path, files: &[String]) -> Vec<String> {
+    let mut seen: HashSet<String> = HashSet::new();
+    let mut words: Vec<String> = Vec::new();
+    let mut add = |w: &str, words: &mut Vec<String>| {
+        let w = w.trim();
+        if w.len() >= 2 && seen.insert(w.to_string()) {
+            words.push(w.to_string());
+        }
+    };
+
+    for f in files {
+        let name = f.rsplit('/').next().unwrap_or(f);
+        let stem = match name.rsplit_once('.') {
+            Some((s, _)) if !s.is_empty() => s,
+            _ => continue,
+        };
+        // Hyphenated stems read as prose; only crate/package names (below)
+        // are joined from separate words.
+        if stem.contains('-') || stem.contains('.') {
+            continue;
+        }
+        add(stem, &mut words);
+    }
+
+    for f in files {
+        let name = f.rsplit('/').next().unwrap_or(f);
+        if !matches!(name, "Cargo.toml" | "pyproject.toml" | "package.json") {
+            continue;
+        }
+        let Ok(text) = read_small(&cwd.join(f)) else {
+            continue;
+        };
+        if name == "package.json" {
+            if let Ok(v) = serde_json::from_str::<serde_json::Value>(&text) {
+                if let Some(n) = v.get("name").and_then(|n| n.as_str()) {
+                    add(n.rsplit('/').next().unwrap_or(n), &mut words);
+                }
+            }
+            continue;
+        }
+        let mut in_pkg = false;
+        for line in text.lines() {
+            let l = line.trim();
+            if l.starts_with('[') {
+                in_pkg = matches!(l, "[package]" | "[project]" | "[tool.poetry]");
+            } else if in_pkg {
+                if let Some(v) = l.strip_prefix("name") {
+                    if let Some(v) = v.trim_start().strip_prefix('=') {
+                        add(v.trim().trim_matches(['"', '\'']), &mut words);
+                    }
+                }
+            }
+        }
+    }
+
+    for doc in DOCS {
+        if let Ok(text) = read_small(&cwd.join(doc)) {
+            for w in doc_terms(&text) {
+                add(&w, &mut words);
+            }
+        }
+    }
+    words
+}
+
+fn read_small(p: &Path) -> std::io::Result<String> {
+    let meta = std::fs::metadata(p)?;
+    if meta.len() > 512 * 1024 {
+        return Err(std::io::ErrorKind::InvalidData.into());
+    }
+    std::fs::read_to_string(p)
+}
+
+/// Terms a doc writes with meaningful casing: CamelCase and ACRONYMS, code
+/// identifiers, and capitalised words that are never written lowercase and
+/// are not just starting a sentence.
+pub(super) fn doc_terms(text: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    let mut cap_mid: HashSet<String> = HashSet::new();
+    let mut lower: HashSet<String> = HashSet::new();
+    let mut in_fence = false;
+    for line in text.lines() {
+        let t = line.trim_start();
+        if t.starts_with("```") {
+            in_fence = !in_fence;
+            continue;
+        }
+        if in_fence {
+            continue;
+        }
+        let heading = t.starts_with('#');
+        for (i, span) in line.split('`').enumerate() {
+            if i % 2 == 1 {
+                let s = span.trim();
+                if is_identifier(s) && (crate::text::has_inner_case(s) || s.contains('_')) {
+                    out.push(s.to_string());
+                }
+            }
+        }
+        let prose: String = line
+            .split('`')
+            .enumerate()
+            .filter(|(i, _)| i % 2 == 0)
+            .map(|(_, s)| s)
+            .collect::<Vec<_>>()
+            .join(" ");
+        let mut start = true;
+        for raw in prose.split_whitespace() {
+            let core = raw.trim_matches(|c: char| !c.is_alphanumeric());
+            let was_start = start;
+            start = raw.ends_with(['.', '!', '?', ':']);
+            if core.is_empty() || !core.chars().all(char::is_alphanumeric) {
+                continue;
+            }
+            let n = core.chars().count();
+            let first_upper = core.chars().next().is_some_and(char::is_uppercase);
+            let acronym = n >= 2
+                && core.chars().any(char::is_alphabetic)
+                && !core.chars().any(char::is_lowercase);
+            if first_upper && n >= 2 && (acronym || crate::text::has_inner_case(core)) {
+                out.push(core.to_string());
+            } else if core.chars().all(char::is_lowercase) {
+                lower.insert(core.to_string());
+            } else if first_upper && !was_start && !heading && n >= 3 {
+                cap_mid.insert(core.to_string());
+            }
+        }
+    }
+    for w in cap_mid {
+        if !lower.contains(&w.to_lowercase()) {
+            out.push(w);
+        }
+    }
+    out.sort();
+    out.dedup();
+    out
+}
+
+fn is_identifier(s: &str) -> bool {
+    !s.is_empty()
+        && s.chars().next().is_some_and(char::is_alphabetic)
+        && s.chars().all(|c| c.is_alphanumeric() || c == '_')
+}
+
+#[derive(Debug)]
+pub(super) struct Entry {
+    vocab: Arc<RepoVocab>,
+    stamp: Option<SystemTime>,
+    built: Instant,
+}
+
+/// The mtime of the repo's `.git/index`, searching up from `cwd`.
+fn index_stamp(cwd: &Path) -> Option<SystemTime> {
+    let mut dir: Option<&Path> = Some(cwd);
+    while let Some(d) = dir {
+        let git = d.join(".git");
+        if git.is_dir() {
+            return std::fs::metadata(git.join("index"))
+                .and_then(|m| m.modified())
+                .ok()
+                .or(Some(SystemTime::UNIX_EPOCH));
+        }
+        if git.is_file() {
+            // Worktree: `.git` is a file; its mtime is the best cheap signal.
+            return std::fs::metadata(&git).and_then(|m| m.modified()).ok();
+        }
+        dir = d.parent();
+    }
+    None
+}
+
+pub(super) fn get(entries: &mut HashMap<PathBuf, Entry>, cwd: &Path) -> Arc<RepoVocab> {
+    let stamp = index_stamp(cwd);
+    if let Some(e) = entries.get(cwd) {
+        let fresh = match stamp {
+            Some(_) => e.stamp == stamp,
+            None => e.stamp.is_none() && e.built.elapsed() < NO_GIT_TTL,
+        };
+        if fresh {
+            return e.vocab.clone();
+        }
+    }
+    let vocab = Arc::new(build(cwd));
+    entries.insert(
+        cwd.to_path_buf(),
+        Entry {
+            vocab: vocab.clone(),
+            stamp,
+            built: Instant::now(),
+        },
+    );
+    vocab
+}
