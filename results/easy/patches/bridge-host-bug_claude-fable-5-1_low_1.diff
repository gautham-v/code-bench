+test("claude: sub-agents' tool calls are steps under their Task step, which ends with the sub-agent's reply", async () => {
+  const t = setup();
+  try {
+    const id = newId();
+    await t.turn(id, "[agents] go");
+    const ev = t.events(id);
+    const starts = ev.filter((e) => e.kind === "tool_start");
+    assert.deepEqual(starts.map((e) => [e.toolUseId, e.name, e.summary, e.parent, e.tabId]), [
+      ["toolu_a", "Task", "Read requests on PyPI", undefined, undefined],
+      ["toolu_b", "Agent", "Read httpx on PyPI", undefined, undefined],
+      ["toolu_a1", "mcp__firefox__navigate", "Open pypi.org/project/requests/", "toolu_a", 7],
+      ["toolu_b1", "mcp__firefox__navigate", "Open pypi.org/project/httpx/", "toolu_b", 8],
+      ["toolu_c", "Task", "Read flask on PyPI", undefined, undefined],
+    ]);
+    assert.ok(!("parent" in starts[0]));
+    const ends = ev.filter((e) => e.kind === "tool_end");
+    assert.deepEqual(ends.slice(0, 3).map((e) => [e.toolUseId, e.ok, e.summary]), [
+      ["toolu_b1", true, "Navigated to https://pypi.org/project/httpx/"],
+      ["toolu_a1", true, "Navigated to https://pypi.org/project/requests/"],
+      ["toolu_a", true, "requests 2.32.3"],
+    ]);
+    assert.equal(ends[3].summary.length, 300);
+    assert.ok(ends[3].summary.startsWith("httpx 999"));
+    assert.deepEqual([ends[4].ok, ends[4].summary], [false, "Sub-agent crashed"]);
+    assert.deepEqual(ev.filter((e) => e.kind === "text").map((e) => e.text), ["Both read."]);
+    assert.ok(!JSON.stringify(ev).includes("agentId"));
+
+    const r = await t.ask("chat.load", { chatId: id, source: "panel" });
+    const loaded = r.items.filter((e) => e.kind === "tool_end");
+    assert.deepEqual(loaded.map((e) => [e.toolUseId, e.ok, e.summary]), ends.filter((e) => /^toolu_[abc]$/.test(e.toolUseId)).map((e) => [e.toolUseId, e.ok, e.summary]));
+  } finally {
+    t.done();
+  }
+});
+
