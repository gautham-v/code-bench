diff --git a/host/chat-format.mjs b/host/chat-format.mjs
index a8a6a75..c4645c1 100644
--- a/host/chat-format.mjs
+++ b/host/chat-format.mjs
@@ -128,10 +128,24 @@ export function summarizePermission(tool, input) {
   return fit(lines.join("\n"), CARD_INPUT_CHARS);
 }
 
+const SUB_AGENT_CHARS = 300;
+
+// A sub-agent step's result is the sub-agent's reply. Claude Code appends a last text block
+// (`agentId: ...` and a <usage> block) that is bookkeeping, not part of the reply.
+function summarizeSubAgentResult(parts, isError) {
+  const text = parts
+    .filter((p) => p?.type === "text" && typeof p.text === "string" && !/^\s*agentId:/.test(p.text))
+    .map((p) => p.text.replace(/\s*\n\s*agentId:[\s\S]*$/, ""))
+    .join("\n");
+  if (isError) return clip(text.split("\n").find((l) => l.trim()) || "Failed", SUB_AGENT_CHARS);
+  return clip(text, SUB_AGENT_CHARS);
+}
+
 // Result summaries: only errors carry text (the bridge already cuts typed values out of its error
 // messages). Page content, script output and screenshots never leave the host.
 export function summarizeToolResult(name, content, isError) {
   const parts = Array.isArray(content) ? content : typeof content === "string" ? [{ type: "text", text: content }] : [];
+  if (name === "Task" || name === "Agent") return summarizeSubAgentResult(parts, isError);
   const text = parts.filter((p) => p?.type === "text").map((p) => p.text).join("\n");
   const first = text.split("\n").find((l) => l.trim()) ?? "";
   if (isError) return clip(first || "Failed", 120);
