+test("claude: sub-agent tool calls are reported under their Task step, their text is not", async () => {
+  const t = setup();
+  try {
+    const id = newId();
+    await t.turn(id, "[subagent] go");
+    const ev = t.events(id);
+    assert.deepEqual(ev.filter((e) => e.kind === "tool_start").map((e) => [e.toolUseId, e.parent ?? null, e.tabId ?? null]), [
+      ["toolu_t1", null, null],
+      ["toolu_t2", null, null],
+      ["toolu_t3", null, null],
+      ["toolu_s1", "toolu_t1", 3],
+      ["toolu_s2", "toolu_t2", 4],
+    ]);
+    assert.deepEqual(ev.filter((e) => e.kind === "tool_end").map((e) => [e.toolUseId, e.ok, e.summary]), [
+      ["toolu_s1", true, "Navigated to https://pypi.org/project/requests/"],
+      ["toolu_s2", true, "Navigated to https://pypi.org/project/httpx/"],
+      ["toolu_t1", true, "requests 2.32.3"],
+      ["toolu_t2", true, `${"h".repeat(299)}…`],
+      ["toolu_t3", false, "Sub-agent could not start"],
+    ]);
+    assert.deepEqual(ev.filter((e) => e.kind === "text").map((e) => e.text), ["Both done."]);
+  } finally {
+    t.done();
+  }
+});
