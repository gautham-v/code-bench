+test("claude: sub-agents' tool calls are steps under their Task/Agent step, which ends with the sub-agent's reply", async () => {
+  const t = setup();
+  try {
+    const id = newId();
+    await t.turn(id, "[agents] compare");
+    const ev = t.events(id);
+    assert.deepEqual(ev.filter((e) => e.kind === "tool_start").map((e) => [e.toolUseId, e.parent, e.name, e.summary, e.tabId]), [
+      ["toolu_agent_a", undefined, "Agent", "Read requests on PyPI", undefined],
+      ["toolu_agent_b", undefined, "Task", "Read httpx on PyPI", undefined],
+      ["toolu_agent_c", undefined, "Agent", "Read nothing", undefined],
+      ["toolu_a_tab", "toolu_agent_a", "mcp__firefox__tabs_create_mcp", "Open a new tab", undefined],
+      ["toolu_b_tab", "toolu_agent_b", "mcp__firefox__tabs_create_mcp", "Open a new tab", undefined],
+      ["toolu_b_nav", "toolu_agent_b", "mcp__firefox__navigate", "Open pypi.org/project/httpx/", 12],
+      ["toolu_a_nav", "toolu_agent_a", "mcp__firefox__navigate", "Open pypi.org/project/requests/", 11],
+    ]);
+    assert.ok(!("parent" in ev.find((e) => e.toolUseId === "toolu_agent_a")), "the agent's own steps have no parent");
+    const ends = ev.filter((e) => e.kind === "tool_end");
+    assert.deepEqual(ends.slice(0, 5).map((e) => [e.toolUseId, e.ok, e.summary]), [
+      ["toolu_b_tab", true, "Created tab 12"],
+      ["toolu_a_tab", true, "Created tab 11"],
+      ["toolu_a_nav", true, "Navigated to https://pypi.org/project/requests/"],
+      ["toolu_b_nav", true, "Navigated to https://pypi.org/project/httpx/"],
+      ["toolu_agent_a", true, "requests 2.32.3"],
+    ]);
+    const long = ends[5];
+    assert.equal(long.toolUseId, "toolu_agent_b");
+    assert.equal(long.summary.length, 300);
+    assert.match(long.summary, /^httpx 0\.28\.1 The page lists every release\. /);
+    assert.deepEqual(ends[6], { kind: "tool_end", toolUseId: "toolu_agent_c", ok: false, summary: "Agent failed: API Error: 529 overloaded" });
+    assert.deepEqual(ev.filter((e) => e.kind === "text").map((e) => e.text), ["requests is 2.32.3 and httpx is 0.28.1."], "what a sub-agent says stays out of the chat");
+    assert.ok(ev.filter((e) => e.kind === "text_delta").every((e) => !e.messageId.startsWith("msg_sub")));
+    assert.equal(ev.filter((e) => e.kind === "error").length, 0, "a sub-agent's API error isn't the chat's");
+    const all = JSON.stringify(ev);
+    for (const hidden of ["agentId", "<usage>", "utm=secret", "Opening the requests page"]) assert.ok(!all.includes(hidden), `${hidden} must not appear`);
+    assert.equal(t.results(id).at(-1).ok, true);
+
+    // Reopened from history, the steps end with the same replies.
+    const r = await t.ask("chat.load", { chatId: id, source: "panel" });
+    assert.deepEqual(r.items.filter((i) => i.kind === "tool_end").map((i) => [i.toolUseId, i.ok, i.summary]), ends.slice(4).map((e) => [e.toolUseId, e.ok, e.summary]));
+  } finally {
+    t.done();
+  }
+});
+
